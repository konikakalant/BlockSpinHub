function Prototype:GetTargets()
	local result = {}

	if not self.Targets then
		return result
	end

	for _, model in ipairs(self.Targets:GetChildren()) do
		if model:IsA("Model") and model:GetAttribute("PrototypeTarget") == true then
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart")

			if humanoid and root and humanoid.Health > 0 then
				table.insert(result, model)
			end
		end
	end

	return result
end

function Prototype:GetTargetPart(model, requested)
	if not model then
		return nil
	end

	if requested == "Random" then
		local choices = {"Head", "UpperTorso", "HumanoidRootPart"}
		requested = choices[math.random(1, #choices)]
	end

	return model:FindFirstChild(requested)
		or model:FindFirstChild("Head")
		or model:FindFirstChild("UpperTorso")
		or model:FindFirstChild("HumanoidRootPart")
end

function Prototype:GetNearestATM()
	local root = GetRoot()

	if not root or not self.ATMs then
		return nil
	end

	local best = nil
	local bestDistance = math.huge

	for _, atm in ipairs(self.ATMs:GetChildren()) do
		local body = atm:FindFirstChild("Body")

		if body then
			local distance = (body.Position - root.Position).Magnitude

			if distance < bestDistance then
				bestDistance = distance
				best = atm
			end
		end
	end

	return best
end

function Prototype:GetJobMarker(name)
	if not self.Jobs then
		return nil
	end

	for _, marker in ipairs(self.Jobs:GetChildren()) do
		if marker:GetAttribute("JobType") == name then
			return marker
		end
	end

	return nil
end

function Prototype:GetLocationByAction(flag)
	if flag == "tp.atm" then
		local atm = self:GetNearestATM()
		return atm and atm:FindFirstChild("Body") or nil
	end

	if flag == "tp.job" then
		local preferred = GetState("jobs.preferred", "Janitor")
		return self:GetJobMarker(preferred)
	end

	local name = LocationNames[flag]

	if name then
		if name == "Illegal Shop" then
			return self.Shops and self.Shops:FindFirstChild(name)
		end

		return self:GetJobMarker(name)
	end

	return nil
end

function Runtime:IsInputDown(name)
	return self.InputDown[name] == true
end

function Runtime:IsAimActivationActive()
	local mode = GetState("aim.activation", "Hold")
	local key = GetState("aim.key", "MouseButton2")
	local secondaryKey = GetState("bind.aim", "MouseButton2")

	if mode == "Always" then
		return true
	end

	if mode == "Toggle" then
		return self.AimToggle
	end

	return self:IsInputDown(key) or self:IsInputDown(secondaryKey)
end

function Runtime:IsVisibleTarget(model, targetPart)
	if not Camera or not targetPart then
		return false
	end

	local character = GetCharacter()
	local origin = Camera.CFrame.Position
	local direction = targetPart.Position - origin

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude

	local ignore = {model}

	if character then
		table.insert(ignore, character)
	end

	if Prototype.Folder then
		-- Target geometry is intentionally excluded by model above while the
		-- rest of the prototype world remains capable of blocking visibility.
	end

	params.FilterDescendantsInstances = ignore

	local result = Workspace:Raycast(origin, direction, params)
	return result == nil
end

function Runtime:GetScreenDistance(worldPosition)
	if not Camera then
		return math.huge, false, nil
	end

	local screenPoint, onScreen = Camera:WorldToViewportPoint(worldPosition)
	local viewport = Camera.ViewportSize
	local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
	local point = Vector2.new(screenPoint.X, screenPoint.Y)

	return (point - center).Magnitude, onScreen and screenPoint.Z > 0, screenPoint
end

function Runtime:PassesTargetChecks(model, prefix)
	if not model then
		return false
	end

	local teamCheck = GetState(prefix .. ".teamCheck", false)
	local friendCheck = GetState(prefix .. ".friendCheck", true)

	if teamCheck then
		local localTeam = LocalPlayer:GetAttribute("PrototypeTeam")
		local targetTeam = model:GetAttribute("PrototypeTeam")

		if localTeam ~= nil and targetTeam == localTeam then
			return false
		end
	end

	if friendCheck and model:GetAttribute("PrototypeFriend") == true then
		return false
	end

	return true
end

function Runtime:GetBestTarget(kind)
	local root = GetRoot()

	if not root or not Camera then
		return nil, nil
	end

	local maxDistance
	local fov
	local priority
	local partName
	local wallCheck
	local knockedCheck
	local silentMethod=nil

	if kind == "silent" then
		maxDistance = GetState("silent.maxDistance", 1200)
		fov = GetState("silent.fov", 180)
		priority = "FOV"
		partName = GetState("silent.randomPart", false) and "Random" or GetState("silent.part", "Head")
		wallCheck = GetState("silent.wallCheck", true)
		knockedCheck = true
		silentMethod=GetState("silent.method", "Raycast")

		if GetState("silent.bulletMagnet", false) or silentMethod == "Bullet Magnet" then
			local magnet = GetState("silent.magnetStrength", 50) / 100
			fov = fov * (1 + magnet * 1.5)
		end
	else
		maxDistance = GetState("aim.maxDistance", 1200)
		fov = GetState("aim.fov", 180)
		priority = GetState("aim.priority", "FOV")
		partName = GetState("aim.part", "Head")
		wallCheck = GetState("aim.wallCheck", true)
		knockedCheck = GetState("aim.knockedCheck", true)
	end


	if kind ~= "silent" and GetState("aim.sticky", false) and self.CurrentAimTarget then
		local stickyPart = Prototype:GetTargetPart(self.CurrentAimTarget, partName)
		local stickyHumanoid = self.CurrentAimTarget:FindFirstChildOfClass("Humanoid")

		if stickyPart and stickyHumanoid and stickyHumanoid.Health > 0 then
			local stickyDistance = GetDistance(root.Position, stickyPart.Position)

			if stickyDistance <= GetState("aim.stickyDistance", 250)
				and self:PassesTargetChecks(self.CurrentAimTarget, "aim") then

				return self.CurrentAimTarget, stickyPart
			end
		end
	end

	local bestModel = nil
	local bestPart = nil
	local bestScore = math.huge

	for _, model in ipairs(Prototype:GetTargets()) do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local targetPart = Prototype:GetTargetPart(model, partName)

		if kind=="silent" and silentMethod=="Closest Part" then
			local closestPart=nil
			local closestScreen=math.huge
			for _,candidateName in ipairs({"Head","UpperTorso","HumanoidRootPart"}) do
				local candidate=model:FindFirstChild(candidateName)
				if candidate then
					local screenDistance,onScreen=self:GetScreenDistance(candidate.Position)
					if onScreen and screenDistance<closestScreen then
						closestScreen=screenDistance
						closestPart=candidate
					end
				end
			end
			targetPart=closestPart or targetPart
		end

		if humanoid and targetPart and self:PassesTargetChecks(model, kind == "silent" and "silent" or "aim") then
			local distance = GetDistance(root.Position, targetPart.Position)
			local screenDistance, onScreen = self:GetScreenDistance(targetPart.Position)
			local valid = distance <= maxDistance and onScreen and screenDistance <= fov

			if knockedCheck and humanoid.Health <= 10 then
				valid = false
			end

			if wallCheck and valid and not self:IsVisibleTarget(model, targetPart) then
				valid = false
			end

			if valid then
				local score

				if priority == "Distance" then
					score = distance
				elseif priority == "Health" then
					score = humanoid.Health
				else
					score = screenDistance
				end

				if score < bestScore then
					bestScore = score
					bestModel = model
					bestPart = targetPart
				end
			end
		end
	end

	return bestModel, bestPart
end

function Runtime:GetSilentDirection(origin, defaultDirection)
	if not GetState("silent.enabled", false) then
		return defaultDirection, nil
	end

	local target, part = self:GetBestTarget("silent")

	if not target or not part then
		return defaultDirection, nil
	end

	self.CurrentSilentTarget = target

	local hitChance = GetState("silent.hitChance", 100)

	if GetState("silent.dynamicHitChance", false) then
		local root = GetRoot()

		if root then
			local distance = GetDistance(root.Position, part.Position)
			hitChance = math.clamp(hitChance - (distance / 120), 35, hitChance)
		end
	end

	if math.random(1, 100) > hitChance then
		return defaultDirection, nil
	end

	local targetPosition = part.Position

	if GetState("silent.prediction", true) then
		local amount = GetState("silent.predictionAmount", 0.12)
		targetPosition = targetPosition + part.AssemblyLinearVelocity * amount
	end

	if GetState("silent.resolver", false) then
		local resolverStrength = GetState("silent.resolverStrength", 60) / 100
		targetPosition = targetPosition:Lerp(part.Position, resolverStrength)
	end

	local targetDelta=targetPosition-origin

	if targetDelta.Magnitude<0.001 then
		return defaultDirection,target
	end

	local targetDirection=targetDelta.Unit

	if GetState("silent.bulletMagnet", false) or GetState("silent.method", "Raycast") == "Bullet Magnet" then
		local strength = math.clamp(GetState("silent.magnetStrength", 50) / 100, 0, 1)
		local blended=defaultDirection:Lerp(targetDirection,strength)
		targetDirection=blended.Magnitude>0.001 and blended.Unit or targetDirection
	end

	return targetDirection, target
end

function Runtime:CreateTracer(origin, hitPosition)
	if not GetState("ballistics.tracers", false) then
		return
	end

	if not Prototype.Effects then
		return
	end

	local distance = (hitPosition - origin).Magnitude
	local midpoint = origin:Lerp(hitPosition, 0.5)
	local width = math.max(0.05, GetState("ballistics.tracerWidth", 0.15))

	local tracer = MakePart(
		Prototype.Effects,
		"Tracer",
		Vector3.new(width, width, distance),
		CFrame.lookAt(midpoint, hitPosition),
		Theme.Accent,
		Enum.Material.Neon,
		true
	)

	tracer.CanCollide = false
	tracer.CanQuery = false
	tracer.Transparency = 0.1

	local lifetime = GetState("ballistics.tracerLifetime", 1)
	local style = GetState("ballistics.tracerStyle", "Fade")

	if style == "Fade" then
		TweenService:Create(
			tracer,
			TweenInfo.new(lifetime, Enum.EasingStyle.Linear),
			{Transparency = 1}
		):Play()
	end

	Debris:AddItem(tracer, lifetime + 0.1)
end

function Runtime:CreateImpact(position)

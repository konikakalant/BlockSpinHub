function Runtime:UpdateRuntimeUI(dt)
    local frameDt=math.max(dt or 0,1/500)
    local instantFPS=1/frameDt
    self.SmoothedFPS=self.SmoothedFPS and (self.SmoothedFPS*0.88+instantFPS*0.12) or instantFPS

    self.RuntimeUIAccumulator=self.RuntimeUIAccumulator+(dt or 0)
    local uiInterval=(Config.PerformanceMode=="Performance" or Config.DeviceProfile=="Phone") and 0.20
        or ((Config.PerformanceMode=="Balanced" or Config.DeviceProfile=="Tablet") and 0.15 or 0.12)
    if self.RuntimeUIAccumulator<uiInterval then return end
    self.RuntimeUIAccumulator=0

    if StatusMode then
        local fps=math.floor(math.clamp(self.SmoothedFPS or 60,1,999)+0.5)
        local activity="ACTIVE"
        if GetState("atm.enabled",false) and self.ATMSession then
            activity="ATM • "..string.upper(tostring(self.ATMSession.Phase or "RUN"))
        elseif self.JobSession and self.JobSession.Name then
            activity="JOB • "..string.upper(string.sub(tostring(self.JobSession.Name),1,8))
        elseif GetState("aim.enabled",false) or GetState("melee.aura",false) then
            activity="COMBAT"
        end
        StatusMode.Text=string.format("%s • %d FPS",activity,fps)
        StatusMode.TextColor3=Theme.Success
    end

end

function Runtime:OnInputBegan(input, processed)
    local name = GetInputName(input)
    self.InputDown[name] = true

    if processed or CapturingKeybind then
        return
    end

    local aimKey = GetState("aim.key", "MouseButton2")
    local secondaryAimKey=GetState("bind.aim","MouseButton2")

    if (name == aimKey or name==secondaryAimKey) and GetState("aim.activation", "Hold") == "Toggle" then
        self.AimToggle = not self.AimToggle
    end

    if name == GetState("bind.panic", "End") then
        for flag, control in pairs(Controls) do
            local isInterfaceFlag=string.sub(flag,1,3)=="ui."
                or string.sub(flag,1,5)=="bind."
                or string.sub(flag,1,7)=="config."

            if not isInterfaceFlag and control.Type == "toggle" and control.Set then
                control.Set(false, false)
            end
        end

        self.TriggerBurstToken=self.TriggerBurstToken+1
        self.ReloadToken=self.ReloadToken+1
        self.SpectateToken=self.SpectateToken+1
        self.FullAutoHeld=false
        self.Reloading=false

        local ownHumanoid=GetHumanoid()
        if Camera and ownHumanoid then Camera.CameraSubject=ownHumanoid end

        AdapterNotify("Panic", "Gameplay toggles disabled; interface settings were preserved.", "warning")
        return
    end

    if name == GetState("bind.fly", "V") or name == GetState("player.flyKey", "V") then
        if Controls["player.fly"] and Controls["player.fly"].Set then
            Controls["player.fly"].Set(not GetState("player.fly", false), false)
        end
    end

    if name == GetState("bind.noclip", "N") or name == GetState("player.noclipKey", "N") then
        if Controls["player.noclip"] and Controls["player.noclip"].Set then
            Controls["player.noclip"].Set(not GetState("player.noclip", false), false)
        end
    end

    if name == GetState("bind.teleport", "T") or name == GetState("player.clickTpKey", "T") then
        local target = self:GetBestTarget("aim")
        local part = target and target:FindFirstChild("HumanoidRootPart")

        if part then
            self:TeleportTo(part)
        end
    end

    if name == "Backspace" then
        self:DropLocalWorldItem()
    end

    if name == "MouseButton1" then
        self.FullAutoHeld = true
    end
end

function Runtime:OnInputEnded(input)
    local name = GetInputName(input)
    self.InputDown[name] = false

    if name == "MouseButton1" then
        self.FullAutoHeld = false
    end
end


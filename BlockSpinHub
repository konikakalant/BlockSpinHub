local function AddSlider(page,section,d)
    if State[d.Flag]==nil then State[d.Flag]=d.Default end
    local initial=tonumber(State[d.Flag]) or d.Default
    local r,l=AddRow(page,section,d.Flag,d.Name,d.Description,44)
    l.Size=UDim2.new(1,-96,1,0)
    local vl=Label(r,tostring(initial)..(d.Suffix or ""),8,Theme.SubText,Enum.Font.GothamMedium); vl.Position=UDim2.new(1,-83,0,0); vl.Size=UDim2.fromOffset(72,20); vl.TextXAlignment=Enum.TextXAlignment.Right; vl.ZIndex=9
    local tr=Create("Frame",{Size=UDim2.new(1,-18,0,3),Position=UDim2.fromOffset(9,31),BackgroundColor3=Theme.Input,BorderSizePixel=0,ZIndex=9},r); Corner(tr,3)
    local pct=math.clamp((initial-d.Min)/(d.Max-d.Min),0,1)
    local f=Create("Frame",{Size=UDim2.new(pct,0,1,0),BackgroundColor3=Theme.Accent,BorderSizePixel=0,ZIndex=10},tr); Corner(f,3)
    local k=Create("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.new(1,0,0.5,0),Size=UDim2.fromOffset(8,8),BackgroundColor3=Theme.White,BorderSizePixel=0,ZIndex=11},f); Corner(k,8)
    local bubble=Create("CanvasGroup",{Size=UDim2.fromOffset(50,20),Position=UDim2.new(pct,-25,0,7),BackgroundColor3=Theme.Popup,BorderSizePixel=0,GroupTransparency=1,Visible=false,ZIndex=20},tr); Corner(bubble,4); local bubbleStroke=Stroke(bubble,Theme.Border)
    local bt=Label(bubble,tostring(initial),8,Theme.Text,Enum.Font.GothamBold); bt.Size=UDim2.fromScale(1,1); bt.TextXAlignment=Enum.TextXAlignment.Center; bt.ZIndex=21

    local function fmt(v)
        if d.Step and d.Step<1 then
            local decimals=d.Step<0.01 and 3 or (d.Step<0.1 and 2 or 1)
            return string.format("%."..tostring(decimals).."f",v)..(d.Suffix or "")
        end
        return tostring(v)..(d.Suffix or "")
    end

    local function set(v,silent)
        v=math.clamp(tonumber(v) or d.Default,d.Min,d.Max)
        local step=math.max(tonumber(d.Step) or 1,0.000001)
        v=math.floor((v/step)+0.5)*step
        if step<1 then v=math.floor(v*1000+0.5)/1000 else v=math.floor(v+0.5) end
        v=math.clamp(v,d.Min,d.Max)
        State[d.Flag]=v
        local p=(v-d.Min)/(d.Max-d.Min)
        f.Size=UDim2.new(p,0,1,0)
        bubble.Position=UDim2.new(p,-25,0,7)
        vl.Text=fmt(v)
        bt.Text=fmt(v)
        if not silent then GameplayAdapter:SetValue(d.Flag,v) end
    end

    local function fromx(x)
        local p=math.clamp((x-tr.AbsolutePosition.X)/math.max(tr.AbsoluteSize.X,1),0,1)
        set(d.Min+(d.Max-d.Min)*p)
    end

    tr.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            if ActiveSliderDrag and ActiveSliderDrag.Finish then ActiveSliderDrag.Finish() end
            bubble.Visible=true
            Tween(bubble,{GroupTransparency=0},0.07)
            Tween(k,{Size=UDim2.fromOffset(11,11)},0.08,Enum.EasingStyle.Back)
            ActiveSliderDrag={
                Flag=d.Flag,
                FromX=fromx,
                Bubble=bubble,
                Knob=k,
                Finish=function()
                    Tween(bubble,{GroupTransparency=1},0.07)
                    Tween(k,{Size=UDim2.fromOffset(8,8)},0.08)
                    task.delay(0.08,function()
                        if not ActiveSliderDrag or ActiveSliderDrag.Flag~=d.Flag then
                            if bubble and bubble.Parent then bubble.Visible=false end
                        end
                    end)
                end,
            }
            fromx(i.Position.X)
        end
    end)

    Controls[d.Flag]={Type="slider",Set=set,Get=function() return State[d.Flag] end,Root=r}
    BindTheme(function()
        vl.TextColor3=Theme.SubText
        tr.BackgroundColor3=Theme.Input
        bubble.BackgroundColor3=Theme.Popup
        bubbleStroke.Color=Theme.Border
        bt.TextColor3=Theme.Text
    end)
    BindAccent(function(a) f.BackgroundColor3=a end)
end


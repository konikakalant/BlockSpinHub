end

local function GetBoundJobMarker(jobName)
    local root=Workspace:FindFirstChild("BlockSpinHubBindings")
    local jobs=root and root:FindFirstChild("Jobs")
    local object=jobs and jobs:FindFirstChild(jobName)
    if not object then return nil end
    if object:IsA("BasePart") then return object end
    if object:IsA("Model") then
        return object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart",true)
    end
    return nil
end

function Runtime:GetJobTargetPosition(jobName,stepDefinition)
    local marker
    if IS_STUDIO then
        marker=LocalWorld:GetJobMarker(jobName)
    else
        -- Outside Studio, never send the player toward the hidden local test world.
        -- A game you own can expose explicit job markers under
        -- Workspace.BlockSpinHubBindings.Jobs/<JobName>.
        marker=GetBoundJobMarker(jobName)
    end
    if not marker then return nil end
    return marker.Position+(stepDefinition.Offset or Vector3.zero)+Vector3.new(0,2.8,0)
end

function Runtime:CompleteJobStep(jobName, step)
    local state=self.JobSession.WorkState or {}
    self.JobSession.WorkState=state
    local label=step and step.Label or ""

    if jobName=="Cook" then
        if label=="Clock in" then state.Order=true
        elseif label=="Collect ingredients" then state.Ingredients=true
        elseif label=="Cook order" then
            if not state.Ingredients then return false,"Need ingredients" end
            state.Ingredients=nil; state.Cooked=true
        elseif label=="Plate order" then
            if not state.Cooked then return false,"Nothing cooked" end
            state.Cooked=nil; state.Plated=true
        elseif label=="Serve order" then
            if not state.Plated then return false,"Nothing plated" end
            state.Plated=nil; state.Order=nil
        end
    elseif jobName=="Burger" then
        if label=="Collect bun" then state.Bun=true
        elseif label=="Grill patty" then state.Patty=true
        elseif label=="Build burger" then
            if not state.Bun or not state.Patty then return false,"Missing burger ingredients" end
            state.Bun=nil; state.Patty=nil; state.Meal=true
        elseif label=="Hand off order" then
            if not state.Meal then return false,"Burger not built" end
            state.Meal=nil
        end
    elseif jobName=="Janitor" then
        if label=="Collect mop" then state.Mop=true
        elseif label=="Clean spill" and not state.Mop then return false,"Need mop"
        elseif label=="Return supplies" then state.Mop=nil end
    elseif jobName=="Butcher" then
        if label=="Collect stock" then state.Stock=true
        elseif label=="Prepare cut" then
            if not state.Stock then return false,"Need stock" end
            state.Stock=nil; state.Cut=true
        elseif label=="Package order" then
            if not state.Cut then return false,"Nothing prepared" end
            state.Cut=nil
        end
    elseif jobName=="Shelf Stocker" then
        if label=="Collect box" then state.Box=true
        elseif label=="Stock shelf" then
            if not state.Box then return false,"Need stock box" end
            state.Box=nil; state.Stocked=true
        elseif label=="Return box" then state.Stocked=nil end
    elseif jobName=="Steak House" then
        if label=="Prep steak" then state.RawSteak=true
        elseif label=="Cook steak" then
            if not state.RawSteak then return false,"Steak not prepared" end
            state.RawSteak=nil; state.CookedSteak=true
        elseif label=="Plate meal" then
            if not state.CookedSteak then return false,"Steak not cooked" end
            state.CookedSteak=nil; state.PlatedSteak=true
        elseif label=="Serve table" then
            if not state.PlatedSteak then return false,"Meal not plated" end
            state.PlatedSteak=nil
        end
    elseif jobName=="Farming" then
        if label=="Collect seeds" then state.Seeds=true
        elseif label=="Work field" and not state.Seeds then return false,"Need seeds"
        elseif label=="Harvest crop" then state.Harvest=true
        elseif label=="Store harvest" then
            if not state.Harvest then return false,"Nothing harvested" end
            state.Harvest=nil; state.Seeds=nil
        end
    elseif jobName=="Fishing" then
        if label=="Prepare bait" and LocalWorld.Data.Bait<=0 then
            return false,"No bait"
        end
    end

    return true
end

function Runtime:CompleteJobCycle(jobName)
    local blueprint=JobBlueprints[jobName]
    if not blueprint then return end

    local payout=blueprint.Reward or JobRates[jobName] or 100
    if jobName=="Janitor" then
        local mop=GetState("jobs.mopType","Default")
        local multi=mop=="Diamond" and 1.5 or mop=="Gold" and 1.3 or mop=="Silver" and 1.15 or 1
        payout=payout*multi
    elseif jobName=="Fishing" then
        if LocalWorld.Data.Bait<=0 then
            if GetState("fish.autoBait",true) and LocalWorld.Data.Cash>=25 then
                local requested=GetState("fish.baitsToBuy",5)
                local amount=math.min(requested,math.floor(LocalWorld.Data.Cash/25))
                LocalWorld.Data.Cash=LocalWorld.Data.Cash-amount*25
                LocalWorld.Data.Bait=LocalWorld.Data.Bait+amount
            end
        end
        if LocalWorld.Data.Bait>0 then
            LocalWorld.Data.Bait=LocalWorld.Data.Bait-1
            local spot=GetState("fish.spot","Automatic")
            local catchAmount=spot=="Safe" and 1 or math.random(1,2)
            LocalWorld.Data.Fish=LocalWorld.Data.Fish+catchAmount
            LocalWorld.Data.JobXP=LocalWorld.Data.JobXP+catchAmount*2
        end
        if GetState("fish.autoSell",true) and LocalWorld.Data.Fish>=GetState("fish.sellAt",15) then
            LocalWorld.Data.Cash=LocalWorld.Data.Cash+LocalWorld.Data.Fish*85
            LocalWorld.Data.Fish=0
        end
        if GetState("fish.autoBait",true) and LocalWorld.Data.Bait<=GetState("fish.buyBaitAt",3) and LocalWorld.Data.Cash>=25 then
            local requested=GetState("fish.baitsToBuy",5)
            local amount=math.min(requested,math.floor(LocalWorld.Data.Cash/25))
            LocalWorld.Data.Cash=LocalWorld.Data.Cash-amount*25
            LocalWorld.Data.Bait=LocalWorld.Data.Bait+amount
        end
        payout=0
    end

    LocalWorld.Data.Cash=LocalWorld.Data.Cash+payout
    LocalWorld.Data.JobXP=LocalWorld.Data.JobXP+1
    self.JobSession.Cycles=self.JobSession.Cycles+1
    UpdateRuntimeDataValues()
end

function Runtime:ChooseActiveJob()
    local active=self:GetActiveJobNames()
    if #active==0 then return nil end

    local preferred=GetState("jobs.preferred",active[1])
    for _,name in ipairs(active) do
        if name==preferred then return name end
    end
    table.sort(active)
    return active[1]
end

function Runtime:RunJobDeposit(now)
    local threshold=GetState("jobs.depositAt",2500)
    local keep=math.min(GetState("jobs.keepCash",750),threshold)
    if not self.JobSession.Depositing and LocalWorld.Data.Cash<threshold then
        return false
    end

    if not self.JobSession.Depositing then
        self.JobSession.Depositing=true
        self.JobSession.DepositStarted=now
        self.JobSession.DepositDeadline=0
        self.JobSession.DepositFailures=0
    elseif self.JobSession.DepositStarted==0 then
        self.JobSession.DepositStarted=now
    end

    local service=LocalWorld.Bank
    if not service or not service.Parent then
        local atm=LocalWorld:GetNearestATM()
        service=atm and atm:FindFirstChild("Body")
    end
    if not service then
        self.JobSession.DepositFailures=(self.JobSession.DepositFailures or 0)+1
        if self.JobSession.DepositFailures>=3 then
            self.JobSession.Depositing=false
            self.JobSession.DepositStarted=0
            self.JobSession.DepositDeadline=0
            self.JobSession.DepositFailures=0
            if self.Navigation.Owner=="JobDeposit" then self:ResetNavigation("JobDeposit") end
            AdapterNotify("Job deposit","Deposit point unavailable; job loop resumed.","warning")
        else
            self:UpdateJobHUD(self.JobSession.Name or "JOB","Waiting for deposit point","WAITING",0)
        end
        return true
    end

    local target=service.Position+service.CFrame.LookVector*5+Vector3.new(0,2.5,0)
    local root=GetRoot()
    local distance=root and GetDistance(root.Position,target) or 0
    local humanoid=GetHumanoid()
    local expectedSpeed=math.max(10,humanoid and humanoid.WalkSpeed or 16)
    local travelTimeout=math.clamp(12+(distance/expectedSpeed)*4,18,75)
    if (self.JobSession.DepositDeadline or 0)<=0 then
        self.JobSession.DepositDeadline=now+travelTimeout
    end

    if now>self.JobSession.DepositDeadline then
        self.JobSession.DepositFailures=(self.JobSession.DepositFailures or 0)+1
        self.JobSession.DepositStarted=now
        self.JobSession.DepositDeadline=now+travelTimeout
        if self.Navigation.Owner=="JobDeposit" then self:ResetNavigation("JobDeposit") end
        if self.JobSession.DepositFailures>=3 then
            self.JobSession.Depositing=false
            self.JobSession.DepositStarted=0
            self.JobSession.DepositDeadline=0
            self.JobSession.DepositFailures=0
            AdapterNotify("Job deposit","Deposit route failed repeatedly; job loop resumed instead of hanging.","warning")
        else
            self:UpdateJobHUD(self.JobSession.Name or "JOB","Replanning deposit route","RECOVERING",0)
        end
        return true
    end

    local arrived,state=self:StepNavigation("JobDeposit",target,"Deposit cash")
    root=GetRoot()
    distance=root and GetDistance(root.Position,target) or 0
    self:UpdateJobHUD(self.JobSession.Name or "JOB","Deposit cash",state,math.clamp(1-distance/80,0,1))

    if arrived then
        local deposit=math.max(0,LocalWorld.Data.Cash-keep)
        LocalWorld.Data.Cash=LocalWorld.Data.Cash-deposit
        LocalWorld.Data.Bank=LocalWorld.Data.Bank+deposit
        self.JobSession.Depositing=false
        self.JobSession.DepositStarted=0
        self.JobSession.DepositDeadline=0
        self.JobSession.DepositFailures=0
        UpdateRuntimeDataValues()
        AdapterNotify("Job deposit","$"..tostring(math.floor(deposit)).." moved to runtime bank.","success")
    end
    return true
end

function Runtime:RunJobs(now)
    local stopWhenKnocked=GetState("jobs.stopKnocked",true) or GetState("player.stopKnocked",true)
    if stopWhenKnocked and self:IsKnocked() then
        if self.Navigation.Owner=="Job" or self.Navigation.Owner=="JobDeposit" then self:ResetNavigation() end
        self:UpdateJobHUD(self.JobSession.Name,"Paused while knocked","PAUSED",0)
        return
    end

    -- ATM automation owns movement while enabled so two systems never fight over the humanoid.
    if GetState("atm.enabled",false) then
        if self.Navigation.Owner=="Job" or self.Navigation.Owner=="JobDeposit" then self:ResetNavigation() end
        self:UpdateJobHUD(self.JobSession.Name,"Paused for ATM route","PAUSED",0)
        return
    end

    if not IS_STUDIO then
        local bindings=Workspace:FindFirstChild("BlockSpinHubBindings")
        local jobsFolder=bindings and bindings:FindFirstChild("Jobs")
        if not jobsFolder then
            if not self.MissingJobBindingWarned then
                self.MissingJobBindingWarned=true
                AdapterNotify("Job automation paused","No authorized job bindings were found. The hub will not walk toward hidden test markers in a live experience.","warning")
            end
            if self.Navigation.Owner=="Job" or self.Navigation.Owner=="JobDeposit" then self:ResetNavigation() end
            self:UpdateJobHUD(self.JobSession.Name,"Waiting for game job bindings","WAITING",0)
            return
        end
    else
        self.MissingJobBindingWarned=false
    end

    local jobName=self:ChooseActiveJob()
    if not jobName then
        if self.JobSession.Name then self:ResetJobSession("No active job") end
        return
    end

    if self.JobSession.Name~=jobName then
        if self.Navigation.Owner=="Job" then self:ResetNavigation("Job") end
        self.JobSession.Name=jobName
        self.JobSession.Step=1
        self.JobSession.Phase="Travel"
        self.JobSession.WorkStarted=0
        self.JobSession.PhaseStarted=now
        self.JobSession.Depositing=false
        self.JobSession.LastTask="Starting"
        self.JobSession.Failures=0
        self.JobSession.WorkState={}
    end

    if GetState("jobs.autoDeposit",false) and (self.JobSession.Depositing or LocalWorld.Data.Cash>=GetState("jobs.depositAt",2500)) then
        if self:RunJobDeposit(now) then return end
    end

    local blueprint=JobBlueprints[jobName]
    if not blueprint or not blueprint.Steps or #blueprint.Steps==0 then
        self:UpdateJobHUD(jobName,"Missing job blueprint","ERROR",0)
        return
    end

    local step=blueprint.Steps[self.JobSession.Step]
    if not step then
        self.JobSession.Step=1
        self.JobSession.Phase="Travel"
        step=blueprint.Steps[1]
    end

    local target=self:GetJobTargetPosition(jobName,step)
    if not target then
        if self.JobSession.PhaseStarted==0 then self.JobSession.PhaseStarted=now end
        if now-self.JobSession.PhaseStarted>10 then
            self.JobSession.Failures=(self.JobSession.Failures or 0)+1
            self.JobSession.PhaseStarted=now
            if self.JobSession.Failures>=3 then
                self.JobSession.Failures=0
                self.JobSession.Step=(self.JobSession.Step%#blueprint.Steps)+1
            end
            self:UpdateJobHUD(jobName,"Recovering missing station","RECOVERING",0)
        else
            self:UpdateJobHUD(jobName,"Waiting for job station","WAITING",0)
        end
        return
    end

    if self.JobSession.Phase=="Travel" then
        if self.JobSession.PhaseStarted==0 then self.JobSession.PhaseStarted=now end
        local travelTimeout=math.max(8,GetState("jobs.stuckTimeout",3)*4)
        if now-self.JobSession.PhaseStarted>travelTimeout then
            self.JobSession.Failures=(self.JobSession.Failures or 0)+1
            self.JobSession.PhaseStarted=now
            if self.Navigation.Owner=="Job" then self:ResetNavigation("Job") end
            self:UpdateJobHUD(jobName,step.Label,"RECOVERING",0)
            if self.JobSession.Failures>=3 then
                self.JobSession.Failures=0
                self.JobSession.Step=(self.JobSession.Step%#blueprint.Steps)+1
            end
            return
        end
        local arrived,state=self:StepNavigation("Job",target,step.Label)
        local root=GetRoot()
        local distance=root and GetDistance(root.Position,target) or 0
        self.JobSession.LastTask=step.Label
        self:UpdateJobHUD(jobName,step.Label,state,math.clamp(1-distance/70,0,0.98))
        if not arrived then return end
        self.JobSession.Phase="Work"
        self.JobSession.WorkStarted=now
        self.JobSession.PhaseStarted=now
        self.JobSession.Failures=0
    end

    if self.JobSession.Phase=="Work" then
        local duration=step.Work or 0.6
        if jobName=="Janitor" and step.Label=="Clean spill" then
            duration=math.max(0.1,GetState("jobs.mopDelay",0.3))+0.65
        end
        local elapsed=now-self.JobSession.WorkStarted
        self:UpdateJobHUD(jobName,step.Label,"WORKING",math.clamp(elapsed/duration,0,1))
        if elapsed<duration then return end

        local stepOk,stepMessage=self:CompleteJobStep(jobName,step)
        if not stepOk then
            self.JobSession.Failures=(self.JobSession.Failures or 0)+1
            self.JobSession.Phase="Travel"
            self.JobSession.WorkStarted=0
            self.JobSession.PhaseStarted=now
            self:UpdateJobHUD(jobName,stepMessage or step.Label,"RECOVERING",0)
            return
        end

        self.JobSession.Step=self.JobSession.Step+1
        self.JobSession.Phase="Travel"
        self.JobSession.WorkStarted=0
        if self.JobSession.Step>#blueprint.Steps then
            self:CompleteJobCycle(jobName)
            self.JobSession.Step=1
            self.JobSession.WorkState={}

            if GetState("jobs.autoSwitch",false) and self.JobSession.Cycles%math.max(1,GetState("jobs.switchCycles",5))==0 then
                local candidates
                if GetState("jobs.loader",false) then
                    candidates={"Janitor","Cook","Burger","Butcher","Shelf Stocker","Steak House","Fishing","Farming"}
                else
                    candidates=self:GetActiveJobNames()
                    table.sort(candidates)
                end
                if #candidates>1 then
                    local current=table.find(candidates,jobName) or 1
                    local nextIndex=current%#candidates+1
                    self.CurrentJobIndex=nextIndex
                    SetControl("jobs.preferred",candidates[nextIndex],true)
                    self.JobSession.Name=nil
                end
            end
        end
    end
end

function Runtime:RunRewards(now)

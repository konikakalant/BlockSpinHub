function Runtime:GetJobTargetPosition(jobName,stepDefinition)
	local marker=Prototype:GetJobMarker(jobName)
	if not marker then return nil end
	return marker.Position+(stepDefinition.Offset or Vector3.zero)+Vector3.new(0,2.8,0)
end

function Runtime:CompleteJobCycle(jobName)
	local blueprint=JobBlueprints[jobName]
	if not blueprint then return end

	local payout=blueprint.Reward or JobRates[jobName] or 100
	if jobName=="Janitor" then
		local mop=GetState("jobs.mopType","Default")
		local multi=mop=="Diamond" and 1.5 or mop=="Gold" and 1.3 or mop=="Silver" and 1.15 or 1
		payout=payout*multi
	elseif jobName=="Fishing" then
		if Prototype.Data.Bait<=0 then
			if GetState("fish.autoBait",true) and Prototype.Data.Cash>=25 then
				local requested=GetState("fish.baitsToBuy",5)
				local amount=math.min(requested,math.floor(Prototype.Data.Cash/25))
				Prototype.Data.Cash=Prototype.Data.Cash-amount*25
				Prototype.Data.Bait=Prototype.Data.Bait+amount
			end
		end
		if Prototype.Data.Bait>0 then
			Prototype.Data.Bait=Prototype.Data.Bait-1
			local spot=GetState("fish.spot","Automatic")
			local catchAmount=spot=="Safe" and 1 or math.random(1,2)
			Prototype.Data.Fish=Prototype.Data.Fish+catchAmount
			Prototype.Data.JobXP=Prototype.Data.JobXP+catchAmount*2
		end
		if GetState("fish.autoSell",true) and Prototype.Data.Fish>=GetState("fish.sellAt",15) then
			Prototype.Data.Cash=Prototype.Data.Cash+Prototype.Data.Fish*85
			Prototype.Data.Fish=0
		end
		if GetState("fish.autoBait",true) and Prototype.Data.Bait<=GetState("fish.buyBaitAt",3) and Prototype.Data.Cash>=25 then
			local requested=GetState("fish.baitsToBuy",5)
			local amount=math.min(requested,math.floor(Prototype.Data.Cash/25))
			Prototype.Data.Cash=Prototype.Data.Cash-amount*25
			Prototype.Data.Bait=Prototype.Data.Bait+amount
		end
		payout=0
	end

	Prototype.Data.Cash=Prototype.Data.Cash+payout
	Prototype.Data.JobXP=Prototype.Data.JobXP+1
	self.JobSession.Cycles=self.JobSession.Cycles+1
	UpdatePrototypeDataValues()
end

function Runtime:ChooseActiveJob()
	local active=self:GetActiveJobNames()
	if #active==0 then return nil end

	local preferred=GetState("jobs.preferred",active[1])
	for _,name in ipairs(active) do
		if name==preferred then return name end
	end
	table.sort(active)
	return active[1]
end

function Runtime:RunJobDeposit(now)
	local threshold=GetState("jobs.depositAt",2500)
	local keep=math.min(GetState("jobs.keepCash",750),threshold)
	if not self.JobSession.Depositing and Prototype.Data.Cash<threshold then
		return false
	end

	self.JobSession.Depositing=true
	local service=Prototype.Bank
	if not service or not service.Parent then
		local atm=Prototype:GetNearestATM()
		service=atm and atm:FindFirstChild("Body")
	end
	if not service then
		self.JobSession.Depositing=false
		return false
	end

	local target=service.Position+service.CFrame.LookVector*5+Vector3.new(0,2.5,0)
	local arrived,state=self:StepNavigation("JobDeposit",target,"Deposit cash")
	local root=GetRoot()
	local distance=root and GetDistance(root.Position,target) or 0
	self:UpdateJobHUD(self.JobSession.Name or "JOB","Deposit cash",state,math.clamp(1-distance/80,0,1))

	if arrived then
		local deposit=math.max(0,Prototype.Data.Cash-keep)
		Prototype.Data.Cash=Prototype.Data.Cash-deposit
		Prototype.Data.Bank=Prototype.Data.Bank+deposit
		self.JobSession.Depositing=false
		UpdatePrototypeDataValues()
		AdapterNotify("Job deposit","$"..tostring(math.floor(deposit)).." moved to prototype bank.","success")
	end
	return true
end

function Runtime:RunJobs(now)
	local stopWhenKnocked=GetState("jobs.stopKnocked",true) or GetState("player.stopKnocked",true)
	if stopWhenKnocked and self:IsKnocked() then
		if self.Navigation.Owner=="Job" or self.Navigation.Owner=="JobDeposit" then self:ResetNavigation() end
		self:UpdateJobHUD(self.JobSession.Name,"Paused while knocked","PAUSED",0)
		return
	end

	-- ATM automation owns movement while enabled so two systems never fight over the humanoid.
	if GetState("atm.enabled",false) then
		if self.Navigation.Owner=="Job" or self.Navigation.Owner=="JobDeposit" then self:ResetNavigation() end
		self:UpdateJobHUD(self.JobSession.Name,"Paused for ATM route","PAUSED",0)
		return
	end

	local jobName=self:ChooseActiveJob()
	if not jobName then
		if self.JobSession.Name then self:ResetJobSession("No active job") end
		return
	end

	if self.JobSession.Name~=jobName then
		if self.Navigation.Owner=="Job" then self:ResetNavigation("Job") end
		self.JobSession.Name=jobName
		self.JobSession.Step=1
		self.JobSession.Phase="Travel"
		self.JobSession.WorkStarted=0
		self.JobSession.PhaseStarted=now
		self.JobSession.Depositing=false
		self.JobSession.LastTask="Starting"
		self.JobSession.PhaseStarted=now
		self.JobSession.Failures=0
	end

	if GetState("jobs.autoDeposit",false) and (self.JobSession.Depositing or Prototype.Data.Cash>=GetState("jobs.depositAt",2500)) then
		if self:RunJobDeposit(now) then return end
	end

	local blueprint=JobBlueprints[jobName]
	if not blueprint or not blueprint.Steps or #blueprint.Steps==0 then
		self:UpdateJobHUD(jobName,"Missing job blueprint","ERROR",0)
		return
	end

	local step=blueprint.Steps[self.JobSession.Step]
	if not step then
		self.JobSession.Step=1
		self.JobSession.Phase="Travel"
		step=blueprint.Steps[1]
	end

	local target=self:GetJobTargetPosition(jobName,step)
	if not target then
		if self.JobSession.PhaseStarted==0 then self.JobSession.PhaseStarted=now end
		if now-self.JobSession.PhaseStarted>10 then
			self.JobSession.Failures=(self.JobSession.Failures or 0)+1
			self.JobSession.PhaseStarted=now
			if self.JobSession.Failures>=3 then
				self.JobSession.Failures=0
				self.JobSession.Step=(self.JobSession.Step%#blueprint.Steps)+1
			end
			self:UpdateJobHUD(jobName,"Recovering missing station","RECOVERING",0)
		else
			self:UpdateJobHUD(jobName,"Waiting for job station","WAITING",0)
		end
		return
	end

	if self.JobSession.Phase=="Travel" then
		if self.JobSession.PhaseStarted==0 then self.JobSession.PhaseStarted=now end
		local travelTimeout=math.max(8,GetState("jobs.stuckTimeout",3)*4)
		if now-self.JobSession.PhaseStarted>travelTimeout then
			self.JobSession.Failures=(self.JobSession.Failures or 0)+1
			self.JobSession.PhaseStarted=now
			if self.Navigation.Owner=="Job" then self:ResetNavigation("Job") end
			self:UpdateJobHUD(jobName,step.Label,"RECOVERING",0)
			if self.JobSession.Failures>=3 then
				self.JobSession.Failures=0
				self.JobSession.Step=(self.JobSession.Step%#blueprint.Steps)+1
			end
			return
		end
		local arrived,state=self:StepNavigation("Job",target,step.Label)
		local root=GetRoot()
		local distance=root and GetDistance(root.Position,target) or 0
		self.JobSession.LastTask=step.Label
		self:UpdateJobHUD(jobName,step.Label,state,math.clamp(1-distance/70,0,0.98))
		if not arrived then return end
		self.JobSession.Phase="Work"
		self.JobSession.WorkStarted=now
		self.JobSession.PhaseStarted=now
		self.JobSession.Failures=0
	end

	if self.JobSession.Phase=="Work" then
		local duration=step.Work or 0.6
		if jobName=="Janitor" and step.Label=="Clean spill" then
			duration=math.max(0.1,GetState("jobs.mopDelay",0.3))+0.65
		end
		local elapsed=now-self.JobSession.WorkStarted
		self:UpdateJobHUD(jobName,step.Label,"WORKING",math.clamp(elapsed/duration,0,1))
		if elapsed<duration then return end

		self.JobSession.Step=self.JobSession.Step+1
		self.JobSession.Phase="Travel"
		self.JobSession.WorkStarted=0
		if self.JobSession.Step>#blueprint.Steps then
			self:CompleteJobCycle(jobName)
			self.JobSession.Step=1

			if GetState("jobs.autoSwitch",false) and self.JobSession.Cycles%math.max(1,GetState("jobs.switchCycles",5))==0 then
				local candidates
				if GetState("jobs.loader",false) then
					candidates={"Janitor","Cook","Burger","Butcher","Shelf Stocker","Steak House","Fishing","Farming"}
				else
					candidates=self:GetActiveJobNames()
					table.sort(candidates)
				end
				if #candidates>1 then
					local current=table.find(candidates,jobName) or 1
					local nextIndex=current%#candidates+1
					self.CurrentJobIndex=nextIndex
					SetControl("jobs.preferred",candidates[nextIndex],true)
					self.JobSession.Name=nil
				end
			end
		end
	end
end

function Runtime:RunRewards(now)
	local interval = GetState("rewards.interval", 10)

	if GetState("misc.skipSpin", false) then
		interval = math.max(1, interval * 0.5)
	end

	if now - self.LastRewardTick < interval then
		return
	end

	self.LastRewardTick = now

	if GetState("rewards.claim", false) then
		Prototype.Data.Rewards = Prototype.Data.Rewards + 1
		Prototype.Data.Bank = Prototype.Data.Bank + 250
	end

	if GetState("rewards.quests", false) then
		Prototype.Data.Quests = Prototype.Data.Quests + 1
		Prototype.Data.Bank = Prototype.Data.Bank + 400
	end

	if GetState("rewards.minigames", false) then
		Prototype.Data.Bank = Prototype.Data.Bank + 150
		AddInventoryItem("Minigame Token", "Misc", 1)
	end

	UpdatePrototypeDataValues()
end

function Runtime:GetATMScore(atm)
	local body = atm:FindFirstChild("Body")
	local root = GetRoot()

	if not body or not root then
		return math.huge
	end

	local route = GetState("atm.route", "Nearest")

	if route == "Highest Value" then
		return -(atm:GetAttribute("CashValue") or 0)
	elseif route == "Safest" then
		local risk=atm:GetAttribute("Risk") or 3
		return GetDistance(root.Position, body.Position) + risk * 18
	end

	return GetDistance(root.Position, body.Position)
end

function Runtime:FindAvailableATM()
	if not Prototype.ATMs then
		return nil
	end

	local best = nil
	local bestScore = math.huge
	local now = os.clock()

	for _, atm in ipairs(Prototype.ATMs:GetChildren()) do
		local cooldown = atm:GetAttribute("CooldownUntil") or 0

		if cooldown <= now then
			atm:SetAttribute("Available", true)
		end

		local available = atm:GetAttribute("Available") == true
		local blacklistedUntil=self.ATMSession and self.ATMSession.Blacklist and self.ATMSession.Blacklist[atm] or 0
		local blacklisted=blacklistedUntil>now
		if blacklistedUntil>0 and not blacklisted then
			self.ATMSession.Blacklist[atm]=nil
		end

		if not blacklisted and (available or not GetState("atm.skipUnavailable", true)) then
			local score = self:GetATMScore(atm)

			if score < bestScore then
				bestScore = score
				best = atm
			end
		end
	end

	return best
end

function Runtime:UpdateATMHUD(phase, task, detail)
	local hud=RuntimeUI.ATMHUD
	if not hud then return end

	local visible=GetState("atm.enabled",false) and GetState("atm.statusHud",true)
	hud.Visible=visible
	if not visible then return end

	if RuntimeUI.ATMHUDTitle then
		RuntimeUI.ATMHUDTitle.Text=string.format("ATM FARM  •  %s",string.upper(phase or "IDLE"))
	end
	if RuntimeUI.ATMHUDTask then
		RuntimeUI.ATMHUDTask.Text=task or "Waiting"
	end
	if RuntimeUI.ATMHUDProgress then
		RuntimeUI.ATMHUDProgress.Text=detail or ""
	end
end

function Runtime:ResetATMSession(reason)
	local s=self.ATMSession
	s.Phase="Idle"
	s.Target=nil
	s.TargetKind=nil
	s.VehicleOwned=false
	s.VehicleWaypoints={}
	s.VehicleWaypointIndex=1
	s.VehicleGoal=nil
	s.LastPlanAt=0
	s.LastProgressAt=0
	s.LastDistance=math.huge
	s.RecoveryAttempts=0
	s.Status=reason or "Idle"
	s.PhaseStarted=0
	s.ConsecutiveFailures=0
	s.LastFailure=nil
	s.Blacklist={}
	s.WatchdogTrips=0
	s.ServiceRetryAt=0
	s.SeatBlockedSince=0
	self.CurrentATM=nil
	self.LastATMAction=0

	if self.Navigation.Owner=="ATM" then
		self:ResetNavigation("ATM")
	end

	if Prototype.Car and Prototype.Car.Parent then
		Prototype.Car:SetAttribute("Locked",false)
	end

	self:UpdateATMHUD("IDLE",reason or "Ready","")
end

function Runtime:SetATMPhase(phase,target,targetKind,now)
	local s=self.ATMSession
	s.Phase=phase or "Select"
	if target~=nil then s.Target=target end
	if targetKind~=nil then s.TargetKind=targetKind end
	s.PhaseStarted=now or os.clock()
end

function Runtime:CheckATMWatchdog(now)
	local s=self.ATMSession
	if not s or s.Phase=="Idle" or s.Phase=="Select" then
		if s and s.PhaseStarted==0 then s.PhaseStarted=now end
		return false
	end

	if s.PhaseStarted==0 then
		s.PhaseStarted=now
		return false
	end

	if s.Phase=="Hack" and not GetState("atm.autoHack",false) then
		s.PhaseStarted=now
		return false
	end

	local limits={TravelService=28,TravelATM=32,Hack=10}
	local limit=limits[s.Phase]
	if not limit or now-s.PhaseStarted<=limit then return false end

	s.WatchdogTrips=(s.WatchdogTrips or 0)+1
	s.ConsecutiveFailures=(s.ConsecutiveFailures or 0)+1
	s.LastFailure=tostring(s.Phase).." timeout"

	if s.TargetKind=="ATM" and s.Target then
		s.Blacklist[s.Target]=now+math.min(60,10+(s.ConsecutiveFailures*5))
	end

	s.VehicleWaypoints={}
	s.VehicleWaypointIndex=1
	s.VehicleGoal=nil
	s.VehicleOwned=false
	if self.Navigation.Owner=="ATM" then self:ResetNavigation("ATM") end

	self.CurrentATM=nil
	s.Target=nil
	s.TargetKind=nil
	self:SetATMPhase("Select",nil,nil,now)
	self:UpdateATMHUD("RECOVER","Watchdog recovery",s.LastFailure)
	return true
end

function Runtime:GetFarmTargetPosition(part, movement)
	if not part then return nil end

	if movement=="Vehicle" then
		local approach=math.max(6,GetState("atm.vehicleApproach",10))
		local look=part.CFrame.LookVector
		return part.Position+(look*approach)+Vector3.new(0,-1.3,0)
	end

	return part.Position+(part.CFrame.LookVector*5)+Vector3.new(0,2.5,0)
end

function Runtime:IsFarmVehicleReady()
	local car=Prototype.Car
	local seat=Prototype.CarSeat
	local body=Prototype.CarBody

	return car~=nil
		and car.Parent~=nil
		and car.PrimaryPart~=nil
		and body~=nil
		and body.Parent~=nil
		and seat~=nil
		and seat.Parent~=nil
		and (car:GetAttribute("Health") or 0)>0
end

function Runtime:EnsureFarmVehicle(now)
	local root=GetRoot()
	local humanoid=GetHumanoid()
	local s=self.ATMSession
	if not root or not humanoid then return false,"Waiting for character" end

	if not self:IsFarmVehicleReady() then
		if not GetState("atm.autoVehicle",true) then
			return false,"No valid farm vehicle"
		end

		if Prototype.Car and Prototype.Car.Parent then
			pcall(function() Prototype.Car:Destroy() end)
		end
		Prototype.Car=nil
		Prototype.CarBody=nil
		Prototype.CarSeat=nil
		Prototype.CarWindow=nil

		if Prototype.Vehicles then
			local spawnPos=root.Position+(root.CFrame.RightVector*8)+Vector3.new(0,-2.5,0)
			Prototype:CreateVehicle(spawnPos)
		end
	end

	if not self:IsFarmVehicleReady() then
		return false,"Vehicle recovery failed"
	end

	local car=Prototype.Car
	local seat=Prototype.CarSeat
	local body=Prototype.CarBody

	if GetState("atm.repairVehicle",true) and (car:GetAttribute("Health") or 0)<100 then
		car:SetAttribute("Health",100)
	end

	if seat.MaxSpeed~=GetState("atm.vehicleSpeed",50) then
		seat.MaxSpeed=GetState("atm.vehicleSpeed",50)
	end

	if seat.Occupant and seat.Occupant~=humanoid then
		if s.SeatBlockedSince==0 then s.SeatBlockedSince=now end
		if GetState("atm.autoRecoverVehicle",true) and now-s.SeatBlockedSince>=3 then
			pcall(function() car:Destroy() end)
			Prototype.Car=nil
			Prototype.CarBody=nil
			Prototype.CarSeat=nil
			Prototype.CarWindow=nil
			s.SeatBlockedSince=0
			s.VehicleOwned=false
			s.VehicleWaypoints={}
			return false,"Replacing occupied farm vehicle"
		end
		return false,"Vehicle occupied"
	end
	s.SeatBlockedSince=0

	local separated=GetDistance(root.Position,body.Position)>16
	if separated and GetState("atm.autoRecoverVehicle",true) then
		local recoverPos=root.Position+(root.CFrame.RightVector*7)+Vector3.new(0,-2.3,0)
		local forward=root.CFrame.LookVector
		local flatForward=Vector3.new(forward.X,0,forward.Z)
		if flatForward.Magnitude<0.01 then flatForward=Vector3.new(0,0,-1) end
		car:PivotTo(CFrame.lookAt(recoverPos,recoverPos+flatForward.Unit))
		s.VehicleWaypoints={}
		s.VehicleWaypointIndex=1
		s.VehicleGoal=nil
		s.RecoveryAttempts=s.RecoveryAttempts+1
	end

	if seat.Occupant~=humanoid then
		seat:Sit(humanoid)
		s.VehicleOwned=false
		return false,"Seating in farm vehicle"
	end

	s.VehicleOwned=true
	car:SetAttribute("Locked",GetState("atm.lockVehicle",true))
	return true,"Vehicle ready"
end

function Runtime:PlanATMVehicleRoute(goalPosition,targetName,force)
	local car=Prototype.Car
	local body=Prototype.CarBody
	local s=self.ATMSession
	if not car or not car.Parent or not body or not goalPosition then return false end

	local now=os.clock()
	local sameGoal=s.VehicleGoal and GetDistance(s.VehicleGoal,goalPosition)<1.5
	local minReplan=math.max(0.5,GetState("atm.vehicleReplan",1.5))

	if not force and sameGoal and #s.VehicleWaypoints>0 then
		return true
	end
	if force and sameGoal and now-s.LastPlanAt<minReplan and #s.VehicleWaypoints>0 then
		return true
	end

	local points={}
	local path=PathfindingService:CreatePath({
		AgentRadius=4,
		AgentHeight=3,
		AgentCanJump=false,
		AgentCanClimb=false,
		WaypointSpacing=8,
	})

	local ok=pcall(function()
		path:ComputeAsync(body.Position,goalPosition)
	end)

	if ok and path.Status==Enum.PathStatus.Success then
		for index,waypoint in ipairs(path:GetWaypoints()) do
			if index>1 then
				table.insert(points,waypoint.Position)
			end
		end
	end

	if #points==0 then
		table.insert(points,goalPosition)
	elseif GetDistance(points[#points],goalPosition)>2 then
		table.insert(points,goalPosition)
	end

	s.VehicleWaypoints=points
	s.VehicleWaypointIndex=1
	s.VehicleGoal=goalPosition
	s.LastPlanAt=now
	s.LastProgressAt=now
	s.LastDistance=math.huge
	s.Status="Route: "..tostring(targetName or "destination")
	return true
end

function Runtime:StepATMVehicle(goalPosition,targetName,now,dt)
	local ready,readyState=self:EnsureFarmVehicle(now)
	if not ready then
		self:UpdateATMHUD("VEHICLE",targetName or "Route",readyState)
		return false,readyState
	end

	local car=Prototype.Car
	local body=Prototype.CarBody
	local s=self.ATMSession
	if not car or not body then return false,"Vehicle unavailable" end

	local arrival=math.max(4,GetState("atm.vehicleApproach",10)*0.55)
	local directDistance=GetDistance(body.Position,goalPosition)
	if directDistance<=arrival then
		s.VehicleWaypoints={}
		s.VehicleWaypointIndex=1
		s.VehicleGoal=goalPosition
		s.LastDistance=0
		return true,"Arrived"
	end

	local sameGoal=s.VehicleGoal and GetDistance(s.VehicleGoal,goalPosition)<1.5
	if not sameGoal or #s.VehicleWaypoints==0 then
		self:PlanATMVehicleRoute(goalPosition,targetName,false)
	end

	local waypoint=s.VehicleWaypoints[s.VehicleWaypointIndex]
	if not waypoint then
		self:PlanATMVehicleRoute(goalPosition,targetName,true)
		waypoint=s.VehicleWaypoints[s.VehicleWaypointIndex]
		if not waypoint then return false,"No vehicle route" end
	end

	local waypointDistance=GetDistance(body.Position,waypoint)
	if waypointDistance<=4 then
		s.VehicleWaypointIndex=s.VehicleWaypointIndex+1
		waypoint=s.VehicleWaypoints[s.VehicleWaypointIndex]
		if not waypoint then
			waypoint=goalPosition
			s.VehicleWaypoints={goalPosition}
			s.VehicleWaypointIndex=1
		end
		waypointDistance=GetDistance(body.Position,waypoint)
		s.LastDistance=math.huge
	end

	local delta=waypoint-body.Position
	if delta.Magnitude>0.01 then
		local baseSpeed=math.clamp(GetState("atm.vehicleSpeed",50),10,120)
		local direction=delta.Unit
		local flat=Vector3.new(direction.X,0,direction.Z)
		if flat.Magnitude<0.01 then flat=body.CFrame.LookVector end
		flat=flat.Unit

		local currentFlat=Vector3.new(body.CFrame.LookVector.X,0,body.CFrame.LookVector.Z)
		if currentFlat.Magnitude<0.01 then currentFlat=flat else currentFlat=currentFlat.Unit end
		local turnDot=math.clamp(currentFlat:Dot(flat),-1,1)
		local turnFactor=math.clamp((turnDot+1)*0.5,0.35,1)
		local arrivalFactor=math.clamp(directDistance/math.max(arrival*3,1),0.35,1)
		local speed=baseSpeed*math.min(turnFactor,arrivalFactor)
		local frameDt=math.clamp(dt or (1/30),0.005,0.08)
		local step=math.min(delta.Magnitude,speed*frameDt)
		local newPos=body.Position+(direction*step)
		local desired=CFrame.lookAt(newPos,newPos+flat)
		local current=car:GetPivot()
		car:PivotTo(current:Lerp(desired,math.clamp(frameDt*7,0.2,1)))
	end

	local progressDistance=GetDistance(Prototype.CarBody.Position,waypoint)
	if progressDistance<s.LastDistance-0.2 then
		s.LastDistance=progressDistance
		s.LastProgressAt=now
		s.RecoveryAttempts=0
	elseif now-s.LastProgressAt>=math.max(1.25,GetState("atm.vehicleReplan",1.5)*1.5) then
		s.RecoveryAttempts=s.RecoveryAttempts+1
		s.LastProgressAt=now
		s.VehicleWaypoints={}
		s.VehicleWaypointIndex=1

		local maxRetries=math.max(1,GetState("atm.vehicleRetries",3))
		if s.RecoveryAttempts>=maxRetries then
			if GetState("atm.autoRecoverVehicle",true) then
				-- Clean fallback: rebuild a direct route from the current car position.
				s.VehicleWaypoints={goalPosition}
				s.VehicleWaypointIndex=1
				s.VehicleGoal=goalPosition
				s.RecoveryAttempts=0
				s.LastDistance=math.huge
				return false,"Direct recovery route"
			end
			return false,"Vehicle route stalled"
		end

		self:PlanATMVehicleRoute(goalPosition,targetName,true)
		return false,"Replanning vehicle route"
	end

	return false,string.format("Driving • %.0f st",directDistance)
end

function Runtime:MoveFarmToPosition(goalPosition,targetName,now,dt)
	local root=GetRoot()
	if not root or not goalPosition then return false,"Character unavailable" end

	local movement=GetState("atm.movement","Vehicle")
	if movement=="Vehicle" then
		self:ResetNavigation("ATM")
		local arrived,state=self:StepATMVehicle(goalPosition,targetName,now,dt)
		if not arrived and not GetState("atm.strictVehicle",true)
			and self.ATMSession.VehicleOwned~=true then

			local walkArrived,walkState=self:StepNavigation("ATM",goalPosition,targetName.." • fallback")
			return walkArrived==true,"Walk fallback • "..tostring(walkState)
		end
		return arrived,state
	elseif movement=="Walk" then
		self.ATMSession.VehicleOwned=false
		local arrived,state=self:StepNavigation("ATM",goalPosition,targetName)
		return arrived==true,state
	end

	-- Explicit test-only mode. It is never used by default.
	self.ATMSession.VehicleOwned=false
	self:ResetNavigation("ATM")
	root.CFrame=CFrame.new(goalPosition,goalPosition+root.CFrame.LookVector)
	return true,"Teleported"
end

function Runtime:MoveToATM(atm,now,dt)
	local body=atm and atm:FindFirstChild("Body")
	if not body then return false,"ATM unavailable" end

	local targetPosition=self:GetFarmTargetPosition(body,GetState("atm.movement","Vehicle"))
	return self:MoveFarmToPosition(targetPosition,atm.Name,now or os.clock(),dt or (1/30))
end

function Runtime:NeedsATMRestock()
	return GetState("atm.buyTools",false)
		and Prototype.Data.HackTools<=math.max(0,GetState("atm.restockAt",1))
end

function Runtime:RestockATMTools()
	local requested=math.max(1,GetState("atm.toolsBuy",2))
	local affordable=math.floor(Prototype.Data.Cash/180)
	local amount=math.min(requested,affordable)

	if amount<=0 then
		return false,"Not enough prototype cash for hack tools"
	end

	Prototype.Data.Cash=Prototype.Data.Cash-(amount*180)
	Prototype.Data.HackTools=Prototype.Data.HackTools+amount
	UpdatePrototypeDataValues()
	return true,"Bought "..tostring(amount).." hack tool"..(amount==1 and "" or "s")
end

function Runtime:NeedsATMDeposit()
	return GetState("atm.autoDeposit",false)
		and Prototype.Data.Cash>=math.max(1000,GetState("atm.depositAt",5000))
end

function Runtime:DepositATMCash()
	local leave=math.max(0,GetState("atm.leaveCash",1000))
	local deposit=math.max(0,Prototype.Data.Cash-leave)
	if deposit<=0 then return true,"No cash to deposit" end

	Prototype.Data.Cash=Prototype.Data.Cash-deposit
	Prototype.Data.Bank=Prototype.Data.Bank+deposit
	UpdatePrototypeDataValues()
	return true,"Deposited $"..tostring(math.floor(deposit))
end

function Runtime:HackATM(atm, fromFarm)
	if not atm or atm:GetAttribute("Available") ~= true then
		return false,"Unavailable"
	end

	if Prototype.Data.HackTools<=0 then
		if not fromFarm and GetState("atm.buyTools", false) and Prototype.Data.Cash>=180 then
			self:RestockATMTools()
		end

		if Prototype.Data.HackTools<=0 then
			if not fromFarm then
				AdapterNotify("ATM","No prototype hack tools available.","warning")
			end
			UpdatePrototypeDataValues()
			return false,"NoTools"
		end
	end

	local now=os.clock()
	atm:SetAttribute("Available",false)
	atm:SetAttribute("CooldownUntil",now+14)

	local payout=atm:GetAttribute("CashValue") or 900
	local tool=GetState("atm.tool","Best Available")

	if tool=="Advanced" then
		payout=payout*1.15
	elseif tool=="Pro" then
		payout=payout*1.3
	elseif tool=="Best Available" then
		payout=payout*1.2
	end

	Prototype.Data.Cash=Prototype.Data.Cash+payout
	Prototype.Data.HackTools=math.max(0,Prototype.Data.HackTools-1)

	-- Manual actions keep the old convenience behavior. The farm itself uses
	-- physical prototype service routes so restocking/depositing are testable.
	if not fromFarm then
		if GetState("atm.buyTools",false) and self:NeedsATMRestock() then
			self:RestockATMTools()
		end
		if GetState("atm.autoDeposit",false) and self:NeedsATMDeposit() then
			self:DepositATMCash()
		end
	end

	UpdatePrototypeDataValues()

	if not fromFarm then
		AdapterNotify("ATM hacked","+$"..tostring(math.floor(payout)).." prototype cash.","success")
	end

	return true,"Success"
end

function Runtime:RunATMFarm(now,dt)
	if not GetState("atm.enabled",false) then
		if self.ATMSession.Phase~="Idle" or self.CurrentATM then
			self:ResetATMSession("Disabled")
		end
		return
	end

	local s=self.ATMSession
	if self:CheckATMWatchdog(now) then return end
	local stopWhenKnocked=GetState("jobs.stopKnocked",true) or GetState("player.stopKnocked",true)
	if stopWhenKnocked and self:IsKnocked() then
		s.VehicleOwned=false
		if self.Navigation.Owner=="ATM" then self:ResetNavigation("ATM") end
		self:UpdateATMHUD("PAUSED","Player is knocked","Automation will resume automatically")
		return
	end

	if s.Phase=="Idle" then
		s.Target=nil
		s.TargetKind=nil
		self:SetATMPhase("Select",nil,nil,now)
	end

	if s.Phase=="Select" then
		if self:NeedsATMRestock() and now<(s.ServiceRetryAt or 0) then
			self:UpdateATMHUD("WAITING","Tool restock paused",string.format("Retry in %.1f s",math.max(0,s.ServiceRetryAt-now)))
			return
		end

		if self:NeedsATMRestock() then
			s.TargetKind="Tools"
			s.Target=Prototype.ToolShop
			self:SetATMPhase("TravelService",s.Target,s.TargetKind,now)
		elseif self:NeedsATMDeposit() then
			s.TargetKind="Bank"
			s.Target=Prototype.Bank
			self:SetATMPhase("TravelService",s.Target,s.TargetKind,now)
		else
			local atm=self:FindAvailableATM()
			if not atm then
				self.CurrentATM=nil
				self:UpdateATMHUD("WAITING","No ATM ready","Waiting for cooldown")
				return
			end
			self.CurrentATM=atm
			s.Target=atm
			s.TargetKind="ATM"
			self:SetATMPhase("TravelATM",s.Target,s.TargetKind,now)
		end
	end

	if s.Phase=="TravelService" then
		local marker=s.Target
		if not marker or not marker.Parent then
			s.Target=nil
			s.TargetKind=nil
			self:SetATMPhase("Select",nil,nil,now)
			return
		end

		local goal=self:GetFarmTargetPosition(marker,GetState("atm.movement","Vehicle"))
		local arrived,state=self:MoveFarmToPosition(goal,s.TargetKind=="Bank" and "Prototype Bank" or "Tool Shop",now,dt)
		self:UpdateATMHUD("SERVICE",s.TargetKind=="Bank" and "Bank run" or "Tool restock",state)

		if not arrived then return end

		local ok,message
		if s.TargetKind=="Bank" then
			ok,message=self:DepositATMCash()
		else
			ok,message=self:RestockATMTools()
		end

		s.Target=nil
		s.TargetKind=nil
		self:SetATMPhase("Select",nil,nil,now)
		if not ok then
			self:UpdateATMHUD("WAITING","Service unavailable",message)
			s.ServiceRetryAt=now+5
			self.LastATMAction=now
		else
			s.ServiceRetryAt=0
			self:UpdateATMHUD("SERVICE","Complete",message)
		end
		return
	end

	if s.Phase=="TravelATM" then
		local atm=s.Target
		if not atm or not atm.Parent then
			self.CurrentATM=nil
			s.Target=nil
			self:SetATMPhase("Select",nil,nil,now)
			return
		end

		if atm:GetAttribute("Available")~=true then
			if GetState("atm.skipUnavailable",true) then
				self.CurrentATM=nil
				s.Target=nil
				self:SetATMPhase("Select",nil,nil,now)
			else
				local cooldown=math.max(0,(atm:GetAttribute("CooldownUntil") or now)-now)
				self:UpdateATMHUD("WAITING",atm.Name,string.format("Cooldown %.1f s",cooldown))
			end
			return
		end

		local arrived,state=self:MoveToATM(atm,now,dt)
		self:UpdateATMHUD("TRAVEL",atm.Name,state)
		if not arrived then return end

		self:SetATMPhase("Hack",s.Target,"ATM",now)
		self.LastATMAction=0
	end

	if s.Phase=="Hack" then
		local atm=s.Target
		if not atm or not atm.Parent or atm:GetAttribute("Available")~=true then
			self.CurrentATM=nil
			s.Target=nil
			self:SetATMPhase("Select",nil,nil,now)
			return
		end

		if not GetState("atm.autoHack",false) then
			self:UpdateATMHUD("READY",atm.Name,"Enable Auto Hack to continue")
			return
		end

		local retry=math.max(0.25,GetState("atm.retry",1))
		if now-self.LastATMAction<retry then
			self:UpdateATMHUD("HACK",atm.Name,string.format("Retry %.1f s",math.max(0,retry-(now-self.LastATMAction))))
			return
		end
		self.LastATMAction=now

		if GetState("atm.killAura",false) then
			self:RunMeleeAura(now)
		end

		local ok,reason=self:HackATM(atm,true)
		if ok then
			s.Hacks=s.Hacks+1
			s.ConsecutiveFailures=0
			s.LastFailure=nil
			self:UpdateATMHUD("SUCCESS",atm.Name,"Hacks this session: "..tostring(s.Hacks))
			self.CurrentATM=nil
			s.Target=nil
			s.TargetKind=nil
			self:SetATMPhase("Select",nil,nil,now)
		elseif reason=="NoTools" then
			s.Target=nil
			s.TargetKind=nil
			self:SetATMPhase("Select",nil,nil,now)
		elseif reason=="Unavailable" then
			self.CurrentATM=nil
			s.Target=nil
			self:SetATMPhase("Select",nil,nil,now)
		else
			self:UpdateATMHUD("RETRY",atm.Name,tostring(reason or "Hack failed"))
		end
	end
end

function Runtime:UpdateATMRoutingLine()
	local line = RuntimeUI.AimLine

	if not line then
		return
	end

	if not GetState("atm.routeLine", false) or not self.CurrentATM or not Camera then
		line.Visible = false
		return
	end

	local body = self.CurrentATM:FindFirstChild("Body")

	if not body then
		line.Visible = false
		return
	end

	local point, onScreen = Camera:WorldToViewportPoint(body.Position)

	if not onScreen or point.Z <= 0 then
		line.Visible = false
		return
	end

	local viewport = Camera.ViewportSize
	local from = Vector2.new(viewport.X * 0.5, viewport.Y)
	local to = Vector2.new(point.X, point.Y)

	self:UpdateLine(line, from, to, 2, Theme.Warning)
end

function Runtime:UpdateVehicle(dt)
	local car = Prototype.Car
	local body = Prototype.CarBody
	local seat = Prototype.CarSeat

	if not car or not body or not seat then
		return
	end

	local health = car:GetAttribute("Health") or 100
	local modsEnabled = GetState("vehicle.mods", false)

	if modsEnabled and GetState("vehicle.noCrash", false) and health < 100 then
		health = 100
	end

	if modsEnabled and GetState("vehicle.autoRepair", false) and health < GetState("vehicle.repairThreshold", 45) then
		health = 100
	end

	car:SetAttribute("Health", health)
	local atmOwnsVehicle=GetState("atm.enabled",false) and self.ATMSession and self.ATMSession.VehicleOwned==true
	car:SetAttribute("Locked", GetState("vehicle.autoLock", false)
		or (atmOwnsVehicle and GetState("atm.lockVehicle", true)))

	local humanoid = GetHumanoid()
	local occupiedByLocal = humanoid and seat.Occupant == humanoid

	if occupiedByLocal and not atmOwnsVehicle then
		local speedMultiplier = modsEnabled and GetState("vehicle.speed", false)
			and GetState("vehicle.speedMulti", 1.25)
			or 1
		local accelerationMultiplier = modsEnabled and GetState("vehicle.accel", false)
			and GetState("vehicle.accelMulti", 1.25)
			or 1
		local baseSpeed = 30 * speedMultiplier

		if modsEnabled and GetState("vehicle.bumpAssist", false) then
			baseSpeed = baseSpeed * 1.1
		end

		local throttle = 0
		local steer = 0

		if self:IsInputDown("W") then
			throttle = throttle + 1
		end

		if self:IsInputDown("S") then
			throttle = throttle - 1
		end

		if self:IsInputDown("A") then
			steer = steer + 1
		end

		if self:IsInputDown("D") then
			steer = steer - 1
		end

		if modsEnabled and GetState("vehicle.instantBrake", false) and self:IsInputDown("Space") then
			throttle = 0
		end

		local pivot = car:GetPivot()
		pivot = pivot * CFrame.Angles(0, math.rad(steer * 65 * dt * accelerationMultiplier), 0)
		pivot = pivot + pivot.LookVector * throttle * baseSpeed * dt * accelerationMultiplier
		car:PivotTo(pivot)
	end

	if GetState("atm.repairVehicle", true) and GetState("atm.enabled", false)
		and self.ATMSession and self.ATMSession.VehicleOwned and health < 100 then
		car:SetAttribute("Health", 100)
	end
end


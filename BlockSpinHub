local function Create(className,props,parent)
    local o=Instance.new(className)
    local finalProps = {}

    for k,v in pairs(props or {}) do
        finalProps[k] = v
    end

    if finalProps.TextSize
        and (className == "TextLabel" or className == "TextButton" or className == "TextBox") then

        finalProps.TextSize = math.max(1, math.floor(finalProps.TextSize * UI_TEXT_SCALE + 0.5))
    end

    for k,v in pairs(finalProps) do
        o[k] = v
    end

    if parent then
        o.Parent=parent
    end

    return o
end


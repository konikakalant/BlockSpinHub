    if not backpack then
        return false
    end

    local character=GetCharacter()
    local function hasTool(name)
        return (backpack and backpack:FindFirstChild(name)) or (character and character:FindFirstChild(name))
    end
    if hasTool("Pistol") and hasTool("Fists") and hasTool("Throwable") then
        return true
    end

    for _, name in ipairs({"Pistol", "Fists", "Throwable"}) do
        local existing = backpack:FindFirstChild(name)

        if existing then
            existing:Destroy()
        end

        if character and character:FindFirstChild(name) then
            character[name]:Destroy()
        end

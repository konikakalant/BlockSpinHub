local function BuildControl(page,section,d)
    if d.Type=="toggle" then AddToggle(page,section,d)
    elseif d.Type=="slider" then AddSlider(page,section,d)
    elseif d.Type=="dropdown" then AddDropdown(page,section,d)
    elseif d.Type=="button" then AddButton(page,section,d)
    elseif d.Type=="keybind" then AddKeybind(page,section,d) end
end

ApplyCompactMode=function(enabled)
    local compact=enabled==true
    for _,control in pairs(Controls) do
        local root=control and control.Root
        if root and root:IsA("GuiObject") then
            local baseHeight=root:GetAttribute("BaseHeight") or (control.Type=="slider" and 44 or 34)
            local targetHeight=baseHeight
            if compact then
                targetHeight=(control.Type=="slider") and math.max(38,baseHeight-6) or math.max(29,baseHeight-5)
            end
            root.Size=UDim2.new(1,0,0,targetHeight)
        end
    end
end


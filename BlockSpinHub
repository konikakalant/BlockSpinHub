local function GetState(flag, fallback)
    local value = State[flag]

    if value == nil then
        return fallback
    end

    -- Child controls keep their UI value, but inactive dependency chains must not
    -- continue affecting the Studio runtime when their parent feature is disabled.
    if DependencyMaster[flag] and not IsDependencyChainEnabled(flag) then
        return fallback
    end

    return value
end

local function SetControl(flag, value, silent)
    local control = Controls[flag]

    if control and control.Set then
        control.Set(value, silent == true)
    else
        State[flag] = value
    end
end


-- DEPENDENCY RENDERER
----------------------------------------------------------------

local function IsDependencyChainEnabled(flag,visited)
	local masterFlag=DependencyMaster[flag]

	if not masterFlag then
		return true
	end

	visited=visited or {}
	if visited[flag] then
		return true
	end
	visited[flag]=true

	if State[masterFlag]~=true then
		return false
	end

	return IsDependencyChainEnabled(masterFlag,visited)
end

local DependencyChildren={}
for childFlag,masterFlag in pairs(DependencyMaster) do
	DependencyChildren[masterFlag]=DependencyChildren[masterFlag] or {}
	table.insert(DependencyChildren[masterFlag],childFlag)
end

local function CollectDependencyDescendants(flag,result,seen)
	result=result or {}
	seen=seen or {}
	if seen[flag] then return result end
	seen[flag]=true

	for _,child in ipairs(DependencyChildren[flag] or {}) do
		result[child]=true
		CollectDependencyDescendants(child,result,seen)
	end
	return result
end

RefreshDependencies=function(changedFlag)
	local targets
	if changedFlag and DependencyChildren[changedFlag] then
		targets=CollectDependencyDescendants(changedFlag)
	else
		targets=DependencyMaster
	end

	for childFlag in pairs(targets) do
		local child=Controls[childFlag]

		if child and child.Root and child.Root:IsA("CanvasGroup") then
			local chainEnabled=IsDependencyChainEnabled(childFlag)
			local targetTransparency=chainEnabled and 0 or 0.42

			if math.abs(child.Root.GroupTransparency-targetTransparency)>0.01 then
				Tween(child.Root,{GroupTransparency=targetTransparency},0.09)
			end
		end
	end
end

RefreshDependencies()


local function Tween(object,props,duration,style,direction)
    if not object then return end

    local previous=ActiveTweens[object]
    if previous then
        pcall(function() previous:Cancel() end)
        ActiveTweens[object]=nil
    end

    if not Config.Animations then
        for k,v in pairs(props) do object[k]=v end
        return
    end

    local tweenDuration=duration or Config.AnimationSpeed
    if Config.PerformanceMode=="Performance" or Config.DeviceProfile=="Phone" then
        tweenDuration=math.min(tweenDuration,0.09)
    elseif Config.PerformanceMode=="Balanced" or Config.DeviceProfile=="Tablet" then
        tweenDuration=math.min(tweenDuration,0.13)
    end

    local tw=TweenService:Create(
        object,
        TweenInfo.new(tweenDuration,style or Enum.EasingStyle.Quart,direction or Enum.EasingDirection.Out),
        props
    )
    ActiveTweens[object]=tw
    tw.Completed:Connect(function()
        if ActiveTweens[object]==tw then
            ActiveTweens[object]=nil
        end
    end)
    tw:Play()
    return tw
end

local function BindTheme(cb) table.insert(ThemeBindings,cb) end

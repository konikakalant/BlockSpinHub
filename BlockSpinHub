function Runtime:UpdateItemESP()
    if not LocalWorld.Items then
        return
    end

    local enabled = GetState("itemEsp.enabled", false)
    if not enabled then
        for _,visual in pairs(LocalWorld.ItemVisuals) do
            if visual.Gui then visual.Gui.Enabled=false end
        end
        return
    end
    local root = GetRoot()

    if not root then
        return
    end

    for _, part in ipairs(LocalWorld.Items:GetChildren()) do
        if part:IsA("BasePart") and part:GetAttribute("LocalWorldItem") == true then
            local visual = self:EnsureItemVisual(part)
            local itemType = part:GetAttribute("ItemType")
            local allowed = true

            if itemType == "Cash" then
                allowed = GetState("itemEsp.cash", true)
            elseif itemType == "Weapon" then
                allowed = GetState("itemEsp.weapons", true)
            elseif itemType == "Crate" then
                allowed = GetState("itemEsp.crates", true)
            else
                allowed = GetState("itemEsp.items", true)
            end

            local distance = GetDistance(root.Position, part.Position)
            local show = enabled
                and allowed
                and part:GetAttribute("Available") ~= false
                and distance <= GetState("itemEsp.maxDistance", 1000)

            visual.Gui.Enabled = show
            visual.Label.TextSize = GetState("itemEsp.textSize", 12)
            visual.Label.Text = part.Name .. " • " .. tostring(math.floor(distance)) .. "m"
            visual.Label.TextColor3 = itemType == "Cash" and Theme.Success or Theme.AccentSoft
        end
    end

    if LocalWorld.ATMs then
        for _, atm in ipairs(LocalWorld.ATMs:GetChildren()) do
            local body = atm:FindFirstChild("Body")

            if body then
                local visual = self:EnsureItemVisual(body)
                local distance = GetDistance(root.Position, body.Position)
                local show = enabled
                    and GetState("itemEsp.atms", true)
                    and distance <= GetState("itemEsp.maxDistance", 1000)

                visual.Gui.Enabled = show
                visual.Label.TextSize = GetState("itemEsp.textSize", 12)
                visual.Label.Text = atm.Name .. " • " .. tostring(math.floor(distance)) .. "m"
                visual.Label.TextColor3 = Theme.Success
            end
        end
    end

    if LocalWorld.Jobs then
        for _, job in ipairs(LocalWorld.Jobs:GetChildren()) do
            if job:IsA("BasePart") then
                local visual = self:EnsureItemVisual(job)
                local distance = GetDistance(root.Position, job.Position)
                local show = enabled
                    and GetState("itemEsp.jobs", false)
                    and distance <= GetState("itemEsp.maxDistance", 1000)

                visual.Gui.Enabled = show
                visual.Label.Text = job.Name .. " • JOB"
                visual.Label.TextColor3 = Theme.Warning
            end
        end
    end

    if LocalWorld.Shops then
        for _, shop in ipairs(LocalWorld.Shops:GetChildren()) do
            if shop:IsA("BasePart") then
                local visual = self:EnsureItemVisual(shop)
                local distance = GetDistance(root.Position, shop.Position)
                visual.Gui.Enabled = enabled
                    and GetState("itemEsp.shops", false)
                    and distance <= GetState("itemEsp.maxDistance", 1000)
                visual.Label.Text = shop.Name .. " • SHOP"
                visual.Label.TextColor3 = Theme.Danger
            end
        end
    end

    if LocalWorld.CarBody then
        local visual = self:EnsureItemVisual(LocalWorld.CarBody)
        local distance = GetDistance(root.Position, LocalWorld.CarBody.Position)
        visual.Gui.Enabled = enabled
            and GetState("itemEsp.vehicles", false)
            and distance <= GetState("itemEsp.maxDistance", 1000)
        visual.Label.Text = "Vehicle • " .. tostring(math.floor(distance)) .. "m"
        visual.Label.TextColor3 = Theme.AccentSoft
    end
end


function Runtime:ApplyRecoil()
	if GetState("weapon.noRecoil", false) then
		return
	end

	if not Camera then
		return
	end

	local recoilPercent = GetState("weapon.recoilPercent", 0)
	local recoil = math.rad(math.max(0, recoilPercent) * 0.035)

	if recoil <= 0 then
		return
	end

	Camera.CFrame = Camera.CFrame * CFrame.Angles(-recoil, 0, 0)
end

function Runtime:GetWeaponRange()
	if GetState("weapon.infiniteRange", false) then
		return 10000
	end

	if GetState("weapon.extendedRange", false) then
		return GetState("weapon.range", 1000)
	end

	return math.min(GetState("weapon.range", 1000), 1200)
end

function Runtime:ReloadWeapon()
	if self.Reloading then
		return
	end

	self.Reloading = true
	self.ReloadToken = self.ReloadToken + 1
	local token = self.ReloadToken
	local delayTime = GetState("weapon.instantReload", false) and 0 or GetState("weapon.reloadTime", 0.45)

	task.delay(math.max(0, delayTime), function()
		if self.Reloading and self.ReloadToken == token then
			self.Ammo = self.MagazineSize
			self.Reloading = false
		end
	end)
end

function Runtime:FireWeapon(automatic)
	if not Camera then
		return false
	end

	if self.Reloading then
		return false
	end

	if self.Ammo <= 0 then
		self:ReloadWeapon()
		return false
	end

	local now = os.clock()
	local rate = GetState("weapon.fireRate", 750)
	local interval = 60 / math.max(rate, 1)

	if not GetState("weapon.rapidFire", false) then
		interval = math.max(interval, 0.11)
	end

	if now - self.LastFire < interval then
		return false
	end

	self.LastFire = now
	self.Ammo = self.Ammo - 1

	local origin = Camera.CFrame.Position
	local defaultDirection

	if Mouse and Mouse.Hit then
		local mouseDelta=Mouse.Hit.Position-origin
		defaultDirection=mouseDelta.Magnitude>0.001 and mouseDelta.Unit or Camera.CFrame.LookVector
	else
		defaultDirection = Camera.CFrame.LookVector
	end

	local direction, silentTarget = self:GetSilentDirection(origin, defaultDirection)

	if not GetState("weapon.noSpread", false) then
		local accuracy = GetState("weapon.accuracy", 100) / 100
		local spread = math.rad((1 - accuracy) * 5)

		if spread > 0 then
			direction = (
				CFrame.lookAt(Vector3.zero, direction)
					* CFrame.Angles(
						(math.random() - 0.5) * spread,
						(math.random() - 0.5) * spread,
						0
					)
			).LookVector
		end
	end

	local shotCount = 1

	if GetState("weapon.multiShot", false) then
		shotCount = math.clamp(GetState("weapon.multiShotCount", 2), 1, 10)
	end

	local range = self:GetWeaponRange()
	local damage = 24

	for shotIndex = 1, shotCount do
		local shotDirection = direction

		if shotIndex > 1 and not GetState("weapon.noSpread", false) then
			local spread = math.rad(0.8)
			shotDirection = (
				CFrame.lookAt(Vector3.zero, direction)
					* CFrame.Angles(
						(math.random() - 0.5) * spread,
						(math.random() - 0.5) * spread,
						0
					)
			).LookVector
		end

		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude

		local ignore = {}
		local character = GetCharacter()

		if character then
			table.insert(ignore, character)
		end

		if Prototype.Effects then
			table.insert(ignore, Prototype.Effects)
		end

		params.FilterDescendantsInstances = ignore

		local result = Workspace:Raycast(origin, shotDirection * range, params)
		local hitPosition = origin + shotDirection * range
		local hitTarget = silentTarget

		if result then
			hitPosition = result.Position

			local ancestor = result.Instance:FindFirstAncestorOfClass("Model")

			if ancestor and ancestor:GetAttribute("PrototypeTarget") == true then
				hitTarget = ancestor
			end
		elseif silentTarget then
			local targetPart = Prototype:GetTargetPart(silentTarget, GetState("silent.part", "Head"))

			if targetPart then
				hitPosition = targetPart.Position
			end
		end

		self:CreateTracer(origin, hitPosition)
		self:CreateImpact(hitPosition)

		if hitTarget then
			local humanoid = hitTarget:FindFirstChildOfClass("Humanoid")

			if humanoid and humanoid.Health > 0 then
				humanoid:TakeDamage(damage)
				self:ShowHitmarker()
				self:ShowDamageText(hitTarget, damage)
			end
		end
	end

	self:ApplyRecoil()
	return true
end

function Runtime:ManualMeleeHit()
	local root = GetRoot()

	if not root then
		return false
	end

	local range = GetState("melee.rangeExpander", false)
		and GetState("melee.expanderSize", 5)
		or 5

	local closest = nil
	local closestDistance = math.huge

	for _, target in ipairs(Prototype:GetTargets()) do
		local targetRoot = target:FindFirstChild("HumanoidRootPart")

		if targetRoot then
			local distance = GetDistance(root.Position, targetRoot.Position)

			if distance <= range and distance < closestDistance then
				closestDistance = distance
				closest = target
			end
		end
	end

	if closest then
		local humanoid = closest:FindFirstChildOfClass("Humanoid")

		if humanoid then
			humanoid:TakeDamage(18)
			self:ShowHitmarker()
			self:ShowDamageText(closest, 18)
			return true
		end
	end

	return false
end

function Runtime:RunMeleeAura(now)
	if not GetState("melee.aura", false) then
		return
	end

	local delaySeconds = GetState("melee.delay", 80) / 1000

	if now - self.LastMelee < delaySeconds then
		return
	end

	self.LastMelee = now

	local root = GetRoot()

	if not root then
		return
	end

	local range = GetState("melee.range", 12)
	local cone = math.rad(GetState("melee.cone", 90))
	local candidates = {}

	for _, target in ipairs(Prototype:GetTargets()) do
		local targetRoot = target:FindFirstChild("HumanoidRootPart")
		local humanoid = target:FindFirstChildOfClass("Humanoid")

		if targetRoot and humanoid and self:PassesTargetChecks(target, "melee") then
			local offset = targetRoot.Position - root.Position
			local distance = offset.Magnitude

			if distance <= range and distance > 0.001 then
				local direction = offset.Unit
				local dot = math.clamp(root.CFrame.LookVector:Dot(direction), -1, 1)
				local angle = math.acos(dot)

				if angle <= cone * 0.5 or GetState("melee.hitAll", false) then
					local visibleOk = not GetState("melee.wallCheck", true) or self:IsVisibleTarget(target, targetRoot)

					if visibleOk and (not GetState("melee.knockedCheck", true) or humanoid.Health > 10) then
						table.insert(candidates, {
							Target = target,
							Distance = distance,
						})
					end
				end
			end
		end
	end

	table.sort(candidates, function(a, b)
		return a.Distance < b.Distance
	end)

	local hitAll = GetState("melee.hitAll", false) and not GetState("melee.closestOnly", true)
	local limit = hitAll and #candidates or math.min(1, #candidates)

	for index = 1, limit do
		local target = candidates[index].Target
		local humanoid = target:FindFirstChildOfClass("Humanoid")

		if humanoid then
			humanoid:TakeDamage(14)
			self:ShowDamageText(target, 14)
		end
	end
end

function Runtime:ThrowAtTarget(automatic)
	local now = os.clock()
	local delaySeconds = GetState("throw.delay", 150) / 1000

	if now - self.LastThrow < delaySeconds then
		return false
	end

	self.LastThrow = now

	local root = GetRoot()

	if not root then
		return false
	end

	local target = nil
	local targetPart = nil
	local bestScore = math.huge
	local range = GetState("throw.range", 35)
	local priority = GetState("throw.target", "Closest")

	for _, candidate in ipairs(Prototype:GetTargets()) do
		local part = candidate:FindFirstChild("HumanoidRootPart")
		local humanoid = candidate:FindFirstChildOfClass("Humanoid")

		if part and humanoid then
			local distance = GetDistance(root.Position, part.Position)
			local visibleOk = not GetState("throw.wallCheck", true) or self:IsVisibleTarget(candidate, part)

			if distance <= range and visibleOk then
				local score = distance

				if priority == "Lowest Health" then
					score = humanoid.Health
				elseif priority == "FOV" then
					score = self:GetScreenDistance(part.Position)
				end

				if score < bestScore then
					bestScore = score
					target = candidate
					targetPart = part
				end
			end
		end
	end

	if not target or not targetPart then
		return false
	end

	if GetState("throw.autoEquip", false) then
		local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
		local humanoid = GetHumanoid()
		local tool = backpack and backpack:FindFirstChild("Prototype Throwable")

		if humanoid and tool then
			humanoid:EquipTool(tool)
		end
	end

	local origin = root.Position + Vector3.new(0, 2, 0)
	local targetPosition = targetPart.Position

	if GetState("throw.prediction", true) then
		targetPosition = targetPosition + targetPart.AssemblyLinearVelocity * GetState("throw.predictionAmount", 0.2)
	end

	local projectile = MakePart(
		Prototype.Effects,
		"Prototype Throwable",
		Vector3.new(0.7, 0.7, 0.7),
		CFrame.new(origin),
		Theme.AccentSoft,
		Enum.Material.Neon,
		true
	)

	projectile.Shape = Enum.PartType.Ball
	projectile.CanCollide = false

	local distance = GetDistance(origin, targetPosition)
	local travelTime = math.clamp(distance / 90, 0.15, 1.1)

	TweenService:Create(
		projectile,
		TweenInfo.new(travelTime, Enum.EasingStyle.Linear),
		{CFrame = CFrame.new(targetPosition)}
	):Play()

	task.delay(travelTime, function()
		if target and target.Parent then
			local humanoid = target:FindFirstChildOfClass("Humanoid")

			if humanoid and humanoid.Health > 0 then
				humanoid:TakeDamage(20)
				self:ShowDamageText(target, 20)
			end
		end

		if projectile then
			projectile:Destroy()
		end
	end)

	return true
end

function Runtime:RunThrowableAura(now)
	if not GetState("throw.enabled", false) then
		return
	end

	self:ThrowAtTarget(true)
end

function Runtime:UpdateAim(dt)
	if not GetState("aim.enabled", false) then
		self.CurrentAimTarget = nil
		return
	end

	if not self:IsAimActivationActive() then
		self.CurrentAimTarget = nil
		return
	end

	local target, part = self:GetBestTarget("aim")

	self.CurrentAimTarget = target

	if not target or not part or not Camera then
		return
	end

	local targetPosition = part.Position

	if GetState("aim.prediction", true) then
		targetPosition = targetPosition
			+ Vector3.new(
				part.AssemblyLinearVelocity.X * GetState("aim.predictionX", 0.15),
				part.AssemblyLinearVelocity.Y * GetState("aim.predictionY", 0.1),
				part.AssemblyLinearVelocity.Z * GetState("aim.predictionX", 0.15)
			)
	end

	local desired = CFrame.lookAt(Camera.CFrame.Position, targetPosition)
	local smoothness = math.clamp(GetState("aim.smoothness", 18) / 100, 0.01, 1)
	local sensitivity = math.clamp(GetState("aim.sensitivity", 50) / 100, 0.05, 1)
	local alpha = math.clamp((1 - smoothness) * sensitivity * dt * 16, 0.02, 1)

	Camera.CFrame = Camera.CFrame:Lerp(desired, alpha)
end

function Runtime:UpdateAimVisuals()
	if not RuntimeUI.CombatOverlay or not Camera then
		return
	end

	local line = RuntimeUI.CombatOverlay:FindFirstChild("AimSnapLine")

	if not line then
		line = self:MakeScreenLine("AimSnapLine", Theme.Accent)
	end

	local target = self.CurrentAimTarget
	local drawSilent = GetState("silent.drawTarget", false) and self.CurrentSilentTarget or nil
	local drawTarget = target or drawSilent

	for model, visual in pairs(Prototype.TargetVisuals) do
		if visual.Highlight then
			local shouldHighlight = (model == target and GetState("aim.targetHighlight", false))
				or (model == drawSilent and GetState("silent.drawTarget", false))
				or (GetState("esp.enabled", false) and GetState("esp.chams", false))

			visual.Highlight.Enabled = shouldHighlight
		end
	end

	if drawTarget and GetState("aim.snapline", false) then
		local part = drawTarget:FindFirstChild("HumanoidRootPart")

		if part then
			local point, onScreen = Camera:WorldToViewportPoint(part.Position)

			if onScreen and point.Z > 0 then
				local viewport = Camera.ViewportSize
				self:UpdateLine(
					line,
					Vector2.new(viewport.X * 0.5, viewport.Y),
					Vector2.new(point.X, point.Y),
					1,
					Theme.Accent
				)
				return
			end
		end
	end

	if line then
		line.Visible = false
	end
end

function Runtime:UpdateHitboxes()
	local enabled = GetState("hitbox.enabled", false)
	local size = GetState("hitbox.size", 8)
	local transparency = GetState("hitbox.transparency", 65) / 100
	local mode = GetState("hitbox.mode", "Head Only")

	for _, model in ipairs(Prototype:GetTargets()) do
		local parts = {
			Head = model:FindFirstChild("Head"),
			UpperTorso = model:FindFirstChild("UpperTorso"),
			HumanoidRootPart = model:FindFirstChild("HumanoidRootPart"),
		}

		for partName, part in pairs(parts) do
			if part then
				local shouldExpand = false

				if enabled then
					if mode == "All Parts" then
						shouldExpand = true
					elseif mode == "Torso Only" then
						shouldExpand = partName == "UpperTorso" or partName == "HumanoidRootPart"
					else
						shouldExpand = partName == "Head"
					end
				end

				if shouldExpand then
					local localRoot = GetRoot()
					local inDistance = true

					if GetState("hitbox.distanceLimit", true) and localRoot then
						inDistance = GetDistance(localRoot.Position, part.Position) <= GetState("hitbox.maxDistance", 500)
					end

					local enemyOk = not GetState("hitbox.onlyEnemies", true)
						or model:GetAttribute("PrototypeTeam") ~= LocalPlayer:GetAttribute("PrototypeTeam")

					if inDistance and enemyOk then
						part.Size = Vector3.new(size, size, size)
						part.Transparency = GetState("hitbox.visualize", false) and transparency or 1
						part.CanCollide = false
					else
						shouldExpand = false
					end
				end

				if not shouldExpand then
					if partName == "Head" then
						part.Size = Vector3.new(1.5, 1.5, 1.5)
						part.Transparency = 0
					elseif partName == "UpperTorso" then
						part.Size = Vector3.new(2.2, 2.2, 1.1)
						part.Transparency = 0
					else
						part.Size = Vector3.new(2, 2, 1)
						part.Transparency = 0.45
					end
				end
			end
		end
	end
end

function Runtime:ApplyHitboxPreset(value)
	if value == "Legit" then
		SetControl("hitbox.size", 3, true)
		SetControl("hitbox.transparency", 80, true)
	elseif value == "Semi-Rage" then
		SetControl("hitbox.size", 10, true)
		SetControl("hitbox.transparency", 60, true)
	elseif value == "Rage" then
		SetControl("hitbox.size", 20, true)
		SetControl("hitbox.transparency", 45, true)
	end

	self:UpdateHitboxes()
end

function Runtime:UpdateTrigger(now)
	local triggerEnabled = GetState("trigger.enabled", false)
	local autoShoot = GetState("trigger.autoShoot", false)

	if not triggerEnabled and not autoShoot then
		return
	end

	local delaySeconds = GetState("trigger.delay", 25) / 1000

	if now - self.LastTrigger < delaySeconds then
		return
	end

	local target, part = self:GetBestTarget("aim")

	if not target or not part then
		return
	end

	if not self:PassesTargetChecks(target, "trigger") then
		return
	end

	if GetState("trigger.wallCheck", true) and not self:IsVisibleTarget(target, part) then
		return
	end

	local requiredPart = GetState("trigger.part", "Any")

	if requiredPart == "Head" and part.Name ~= "Head" then
		return
	end

	if requiredPart == "Torso" and part.Name == "Head" then
		return
	end

	local screenDistance = self:GetScreenDistance(part.Position)

	if screenDistance > 22 and triggerEnabled then
		return
	end

	self.LastTrigger = now
	self.TriggerBurstToken=self.TriggerBurstToken+1
	local token=self.TriggerBurstToken

	local burst = math.clamp(GetState("trigger.burst", 1), 1, 10)
	local fireRate=math.max(1,GetState("weapon.fireRate",750))
	local burstInterval=60/fireRate
	if not GetState("weapon.rapidFire",false) then burstInterval=math.max(burstInterval,0.11) end

	for index = 1, burst do
		task.delay((index - 1) * burstInterval, function()
			if self.Started
				and token==self.TriggerBurstToken
				and (GetState("trigger.enabled",false) or GetState("trigger.autoShoot",false)) then
				self:FireWeapon(true)
			end
		end)
	end
end

function Runtime:UpdatePlayerBaseline()
	local humanoid=GetHumanoid()
	local root=GetRoot()
	if not humanoid or not root then return end

	if humanoid.Health>0 and root.Position.Y>-20 then
		self.LastSafeCFrame=root.CFrame
	end

	local currentState=humanoid:GetState()
	if currentState==Enum.HumanoidStateType.Freefall then
		self.WasFreefall=true
		self.FallVelocity=math.min(self.FallVelocity,root.AssemblyLinearVelocity.Y)
	elseif self.WasFreefall then
		if self.FallVelocity < -65 and not GetState("player.noFall",false) then
			local damage=math.clamp((-self.FallVelocity-65)*0.6,0,70)
			humanoid:TakeDamage(damage)
		end
		self.WasFreefall=false
		self.FallVelocity=0
	end
end

function Runtime:UpdatePlayer(dt)
	local character = GetCharacter()
	local humanoid = GetHumanoid()
	local root = GetRoot()

	if not character or not humanoid or not root then
		return
	end

	if humanoid.Health > 0 and root.Position.Y > -20 then
		self.LastSafeCFrame = root.CFrame
	end

	if GetState("melee.fists", false) and not self.FistsEquipped then
		local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
		local fists = backpack and backpack:FindFirstChild("Prototype Fists")

		if fists then
			humanoid:EquipTool(fists)
		end
	end

	local currentState = humanoid:GetState()

	if currentState == Enum.HumanoidStateType.Freefall then
		self.WasFreefall = true
		self.FallVelocity = math.min(self.FallVelocity, root.AssemblyLinearVelocity.Y)
	elseif self.WasFreefall then
		if self.FallVelocity < -65 and not GetState("player.noFall", false) then
			local damage = math.clamp((-self.FallVelocity - 65) * 0.6, 0, 70)
			humanoid:TakeDamage(damage)
		end

		self.WasFreefall = false
		self.FallVelocity = 0
	end

	self:CaptureCharacterBaseline(false)
	local baseline=self.CharacterBaseline
	local baseWalkSpeed=baseline and baseline.WalkSpeed or 16
	local baseJumpPower=baseline and baseline.JumpPower or 50
	local baseUseJumpPower=baseline and baseline.UseJumpPower

	if GetState("player.speed", false) then
		local multiplier = GetState("player.speedMultiplier", 1.2)
		local method = GetState("player.speedMethod", "Hybrid")

		if method == "WalkSpeed" or method == "Hybrid" then
			humanoid.WalkSpeed = baseWalkSpeed * multiplier
		else
			humanoid.WalkSpeed = baseWalkSpeed
		end

		if (method == "CFrame" or method == "Hybrid") and humanoid.MoveDirection.Magnitude > 0 then
			root.CFrame = root.CFrame + humanoid.MoveDirection * math.max(0, multiplier - 1) * 8 * dt
		end
	elseif GetState("player.noSlow", false) then
		humanoid.WalkSpeed = math.max(humanoid.WalkSpeed, baseWalkSpeed)
	else
		humanoid.WalkSpeed = baseWalkSpeed
	end

	humanoid.UseJumpPower = true

	if GetState("player.superJump", false) then
		humanoid.JumpPower = GetState("player.jumpPower", 55)
	else
		humanoid.JumpPower = baseJumpPower
		if baseUseJumpPower~=nil then humanoid.UseJumpPower=baseUseJumpPower end
	end

	local noclipEnabled=GetState("player.noclip", false)

	if GetState("player.fly", false) then
		humanoid.PlatformStand = true

		local move = Vector3.zero
		local cameraCFrame = Camera and Camera.CFrame or root.CFrame

		if self:IsInputDown("W") then
			move = move + cameraCFrame.LookVector
		end

		if self:IsInputDown("S") then
			move = move - cameraCFrame.LookVector
		end

		if self:IsInputDown("A") then
			move = move - cameraCFrame.RightVector
		end

		if self:IsInputDown("D") then
			move = move + cameraCFrame.RightVector
		end

		if self:IsInputDown("Space") then
			move = move + Vector3.new(0, 1, 0)
		end

		if self:IsInputDown("LeftControl") or self:IsInputDown("LeftShift") then
			move = move - Vector3.new(0, 1, 0)
		end

		if move.Magnitude > 0 then
			move = move.Unit
		end

		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = root.CFrame + move * GetState("player.flySpeed", 60) * dt
	elseif humanoid.PlatformStand then
		humanoid.PlatformStand = baseline and baseline.PlatformStand or false
	end

	if GetState("player.antiKill", false) or GetState("player.antiDeath", false) or GetState("player.autoRespawn", false) then
		if humanoid.Health < math.max(15, humanoid.MaxHealth * 0.18) then
			humanoid.Health = humanoid.MaxHealth

			if self.LastSafeCFrame then
				root.CFrame = self.LastSafeCFrame
			end
		end
	end

	if GetState("player.antiRagdoll", false) then
		local state = humanoid:GetState()

		if state == Enum.HumanoidStateType.Ragdoll
			or state == Enum.HumanoidStateType.FallingDown
			or state == Enum.HumanoidStateType.Physics then

			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end

	if GetState("player.antiVoid", false) and root.Position.Y < -25 and self.LastSafeCFrame then
		root.CFrame = self.LastSafeCFrame + Vector3.new(0, 4, 0)
		root.AssemblyLinearVelocity = Vector3.zero
	end

	local invisible = GetState("identity.invisible", false)
	self.CharacterVisualAccumulator=self.CharacterVisualAccumulator+dt

	if self.CharacterVisualAccumulator>=0.1 then
		self.CharacterVisualAccumulator=0

		for _, descendant in ipairs(character:GetDescendants()) do
			if descendant:IsA("BasePart") then
				self:RememberPartBaseline(descendant)
				local partBaseline=self.CharacterBaseline and self.CharacterBaseline.Parts[descendant]

				if noclipEnabled then
					descendant.CanCollide=false
				elseif partBaseline then
					descendant.CanCollide=partBaseline.CanCollide
				end

				if descendant.Name ~= "HumanoidRootPart" then
					descendant.LocalTransparencyModifier = invisible and 0.78 or (partBaseline and partBaseline.LocalTransparencyModifier or 0)
				end
			end
		end
	end

	if GetState("identity.hideName", false) then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	else
		humanoid.DisplayDistanceType = baseline and baseline.DisplayDistanceType or Enum.HumanoidDisplayDistanceType.Viewer
	end

	if GetState("identity.snap", false) then
		local target = self:GetBestTarget("aim")

		if target then
			local targetRoot = target:FindFirstChild("HumanoidRootPart")

			if targetRoot then
				local look = Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z)
				root.CFrame = CFrame.lookAt(root.Position, look)
			end
		end
	elseif GetState("identity.antiAim", false) then
		local amount = GetState("identity.antiAimAmount", 50)
		root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(amount * dt * 4), 0)
	end

	if not self:AnyEnabled({
		"player.speed","player.noSlow","player.superJump","player.fly","player.noclip",
		"player.antiKill","player.antiDeath","player.antiRagdoll","player.antiVoid",
		"identity.invisible","identity.hideName","identity.snap","identity.antiAim","melee.fists"
		}) then
		self.PlayerCleanupPending=false
	end
end

function Runtime:UpdateStamina(dt)
	local folder = LocalPlayer:FindFirstChild("BlockSpinPrototypeData")

	if not folder then
		return
	end

	local stamina = folder:FindFirstChild("Stamina")

	if not stamina then
		stamina = Instance.new("NumberValue")
		stamina.Name = "Stamina"
		stamina.Value = 100
		stamina.Parent = folder
	end

	if GetState("player.stamina", false) then
		stamina.Value = 100
		return
	end

	local humanoid = GetHumanoid()
	local sprinting = self:IsInputDown("LeftShift") and humanoid and humanoid.MoveDirection.Magnitude > 0

	if sprinting then
		stamina.Value = math.max(0, stamina.Value - 20 * dt)
	else
		stamina.Value = math.min(100, stamina.Value + 12 * dt)
	end
end

function Runtime:UpdateWorld(dt)
	if GetState("world.fullbright", false) then
		Lighting.Brightness = 3
		Lighting.Ambient = Color3.fromRGB(180, 180, 180)
		Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
	else
		Lighting.Brightness = Prototype.LightingBackup.Brightness
		Lighting.Ambient = Prototype.LightingBackup.Ambient
		Lighting.OutdoorAmbient = Prototype.LightingBackup.OutdoorAmbient
	end

	if GetState("world.noFog", false) then
		Lighting.FogEnd = 100000
	else
		Lighting.FogEnd = Prototype.LightingBackup.FogEnd
	end

	Lighting.GlobalShadows = GetState("world.noShadows", false) and false or Prototype.LightingBackup.GlobalShadows

	if GetState("world.customTime", false) then
		Lighting.ClockTime = GetState("world.time", 14)
	else
		Lighting.ClockTime = Prototype.LightingBackup.ClockTime
	end

	if GetState("world.customGravity", false) then
		Workspace.Gravity = GetState("world.gravity", 196)
	else
		Workspace.Gravity = Prototype.LightingBackup.Gravity
	end

	local reduce = GetState("world.disableParticles", false)
		or GetState("world.fpsBoost", false)
		or GetState("misc.disableParticles", false)
		or GetState("misc.fpsBoost", false)
		or GetState("misc.reduceEffects", false)
		or GetState("misc.hideOtherEffects", false)

	self.WorldEffectsAccumulator=self.WorldEffectsAccumulator+(dt or 0)

	if Prototype.Folder and self.WorldEffectsAccumulator>=0.25 then
		self.WorldEffectsAccumulator=0
		local fpsBoost=GetState("world.fpsBoost", false) or GetState("misc.fpsBoost", false)

		for _, descendant in ipairs(Prototype.Folder:GetDescendants()) do
			if descendant:IsA("ParticleEmitter") or descendant:IsA("Trail") then
				if Prototype.EffectEnabledBackup[descendant]==nil then
					Prototype.EffectEnabledBackup[descendant]=descendant.Enabled
				end
				descendant.Enabled = reduce and false or Prototype.EffectEnabledBackup[descendant]
			end

			if descendant:IsA("BasePart") and descendant:GetAttribute("PrototypeFloor") ~= true then
				if Prototype.MaterialBackup[descendant]==nil then
					Prototype.MaterialBackup[descendant]=descendant.Material
				end

				if fpsBoost then
					if descendant.Material ~= Enum.Material.Neon then
						descendant.Material = Enum.Material.SmoothPlastic
					end
				else
					descendant.Material=Prototype.MaterialBackup[descendant]
				end
			end
		end
	end
end

function Runtime:MakeScreenLine(name, color)
	if not RuntimeUI.CombatOverlay then
		return nil
	end

	local line = RuntimeUI.CombatOverlay:FindFirstChild(name)

	if line then
		return line
	end

	line = Instance.new("Frame")
	line.Name = name
	line.AnchorPoint = Vector2.new(0, 0.5)
	line.Size = UDim2.fromOffset(0, 1)
	line.BackgroundColor3 = color or Theme.Accent
	line.BorderSizePixel = 0
	line.Visible = false
	line.ZIndex = 20
	line.Parent = RuntimeUI.CombatOverlay

	return line
end

function Runtime:UpdateLine(line, fromPoint, toPoint, thickness, color)
	if not line then
		return
	end

	local delta = toPoint - fromPoint
	local distance = delta.Magnitude
	local angle = math.deg(math.atan2(delta.Y, delta.X))

	line.Position = UDim2.fromOffset(fromPoint.X, fromPoint.Y)
	line.Size = UDim2.fromOffset(distance, thickness or 1)
	line.Rotation = angle
	line.BackgroundColor3 = color or Theme.Accent
	line.Visible = true
end


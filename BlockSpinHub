    if string.sub(flag, 1, 3) == "tp." then
        local location = LocalWorld:GetLocationByAction(flag)
        local success = self:TeleportTo(location)
        return success, success and "Teleported to the runtime location." or "Location was not found.", success and "success" or "warning"
    end

    if flag == "diag.runtime" then
        local activeErrors=0
        for _,errorState in pairs(self.SystemErrors) do
            if (errorState.Count or 0)>0 or (errorState.DisabledUntil or 0)>os.clock() then activeErrors=activeErrors+1 end
        end
        local message=string.format(
            "builtPages=%d/%d themeBindings=%d accentBindings=%d atmHacks=%d watchdogTrips=%d activeErrorBackoffs=%d",
            BuiltPageCount,
            (function() local n=0 for _ in pairs(Pages) do n=n+1 end return n end)(),
            #ThemeBindings,#AccentBindings,
            self.ATMSession and self.ATMSession.Hacks or 0,
            self.ATMSession and self.ATMSession.WatchdogTrips or 0,
            activeErrors
        )
        print("[BlockSpin V19 Diagnostics] "..message)
        return true,message,"success"
    end

    if flag == "diag.atmStress" then
        local passed,recovered,failed=0,0,0
        local atmCount=LocalWorld.ATMs and #LocalWorld.ATMs:GetChildren() or 0
        local baseVehicle=self:IsFarmVehicleReady()
        local servicesReady=(LocalWorld.Bank and LocalWorld.Bank.Parent~=nil and LocalWorld.ToolShop and LocalWorld.ToolShop.Parent~=nil)
        local routePolicy=GetState("atm.route","Nearest")
        local validPolicy=routePolicy=="Nearest" or routePolicy=="Safest" or routePolicy=="Highest Value"

        for index=1,100 do
            local scenario=index%5
            local ok=atmCount>=5 and servicesReady and validPolicy
            local didRecover=false

            if scenario==0 then
                -- Missing vehicle: should be recoverable only with automatic vehicle recovery.
                ok=ok and GetState("atm.autoVehicle",true) and GetState("atm.autoRecoverVehicle",true)
                didRecover=ok
            elseif scenario==1 then
                -- No tools: either existing cash can fund a restock or Auto Buy is enabled.
                ok=ok and (GetState("atm.buyTools",false) or LocalWorld.Data.Cash>=180)
                didRecover=ok
            elseif scenario==2 then
                -- Route stall: requires bounded retry/recovery settings.
                ok=ok and GetState("atm.autoRecoverVehicle",true) and GetState("atm.vehicleRetries",3)>=1
                didRecover=ok
            elseif scenario==3 then
                -- ATM cooldown: needs another target or skip-unavailable behavior.
                ok=ok and (atmCount>1 or GetState("atm.skipUnavailable",true))
                didRecover=ok
            else
                -- Normal path validates the base vehicle and target/service graph.
                ok=ok and baseVehicle
            end

            if ok then
                passed=passed+1
                if didRecover then recovered=recovered+1 end
            else
                failed=failed+1
            end
        end

        local message=string.format(
            "ATM runtime stress: %d/100 passed • %d recovery cases passed • %d failed",
            passed,recovered,failed
        )
        print("[BlockSpin V19 Diagnostics] "..message)
        return failed==0,message,failed==0 and "success" or "warning"
    end

    if flag == "diag.uiSmoke" then
        local buildFailures=0
        local controlFailures=0
        for pageId in pairs(Pages) do
            local ok,result=pcall(EnsurePageBuilt,pageId)
            if not ok or result~=true then
                buildFailures=buildFailures+1
                warn("[BlockSpin V19 UI Smoke] Failed page: "..tostring(pageId).." • "..tostring(result))
            end
        end
        for controlFlag,control in pairs(Controls) do
            if control and control.Type~="button" and control.Get and control.Set then
                local ok,current=pcall(control.Get)
                if ok then
                    local setOk=pcall(control.Set,current,true)
                    if not setOk then
                        controlFailures=controlFailures+1
                        warn("[BlockSpin V19 UI Smoke] Setter failed: "..tostring(controlFlag))
                    end
                else
                    controlFailures=controlFailures+1
                    warn("[BlockSpin V19 UI Smoke] Getter failed: "..tostring(controlFlag))
                end
            end
        end
        self:ApplyAllSettings()
        RefreshDependencies()
        local message=string.format("UI smoke: built=%d/%d • pageFailures=%d • controlFailures=%d",
            BuiltPageCount,(function() local n=0 for _ in pairs(Pages) do n=n+1 end return n end)(),buildFailures,controlFailures)
        print("[BlockSpin V19 Diagnostics] "..message)
        return buildFailures==0 and controlFailures==0,message,(buildFailures==0 and controlFailures==0) and "success" or "warning"
    end

    if flag == "diag.settings" then
        local failures={}
        local okApply=self:ApplyAllSettings()
        if not okApply then table.insert(failures,"apply") end

        local expectedScale=math.clamp((tonumber(State["ui.scale"]) or 130)/100,0.80,1.50)
        if math.abs((Config.Scale or 0)-expectedScale)>0.001 then table.insert(failures,"scale") end
        local expectedOpacity=math.clamp((tonumber(State["ui.opacity"]) or 100)/100,0.70,1)
        if math.abs((Config.Opacity or 0)-expectedOpacity)>0.001 then table.insert(failures,"opacity") end
        if Config.Animations~=(State["ui.animations"]==true) then table.insert(failures,"animations") end
        if Config.Tooltips~=(State["ui.tooltips"]==true) then table.insert(failures,"tooltips") end
        if Config.Effects~=(State["ui.effects"]==true) then table.insert(failures,"effects") end
        local menuKey=tostring(State["bind.menu"] or "RightShift")
        if Enum.KeyCode[menuKey] and Config.MenuKey~=Enum.KeyCode[menuKey] then table.insert(failures,"menuKey") end
        if MainGradient and MainGradient.Enabled~=(State["ui.effects"]==true) then table.insert(failures,"gradient") end
        if MenuBlur then
            local shouldBlur=State["ui.blur"]==true and Config.MenuVisible
            if shouldBlur and MenuBlur.Size<=0 then table.insert(failures,"blur") end
            if not shouldBlur and MenuBlur.Size>0 then table.insert(failures,"blurOff") end
        end

        local success=#failures==0
        local message=success and "Settings engine passed: live theme, scale, opacity, effects, blur and keybind state are synchronized."
            or ("Settings issues: "..table.concat(failures,", "))
        print("[BlockSpin V19 Settings] "..message)
        return success,message,success and "success" or "warning"
    end

    if flag == "diag.clearErrors" then
        self.SystemErrors={}
        return true,"Runtime subsystem error counters cleared.","success"
    end

    if flag == "about.status" then
        return true, "V19 settings engine runtime is active.", "success"
    end

    if flag == "about.version" then
        return true, "V19 Settings Engine / Adaptive Automation Build.", "success"
    end

    if flag == "about.unload" then
        self:Stop()
        LocalWorld:Clear()
        ClosePopup()
        HideTooltip()
        ActiveSliderDrag=nil
        CleanupUIConnections()
        ScreenGui:Destroy()
        return true, "", "success"
    end

    return true, "Action completed.", "success"
end

function Runtime:SetFeature(flag, value)
    self:ApplyUISetting(flag, value)

    if value==true and (string.sub(flag,1,7)=="weapon."
        or string.sub(flag,1,16)=="weaponCosmetics."
        or string.sub(flag,1,6)=="melee."
        or string.sub(flag,1,6)=="throw.") then
        LocalWorld:CreateTools()
    end

    -- Direct job toggles are mutually exclusive by default because the runtime
    -- executes one active job state machine at a time. Auto Switch deliberately
    -- allows a pool of enabled jobs.
    if value==true and GetState("jobs.singleJob",true) and not GetState("jobs.autoSwitch",false) then
        local isDirectJob=false
        for _,jobFlag in pairs(JobFlags) do
            if jobFlag==flag then isDirectJob=true break end
        end
        if isDirectJob then
            for _,jobFlag in pairs(JobFlags) do
                if jobFlag~=flag then SetControl(jobFlag,false,true) end
            end
            SetControl("jobs.loader",false,true)
        elseif flag=="jobs.loader" then
            for _,jobFlag in pairs(JobFlags) do SetControl(jobFlag,false,true) end
        end
    end

    if string.sub(flag,1,7)=="player." or string.sub(flag,1,9)=="identity." or flag=="melee.fists" then
        self.PlayerCleanupPending=true
        if flag=="player.noclip" or flag=="identity.invisible" then
            self.CharacterVisualAccumulator=1
        end
    end

    if string.sub(flag, 1, 7) == "hitbox." then
        self:UpdateHitboxes()
    end

    if flag == "identity.invisible" or flag == "identity.hideName" then
        self:UpdatePlayer(0)
    end

    if flag == "inventory.enabled" then
        self:UpdateInventoryOverlay(true)
    end

    if flag == "misc.fastPrompts" or flag == "misc.instantInteract" then
        self:UpdatePrompts()
    end

    if flag == "bind.list" then
        UpdateDeviceChrome()
    end

    if flag=="atm.enabled" then
        if value~=true then
            self:ResetATMSession("Disabled")
        else
            self.ATMSession.Phase="Select"
            self.ATMSession.Target=nil
            self.ATMSession.TargetKind=nil
            self:UpdateATMHUD("START","Checking vehicle and services","")
        end
    end

    if flag=="config.autoload" and value==true and not self.ProfileLoadInProgress then
        self:LoadProfile()
    end

    if flag=="jobs.smartNav" and value~=true then
        self:ResetNavigation()
    elseif flag=="jobs.routeBubbles" or flag=="jobs.destinationBeacon" or flag=="jobs.flowAnimation" then
        if self:GetRouteGuideContext() then self:RefreshRouteGuide() else self:HideRouteVisuals() end
    elseif flag=="atm.routeDots" or flag=="atm.destinationBeacon" or flag=="atm.routeFlow" then
        if self:GetRouteGuideContext() then self:RefreshRouteGuide() else self:HideRouteVisuals() end
    end

    return true
end

function Runtime:SetValue(flag, value)
    self:ApplyUISetting(flag, value)

    if flag == "hitbox.preset" then
        self:ApplyHitboxPreset(value)
    elseif string.sub(flag, 1, 7) == "hitbox." then
        self:UpdateHitboxes()
    end

    if flag == "inventory.targetMode" or string.sub(flag, 1, 10) == "inventory." then
        self:UpdateInventoryOverlay(true)
    end

    if flag == "config.slot" and State["config.autoload"]==true and not self.ProfileLoadInProgress then
        self:LoadProfile()
    end

    if flag == "misc.fastPrompts" or flag == "misc.instantInteract" then
        self:UpdatePrompts()
    end

    if flag == "vehicle.paint" or flag == "vehicle.finish" or flag == "vehicle.tint" then
        if GetState("vehicle.cosmetics", false) then
            self:ApplyVehicleCosmetics()
        end
    end

    if string.sub(flag,1,5)=="jobs." and self.Navigation.Owner then
        if flag=="jobs.bubbleSpacing" or flag=="jobs.pathMaxDots" then
            self:BuildRoutePoints()
        end
        self:RefreshRouteGuide()
    end

    if string.sub(flag,1,4)=="atm." then
        if flag=="atm.movement" then
            self.ATMSession.VehicleOwned=false
            self.ATMSession.VehicleWaypoints={}
            self.ATMSession.VehicleWaypointIndex=1
            self.ATMSession.VehicleGoal=nil
            self.ATMSession.RoutePoints={}
            self.ATMSession.RoutePointIndex=1
            if self.Navigation.Owner=="ATM" then self:ResetNavigation("ATM") end
            self:HideRouteVisuals()
            if GetState("atm.enabled",false) then self:SetATMPhase("Select",nil,nil,os.clock()) end
        end
        if flag=="atm.routeDotSpacing" or flag=="atm.routeMaxDots" then
            if self.ATMSession and self.ATMSession.VehicleGoal then self:BuildATMRoutePoints() end
        end
        if flag=="atm.routeDotSpacing" or flag=="atm.routeMaxDots" or flag=="atm.routeDotSize" or flag=="atm.routeColor" then
            if self:GetRouteGuideContext() then self:RefreshRouteGuide() end
        end
    end

    return true
end


function Runtime:SafeCall(name, method, ...)
	local state=self.SystemErrors[name]

	if not state then
		state={Count=0,LastWarn=0,DisabledUntil=0}
		self.SystemErrors[name]=state
	end

	local now=os.clock()

	if now < state.DisabledUntil then
		return false
	end

	local ok,err=pcall(method,self,...)

	if ok then
		state.Count=0
		return true
	end

	state.Count=state.Count+1

	if now-state.LastWarn>=4 then
		warn("[BlockSpin V14 "..name.."] "..tostring(err))
		state.LastWarn=now
	end

	if state.Count>=4 then
		state.Count=0
		state.DisabledUntil=now+2
	end

	return false
end

function Runtime:AnyEnabled(flags)
	for _,flag in ipairs(flags) do
		if GetState(flag,false)==true then return true end
	end
	return false
end

function Runtime:PlayerNeedsFrameUpdate()
	return self:AnyEnabled({
		"player.speed","player.noSlow","player.superJump","player.fly","player.noclip",
		"player.antiKill","player.antiDeath","player.antiRagdoll","player.antiVoid",
		"identity.invisible","identity.hideName","identity.snap","identity.antiAim","melee.fists"
	}) or self.PlayerCleanupPending==true
end

function Runtime:VehicleNeedsFrameUpdate()
	return GetState("atm.enabled",false)
		or self:AnyEnabled({"vehicle.mods","vehicle.autoLock","vehicle.autoRepair","vehicle.cosmetics"})
		or (Prototype.Car and Prototype.Car:GetAttribute("Locked")==true)
		or (Prototype.CarSeat and GetHumanoid() and Prototype.CarSeat.Occupant==GetHumanoid())
end

function Runtime:UpdateRender(dt)
	local now=os.clock()

	if GetState("aim.enabled",false) then
		self:SafeCall("Aim",self.UpdateAim,dt)
	elseif self.CurrentAimTarget then
		self.CurrentAimTarget=nil
	end

	local aimVisualsActive=GetState("aim.snapline",false) or GetState("aim.targetHighlight",false)
		or GetState("silent.drawTarget",false) or (GetState("esp.enabled",false) and GetState("esp.chams",false))
	if aimVisualsActive or self.AimVisualsWasActive then
		self:SafeCall("AimVisuals",self.UpdateAimVisuals)
	end
	self.AimVisualsWasActive=aimVisualsActive

	if self:PlayerNeedsFrameUpdate() then
		self:SafeCall("Player",self.UpdatePlayer,dt)
	else
		self:SafeCall("PlayerBaseline",self.UpdatePlayerBaseline)
	end
	if self:VehicleNeedsFrameUpdate() then
		self:SafeCall("Vehicle",self.UpdateVehicle,dt)
	end
	self:SafeCall("RuntimeUI",self.UpdateRuntimeUI,dt)
	local routeGuideActive=self.Navigation.Owner~=nil
		and (GetState("jobs.routeBubbles",false) or GetState("jobs.destinationBeacon",false))
	if routeGuideActive then
		self.NavigationAccumulator=self.NavigationAccumulator+dt
		local guideHz=30
		if Config.PerformanceMode=="Performance" or Config.DeviceProfile=="Phone"
			or (Config.PerformanceMode=="Auto" and self.SmoothedFPS and self.SmoothedFPS<48) then
			guideHz=15
		end
		if self.NavigationAccumulator>=1/guideHz then
			self.NavigationAccumulator=0
			self:SafeCall("RouteGuide",self.AnimateRouteGuide,now)
		end
	else
		self.NavigationAccumulator=0
	end

	self.VisualAccumulator=self.VisualAccumulator+dt
	local visualCap=60
	if Config.PerformanceMode=="Performance" or Config.DeviceProfile=="Phone" then
		visualCap=30
	elseif Config.PerformanceMode=="Balanced" or Config.DeviceProfile=="Tablet" then
		visualCap=45
	elseif Config.PerformanceMode=="Auto" then
		visualCap=(self.SmoothedFPS and self.SmoothedFPS<50) and 30 or 45
	end
	local visualRate=1/math.clamp(GetState("misc.fpsTarget",120),20,visualCap)

	if self.VisualAccumulator>=visualRate then
		self.VisualAccumulator=0
		local espEnabled=GetState("esp.enabled",false)
		if espEnabled or self.ESPWasEnabled then self:SafeCall("ESP",self.UpdateESP) end
		self.ESPWasEnabled=espEnabled

		local itemESPEnabled=GetState("itemEsp.enabled",false)
		if itemESPEnabled or self.ItemESPWasEnabled then self:SafeCall("ItemESP",self.UpdateItemESP) end
		self.ItemESPWasEnabled=itemESPEnabled

		local atmESPEnabled=GetState("atm.esp",false)
		if atmESPEnabled or self.ATMESPWasEnabled then self:SafeCall("ATMESP",self.UpdateATMESP) end
		self.ATMESPWasEnabled=atmESPEnabled

		local routeEnabled=GetState("atm.routeLine",false)
		if routeEnabled then
			self:SafeCall("ATMRoute",self.UpdateATMRoutingLine)
		elseif self.ATMRouteWasEnabled and RuntimeUI.AimLine then
			RuntimeUI.AimLine.Visible=false
		end
		self.ATMRouteWasEnabled=routeEnabled
	end

	if self.WeaponEquipped
		and self.FullAutoHeld
		and (GetState("weapon.fullAuto",false) or GetState("weapon.rapidFire",false)) then
		self:FireWeapon(true)
	end
end

function Runtime:UpdateHeartbeat(dt)
	local now=os.clock()

	if GetState("server.autoRejoin",false) and (not Prototype.Folder or not Prototype.Folder.Parent) then
		Prototype:Init()
	end

	self.FastAccumulator=self.FastAccumulator+dt
	if self.FastAccumulator>=(1/30) then
		local fastDt=self.FastAccumulator
		self.FastAccumulator=0
		local prototypeData=LocalPlayer:FindFirstChild("BlockSpinPrototypeData")
		local staminaValue=prototypeData and prototypeData:FindFirstChild("Stamina")
		if GetState("player.stamina",false) or self:IsInputDown("LeftShift")
			or (staminaValue and staminaValue.Value<99.9) then
			self:SafeCall("Stamina",self.UpdateStamina,fastDt)
		end
		if GetState("melee.aura",false) then self:SafeCall("Melee",self.RunMeleeAura,now) end
		if GetState("throw.enabled",false) then self:SafeCall("Throwables",self.RunThrowableAura,now) end
		if GetState("trigger.enabled",false) or GetState("trigger.autoShoot",false) then
			self:SafeCall("Trigger",self.UpdateTrigger,now)
		end
		if GetState("atm.enabled",false) then
			self:SafeCall("ATM",self.RunATMFarm,now,fastDt)
		end
	end

	self.BackgroundAccumulator=self.BackgroundAccumulator+dt
	if self.BackgroundAccumulator>=0.1 then
		local backgroundDt=self.BackgroundAccumulator
		self.BackgroundAccumulator=0
		local worldActive=self:AnyEnabled({"world.fullbright","world.noFog","world.noShadows","world.customTime","world.customGravity","world.disableParticles","world.fpsBoost","misc.disableParticles","misc.fpsBoost","misc.reduceEffects","misc.hideOtherEffects"})
		if not worldActive and self.WorldWasActive then self.WorldEffectsAccumulator=1 end
		if worldActive or self.WorldWasActive then self:SafeCall("World",self.UpdateWorld,backgroundDt) end
		self.WorldWasActive=worldActive
		if GetState("inventory.enabled",false) then self:SafeCall("Inventory",self.UpdateInventoryOverlay,false) end
		if #self:GetActiveJobNames()>0 or self.JobSession.Name then self:SafeCall("Jobs",self.RunJobs,now) end
		if self:AnyEnabled({"rewards.claim","rewards.quests","rewards.minigames"}) then self:SafeCall("Rewards",self.RunRewards,now) end
		if not GetState("atm.enabled",false)
			and (self.ATMSession.Phase~="Idle" or self.CurrentATM~=nil) then
			self:SafeCall("ATM",self.RunATMFarm,now,backgroundDt)
		end
		if GetState("misc.autoPickup",false) then self:SafeCall("Pickup",self.RunAutoPickup,now) end
		if GetState("misc.silentRepair",false) then self:SafeCall("Crates",self.RepairCrates) end
	end
end

function Runtime:Update(dt)
	-- Compatibility helper for manual tests; live runtime uses split schedulers.
	self:UpdateRender(dt)
	self:UpdateHeartbeat(dt)
end

function Runtime:SelfTest()
	local report = {
		Controls = 0,
		MissingControls = 0,
		Targets = 0,
		ATMs = 0,
		Jobs = 0,
		Tools = 0,
		DuplicateFlags = 0,
		InvalidDefinitions = 0,
		ControlSmokeFailures = 0,
		DependencyLinks = 0,
		MissingDependencyFlags = 0,
		DependencyCycles = 0,
		ResponsiveScale = GetEffectiveScale(),
		UIOnScreen = true,
		SplitSchedulers = true,
		SmartNavigation = type(self.PlanNavigation)=="function" and type(self.StepNavigation)=="function",
		RouteGuide = type(self.RefreshRouteGuide)=="function",
		JobBlueprints = 0,
		RouteLeak = 0,
		ATMStateMachine = type(self.ResetATMSession)=="function"
			and type(self.StepATMVehicle)=="function"
			and type(self.MoveFarmToPosition)=="function",
		ATMVehicleReady = self:IsFarmVehicleReady(),
		DeviceProfile = Config.DeviceProfile,
		ThemeBindingCount = #ThemeBindings,
		AccentBindingCount = #AccentBindings,
		LazyPagesBuilt = BuiltPageCount,
		LazyPagesTotal = (function() local n=0 for _ in pairs(Pages) do n=n+1 end return n end)(),
	}

	local seenFlags = {}

	for _, pageDefinition in pairs(Manifest) do
		for _, subtabDefinition in pairs(pageDefinition.Subtabs) do
			for _, definition in ipairs(subtabDefinition.Features) do
				report.Controls = report.Controls + 1

				if seenFlags[definition.Flag] then
					report.DuplicateFlags=report.DuplicateFlags+1
					warn("[BlockSpin V14 SelfTest] Duplicate flag: "..tostring(definition.Flag))
				else
					seenFlags[definition.Flag]=true
				end

				if definition.Type=="slider" then
					if type(definition.Min)~="number" or type(definition.Max)~="number" or definition.Min>=definition.Max or definition.Default<definition.Min or definition.Default>definition.Max then
						report.InvalidDefinitions=report.InvalidDefinitions+1
						warn("[BlockSpin V14 SelfTest] Invalid slider: "..tostring(definition.Flag))
					end
				elseif definition.Type=="dropdown" then
					local found=false
					for _,option in ipairs(definition.Options or {}) do
						if option==definition.Default then found=true break end
					end
					if not found then
						report.InvalidDefinitions=report.InvalidDefinitions+1
						warn("[BlockSpin V14 SelfTest] Invalid dropdown default: "..tostring(definition.Flag))
					end
				end

				local control=Controls[definition.Flag]
				if not control then
					report.MissingControls = report.MissingControls + 1
					warn("[BlockSpin V14 SelfTest] Missing control: " .. tostring(definition.Flag))
				elseif control.Set and control.Get then
					local current=control.Get()
					local ok,err=pcall(function() control.Set(current,true) end)
					if not ok then
						report.ControlSmokeFailures=report.ControlSmokeFailures+1
						warn("[BlockSpin V14 SelfTest] Control smoke failure "..tostring(definition.Flag)..": "..tostring(err))
					end
				end
			end
		end
	end

	for jobName,blueprint in pairs(JobBlueprints) do
		if blueprint and blueprint.Steps and #blueprint.Steps>=3 and Prototype:GetJobMarker(jobName) then
			report.JobBlueprints=report.JobBlueprints+1
		end
	end

	if RuntimeUI.RouteFolder then
		for _,part in ipairs(RuntimeUI.RouteFolder:GetChildren()) do
			if part:IsA("BasePart") and part.Transparency<0.99 and not self.Navigation.Owner then
				report.RouteLeak=report.RouteLeak+1
			end
		end
	end

	report.Targets = Prototype.Targets and #Prototype.Targets:GetChildren() or 0
	report.ATMs = Prototype.ATMs and #Prototype.ATMs:GetChildren() or 0
	report.Jobs = Prototype.Jobs and #Prototype.Jobs:GetChildren() or 0

	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

	if backpack then
		for _, toolName in ipairs({"Prototype Pistol", "Prototype Fists", "Prototype Throwable"}) do
			if backpack:FindFirstChild(toolName) or (GetCharacter() and GetCharacter():FindFirstChild(toolName)) then
				report.Tools = report.Tools + 1
			end
		end
	end

	for childFlag,masterFlag in pairs(DependencyMaster) do
		report.DependencyLinks = report.DependencyLinks + 1

		if not Controls[childFlag] or not Controls[masterFlag] then
			report.MissingDependencyFlags = report.MissingDependencyFlags + 1
			warn("[BlockSpin V14 SelfTest] Missing dependency control: "..tostring(childFlag).." -> "..tostring(masterFlag))
		end
	end

	for childFlag in pairs(DependencyMaster) do
		local seen={}
		local cursor=childFlag

		while DependencyMaster[cursor] do
			if seen[cursor] then
				report.DependencyCycles=report.DependencyCycles+1
				warn("[BlockSpin V14 SelfTest] Dependency cycle detected at: "..tostring(childFlag))
				break
			end

			seen[cursor]=true
			cursor=DependencyMaster[cursor]
		end
	end

	report.EnabledPrototypeDebugBillboards=0
	report.VisiblePrototypeParts=0
	if Prototype.Folder then
		for _,descendant in ipairs(Prototype.Folder:GetDescendants()) do
			if descendant:IsA("BillboardGui")
				and descendant.Name=="PrototypeBillboard"
				and descendant.Enabled then

				report.EnabledPrototypeDebugBillboards+=1
			elseif descendant:IsA("BasePart")
				and descendant.LocalTransparencyModifier<0.99
				and descendant:GetAttribute("PrototypeFloor")~=true then

				report.VisiblePrototypeParts+=1
			end
		end
	end

	if not GetState("ui.testWorld",false) then
		if report.EnabledPrototypeDebugBillboards>0 then
			warn("[BlockSpin V14 SelfTest] Prototype debug labels are visible while test world is hidden.")
		end

		if report.VisiblePrototypeParts>0 then
			warn("[BlockSpin V14 SelfTest] Prototype parts are visible while clean mode is active.")
		end
	end

	local viewport=GetViewportSize()
	local effectiveScale=GetEffectiveScale()
	local absolutePosition=Main.AbsolutePosition
	local scaledWidth=WINDOW_WIDTH*effectiveScale
	local scaledHeight=(minimized and TOPBAR_HEIGHT or WINDOW_HEIGHT)*effectiveScale
	report.UIOnScreen=absolutePosition.X>=-2
		and absolutePosition.Y>=-2
		and absolutePosition.X+scaledWidth<=viewport.X+2
		and absolutePosition.Y+scaledHeight<=viewport.Y+2

	if not report.UIOnScreen then
		warn("[BlockSpin V14 SelfTest] UI bounds exceed current viewport.")
	end

	local success = report.MissingControls == 0
		and report.DuplicateFlags == 0
		and report.InvalidDefinitions == 0
		and report.ControlSmokeFailures == 0
		and report.MissingDependencyFlags == 0
		and report.DependencyCycles == 0
		and (GetState("ui.testWorld",false) == true
			or (report.EnabledPrototypeDebugBillboards == 0 and report.VisiblePrototypeParts == 0))
		and report.UIOnScreen == true
		and report.Targets >= 5
		and report.ATMs >= 5
		and report.Jobs >= 8
		and report.Tools >= 3
		and report.SmartNavigation == true
		and report.RouteGuide == true
		and report.JobBlueprints >= 8
		and report.RouteLeak == 0
		and report.ATMStateMachine == true
		and report.ATMVehicleReady == true

	if success then
		AdapterNotify(
			"Self-test passed",
			tostring(report.Controls) .. "/" .. tostring(report.Controls) .. " controls linked • "
				.. "0 duplicates • 0 invalid • 0 smoke failures • "
				.. tostring(report.Targets) .. " targets • "
				.. tostring(report.ATMs) .. " ATMs • "
				.. tostring(report.Jobs) .. " jobs.",
			"success"
		)
	else
		AdapterNotify(
			"Self-test warning",
			"Open Studio Output for the validation report.",
			"warning"
		)
	end

	print(
		"[BlockSpin V14 SelfTest] controls=" .. tostring(report.Controls)
			.. " missing=" .. tostring(report.MissingControls)
			.. " targets=" .. tostring(report.Targets)
			.. " atms=" .. tostring(report.ATMs)
			.. " jobs=" .. tostring(report.Jobs)
			.. " tools=" .. tostring(report.Tools)
			.. " duplicates=" .. tostring(report.DuplicateFlags)
			.. " invalid=" .. tostring(report.InvalidDefinitions)
			.. " smokeFailures=" .. tostring(report.ControlSmokeFailures)
			.. " dependencies=" .. tostring(report.DependencyLinks)
			.. " missingDeps=" .. tostring(report.MissingDependencyFlags)
			.. " dependencyCycles=" .. tostring(report.DependencyCycles)
			.. " debugLabels=" .. tostring(report.EnabledPrototypeDebugBillboards)
			.. " visibleTestParts=" .. tostring(report.VisiblePrototypeParts)
			.. " uiScale=" .. string.format("%.2f",report.ResponsiveScale)
			.. " uiOnScreen=" .. tostring(report.UIOnScreen)
			.. " splitSchedulers=" .. tostring(report.SplitSchedulers)
			.. " smartNav=" .. tostring(report.SmartNavigation)
			.. " routeGuide=" .. tostring(report.RouteGuide)
			.. " jobBlueprints=" .. tostring(report.JobBlueprints)
			.. " routeLeak=" .. tostring(report.RouteLeak)
			.. " atmStateMachine=" .. tostring(report.ATMStateMachine)
			.. " atmVehicleReady=" .. tostring(report.ATMVehicleReady)
			.. " device=" .. tostring(report.DeviceProfile)
			.. " themeBindings=" .. tostring(report.ThemeBindingCount)
			.. " accentBindings=" .. tostring(report.AccentBindingCount)
	)

	return success, report
end

function Runtime:Start()
	if self.Started then
		return
	end

	self.Started = true
	self.FastAccumulator=0
	self.BackgroundAccumulator=0
	self.VisualAccumulator=0
	self.NavigationAccumulator=0
	self.TriggerBurstToken=self.TriggerBurstToken+1
	self.HitmarkerToken=self.HitmarkerToken+1

	StatusMode.Text = "STARTING"
	StatusMode.TextColor3 = Theme.Success
	StatusDot.BackgroundColor3 = Theme.Success

	Prototype:Init()
	self:CreateRuntimeUI()
	self:UpdatePrompts()
	self:UpdateHitboxes()
	self:CaptureCharacterBaseline(true)

	TrackConnection(Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		Camera=Workspace.CurrentCamera
	end))

	TrackConnection(LocalPlayer.CharacterAdded:Connect(function(character)
		self.CharacterBaseline=nil
		self.CharacterBaselineCharacter=nil
		self.CurrentAimTarget=nil
		self.CurrentSilentTarget=nil
		self.WeaponEquipped=false
		self.FistsEquipped=false
		self.GrenadeEquipped=false
		self.FullAutoHeld=false

		task.delay(0.35,function()
			if not self.Started then return end
			self:CaptureCharacterBaseline(true)
			Prototype:CreateTools()
			self:UpdateHitboxes()
		end)
	end))

	TrackConnection(UserInputService.InputBegan:Connect(function(input, processed)
		self:OnInputBegan(input, processed)
	end))

	TrackConnection(UserInputService.InputEnded:Connect(function(input)
		self:OnInputEnded(input)
	end))

	TrackConnection(UserInputService.JumpRequest:Connect(function()
		self:OnJumpRequest()
	end))

	local lastRenderWarn=0
	TrackConnection(RunService.RenderStepped:Connect(function(dt)
		local success, err = pcall(function()
			self:UpdateRender(dt)
		end)

		if not success and os.clock()-lastRenderWarn>=4 then
			warn("[BlockSpin V14 Render] " .. tostring(err))
			lastRenderWarn=os.clock()
		end
	end))

	local lastHeartbeatWarn=0
	TrackConnection(RunService.Heartbeat:Connect(function(dt)
		local success, err = pcall(function()
			self:UpdateHeartbeat(dt)
		end)

		if not success and os.clock()-lastHeartbeatWarn>=4 then
			warn("[BlockSpin V14 Heartbeat] " .. tostring(err))
			lastHeartbeatWarn=os.clock()
		end
	end))

	TrackConnection(LocalPlayer.Idled:Connect(function()
		if GetState("player.antiAFK", false) then
			pcall(function()
				VirtualUser:CaptureController()
				VirtualUser:ClickButton2(Vector2.new(0, 0))
			end)
		end
	end))

	self:SelfTest()
	AdapterNotify("Runtime ready", "Runtime started with isolated subsystems and Studio prototype recovery.", "success")
end

function Runtime:Stop()
	for _, connection in ipairs(self.Connections) do
		SafeDisconnect(connection)
	end

	self.Connections = {}
	self.Started = false
	self.ReloadToken=self.ReloadToken+1
	self.SpectateToken=self.SpectateToken+1
	self.TriggerBurstToken=self.TriggerBurstToken+1
	self.HitmarkerToken=self.HitmarkerToken+1
	self.Reloading=false
	self.FullAutoHeld=false
	self.ProfileLoadInProgress=false
	self.FastAccumulator=0
	self.BackgroundAccumulator=0
	self.VisualAccumulator=0
	self.NavigationAccumulator=0
	self.CharacterVisualAccumulator=0
	ActiveSliderDrag=nil

	if RuntimeUI.Blur then
		RuntimeUI.Blur:Destroy()
		RuntimeUI.Blur = nil
	end

	if RuntimeUI.CombatOverlay then
		RuntimeUI.CombatOverlay:Destroy()
		RuntimeUI.CombatOverlay = nil
	end

	if RuntimeUI.InventoryOverlay then
		RuntimeUI.InventoryOverlay:Destroy()
		RuntimeUI.InventoryOverlay = nil
	end

	if RuntimeUI.PrototypeStatus then
		RuntimeUI.PrototypeStatus:Destroy()
		RuntimeUI.PrototypeStatus = nil
	end

	if RuntimeUI.JobHUD then
		RuntimeUI.JobHUD:Destroy()
		RuntimeUI.JobHUD=nil
		RuntimeUI.JobHUDTitle=nil
		RuntimeUI.JobHUDTask=nil
		RuntimeUI.JobHUDProgress=nil
	end

	if RuntimeUI.ATMHUD then
		RuntimeUI.ATMHUD:Destroy()
		RuntimeUI.ATMHUD=nil
		RuntimeUI.ATMHUDTitle=nil
		RuntimeUI.ATMHUDTask=nil
		RuntimeUI.ATMHUDProgress=nil
	end

	self:ResetNavigation()
	if RuntimeUI.RouteFolder then
		RuntimeUI.RouteFolder:Destroy()
		RuntimeUI.RouteFolder=nil
		RuntimeUI.RouteDots={}
		RuntimeUI.DestinationBeacon=nil
		RuntimeUI.DestinationBillboard=nil
		RuntimeUI.DestinationText=nil
	end
	self:ResetJobSession("Stopped")
	self:ResetATMSession("Stopped")

	self:ResetWorldSettings()
	self:RestoreCharacterBaseline()

	local humanoid=GetHumanoid()
	if Camera and humanoid then
		Camera.CameraSubject=humanoid
	end

	if KeybindPanel then
		KeybindPanel.Visible=false
	end
end


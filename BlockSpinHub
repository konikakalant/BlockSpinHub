-- V14 lazy control registry -------------------------------------------------
-- Every feature gets a lightweight state/control stub immediately so runtime,
-- profiles, keybinds and dependency checks work before its visual page exists.
-- The heavy GuiObjects are created only when the page is opened.
for pageId,pageDef in pairs(Manifest) do
	local page=AddPage(pageId,pageDef.Subtitle)
	page.Built=false
	page.Definition=pageDef

	for _,subtabDef in pairs(pageDef.Subtabs) do
		for _,definition in ipairs(subtabDef.Features) do
			ControlDefinitions[definition.Flag]=definition
			if definition.Default~=nil and State[definition.Flag]==nil then
				State[definition.Flag]=definition.Default
			end

			if not Controls[definition.Flag] then
				local flag=definition.Flag
				local controlType=definition.Type
				local stub={Type=controlType,Root=nil,Lazy=true}
				if controlType~="button" then
					local definitionRef=definition
					stub.Get=function() return State[flag] end
					stub.Set=function(value,silent)
						if controlType=="toggle" then
							value=value==true
						elseif controlType=="slider" then
							value=math.clamp(tonumber(value) or definitionRef.Default,definitionRef.Min,definitionRef.Max)
							local step=math.max(tonumber(definitionRef.Step) or 1,0.000001)
							value=math.floor((value/step)+0.5)*step
							if step<1 then value=math.floor(value*1000+0.5)/1000 else value=math.floor(value+0.5) end
							value=math.clamp(value,definitionRef.Min,definitionRef.Max)
						elseif controlType=="dropdown" then
							local valid=false
							for _,option in ipairs(definitionRef.Options or {}) do
								if option==value then valid=true break end
							end
							if not valid then value=definitionRef.Default end
						elseif controlType=="keybind" then
							value=tostring(value or definitionRef.Default)
						end

						State[flag]=value
						if not silent then
							if controlType=="toggle" then
								GameplayAdapter:SetFeature(flag,value==true)
							else
								GameplayAdapter:SetValue(flag,value)
							end
						end
						RefreshDependencies(flag)
					end
				end
				Controls[flag]=stub
			end
		end
	end
end

EnsurePageBuilt=function(pageId)
	local page=Pages[pageId]
	if not page then return false end
	if page.Built then return true end

	local pageDef=page.Definition or Manifest[pageId]
	if not pageDef then return false end

	local ids={}
	for id in pairs(pageDef.Subtabs) do table.insert(ids,id) end
	table.sort(ids,function(a,b) return pageDef.Subtabs[a].Order<pageDef.Subtabs[b].Order end)

	for _,subtabId in ipairs(ids) do
		local sd=pageDef.Subtabs[subtabId]
		local sub=AddSubtab(page,subtabId,sd.Order)
		local count=#sd.Features
		local oneColumn=Config.DeviceProfile=="Phone"
		local split=oneColumn and count or math.ceil(count/2)
		local left=AddSection(page,sub,"left",subtabId)
		local right=(not oneColumn and count>split) and AddSection(page,sub,"right","OPTIONS") or nil
		if oneColumn then
			sub.Left.Size=UDim2.new(1,-2,1,0)
			sub.Right.Visible=false
		end
		for index,d in ipairs(sd.Features) do
			BuildControl(page,(index<=split or not right) and left or right,d)
		end
	end

	page.Built=true
	BuiltPageCount=BuiltPageCount+1

	if State["ui.compact"]==true then
		for _,control in pairs(Controls) do
			if control.Root and control.Root:IsDescendantOf(page.Root) and control.Type~="slider" then
				control.Root.Size=UDim2.new(1,0,0,29)
			end
		end
	end

	RefreshDependencies()
	return true
end


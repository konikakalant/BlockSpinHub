local function RouteGroundPosition(position)
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    local exclude={}
    local character=GetCharacter()
    if character then table.insert(exclude,character) end
    if RuntimeUI.RouteFolder then table.insert(exclude,RuntimeUI.RouteFolder) end
    params.FilterDescendantsInstances=exclude
    local hit=Workspace:Raycast(position+Vector3.new(0,7,0),Vector3.new(0,-18,0),params)
    if hit then
        return hit.Position+Vector3.new(0,0.18,0)
    end
    return position-Vector3.new(0,2.6,0)
end

local function SampleRoutePolyline(startPosition, points, spacing, maxDots, extractor)
    local result={}
    if not startPosition or not points or #points==0 then return result end

    spacing=math.max(1,spacing or 6)
    maxDots=math.max(1,maxDots or 24)
    local previous=startPosition
    local distanceSinceDot=0

    for index=1,#points do
        local target=extractor and extractor(points[index]) or points[index]
        if target then
            local segment=target-previous
            local segmentLength=segment.Magnitude
            if segmentLength>0.05 then
                local direction=segment.Unit
                local cursor=spacing-distanceSinceDot
                while cursor<=segmentLength+0.0001 and #result<maxDots do
                    table.insert(result,RouteGroundPosition(previous+direction*cursor))
                    cursor=cursor+spacing
                end
                distanceSinceDot=(distanceSinceDot+segmentLength)%spacing
            end
            previous=target
        end
        if #result>=maxDots then break end
    end

    return result
end

function Runtime:BuildRoutePoints()
    local nav=self.Navigation
    nav.RoutePoints={}
    nav.RoutePointIndex=1
    local root=GetRoot()
    if not root or #nav.Waypoints==0 then return end

    local isATM=nav.Owner=="ATM"
    local spacing=isATM and math.max(3,GetState("atm.routeDotSpacing",6))
        or math.max(3,GetState("jobs.bubbleSpacing",7))
    local maxDots=isATM and math.floor(math.clamp(GetState("atm.routeMaxDots",30),8,48))
        or math.floor(math.clamp(GetState("jobs.pathMaxDots",24),8,36))

    local pending={}
    for index=nav.WaypointIndex,#nav.Waypoints do
        table.insert(pending,nav.Waypoints[index])
    end
    nav.RoutePoints=SampleRoutePolyline(root.Position,pending,spacing,maxDots,function(waypoint)
        return waypoint and waypoint.Position or nil
    end)

    -- Pathfinding commonly returns waypoints roughly 4 studs apart while route-dot
    -- spacing may be 6-7 studs. Sampling across the WHOLE polyline instead of
    -- restarting the spacing counter for every short segment prevents the old
    -- "only one bubble" bug.
    if #nav.RoutePoints==0 and nav.GoalPosition then
        table.insert(nav.RoutePoints,RouteGroundPosition(nav.GoalPosition))
    end
end

function Runtime:BuildATMRoutePoints()
    local session=self.ATMSession
    session.RoutePoints={}
    session.RoutePointIndex=1

    local body=LocalWorld.CarBody
    if not body or not body.Parent or #session.VehicleWaypoints==0 then return end

    local spacing=math.max(3,GetState("atm.routeDotSpacing",6))
    local maxDots=math.floor(math.clamp(GetState("atm.routeMaxDots",30),8,48))
    local pending={}
    for index=session.VehicleWaypointIndex,#session.VehicleWaypoints do
        table.insert(pending,session.VehicleWaypoints[index])
    end
    session.RoutePoints=SampleRoutePolyline(body.Position,pending,spacing,maxDots,function(point)
        return point
    end)

    if #session.RoutePoints==0 and session.VehicleGoal then
        table.insert(session.RoutePoints,RouteGroundPosition(session.VehicleGoal))
    end
end

function Runtime:GetRouteGuideContext()
    local s=self.ATMSession
    local atmEnabled=GetState("atm.enabled",false)
    local vehicleRoute=atmEnabled
        and GetState("atm.movement","Vehicle")=="Vehicle"
        and s and s.VehicleGoal~=nil
        and (#s.RoutePoints>0 or #s.VehicleWaypoints>0)

    if vehicleRoute then
        return {
            Owner="ATM",
            Points=s.RoutePoints,
            StartIndex=s.RoutePointIndex or 1,
            Goal=s.VehicleGoal,
            TargetName=s.VehicleTargetName or (s.Target and s.Target.Name) or "ATM route",
            ShowDots=GetState("atm.routeDots",true),
            ShowBeacon=GetState("atm.destinationBeacon",true),
            Flow=GetState("atm.routeFlow",true),
            MaxDots=math.floor(math.clamp(GetState("atm.routeMaxDots",30),8,48)),
            DotSize=math.clamp(GetState("atm.routeDotSize",0.55),0.3,0.9),
            Color=GetATMRouteColor(),
            Origin=LocalWorld.CarBody,
        }
    end

    local nav=self.Navigation
    if not nav or not nav.Owner or not nav.GoalPosition then return nil end
    local isATM=nav.Owner=="ATM"
    return {
        Owner=nav.Owner,
        Points=nav.RoutePoints,
        StartIndex=nav.RoutePointIndex or 1,
        Goal=nav.GoalPosition,
        TargetName=nav.TargetName or "Destination",
        ShowDots=isATM and GetState("atm.routeDots",true) or GetState("jobs.routeBubbles",true),
        ShowBeacon=isATM and GetState("atm.destinationBeacon",true) or GetState("jobs.destinationBeacon",true),
        Flow=isATM and GetState("atm.routeFlow",true) or GetState("jobs.flowAnimation",true),
        MaxDots=isATM and math.floor(math.clamp(GetState("atm.routeMaxDots",30),8,48))
            or math.floor(math.clamp(GetState("jobs.pathMaxDots",24),8,36)),
        DotSize=isATM and math.clamp(GetState("atm.routeDotSize",0.55),0.3,0.9) or 0.42,
        Color=isATM and GetATMRouteColor() or Theme.Accent,
        Origin=GetRoot(),
    }
end

function Runtime:RefreshRouteGuide()
    local context=self:GetRouteGuideContext()
    if not context or (not context.ShowDots and not context.ShowBeacon) then
        self:HideRouteVisuals()
        return
    end

    self:EnsureRouteVisuals()
    local points=context.Points or {}
    local startIndex=math.max(1,context.StartIndex or 1)
    local color=context.Color or Theme.Accent
    local baseSize=context.DotSize or 0.45
    if RuntimeUI.DestinationBackground then RuntimeUI.DestinationBackground.BackgroundColor3=Theme.Popup end
    if RuntimeUI.DestinationText then RuntimeUI.DestinationText.TextColor3=Theme.Text end

    for displayIndex,dot in ipairs(RuntimeUI.RouteDots) do
        local point=points[startIndex+displayIndex-1]
        if context.ShowDots and displayIndex<=context.MaxDots and point then
            dot.Position=point
            dot.Color=color
            dot.Size=Vector3.new(baseSize,baseSize,baseSize)
            dot.Transparency=0.10
        else
            dot.Transparency=1
        end
    end

    local beacon=RuntimeUI.DestinationBeacon
    local billboard=RuntimeUI.DestinationBillboard
    if beacon and context.Goal and context.ShowBeacon then
        beacon.Position=RouteGroundPosition(context.Goal)+Vector3.new(0,0.32,0)
        beacon.Color=color
        beacon.Transparency=0.08
        if RuntimeUI.DestinationStroke then RuntimeUI.DestinationStroke.Color=color end
        if billboard then billboard.Enabled=true end
    elseif beacon then
        beacon.Transparency=1
        if billboard then billboard.Enabled=false end
    end
end

function Runtime:AnimateRouteGuide(now)
    local context=self:GetRouteGuideContext()
    if not context then
        self:HideRouteVisuals()
        return
    end

    -- Progressively retire vehicle dots as the car passes them. This gives the
    -- same readable "where I am going" trail as the reference screenshot.
    if context.Owner=="ATM" and GetState("atm.movement","Vehicle")=="Vehicle" then
        local s=self.ATMSession
        local body=LocalWorld.CarBody
        local spacing=math.max(3,GetState("atm.routeDotSpacing",6))
        if body and body.Parent then
            local index=math.max(1,s.RoutePointIndex or 1)
            while index<=#s.RoutePoints do
                local point=s.RoutePoints[index]
                local offset=point-body.Position
                local distance=offset.Magnitude
                local passed=false
                if distance<=math.max(2.4,spacing*0.65) then
                    passed=true
                elseif distance>0.05 and distance<=spacing*2.2 then
                    local flatForward=Vector3.new(body.CFrame.LookVector.X,0,body.CFrame.LookVector.Z)
                    local flatOffset=Vector3.new(offset.X,0,offset.Z)
                    if flatForward.Magnitude>0.01 and flatOffset.Magnitude>0.01 then
                        passed=flatForward.Unit:Dot(flatOffset.Unit)<-0.25
                    end
                end
                if not passed then break end
                index=index+1
            end
            s.RoutePointIndex=index
        end
    else
        -- Walking/job routes also retire dots that the player has already passed.
        -- This keeps the guide readable and avoids leaving markers behind the player.
        local nav=self.Navigation
        local root=GetRoot()
        local points=nav and nav.RoutePoints or nil
        local spacing=context.Owner=="ATM" and math.max(3,GetState("atm.routeDotSpacing",6))
            or math.max(3,GetState("jobs.bubbleSpacing",7))
        if root and points then
            local index=math.max(1,nav.RoutePointIndex or 1)
            while index<=#points do
                local point=points[index]
                local offset=point-root.Position
                local distance=offset.Magnitude
                local passed=distance<=math.max(2.2,spacing*0.60)
                if not passed and distance>0.05 and distance<=spacing*2.0 then
                    local flatForward=Vector3.new(root.CFrame.LookVector.X,0,root.CFrame.LookVector.Z)
                    local flatOffset=Vector3.new(offset.X,0,offset.Z)
                    if flatForward.Magnitude>0.01 and flatOffset.Magnitude>0.01 then
                        passed=flatForward.Unit:Dot(flatOffset.Unit)<-0.30
                    end
                end
                if not passed then break end
                index=index+1
            end
            nav.RoutePointIndex=index
        end
    end

    self:RefreshRouteGuide()
    context=self:GetRouteGuideContext()
    if not context then return end

    local origin=context.Origin
    local flow=context.Flow
    local baseSize=context.DotSize or 0.45
    for index,dot in ipairs(RuntimeUI.RouteDots or {}) do
        if dot and dot.Parent and dot.Transparency<1 then
            local pulse=flow and (0.5+0.5*math.sin(now*5-index*0.65)) or 0.5
            local near=origin and GetDistance(origin.Position,dot.Position)<2.0
            dot.Size=Vector3.new(baseSize,baseSize,baseSize)*(1+pulse*0.28)
            dot.Transparency=near and 0.72 or (0.08+pulse*0.16)
        end
    end

    local beacon=RuntimeUI.DestinationBeacon
    if beacon and beacon.Transparency<1 then
        local pulse=0.5+0.5*math.sin(now*4)
        beacon.Size=Vector3.new(0.74,0.74,0.74)*(1+pulse*0.22)
        local distance=origin and context.Goal and GetDistance(origin.Position,context.Goal) or 0
        if RuntimeUI.DestinationText then
            RuntimeUI.DestinationText.Text=string.format("%s  •  %.0f studs",context.TargetName or "Destination",distance)
        end
    end
end

function Runtime:PlanNavigation(owner,goalPosition,targetName,force)
    local root=GetRoot()
    local nav=self.Navigation
    if not root or not goalPosition then return false end

    local now=os.clock()
    local sameGoal=nav.GoalPosition and GetDistance(nav.GoalPosition,goalPosition)<1.5
    local recompute=owner=="ATM" and math.max(0.5,GetState("atm.vehicleReplan",1.5))
        or math.max(0.5,GetState("jobs.recompute",1.5))
    if not force and nav.Owner==owner and sameGoal and not nav.Dirty and #nav.Waypoints>0 then
        return true
    end
    if not force and now-nav.LastPlanAt<recompute and nav.Owner==owner and sameGoal then
        return #nav.Waypoints>0
    end

    DisconnectNavigationPath()
    nav.Owner=owner
    nav.TargetName=targetName or owner
    nav.GoalPosition=goalPosition
    nav.LastPlanAt=now
    nav.Dirty=false
    nav.PlanToken=nav.PlanToken+1

    local function computePath(radius)
        local candidate=PathfindingService:CreatePath({
            AgentRadius=radius,
            AgentHeight=5,
            AgentCanJump=true,
            AgentCanClimb=true,
            WaypointSpacing=3,
        })
        local ok=pcall(function()
            candidate:ComputeAsync(root.Position,goalPosition)
        end)
        if ok and candidate.Status==Enum.PathStatus.Success then
            return candidate
        end
        return nil
    end

    -- Start with extra wall clearance. If Roblox cannot solve the route, retry once
    -- with a narrower agent rather than immediately walking straight through walls.
    local radius=(nav.RecoveryStage or 0)>0 and 2.0 or 2.6
    local path=computePath(radius) or computePath(1.7)

    if path then
        nav.Path=path
        nav.Waypoints=path:GetWaypoints()
        nav.WaypointIndex=math.min(2,math.max(1,#nav.Waypoints))
        nav.BlockedConnection=path.Blocked:Connect(function(blockedIndex)
            if blockedIndex>=nav.WaypointIndex then
                nav.Dirty=true
            end
        end)
    else
        nav.Path=nil
        nav.Waypoints={}
        nav.WaypointIndex=1
    end

    nav.LastProgressAt=now
    nav.LastWaypointDistance=math.huge
    nav.StuckCount=0
    self:BuildRoutePoints()
    self:RefreshRouteGuide()
    return #nav.Waypoints>0
end

local function NavigationRaycast(origin, direction)
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    local exclude={}
    local character=GetCharacter()
    if character then table.insert(exclude,character) end
    if RuntimeUI.RouteFolder then table.insert(exclude,RuntimeUI.RouteFolder) end
    if LocalWorld.Folder then table.insert(exclude,LocalWorld.Folder) end
    params.FilterDescendantsInstances=exclude
    return Workspace:Raycast(origin,direction,params)
end

function Runtime:BeginObstacleRecovery(goalPosition, waypointPosition)
    local nav=self.Navigation
    local root=GetRoot()
    local humanoid=GetHumanoid()
    if not root or not humanoid then return false end

    nav.RecoveryStage=math.min((nav.RecoveryStage or 0)+1,3)
    nav.LastObstacleAt=os.clock()
    humanoid.Jump=true

    local forward=waypointPosition-root.Position
    forward=Vector3.new(forward.X,0,forward.Z)
    if forward.Magnitude<0.1 then
        forward=Vector3.new(root.CFrame.LookVector.X,0,root.CFrame.LookVector.Z)
    end
    if forward.Magnitude<0.1 then forward=Vector3.new(0,0,-1) end
    forward=forward.Unit
    local right=Vector3.new(-forward.Z,0,forward.X)
    local origin=root.Position+Vector3.new(0,2,0)

    local leftHit=NavigationRaycast(origin,-right*4)
    local rightHit=NavigationRaycast(origin,right*4)
    local side
    if not rightHit then side=right elseif not leftHit then side=-right end

    if side then
        nav.RecoveryTarget=root.Position+side*3.5+forward*2.0
        nav.RecoveryUntil=os.clock()+0.55
        humanoid:MoveTo(nav.RecoveryTarget)
    else
        nav.RecoveryTarget=nil
        nav.RecoveryUntil=os.clock()+0.25
    end

    nav.Dirty=true
    return true
end

function Runtime:StepNavigation(owner,goalPosition,targetName)
    local root=GetRoot()
    local humanoid=GetHumanoid()
    if not root or not humanoid or not goalPosition then return false,"Unavailable" end

    local isATM=owner=="ATM"
    local isJob=owner=="Job" or owner=="JobDeposit"
    local arrival=isATM and 4 or math.max(2,GetState("jobs.arrivalRadius",4))
    local directDistance=GetDistance(root.Position,goalPosition)
    if directDistance<=arrival then
        self:ResetNavigation(owner)
        return true,"Arrived"
    end

    local mode=isATM and "Walk" or GetState("jobs.navMode","Sprint")
    if mode=="Teleport" then
        -- Teleport remains a local/test convenience only. Collision-safe navigation
        -- is the recommended default because it behaves predictably in owned games.
        root.CFrame=CFrame.new(goalPosition,goalPosition+root.CFrame.LookVector)
        self:ResetNavigation(owner)
        return true,"Teleported"
    end

    local nav=self.Navigation
    local now=os.clock()
    if nav.RecoveryTarget and now<(nav.RecoveryUntil or 0) then
        humanoid:MoveTo(nav.RecoveryTarget)
        return false,"Obstacle recovery"
    elseif nav.RecoveryTarget and now>=(nav.RecoveryUntil or 0) then
        nav.RecoveryTarget=nil
        nav.RecoveryUntil=0
        nav.Dirty=true
    end

    local smartNavigation=isATM or GetState("jobs.smartNav",true)
    if not smartNavigation then
        humanoid:MoveTo(goalPosition)
        return false,"Direct"
    end

    local sameGoal=nav.Owner==owner and nav.GoalPosition and GetDistance(nav.GoalPosition,goalPosition)<1.5
    if not sameGoal or nav.Dirty or #nav.Waypoints==0 then
        self:PlanNavigation(owner,goalPosition,targetName,nav.Dirty)
    end

    local waypoint=nav.Waypoints[nav.WaypointIndex]
    if not waypoint then
        self:PlanNavigation(owner,goalPosition,targetName,true)
        waypoint=nav.Waypoints[nav.WaypointIndex]
        if not waypoint then return false,"No path" end
    end

    local waypointDistance=GetDistance(root.Position,waypoint.Position)
    if waypointDistance<=math.max(2.2,arrival*0.7) then
        nav.WaypointIndex=nav.WaypointIndex+1
        waypoint=nav.Waypoints[nav.WaypointIndex]
        if not waypoint then
            if GetDistance(root.Position,goalPosition)<=arrival*1.35 then
                self:ResetNavigation(owner)
                return true,"Arrived"
            end
            self:PlanNavigation(owner,goalPosition,targetName,true)
            waypoint=nav.Waypoints[nav.WaypointIndex]
            if not waypoint then return false,"No path" end
        end
        nav.LastWaypointDistance=math.huge
        self:BuildRoutePoints()
        self:RefreshRouteGuide()
    end

    if waypoint.Action==Enum.PathWaypointAction.Jump then
        humanoid.Jump=true
    end

    -- Faster job travel, but still through ordinary Humanoid movement/collision.
    -- This deliberately does NOT attempt anti-cheat or collision-detection bypasses.
    if isJob then
        if not nav.PreviousWalkSpeed then nav.PreviousWalkSpeed=humanoid.WalkSpeed end
        local requested=math.clamp(GetState("jobs.travelSpeed",24),16,30)
        if mode=="Sprint" then
            humanoid.WalkSpeed=math.max(nav.PreviousWalkSpeed,requested)
        else
            humanoid.WalkSpeed=nav.PreviousWalkSpeed
        end
    elseif nav.PreviousWalkSpeed then
        if not GetState("player.speed",false) then humanoid.WalkSpeed=nav.PreviousWalkSpeed end
        nav.PreviousWalkSpeed=nil
    end

    local toWaypoint=waypoint.Position-root.Position
    if GetState("jobs.obstacleRecovery",true) and isJob and toWaypoint.Magnitude>3.5 then
        local flat=Vector3.new(toWaypoint.X,0,toWaypoint.Z)
        if flat.Magnitude>0.1 then
            local probeDistance=math.min(5.5,flat.Magnitude)
            local hit=NavigationRaycast(root.Position+Vector3.new(0,2,0),flat.Unit*probeDistance)
            if hit and hit.Instance and not hit.Instance:IsDescendantOf(GetCharacter()) then
                if now-(nav.LastObstacleAt or 0)>0.65 then
                    self:BeginObstacleRecovery(goalPosition,waypoint.Position)
                    self:PlanNavigation(owner,goalPosition,targetName,true)
                end
                return false,"Avoiding obstacle"
            end
        end
    end

    humanoid:MoveTo(waypoint.Position)

    local currentDistance=GetDistance(root.Position,waypoint.Position)
    if currentDistance<nav.LastWaypointDistance-0.35 then
        nav.LastWaypointDistance=currentDistance
        nav.LastProgressAt=now
        nav.StuckCount=0
        nav.RecoveryStage=0
    elseif (isATM or GetState("jobs.stuckRecovery",false))
        and now-nav.LastProgressAt>=(isATM and 3 or GetState("jobs.stuckTimeout",3)) then
        nav.StuckCount=nav.StuckCount+1
        nav.LastProgressAt=now
        if isJob and GetState("jobs.obstacleRecovery",true) then
            self:BeginObstacleRecovery(goalPosition,waypoint.Position)
        end
        self:PlanNavigation(owner,goalPosition,targetName,true)
        return false,nav.StuckCount>=2 and "Recovering route" or "Replanning"
    end

    return false,mode=="Sprint" and "Moving fast" or "Moving"
end

function Runtime:UpdateJobHUD(jobName,task,state,progress)
    local hud=RuntimeUI.JobHUD
    if not hud then return end
    local visible=jobName~=nil and GetState("jobs.jobHud",false)
    hud.Visible=visible
    if not visible then return end

    if RuntimeUI.JobHUDTitle then
        RuntimeUI.JobHUDTitle.Text=string.format("%s  •  CYCLE %d",jobName or "JOB",self.JobSession.Cycles or 0)
    end
    if RuntimeUI.JobHUDTask then
        RuntimeUI.JobHUDTask.Text=task or "Waiting"
    end
    if RuntimeUI.JobHUDProgress then
        local pct=math.floor(math.clamp(progress or 0,0,1)*100+0.5)
        RuntimeUI.JobHUDProgress.Text=string.format("%s  •  %d%%",state or "IDLE",pct)
    end
end

function Runtime:ResetJobSession(reason)
    self.JobSession.Name=nil
    self.JobSession.Step=1
    self.JobSession.Phase="Idle"
    self.JobSession.WorkStarted=0
    self.JobSession.Cycles=0
    self.JobSession.Depositing=false
    self.JobSession.LastTask=reason or "Idle"
    self.JobSession.Failures=0
    self.JobSession.PhaseStarted=0
    self.JobSession.DepositStarted=0
    self.JobSession.DepositDeadline=0
    self.JobSession.DepositFailures=0
    self.JobSession.WorkState={}
    if self.Navigation.Owner=="Job" or self.Navigation.Owner=="JobDeposit" then
        self:ResetNavigation()
    end
    self:UpdateJobHUD(nil,nil,nil,0)
end

local function SetDebugLabelsVisible(visible)
    if not LocalWorld.Folder then
        return
    end

    for _, descendant in ipairs(LocalWorld.Folder:GetDescendants()) do
        if descendant:IsA("BillboardGui")
            and descendant.Name == "RuntimeBillboard" then

            descendant.Enabled = visible == true
        end
    end
end

local function SetLocalWorldVisible(visible)
    if not LocalWorld.Folder then
        return
    end

    for _, descendant in ipairs(LocalWorld.Folder:GetDescendants()) do
        if descendant:IsA("BasePart") then
            descendant.LocalTransparencyModifier = visible and 0 or 1
        elseif descendant:IsA("ProximityPrompt") then
            descendant.Enabled = visible == true
        end
    end

    SetDebugLabelsVisible(false)
end

local function GetInputName(input)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        return input.KeyCode.Name
    end

    return input.UserInputType.Name
end

function LocalWorld:Clear()
    if Runtime and Runtime.ResetNavigation then
        Runtime:ResetNavigation()
    end
    if Runtime and Runtime.ResetATMSession then
        Runtime:ResetATMSession("Runtime reset")
    end
    if RuntimeUI.RouteFolder then
        RuntimeUI.RouteFolder:Destroy()
        RuntimeUI.RouteFolder=nil
        RuntimeUI.RouteDots={}
        RuntimeUI.DestinationBeacon=nil
        RuntimeUI.DestinationBillboard=nil
        RuntimeUI.DestinationBackground=nil
        RuntimeUI.DestinationText=nil
        RuntimeUI.DestinationStroke=nil
    end

    if self.Folder then
        self.Folder:Destroy()
        self.Folder = nil
    end

    local dataFolder = LocalPlayer:FindFirstChild("BlockSpinRuntimeData")

    if dataFolder then
        dataFolder:Destroy()
    end

    local backpack=LocalPlayer:FindFirstChildOfClass("Backpack")
    local character=GetCharacter()

    for _,toolName in ipairs({"Pistol","Fists","Throwable"}) do
        local backpackTool=backpack and backpack:FindFirstChild(toolName)
        if backpackTool then backpackTool:Destroy() end

        local characterTool=character and character:FindFirstChild(toolName)
        if characterTool then characterTool:Destroy() end
    end

    LocalPlayer:SetAttribute("LocalWorldTeam",nil)

    self.Targets = nil
    self.ATMs = nil
    self.Jobs = nil
    self.Items = nil
    self.Vehicles = nil
    self.Shops = nil
    self.Bank = nil
    self.ToolShop = nil
    self.Effects = nil
    self.Car = nil
    self.CarBody = nil
    self.CarSeat = nil
    self.CarWindow = nil
    self.TargetVisuals = {}
    self.ItemVisuals = {}
    self.ATMVisuals = {}
    self.MaterialBackup = {}
    self.EffectEnabledBackup = {}

    Runtime.CurrentATM=nil
    Runtime.CurrentAimTarget=nil
    Runtime.CurrentSilentTarget=nil
    Runtime.WeaponEquipped=false
    Runtime.FistsEquipped=false
    Runtime.GrenadeEquipped=false
    Runtime.FullAutoHeld=false
end


    end
    if RuntimeUI.ATMHUDTask then
        RuntimeUI.ATMHUDTask.Text=task or "Waiting"
    end
    if RuntimeUI.ATMHUDProgress then
        RuntimeUI.ATMHUDProgress.Text=detail or ""
    end
end

function Runtime:ResetATMSession(reason)
    local s=self.ATMSession
    s.Phase="Idle"
    s.Target=nil
    s.TargetKind=nil
    s.VehicleOwned=false
    s.VehicleWaypoints={}
    s.VehicleWaypointIndex=1
    s.VehicleGoal=nil
    s.VehicleTargetName=nil
    s.RoutePoints={}
    s.RoutePointIndex=1
    s.LastPlanAt=0
    s.LastProgressAt=0
    s.LastDistance=math.huge
    s.RecoveryAttempts=0
    s.Status=reason or "Idle"
    s.Hacks=0
    s.PhaseStarted=0
    s.WatchdogDeadline=0
    s.ConsecutiveFailures=0
    s.LastFailure=nil
    s.Blacklist={}
    s.WatchdogTrips=0
    s.ServiceRetryAt=0
    s.SeatBlockedSince=0
    s.BackoffUntil=0
    self.CurrentATM=nil
    self.LastATMAction=0

    if self.Navigation.Owner=="ATM" then
        self:ResetNavigation("ATM")
    end

    if LocalWorld.Car and LocalWorld.Car.Parent then
        LocalWorld.Car:SetAttribute("Locked",false)
    end

    self:UpdateATMHUD("IDLE",reason or "Ready","")
end

function Runtime:SetATMPhase(phase,target,targetKind,now)
    local s=self.ATMSession
    s.Phase=phase or "Select"
    if target~=nil then s.Target=target end
    if targetKind~=nil then s.TargetKind=targetKind end
    s.PhaseStarted=now or os.clock()
    s.WatchdogDeadline=0
end

function Runtime:GetATMWatchdogLimit()
    local s=self.ATMSession
    if not s then return 30 end
    if s.Phase=="Hack" then return 10 end
    if s.Phase~="TravelService" and s.Phase~="TravelATM" then return 30 end

    local target=s.Target
    local targetPart=nil
    if s.TargetKind=="ATM" and target then
        targetPart=target:FindFirstChild("Body")
    elseif target and target:IsA("BasePart") then
        targetPart=target
    end

    local movement=GetState("atm.movement","Vehicle")
    local origin=(movement=="Vehicle" and LocalWorld.CarBody) or GetRoot()
    local distance=(origin and targetPart) and GetDistance(origin.Position,targetPart.Position) or 120
    local speed
    if movement=="Vehicle" then
        speed=math.max(12,GetState("atm.vehicleSpeed",50)*0.55)
    else
        local humanoid=GetHumanoid()
        speed=math.max(10,humanoid and humanoid.WalkSpeed or 16)
    end

    -- Long legitimate routes get more time while truly stalled routes are still
    -- recovered by the progress watchdog inside the movement engine.
    return math.clamp(14+(distance/speed)*4,22,120)
end

function Runtime:CheckATMWatchdog(now)
    local s=self.ATMSession
    if not s or s.Phase=="Idle" or s.Phase=="Select" then
        if s and s.PhaseStarted==0 then s.PhaseStarted=now end
        return false
    end

    if s.PhaseStarted==0 then
        s.PhaseStarted=now
        return false
    end

    if s.Phase=="Hack" and not GetState("atm.autoHack",false) then
        s.PhaseStarted=now
        s.WatchdogDeadline=0
        return false
    end

    local limit=self:GetATMWatchdogLimit()
    if not limit then return false end
    if (s.WatchdogDeadline or 0)<=0 then
        s.WatchdogDeadline=now+limit
    end
    if now<=s.WatchdogDeadline then return false end

    s.WatchdogTrips=(s.WatchdogTrips or 0)+1
    s.ConsecutiveFailures=(s.ConsecutiveFailures or 0)+1
    s.LastFailure=tostring(s.Phase).." timeout"
    s.BackoffUntil=now+math.min(12,2+(s.ConsecutiveFailures*2))

    if s.TargetKind=="ATM" and s.Target then
        s.Blacklist[s.Target]=now+math.min(60,10+(s.ConsecutiveFailures*5))
    end

    s.VehicleWaypoints={}
    s.VehicleWaypointIndex=1
    s.VehicleGoal=nil
    s.VehicleTargetName=nil
    s.RoutePoints={}
    s.RoutePointIndex=1
    s.VehicleOwned=false
    if self.Navigation.Owner=="ATM" then self:ResetNavigation("ATM") end

    self.CurrentATM=nil
    s.Target=nil
    s.TargetKind=nil
    self:SetATMPhase("Select",nil,nil,now)
    self:UpdateATMHUD("RECOVER","Watchdog recovery",s.LastFailure)
    return true
end

function Runtime:GetFarmTargetPosition(part, movement)
    if not part then return nil end

    if movement=="Vehicle" then
        local approach=math.max(6,GetState("atm.vehicleApproach",10))
        local look=part.CFrame.LookVector
        return part.Position+(look*approach)+Vector3.new(0,-1.3,0)
    end

    return part.Position+(part.CFrame.LookVector*5)+Vector3.new(0,2.5,0)
end

function Runtime:IsFarmVehicleReady()
    local car=LocalWorld.Car
    local seat=LocalWorld.CarSeat
    local body=LocalWorld.CarBody

    return car~=nil
        and car.Parent~=nil
        and car.PrimaryPart~=nil
        and body~=nil
        and body.Parent~=nil
        and seat~=nil
        and seat.Parent~=nil
        and (car:GetAttribute("Health") or 0)>0
end

function Runtime:EnsureFarmVehicle(now)
    local root=GetRoot()
    local humanoid=GetHumanoid()
    local s=self.ATMSession
    if not root or not humanoid then return false,"Waiting for character" end

    if not self:IsFarmVehicleReady() then
        if not GetState("atm.autoVehicle",true) then
            return false,"No valid farm vehicle"
        end

        if LocalWorld.Car and LocalWorld.Car.Parent then
            pcall(function() LocalWorld.Car:Destroy() end)
        end
        LocalWorld.Car=nil
        LocalWorld.CarBody=nil
        LocalWorld.CarSeat=nil
        LocalWorld.CarWindow=nil

        if LocalWorld.Vehicles then
            local spawnPos=root.Position+(root.CFrame.RightVector*8)+Vector3.new(0,-2.5,0)
            LocalWorld:CreateVehicle(spawnPos)
        end
    end

    if not self:IsFarmVehicleReady() then
        return false,"Vehicle recovery failed"
    end

    local car=LocalWorld.Car
    local seat=LocalWorld.CarSeat
    local body=LocalWorld.CarBody

    if GetState("atm.repairVehicle",true) and (car:GetAttribute("Health") or 0)<100 then
        car:SetAttribute("Health",100)
    end

    if seat.MaxSpeed~=GetState("atm.vehicleSpeed",50) then
        seat.MaxSpeed=GetState("atm.vehicleSpeed",50)
    end

    if seat.Occupant and seat.Occupant~=humanoid then
        if s.SeatBlockedSince==0 then s.SeatBlockedSince=now end
        if GetState("atm.autoRecoverVehicle",true) and now-s.SeatBlockedSince>=3 then
            pcall(function() car:Destroy() end)
            LocalWorld.Car=nil
            LocalWorld.CarBody=nil
            LocalWorld.CarSeat=nil
            LocalWorld.CarWindow=nil
            s.SeatBlockedSince=0
            s.VehicleOwned=false
            s.VehicleWaypoints={}
            s.VehicleWaypointIndex=1
            s.VehicleGoal=nil
            s.VehicleTargetName=nil
            s.RoutePoints={}
            s.RoutePointIndex=1
            self:HideRouteVisuals()
            return false,"Replacing occupied farm vehicle"
        end
        return false,"Vehicle occupied"
    end
    s.SeatBlockedSince=0

    local separated=GetDistance(root.Position,body.Position)>16
    if separated and GetState("atm.autoRecoverVehicle",true) then
        local recoverPos=root.Position+(root.CFrame.RightVector*7)+Vector3.new(0,-2.3,0)
        local forward=root.CFrame.LookVector
        local flatForward=Vector3.new(forward.X,0,forward.Z)
        if flatForward.Magnitude<0.01 then flatForward=Vector3.new(0,0,-1) end
        car:PivotTo(CFrame.lookAt(recoverPos,recoverPos+flatForward.Unit))
        s.VehicleWaypoints={}
        s.VehicleWaypointIndex=1
        s.VehicleGoal=nil
        s.VehicleTargetName=nil
        s.RoutePoints={}
        s.RoutePointIndex=1
        self:HideRouteVisuals()
        s.RecoveryAttempts=s.RecoveryAttempts+1
    end

    if seat.Occupant~=humanoid then
        seat:Sit(humanoid)
        s.VehicleOwned=false
        return false,"Seating in farm vehicle"
    end

    s.VehicleOwned=true
    car:SetAttribute("Locked",GetState("atm.lockVehicle",true))
    return true,"Vehicle ready"
end

function Runtime:PlanATMVehicleRoute(goalPosition,targetName,force)
    local car=LocalWorld.Car
    local body=LocalWorld.CarBody
    local s=self.ATMSession
    if not car or not car.Parent or not body or not goalPosition then return false end

    local now=os.clock()
    local sameGoal=s.VehicleGoal and GetDistance(s.VehicleGoal,goalPosition)<1.5
    local minReplan=math.max(0.5,GetState("atm.vehicleReplan",1.5))

    if not force and sameGoal and #s.VehicleWaypoints>0 then
        return true
    end
    if force and sameGoal and now-s.LastPlanAt<minReplan and #s.VehicleWaypoints>0 then
        return true
    end

    local points={}
    local path=PathfindingService:CreatePath({
        AgentRadius=4,
        AgentHeight=3,
        AgentCanJump=false,
        AgentCanClimb=false,
        WaypointSpacing=8,
    })

    local ok=pcall(function()
        path:ComputeAsync(body.Position,goalPosition)
    end)

    if ok and path.Status==Enum.PathStatus.Success then
        for index,waypoint in ipairs(path:GetWaypoints()) do
            if index>1 then
                table.insert(points,waypoint.Position)
            end
        end
    end

    if #points==0 then
        table.insert(points,goalPosition)
    elseif GetDistance(points[#points],goalPosition)>2 then
        table.insert(points,goalPosition)
    end

    s.VehicleWaypoints=points
    s.VehicleWaypointIndex=1
    s.VehicleGoal=goalPosition
    s.VehicleTargetName=targetName or "Destination"
    s.LastPlanAt=now
    s.LastProgressAt=now
    s.LastDistance=math.huge
    s.Status="Route: "..tostring(targetName or "destination")
    self:BuildATMRoutePoints()
    self:RefreshRouteGuide()
    return true
end

function Runtime:StepATMVehicle(goalPosition,targetName,now,dt)
    local ready,readyState=self:EnsureFarmVehicle(now)
    if not ready then
        self:UpdateATMHUD("VEHICLE",targetName or "Route",readyState)
        return false,readyState
    end

    local car=LocalWorld.Car
    local body=LocalWorld.CarBody
    local s=self.ATMSession
    if not car or not body then return false,"Vehicle unavailable" end

    local arrival=math.max(4,GetState("atm.vehicleApproach",10)*0.55)
    local directDistance=GetDistance(body.Position,goalPosition)
    if directDistance<=arrival then
        s.VehicleWaypoints={}
        s.VehicleWaypointIndex=1
        s.VehicleGoal=nil
        s.VehicleTargetName=nil
        s.RoutePoints={}
        s.RoutePointIndex=1
        s.LastDistance=0
        self:HideRouteVisuals()
        return true,"Arrived"
    end

    local sameGoal=s.VehicleGoal and GetDistance(s.VehicleGoal,goalPosition)<1.5
    if not sameGoal or #s.VehicleWaypoints==0 then
        self:PlanATMVehicleRoute(goalPosition,targetName,false)
    end

    local waypoint=s.VehicleWaypoints[s.VehicleWaypointIndex]
    if not waypoint then
        self:PlanATMVehicleRoute(goalPosition,targetName,true)
        waypoint=s.VehicleWaypoints[s.VehicleWaypointIndex]
        if not waypoint then return false,"No vehicle route" end
    end

    local waypointDistance=GetDistance(body.Position,waypoint)
    if waypointDistance<=4 then
        s.VehicleWaypointIndex=s.VehicleWaypointIndex+1
        waypoint=s.VehicleWaypoints[s.VehicleWaypointIndex]
        if not waypoint then
            waypoint=goalPosition
            s.VehicleWaypoints={goalPosition}
            s.VehicleWaypointIndex=1
        end
        waypointDistance=GetDistance(body.Position,waypoint)
        s.LastDistance=math.huge
        self:BuildATMRoutePoints()
        self:RefreshRouteGuide()
    end

    local delta=waypoint-body.Position
    if delta.Magnitude>0.01 then
        local baseSpeed=math.clamp(GetState("atm.vehicleSpeed",50),10,120)
        local direction=delta.Unit
        local flat=Vector3.new(direction.X,0,direction.Z)
        if flat.Magnitude<0.01 then flat=body.CFrame.LookVector end
        flat=flat.Unit

        local currentFlat=Vector3.new(body.CFrame.LookVector.X,0,body.CFrame.LookVector.Z)
        if currentFlat.Magnitude<0.01 then currentFlat=flat else currentFlat=currentFlat.Unit end
        local turnDot=math.clamp(currentFlat:Dot(flat),-1,1)
        local turnFactor=math.clamp((turnDot+1)*0.5,0.35,1)
        local arrivalFactor=math.clamp(directDistance/math.max(arrival*3,1),0.35,1)
        local speed=baseSpeed*math.min(turnFactor,arrivalFactor)
        local frameDt=math.clamp(dt or (1/30),0.005,0.08)
        local step=math.min(delta.Magnitude,speed*frameDt)
        local newPos=body.Position+(direction*step)
        local desired=CFrame.lookAt(newPos,newPos+flat)
        local current=car:GetPivot()
        car:PivotTo(current:Lerp(desired,math.clamp(frameDt*7,0.2,1)))
    end

    local progressDistance=GetDistance(LocalWorld.CarBody.Position,waypoint)
    if progressDistance<s.LastDistance-0.2 then
        s.LastDistance=progressDistance
        s.LastProgressAt=now
        s.RecoveryAttempts=0
    elseif now-s.LastProgressAt>=math.max(1.25,GetState("atm.vehicleReplan",1.5)*1.5) then
        s.RecoveryAttempts=s.RecoveryAttempts+1
        s.LastProgressAt=now
        s.VehicleWaypoints={}
        s.VehicleWaypointIndex=1
        s.RoutePoints={}
        s.RoutePointIndex=1

        local maxRetries=math.max(1,GetState("atm.vehicleRetries",3))
        if s.RecoveryAttempts>=maxRetries then
            if GetState("atm.autoRecoverVehicle",true) then
                -- Clean fallback: rebuild a direct route from the current car position.
                s.VehicleWaypoints={goalPosition}
                s.VehicleWaypointIndex=1
                s.VehicleGoal=goalPosition
                s.VehicleTargetName=targetName or s.VehicleTargetName
                s.RecoveryAttempts=0
                s.LastDistance=math.huge
                self:BuildATMRoutePoints()
                self:RefreshRouteGuide()
                return false,"Direct recovery route"
            end
            return false,"Vehicle route stalled"
        end

        self:PlanATMVehicleRoute(goalPosition,targetName,true)
        return false,"Replanning vehicle route"
    end

    return false,string.format("Driving • %.0f studs",directDistance)
end

function Runtime:MoveFarmToPosition(goalPosition,targetName,now,dt)
    local root=GetRoot()
    if not root or not goalPosition then return false,"Character unavailable" end

    local movement=GetState("atm.movement","Vehicle")
    if movement=="Vehicle" then
        if self.Navigation.Owner=="ATM" then
            self:ResetNavigation("ATM")
        end
        local arrived,state=self:StepATMVehicle(goalPosition,targetName,now,dt)
        if not arrived and not GetState("atm.strictVehicle",true)
            and self.ATMSession.VehicleOwned~=true then

            local walkArrived,walkState=self:StepNavigation("ATM",goalPosition,targetName.." • fallback")
            return walkArrived==true,"Walk fallback • "..tostring(walkState)
        end
        return arrived,state
    elseif movement=="Walk" then
        self.ATMSession.VehicleOwned=false
        local arrived,state=self:StepNavigation("ATM",goalPosition,targetName)
        return arrived==true,state
    end

    -- Explicit test-only mode. It is never used by default.
    self.ATMSession.VehicleOwned=false
    self:ResetNavigation("ATM")
    root.CFrame=CFrame.new(goalPosition,goalPosition+root.CFrame.LookVector)
    return true,"Teleported"
end

function Runtime:MoveToATM(atm,now,dt)
    local body=atm and atm:FindFirstChild("Body")
    if not body then return false,"ATM unavailable" end

    local targetPosition=self:GetFarmTargetPosition(body,GetState("atm.movement","Vehicle"))
    return self:MoveFarmToPosition(targetPosition,atm.Name,now or os.clock(),dt or (1/30))
end

function Runtime:NeedsATMRestock()
    return GetState("atm.buyTools",false)
        and LocalWorld.Data.HackTools<=math.max(0,GetState("atm.restockAt",1))
end

function Runtime:RestockATMTools()
    local requested=math.max(1,GetState("atm.toolsBuy",2))
    local affordable=math.floor(LocalWorld.Data.Cash/180)
    local amount=math.min(requested,affordable)

    if amount<=0 then
        return false,"Not enough runtime cash for hack tools"
    end

    LocalWorld.Data.Cash=LocalWorld.Data.Cash-(amount*180)
    LocalWorld.Data.HackTools=LocalWorld.Data.HackTools+amount
    UpdateRuntimeDataValues()
    return true,"Bought "..tostring(amount).." hack tool"..(amount==1 and "" or "s")
end

function Runtime:NeedsATMDeposit()
    return GetState("atm.autoDeposit",false)
        and LocalWorld.Data.Cash>=math.max(1000,GetState("atm.depositAt",5000))
end

function Runtime:DepositATMCash()
    local leave=math.max(0,GetState("atm.leaveCash",1000))
    local deposit=math.max(0,LocalWorld.Data.Cash-leave)
    if deposit<=0 then return true,"No cash to deposit" end

    LocalWorld.Data.Cash=LocalWorld.Data.Cash-deposit
    LocalWorld.Data.Bank=LocalWorld.Data.Bank+deposit
    UpdateRuntimeDataValues()
    return true,"Deposited $"..tostring(math.floor(deposit))
end

function Runtime:HackATM(atm, fromFarm)
    if not atm or atm:GetAttribute("Available") ~= true then
        return false,"Unavailable"
    end

    if LocalWorld.Data.HackTools<=0 then
        if not fromFarm and GetState("atm.buyTools", false) and LocalWorld.Data.Cash>=180 then
            self:RestockATMTools()
        end

        if LocalWorld.Data.HackTools<=0 then
            if not fromFarm then
                AdapterNotify("ATM","No runtime hack tools available.","warning")
            end
            UpdateRuntimeDataValues()
            return false,"NoTools"
        end
    end

    local now=os.clock()
    atm:SetAttribute("Available",false)
    atm:SetAttribute("CooldownUntil",now+14)

    local payout=atm:GetAttribute("CashValue") or 900
    local tool=GetState("atm.tool","Best Available")

    if tool=="Advanced" then
        payout=payout*1.15
    elseif tool=="Pro" then
        payout=payout*1.3
    elseif tool=="Best Available" then
        payout=payout*1.2
    end

    LocalWorld.Data.Cash=LocalWorld.Data.Cash+payout
    LocalWorld.Data.HackTools=math.max(0,LocalWorld.Data.HackTools-1)

    -- Manual actions keep the old convenience behavior. The farm itself uses
    -- physical runtime service routes so restocking/depositing are testable.
    if not fromFarm then
        if GetState("atm.buyTools",false) and self:NeedsATMRestock() then
            self:RestockATMTools()
        end
        if GetState("atm.autoDeposit",false) and self:NeedsATMDeposit() then
            self:DepositATMCash()
        end
    end

    UpdateRuntimeDataValues()

    if not fromFarm then
        AdapterNotify("ATM hacked","+$"..tostring(math.floor(payout)).." runtime cash.","success")
    end

    return true,"Success"
end

function Runtime:RunATMFarm(now,dt)
    if not GetState("atm.enabled",false) then
        if self.ATMSession.Phase~="Idle" or self.CurrentATM then
            self:ResetATMSession("Disabled")
        end
        return
    end

    local s=self.ATMSession
    local stopWhenKnocked=GetState("jobs.stopKnocked",true) or GetState("player.stopKnocked",true)
    if stopWhenKnocked and self:IsKnocked() then
        s.VehicleOwned=false
        s.PhaseStarted=now
        s.WatchdogDeadline=0
        s.LastProgressAt=now
        if self.Navigation.Owner=="ATM" then self:ResetNavigation("ATM") end
        self:UpdateATMHUD("PAUSED","Player is knocked","Automation will resume automatically")
        return
    end
    if self:CheckATMWatchdog(now) then return end

    if s.Phase=="Idle" then
        s.Target=nil
        s.TargetKind=nil
        self:SetATMPhase("Select",nil,nil,now)
    end

    if s.Phase=="Select" then
        if now<(s.BackoffUntil or 0) then
            self:UpdateATMHUD("RECOVER","Cooling down after a route failure",string.format("Retry in %.1f s",math.max(0,s.BackoffUntil-now)))
            return
        end

        if self:NeedsATMRestock() and LocalWorld.Data.Cash<180 then
            s.ServiceRetryAt=math.max(s.ServiceRetryAt or 0,now+10)
            self:UpdateATMHUD("BLOCKED","Need hack tools","Not enough runtime cash to buy a tool")
            return
        end

        if self:NeedsATMRestock() and now<(s.ServiceRetryAt or 0) then
            self:UpdateATMHUD("WAITING","Tool restock paused",string.format("Retry in %.1f s",math.max(0,s.ServiceRetryAt-now)))
            return
        end

        if self:NeedsATMRestock() then
            s.TargetKind="Tools"
            s.Target=LocalWorld.ToolShop
            self:SetATMPhase("TravelService",s.Target,s.TargetKind,now)
        elseif self:NeedsATMDeposit() then
            s.TargetKind="Bank"
            s.Target=LocalWorld.Bank
            self:SetATMPhase("TravelService",s.Target,s.TargetKind,now)
        else
            local atm=self:FindAvailableATM()
            if not atm then
                self.CurrentATM=nil
                self:UpdateATMHUD("WAITING","No ATM ready","Waiting for cooldown")
                return
            end
            self.CurrentATM=atm
            s.Target=atm
            s.TargetKind="ATM"
            self:SetATMPhase("TravelATM",s.Target,s.TargetKind,now)
        end
    end

    if s.Phase=="TravelService" then
        local marker=s.Target
        if not marker or not marker.Parent then
            s.Target=nil
            s.TargetKind=nil
            self:SetATMPhase("Select",nil,nil,now)
            return
        end

        local goal=self:GetFarmTargetPosition(marker,GetState("atm.movement","Vehicle"))
        local arrived,state=self:MoveFarmToPosition(goal,s.TargetKind=="Bank" and "Bank" or "Tool Shop",now,dt)
        self:UpdateATMHUD("SERVICE",s.TargetKind=="Bank" and "Bank run" or "Tool restock",state)

        if not arrived then return end

        local ok,message
        if s.TargetKind=="Bank" then
            ok,message=self:DepositATMCash()
        else
            ok,message=self:RestockATMTools()
        end

        s.Target=nil
        s.TargetKind=nil
        self:SetATMPhase("Select",nil,nil,now)
        if not ok then
            self:UpdateATMHUD("WAITING","Service unavailable",message)
            s.ServiceRetryAt=now+5
            self.LastATMAction=now
        else
            s.ServiceRetryAt=0
            self:UpdateATMHUD("SERVICE","Complete",message)
        end
        return
    end

    if s.Phase=="TravelATM" then
        local atm=s.Target
        if not atm or not atm.Parent then
            self.CurrentATM=nil
            s.Target=nil
            self:SetATMPhase("Select",nil,nil,now)
            return
        end

        if atm:GetAttribute("Available")~=true then
            if GetState("atm.skipUnavailable",true) then
                self.CurrentATM=nil
                s.Target=nil
                self:SetATMPhase("Select",nil,nil,now)
            else
                local cooldown=math.max(0,(atm:GetAttribute("CooldownUntil") or now)-now)
                self:UpdateATMHUD("WAITING",atm.Name,string.format("Cooldown %.1f s",cooldown))
            end
            return
        end

        local arrived,state=self:MoveToATM(atm,now,dt)
        self:UpdateATMHUD("TRAVEL",atm.Name,state)
        if not arrived then return end

        local atmBody=atm:FindFirstChild("Body")
        local movement=GetState("atm.movement","Vehicle")
        local origin=(movement=="Vehicle" and LocalWorld.CarBody) or GetRoot()
        local verifyDistance=movement=="Vehicle" and (math.max(6,GetState("atm.vehicleApproach",10))+7) or 10
        if not atmBody or not origin or GetDistance(origin.Position,atmBody.Position)>verifyDistance then
            s.ConsecutiveFailures=(s.ConsecutiveFailures or 0)+1
            s.LastFailure="ATM arrival verification failed"
            self:SetATMPhase("TravelATM",s.Target,"ATM",now)
            self:UpdateATMHUD("VERIFY",atm.Name,"Rechecking approach position")
            return
        end
        if movement=="Vehicle" and GetState("atm.strictVehicle",true) then
            local humanoid=GetHumanoid()
            if not self:IsFarmVehicleReady() or not LocalWorld.CarSeat or LocalWorld.CarSeat.Occupant~=humanoid then
                s.VehicleOwned=false
                self:SetATMPhase("TravelATM",s.Target,"ATM",now)
                self:UpdateATMHUD("VEHICLE",atm.Name,"Seat/vehicle verification failed; recovering")
                return
            end
        end

        self:SetATMPhase("Hack",s.Target,"ATM",now)
        self.LastATMAction=0
    end

    if s.Phase=="Hack" then
        local atm=s.Target
        if not atm or not atm.Parent or atm:GetAttribute("Available")~=true then
            self.CurrentATM=nil
            s.Target=nil
            self:SetATMPhase("Select",nil,nil,now)
            return
        end

        if not GetState("atm.autoHack",false) then
            self:UpdateATMHUD("READY",atm.Name,"Enable Auto Hack to continue")
            return
        end

        local retry=math.max(0.25,GetState("atm.retry",1))
        if now-self.LastATMAction<retry then
            self:UpdateATMHUD("HACK",atm.Name,string.format("Retry %.1f s",math.max(0,retry-(now-self.LastATMAction))))
            return
        end
        self.LastATMAction=now

        if GetState("atm.killAura",false) then
            self:RunMeleeAura(now)
        end

        local ok,reason=self:HackATM(atm,true)
        if ok then
            s.Hacks=s.Hacks+1
            s.ConsecutiveFailures=0
            s.LastFailure=nil
            s.BackoffUntil=0
            self:UpdateATMHUD("SUCCESS",atm.Name,"Hacks this session: "..tostring(s.Hacks))
            self.CurrentATM=nil
            s.Target=nil
            s.TargetKind=nil
            self:SetATMPhase("Select",nil,nil,now)
        elseif reason=="NoTools" then
            s.Target=nil
            s.TargetKind=nil
            self:SetATMPhase("Select",nil,nil,now)
        elseif reason=="Unavailable" then
            self.CurrentATM=nil
            s.Target=nil
            self:SetATMPhase("Select",nil,nil,now)
        else
            self:UpdateATMHUD("RETRY",atm.Name,tostring(reason or "Hack failed"))
        end
    end
end

function Runtime:UpdateATMRoutingLine()
    local line = RuntimeUI.AimLine

    if not line then
        return
    end

    if not GetState("atm.routeLine", false) or not self.CurrentATM or not Camera then
        line.Visible = false
        return
    end

    local body = self.CurrentATM:FindFirstChild("Body")

    if not body then
        line.Visible = false
        return
    end

    local point, onScreen = Camera:WorldToViewportPoint(body.Position)

    if not onScreen or point.Z <= 0 then
        line.Visible = false
        return
    end

    local viewport = Camera.ViewportSize
    local from = Vector2.new(viewport.X * 0.5, viewport.Y)
    local to = Vector2.new(point.X, point.Y)

    self:UpdateLine(line, from, to, 2, Theme.Warning)
end

function Runtime:UpdateVehicle(dt)
    local car = LocalWorld.Car
    local body = LocalWorld.CarBody
    local seat = LocalWorld.CarSeat

    if not car or not body or not seat then
        return
    end

    local health = car:GetAttribute("Health") or 100
    local modsEnabled = GetState("vehicle.mods", false)

    if modsEnabled and GetState("vehicle.noCrash", false) and health < 100 then
        health = 100
    end

    if modsEnabled and GetState("vehicle.autoRepair", false) and health < GetState("vehicle.repairThreshold", 45) then
        health = 100
    end

    car:SetAttribute("Health", health)
    local atmOwnsVehicle=GetState("atm.enabled",false) and self.ATMSession and self.ATMSession.VehicleOwned==true
    car:SetAttribute("Locked", GetState("vehicle.autoLock", false)
        or (atmOwnsVehicle and GetState("atm.lockVehicle", true)))

    local humanoid = GetHumanoid()
    local occupiedByLocal = humanoid and seat.Occupant == humanoid

    if occupiedByLocal and not atmOwnsVehicle then
        local speedMultiplier = modsEnabled and GetState("vehicle.speed", false)
            and GetState("vehicle.speedMulti", 1.25)
            or 1
        local accelerationMultiplier = modsEnabled and GetState("vehicle.accel", false)
            and GetState("vehicle.accelMulti", 1.25)
            or 1
        local baseSpeed = 30 * speedMultiplier

        if modsEnabled and GetState("vehicle.bumpAssist", false) then
            baseSpeed = baseSpeed * 1.1
        end

        local throttle = 0
        local steer = 0

        if self:IsInputDown("W") then
            throttle = throttle + 1
        end

        if self:IsInputDown("S") then
            throttle = throttle - 1
        end

        if self:IsInputDown("A") then
            steer = steer + 1
        end

        if self:IsInputDown("D") then
            steer = steer - 1
        end

        if modsEnabled and GetState("vehicle.instantBrake", false) and self:IsInputDown("Space") then
            throttle = 0
        end

        local pivot = car:GetPivot()
        pivot = pivot * CFrame.Angles(0, math.rad(steer * 65 * dt * accelerationMultiplier), 0)
        pivot = pivot + pivot.LookVector * throttle * baseSpeed * dt * accelerationMultiplier
        car:PivotTo(pivot)
    end

    if GetState("atm.repairVehicle", true) and GetState("atm.enabled", false)
        and self.ATMSession and self.ATMSession.VehicleOwned and health < 100 then
        car:SetAttribute("Health", 100)
    end
end

function Runtime:ApplyVehicleCosmetics()
    if not LocalWorld.CarBody then
        return false
    end

    local paints = {
        Default = Color3.fromRGB(45, 65, 105),
        Black = Color3.fromRGB(22, 22, 24),
        White = Color3.fromRGB(225, 228, 235),
        Red = Color3.fromRGB(188, 57, 69),
        Blue = Color3.fromRGB(52, 95, 191),
        Purple = Color3.fromRGB(117, 72, 184),
        Gold = Color3.fromRGB(202, 161, 63),
    }

    local materials = {
        Default = Enum.Material.Metal,
        Matte = Enum.Material.SmoothPlastic,
        Gloss = Enum.Material.Glass,
        Metallic = Enum.Material.Metal,
    }

    LocalWorld.CarBody.Color = paints[GetState("vehicle.paint", "Default")] or paints.Default
    LocalWorld.CarBody.Material = materials[GetState("vehicle.finish", "Default")] or Enum.Material.Metal

    if LocalWorld.CarWindow then
        LocalWorld.CarWindow.Transparency = math.clamp(GetState("vehicle.tint", 20) / 100, 0.05, 0.95)
    end

    return true
end

function Runtime:ApplyWeaponCosmetics(reset)
    if not reset and not GetState("weaponCosmetics.enabled", false) then
        return false
    end

    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local character = GetCharacter()
    local tool = backpack and backpack:FindFirstChild("Pistol")
        or character and character:FindFirstChild("Pistol")

    if not tool then
        return false
    end

    local handle = tool:FindFirstChild("Handle")

    if not handle then
        return false
    end

    if reset then
        handle.Color = Color3.fromRGB(55, 58, 66)
        handle.Material = Enum.Material.Metal
        handle.Reflectance = 0
        return true
    end

    local colors = {
        Default = Color3.fromRGB(55, 58, 66),
        Black = Color3.fromRGB(22, 22, 24),
        White = Color3.fromRGB(225, 228, 235),
        Red = Color3.fromRGB(193, 65, 75),
        Blue = Color3.fromRGB(70, 105, 205),
        Purple = Color3.fromRGB(126, 82, 191),
    }

    local finish = GetState("weaponCosmetics.finish", "Default")
    local tint = GetState("weaponCosmetics.tint", "Default")
    local category = GetState("weaponCosmetics.category", "Current Weapon")
    local intensity = GetState("weaponCosmetics.material", 50) / 100

    handle:SetAttribute("CosmeticCategory", category)

    handle.Color = colors[tint] or colors.Default

    if finish == "Matte" then
        handle.Material = Enum.Material.SmoothPlastic
    elseif finish == "Chrome" then
        handle.Material = Enum.Material.Metal
        handle.Reflectance = 0.35
    elseif finish == "Carbon" then
        handle.Material = Enum.Material.Foil
    elseif finish == "Gold" then
        handle.Material = Enum.Material.Metal
        handle.Color = Color3.fromRGB(213, 170, 62)
    else
        handle.Material = Enum.Material.Metal
        handle.Reflectance = 0
    end

    handle.Reflectance = math.clamp(handle.Reflectance + intensity * 0.2, 0, 0.6)

    return true
end

function Runtime:CollectPickup(part)
    if not part or part:GetAttribute("Available") == false then
        return false
    end

    local itemType = part:GetAttribute("ItemType")
    local value = part:GetAttribute("Value") or 1

    part:SetAttribute("Available", false)
    part.Transparency = 1
    part.CanCollide = false

    local prompt = part:FindFirstChildOfClass("ProximityPrompt")

    if prompt then
        prompt.Enabled = false
    end

    if itemType == "Cash" then
        LocalWorld.Data.Cash = LocalWorld.Data.Cash + value
    elseif itemType == "Weapon" then
        AddInventoryItem("Street Pickup Weapon", "Weapons", 1)
    else
        AddInventoryItem("Street Item", "Misc", 1)
    end

    UpdateRuntimeDataValues()

    task.delay(10, function()
        if part and part.Parent then
            part:SetAttribute("Available", true)
            part.Transparency = 0
            part.CanCollide = true

            if prompt and prompt.Parent then
                prompt.Enabled = true
            end
        end
    end)

    return true
end

function Runtime:OpenCrate(part)
    if not part or part:GetAttribute("Available") == false or part:GetAttribute("Busy") == true then
        return false
    end

    part:SetAttribute("Available", false)
    part:SetAttribute("Busy", true)

    local prompt=part:FindFirstChildOfClass("ProximityPrompt")
    if prompt then prompt.Enabled=false end

    local reward = part:GetAttribute("Value") or 750
    local delayTime = GetState("misc.skipCrate", false) and 0 or 1.25

    task.delay(delayTime, function()
        if not self.Started or not part or not part.Parent then return end

        LocalWorld.Data.Cash = LocalWorld.Data.Cash + reward
        AddInventoryItem("Crate Token", "Misc", 1)
        UpdateRuntimeDataValues()

        AdapterNotify("Crate opened", "+$" .. tostring(reward) .. " runtime reward.", "success")

        task.delay(9, function()
            if part and part.Parent then
                part:SetAttribute("Available", true)
                part:SetAttribute("Busy", false)
                if prompt and prompt.Parent then prompt.Enabled=true end
            end
        end)
    end)

    return true
end

function Runtime:UpdatePrompts()
    if not LocalWorld.Folder then
        return
    end

    local hold

    if GetState("misc.instantInteract", false) then
        hold = 0
    elseif GetState("misc.fastPrompts", false) then
        hold = 0.08
    end

    for _, descendant in ipairs(LocalWorld.Folder:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            if hold ~= nil then
                descendant.HoldDuration = hold
            else
                if descendant.Name == "HackPrompt" then
                    descendant.HoldDuration = 1.2
                elseif descendant.Name == "PickupPrompt" then
                    descendant.HoldDuration = descendant.ObjectText:find("Crate") and 1.5 or 0.35
                else
                    descendant.HoldDuration = 0.3
                end
            end
        end
    end
end

function Runtime:RunAutoPickup(now)
    if not GetState("misc.autoPickup", false) then
        return
    end

    if now - self.LastPickupTick < 0.18 then
        return
    end

    self.LastPickupTick = now

    local root = GetRoot()

    if not root or not LocalWorld.Items then
        return
    end

    local range = GetState("misc.pickupRange", 10)

    for _, part in ipairs(LocalWorld.Items:GetChildren()) do
        if part:IsA("BasePart") and part:GetAttribute("Available") ~= false then
            local itemType = part:GetAttribute("ItemType")
            local allowed = itemType == "Cash"
                and GetState("misc.pickupMoney", true)
                or itemType ~= "Cash"
                and itemType ~= "Crate"
                and GetState("misc.pickupItems", true)

            if allowed and GetDistance(root.Position, part.Position) <= range then
                self:CollectPickup(part)
            end
        end
    end
end

function Runtime:DropLocalWorldItem()
    if not GetState("misc.itemDrop", false) then
        return
    end

    local root = GetRoot()

    if not root then
        return
    end

    local item = LocalWorld.Inventory[1]

    if not item then
        return
    end

    if RemoveInventoryItem(item.Name, 1) then
        LocalWorld:CreateItem(
            math.random(100, 999),
            "General",
            root.Position + root.CFrame.LookVector * 4,
            1
        )

        AdapterNotify("Item dropped", item.Name .. " dropped into the runtime world.", "success")
    end
end

function Runtime:RepairCrates()
    if not GetState("misc.silentRepair", false) or not LocalWorld.Items then
        return
    end

    for _, part in ipairs(LocalWorld.Items:GetChildren()) do
        if part:GetAttribute("ItemType") == "Crate" and part:GetAttribute("Busy") ~= true then
            part:SetAttribute("Available", true)
            local prompt=part:FindFirstChildOfClass("ProximityPrompt")
            if prompt then prompt.Enabled=true end
        end
    end
end

function Runtime:TeleportTo(part)
    local root = GetRoot()

    if not root or not part then
        return false
    end

    root.CFrame = part.CFrame * CFrame.new(0, 4, 0)
    root.AssemblyLinearVelocity = Vector3.zero
    return true
end

function Runtime:GetTeleportPlayerTarget()
    local mode = GetState("tp.playerTarget", "None")

    if mode == "Last Target" then
        return self.CurrentAimTarget or self.CurrentSilentTarget
    end

    if mode == "Nearest Player" then
        return self:GetBestTarget("aim")
    end

    return nil
end

function Runtime:SpectateTarget(target)
    if not Camera or not target then
        return false
    end

    local humanoid = target:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return false
    end

    self.SpectateToken=self.SpectateToken+1
    local token=self.SpectateToken
    Camera.CameraSubject = humanoid

    task.delay(5, function()
        if not self.Started or token~=self.SpectateToken then return end
        local ownHumanoid=GetHumanoid()
        if Camera and ownHumanoid then
            Camera.CameraSubject = ownHumanoid
        end
    end)

    return true
end


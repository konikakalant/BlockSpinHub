    prompt.Triggered:Connect(function(player)
        if player ~= LocalPlayer then
            return
        end

        if itemType == "Crate" then
            Runtime:OpenCrate(part)
        else
            Runtime:CollectPickup(part)
        end
    end)

    return part
end


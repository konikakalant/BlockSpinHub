local function BuildSubtabButtons(pageId)
	ClearSubtabs()
	local p=Pages[pageId]
	if not p then return end

	local ids={}
	for id in pairs(p.Subtabs) do table.insert(ids,id) end
	table.sort(ids,function(a,b)
		return (p.Subtabs[a].Order or 999)<(p.Subtabs[b].Order or 999)
	end)

	-- V14 intentionally does not add these transient buttons to ThemeBindings.
	-- The V12 approach retained a callback every time a page was opened, so
	-- repeated navigation slowly grew the binding list. Subtab buttons are
	-- recreated from the current theme instead.
	for _,id in ipairs(ids) do
		local selected=CurrentSubtab[pageId]==id
		local selectedColor=Theme.Accent:Lerp(Theme.Section,0.82)
		local b=Create("TextButton",{
			Name=id,
			AutomaticSize=Enum.AutomaticSize.X,
			Size=UDim2.fromOffset(0,21),
			BackgroundColor3=selected and selectedColor or Theme.RowHover,
			BackgroundTransparency=selected and 0.2 or 1,
			BorderSizePixel=0,
			AutoButtonColor=false,
			Text=id,
			TextColor3=selected and Theme.Text or Theme.Muted,
			TextSize=8,
			Font=Enum.Font.GothamMedium,
			ZIndex=6,
		},Subtabs)
		Corner(b,4)
		Padding(b,8,8,0,0)

		b.MouseEnter:Connect(function()
			if CurrentSubtab[pageId]~=id then
				Tween(b,{BackgroundTransparency=0.55,TextColor3=Theme.SubText},0.06)
			end
		end)
		b.MouseLeave:Connect(function()
			if CurrentSubtab[pageId]~=id then
				Tween(b,{BackgroundTransparency=1,TextColor3=Theme.Muted},0.06)
			end
		end)
		b.MouseButton1Click:Connect(function()
			SwitchSubtab(pageId,id,true)
		end)
	end
end


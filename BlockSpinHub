local function InferRarity(name,category)
    if string.find(name or "","LocalWorld",1,true) then return "Rare" end
    if category=="Weapons" then return "Epic" end
    if category=="Throwables" then return "Rare" end
    if category=="Tools" then return "Uncommon" end
    return "Common"
end

local function AddInventoryItem(name, category, amount, rarity)
    amount = amount or 1

    for _, item in ipairs(LocalWorld.Inventory) do
        if item.Name == name and item.Category == category then
            item.Amount = item.Amount + amount
            item.Rarity = item.Rarity or rarity or InferRarity(name,category)
            return item
        end
    end

    local item = {
        Name = name,
        Category = category,
        Amount = amount,
        Rarity = rarity or InferRarity(name,category),
    }

    table.insert(LocalWorld.Inventory, item)
    return item
end

local function RemoveInventoryItem(name, amount)
    amount = amount or 1

    for index, item in ipairs(LocalWorld.Inventory) do
        if item.Name == name then
            item.Amount = item.Amount - amount

            if item.Amount <= 0 then
                table.remove(LocalWorld.Inventory, index)
            end

            return true
        end
    end

    return false
end

local function GetInventoryAmount(name)
    for _, item in ipairs(LocalWorld.Inventory) do
        if item.Name == name then
            return item.Amount
        end
    end

    return 0
end


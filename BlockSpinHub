function Runtime:ApplyUISetting(flag, value)
    if flag == "ui.theme" then
        local name=tostring(value or "Amethyst")
        if not ThemePresets[name] then name="Amethyst" end
        SetTheme(name)
        return true
    end

    if flag == "ui.accent" then
        local name=tostring(value or "Violet")
        if not AccentPresets[name] then name="Violet" end
        SetAccent(name)
        return true
    end

    if flag == "ui.deviceMode" then
        local mode=tostring(value or "Auto")
        if mode~="Auto" and mode~="Desktop" and mode~="Tablet" and mode~="Phone" then mode="Auto" end
        Config.DeviceMode=mode
        UpdateResponsiveScale(true,true)
        UpdateDeviceChrome()
        ApplyBuiltPageLayouts()
        return true
    end

    if flag == "ui.performanceMode" then
        local mode=tostring(value or "Auto")
        if mode~="Auto" and mode~="Quality" and mode~="Balanced" and mode~="Performance" then mode="Auto" end
        Config.PerformanceMode=mode
        self.FastAccumulator=0
        self.BackgroundAccumulator=0
        self.VisualAccumulator=0
        self.RuntimeUIAccumulator=0
        return true
    end

    if flag == "ui.scale" then
        local numeric=tonumber(value) or 130
        Config.Scale=math.clamp(numeric/100,0.80,1.50)
        UpdateResponsiveScale(false,true)
        local clamped=ClampWindowPosition(Main.Position)
        Tween(Main,{Position=clamped},0.1)
        local scale=GetEffectiveScale()
        Tween(Shadow,{Position=UDim2.fromOffset(clamped.X.Offset-(5*scale),clamped.Y.Offset-(1*scale))},0.1)
        return true
    end

    if flag == "ui.opacity" then
        local numeric=tonumber(value) or 100
        Config.Opacity=math.clamp(numeric/100,0.70,1)
        if Config.MenuVisible then
            Tween(Main,{GroupTransparency=1-Config.Opacity},0.1)
        end
        return true
    end

    if flag == "ui.animations" then
        Config.Animations=value==true
        if not Config.Animations then
            for object,tween in pairs(ActiveTweens) do
                pcall(function() tween:Cancel() end)
                ActiveTweens[object]=nil
            end
        end
        return true
    end

    if flag == "ui.animSpeed" then
        local speed=tostring(value or "Fast")
        if speed=="Fast" then
            Config.AnimationSpeed=0.07
        elseif speed=="Smooth" then
            Config.AnimationSpeed=0.20
        else
            Config.AnimationSpeed=0.12
        end
        return true
    end

    if flag == "ui.tooltips" then
        Config.Tooltips=value==true
        if not Config.Tooltips then HideTooltip() end
        return true
    end

    if flag == "ui.blur" then
        if not MenuBlur then
            MenuBlur=Instance.new("BlurEffect")
            MenuBlur.Name="BlockSpinMenuBlur"
            MenuBlur.Size=0
            MenuBlur.Parent=Lighting
            RuntimeUI.Blur=MenuBlur
        end
        MenuBlur.Size=(value==true and Config.MenuVisible) and 7 or 0
        return true
    end

    if flag == "ui.effects" then
        Config.Effects=value==true
        if MainGradient then MainGradient.Enabled=Config.Effects end
        if SidebarGradient then SidebarGradient.Enabled=Config.Effects end
        if TopbarAccentGradient then TopbarAccentGradient.Enabled=Config.Effects end
        if TopbarSheen then TopbarSheen.Visible=Config.Effects end
        if Config.Effects and Config.MenuVisible then task.defer(PlayPremiumSheen) end
        return true
    end

    if flag == "ui.compact" then
        ApplyCompactMode(value==true)
        return true
    end

    if flag == "bind.menu" then
        local keyName=tostring(value or "RightShift")
        if Enum.KeyCode[keyName] then
            Config.MenuKey=Enum.KeyCode[keyName]
            if StatusKey then StatusKey.Text="["..string.upper(keyName).."] MENU" end
            return true
        end
        return false
    end

    if string.sub(flag,1,5)=="bind." then
        if flag=="bind.list" then
            if value==true and not Pages.Settings.Built then EnsurePageBuilt("Settings") end
            UpdateDeviceChrome()
        end
        return true
    end

    return false
end

local SETTINGS_APPLY_ORDER={
    "ui.theme","ui.accent","ui.performanceMode","ui.deviceMode","ui.scale","ui.opacity",
    "ui.animations","ui.animSpeed","ui.tooltips","ui.effects","ui.blur","ui.compact",
    "bind.menu","bind.list",
}

function Runtime:ApplyAllSettings()
    local ok=true
    for _,flag in ipairs(SETTINGS_APPLY_ORDER) do
        local success,result=pcall(function()
            return self:ApplyUISetting(flag,State[flag])
        end)
        if not success or result==false then ok=false end
    end
    UpdateDeviceChrome()
    ApplyBuiltPageLayouts()
    return ok
end

function Runtime:SaveProfile()
    local slot = State["config.slot"] or "Default"
    local snapshot = {}

    for flag, control in pairs(Controls) do
        if flag~="config.slot" then
            if control.Get then
                snapshot[flag] = control.Get()
            elseif State[flag] ~= nil then
                snapshot[flag] = State[flag]
            end
        end
    end

    LocalWorld.Profiles[slot] = snapshot
    return true
end

function Runtime:LoadProfile()
    if self.ProfileLoadInProgress then
        return false
    end

    local slot = State["config.slot"] or "Default"
    local snapshot = LocalWorld.Profiles[slot]

    if not snapshot then
        return false
    end

    self.ProfileLoadInProgress=true
    local ok,err=pcall(function()
        for flag, value in pairs(snapshot) do
            if flag~="config.slot" then
                local control = Controls[flag]

                if control and control.Set then
                    control.Set(value, false)
                else
                    State[flag] = value
                end
            end
        end
    end)
    self.ProfileLoadInProgress=false

    if not ok then
        warn("[BlockSpin V19 Config] Load failed: "..tostring(err))
        return false
    end

    self:ApplyAllSettings()
    RefreshDependencies()
    return true
end

function Runtime:ResetProfile()
    if self.ProfileLoadInProgress then
        return false
    end

    self.ProfileLoadInProgress=true
    local ok,err=pcall(function()
        for _, pageDef in pairs(Manifest) do
            for _, subtabDef in pairs(pageDef.Subtabs) do
                for _, definition in ipairs(subtabDef.Features) do
                    if definition.Default ~= nil and definition.Flag~="config.slot" then
                        local control = Controls[definition.Flag]

                        if control and control.Set then
                            control.Set(definition.Default, false)
                        else
                            State[definition.Flag] = definition.Default
                        end
                    end
                end
            end
        end
    end)
    self.ProfileLoadInProgress=false

    if not ok then
        warn("[BlockSpin V19 Config] Reset failed: "..tostring(err))
        return false
    end

    self:ApplyAllSettings()
    RefreshDependencies()
    return true
end

function Runtime:ExportProfile()
    local snapshot = {}

    for flag, value in pairs(State) do
        local valueType = typeof(value)

        if valueType == "boolean" or valueType == "number" or valueType == "string" then
            snapshot[flag] = value
        end
    end

    local encoded = HttpService:JSONEncode(snapshot)
    self.LastExport = encoded
    print("[BlockSpin Hub Config Export]")
    print(encoded)
    return encoded
end

function Runtime:ImportLastProfile()
    if not self.LastExport or self.ProfileLoadInProgress then
        return false
    end

    local success, decoded = pcall(function()
        return HttpService:JSONDecode(self.LastExport)
    end)

    if not success or type(decoded) ~= "table" then
        return false
    end

    self.ProfileLoadInProgress=true
    local ok,err=pcall(function()
        for flag, value in pairs(decoded) do
            if flag~="config.slot" then
                local control = Controls[flag]

                if control and control.Set then
                    control.Set(value, false)
                else
                    State[flag] = value
                end
            end
        end
    end)
    self.ProfileLoadInProgress=false

    if not ok then
        warn("[BlockSpin V19 Config] Import failed: "..tostring(err))
        return false
    end

    self:ApplyAllSettings()
    RefreshDependencies()
    return true
end


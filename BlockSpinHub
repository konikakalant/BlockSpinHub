local function ShowTooltip(title,body,target)
	if not Config.Tooltips or Config.DeviceProfile=="Phone" or not target then return end
	TooltipTitle.Text=title or ""; TooltipBody.Text=body or ""
	local scale=math.clamp((Config.Scale or 1)*(Config.ResponsiveScale or 1),0.55,1.2)
	TooltipScale.Scale=scale
	local w,h=260*scale,50*scale
	local x=target.AbsolutePosition.X+target.AbsoluteSize.X+(8*scale)
	local y=target.AbsolutePosition.Y+math.max(0,(target.AbsoluteSize.Y-h)/2)
	if x+w>Root.AbsoluteSize.X-8 then x=target.AbsolutePosition.X-w-(8*scale) end
	y=math.clamp(y,8,math.max(8,Root.AbsoluteSize.Y-h-8))
	Tooltip.Position=UDim2.fromOffset(x,y); Tooltip.Visible=true; Tooltip.GroupTransparency=1
	Tween(Tooltip,{GroupTransparency=0},0.08)
end

local function AttachTooltip(target,title,body)
	local hovering=false
	target.MouseEnter:Connect(function() hovering=true; task.delay(0.4,function() if hovering then ShowTooltip(title,body,target) end end) end)
	target.MouseLeave:Connect(function() hovering=false; HideTooltip() end)
end


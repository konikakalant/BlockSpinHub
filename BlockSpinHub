-- Theme/accent callbacks can belong to lazy UI that is later destroyed.
-- Refreshing now prunes callbacks that reference dead instances instead of
-- letting stale closures accumulate for the entire session.
local function RefreshBindingList(list,...)
    local writeIndex=1
    local count=#list
    for readIndex=1,count do
        local cb=list[readIndex]
        local ok=pcall(cb,...)
        if ok then
            list[writeIndex]=cb
            writeIndex=writeIndex+1
        end
    end
    for index=count,writeIndex,-1 do
        list[index]=nil
    end
end

local function RefreshTheme()
    RefreshBindingList(ThemeBindings)
end

local function RefreshAccent()
    RefreshBindingList(AccentBindings,Theme.Accent,Theme.AccentSoft)
end

local function SetTheme(name)
    local p=ThemePresets[name]
    if not p then return end
    for k,v in pairs(p) do Theme[k]=v end

    Theme.Popup=Theme.Section
    Theme.PopupHover=Theme.RowHover
    Theme.Statusbar=Theme.Topbar
    Theme.InputHover=Theme.Input:Lerp(Theme.RowHover,0.5)

    RefreshTheme()
end

local function SetAccent(name)
    local c=AccentPresets[name]
    if not c then return end
    Theme.Accent=c
    Theme.AccentSoft=c:Lerp(Theme.White,0.2)
    RefreshAccent()
end


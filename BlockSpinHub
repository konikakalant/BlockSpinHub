function Prototype:CreateItem(index, itemType, position, value)
	local color = Color3.fromRGB(236, 183, 72)

	if itemType == "Weapon" then
		color = Color3.fromRGB(232, 90, 104)
	elseif itemType == "Crate" then
		color = Color3.fromRGB(125, 93, 57)
	elseif itemType == "General" then
		color = Color3.fromRGB(103, 126, 255)
	end

	local part = MakePart(
		self.Items,
		itemType .. " Pickup " .. tostring(index),
		Vector3.new(1.6, 1.2, 1.6),
		CFrame.new(position),
		color,
		itemType == "Cash" and Enum.Material.Neon or Enum.Material.SmoothPlastic,
		true
	)

	part:SetAttribute("PrototypeItem", true)
	part:SetAttribute("ItemType", itemType)
	part:SetAttribute("Value", value or 100)
	part:SetAttribute("Available", true)
	part:SetAttribute("Busy", false)

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "PickupPrompt"
	prompt.ActionText = itemType == "Crate" and "Open" or "Pick Up"
	prompt.ObjectText = part.Name
	prompt.HoldDuration = itemType == "Crate" and 1.5 or 0.35
	prompt.MaxActivationDistance = 9
	prompt.Parent = part

	MakeBillboard(part, part.Name, color)

	prompt.Triggered:Connect(function(player)
		if player ~= LocalPlayer then
			return
		end

		if itemType == "Crate" then
			Runtime:OpenCrate(part)
		else
			Runtime:CollectPickup(part)
		end
	end)

	return part
end


local function GetEffectiveScale()
	return math.clamp((Config.Scale or 1) * (Config.ResponsiveScale or 1), 0.38, 1.2)
end

local function GetViewportSize()
	local camera=workspace.CurrentCamera
	if camera then
		return camera.ViewportSize
	end
	return Root.AbsoluteSize
end

local function ResolveDeviceProfile()
	local forced=Config.DeviceMode or "Auto"
	if forced~="Auto" then
		return forced
	end

	local viewport=GetViewportSize()
	local touch=UserInputService.TouchEnabled
	local keyboard=UserInputService.KeyboardEnabled
	local smallest=math.min(viewport.X,viewport.Y)

	if touch and not keyboard then
		if smallest<=520 then
			return "Phone"
		end
		return "Tablet"
	end

	if touch and smallest<=700 then
		return "Tablet"
	end

	return "Desktop"
end

local function CenterWindow(animated)
	local viewport=GetViewportSize()
	local scale=GetEffectiveScale()
	local width=WINDOW_WIDTH*scale
	-- Center against the full window footprint even while minimized so
	-- restoring never expands the menu off-screen.
	local height=WINDOW_HEIGHT*scale
	local x=math.max(8,(viewport.X-width)/2)
	local y=math.max(8,(viewport.Y-height)/2)
	local target=UDim2.fromOffset(x,y)

	local shadowOffsetX=5*scale
	local shadowOffsetY=1*scale

	if animated then
		Tween(Main,{Position=target},0.12,Enum.EasingStyle.Quint)
		Tween(Shadow,{Position=UDim2.fromOffset(x-shadowOffsetX,y-shadowOffsetY)},0.12,Enum.EasingStyle.Quint)
	else
		Main.Position=target
		Shadow.Position=UDim2.fromOffset(x-shadowOffsetX,y-shadowOffsetY)
	end
end

local function UpdateResponsiveScale(recenter,animated)
	local viewport=GetViewportSize()
	local profile=ResolveDeviceProfile()
	Config.DeviceProfile=profile

	local margin=profile=="Phone" and 12 or (profile=="Tablet" and 18 or 28)
	local fitX=(viewport.X-margin)/WINDOW_WIDTH
	local fitY=(viewport.Y-margin)/WINDOW_HEIGHT
	local fit=math.min(fitX,fitY,1)

	-- V14 allows the UI to truly fit phones instead of enforcing the old
	-- desktop-only 0.68 scale floor. The lower hard floor only protects
	-- against pathological viewports.
	Config.ResponsiveScale=math.clamp(fit,0.38,1)
	local target=GetEffectiveScale()

	if animated then
		Tween(MainScale,{Scale=target},0.09,Enum.EasingStyle.Quint)
		Tween(ShadowScale,{Scale=target},0.09,Enum.EasingStyle.Quint)
		if KeybindPanelScale then Tween(KeybindPanelScale,{Scale=target},0.09,Enum.EasingStyle.Quint) end
	else
		MainScale.Scale=target
		ShadowScale.Scale=target
		if KeybindPanelScale then KeybindPanelScale.Scale=target end
	end

	UpdateDeviceChrome()

	if recenter then
		CenterWindow(animated)
	end
end


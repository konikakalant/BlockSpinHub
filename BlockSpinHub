    return humanoid ~= nil and humanoid.Health <= 10
end

function Runtime:GetActiveJobNames()
    local result = {}
    local loader = GetState("jobs.loader", false)

    if loader then
        local preferred = GetState("jobs.preferred", "Janitor")
        table.insert(result, preferred)
        return result
    end

    for jobName, flag in pairs(JobFlags) do
        if GetState(flag, false) then
            table.insert(result, jobName)
        end
    end


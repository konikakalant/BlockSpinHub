                set(previous,true)
            else
                local key=i.UserInputType==Enum.UserInputType.Keyboard and i.KeyCode.Name or i.UserInputType.Name
                set(key,false)
            end

            b.TextColor3=Theme.SubText
            bs.Color=Theme.BorderSoft
            CapturingKeybind=false
        end)
    end)

    Controls[d.Flag]={Type="keybind",Set=set,Get=function() return State[d.Flag] end,Root=r}

function Runtime:CaptureCharacterBaseline(force)
    local character=GetCharacter()
    local humanoid=GetHumanoid()

    if not character or not humanoid then
        return false
    end

    if not force and self.CharacterBaselineCharacter==character and self.CharacterBaseline then
        return true
    end

    local baseline={
        WalkSpeed=humanoid.WalkSpeed,
        JumpPower=humanoid.JumpPower,
        UseJumpPower=humanoid.UseJumpPower,
        PlatformStand=humanoid.PlatformStand,
        DisplayDistanceType=humanoid.DisplayDistanceType,
        Parts={},
    }

    for _,descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("BasePart") then
            baseline.Parts[descendant]={
                CanCollide=descendant.CanCollide,
                LocalTransparencyModifier=descendant.LocalTransparencyModifier,
            }
        end
    end

    self.CharacterBaseline=baseline
    self.CharacterBaselineCharacter=character
    return true
end

function Runtime:RestoreCharacterBaseline()
    local character=GetCharacter()
    local humanoid=GetHumanoid()
    local baseline=self.CharacterBaseline

    if not character or not humanoid or not baseline or self.CharacterBaselineCharacter~=character then
        return false
    end

    humanoid.WalkSpeed=baseline.WalkSpeed
    humanoid.JumpPower=baseline.JumpPower
    humanoid.UseJumpPower=baseline.UseJumpPower
    humanoid.PlatformStand=baseline.PlatformStand
    humanoid.DisplayDistanceType=baseline.DisplayDistanceType

    for part,values in pairs(baseline.Parts) do
        if part and part.Parent then
            part.CanCollide=values.CanCollide
            part.LocalTransparencyModifier=values.LocalTransparencyModifier
        end
    end

    return true
end

function Runtime:RememberPartBaseline(part)
    if not part or not part:IsA("BasePart") then
        return
    end

    if not self.CharacterBaseline or self.CharacterBaselineCharacter~=GetCharacter() then
        self:CaptureCharacterBaseline(true)
    end

    if self.CharacterBaseline and not self.CharacterBaseline.Parts[part] then
        self.CharacterBaseline.Parts[part]={
            CanCollide=part.CanCollide,
            LocalTransparencyModifier=part.LocalTransparencyModifier,
        }
    end
end


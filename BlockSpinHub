			visual.Label.Text = table.concat(pieces, " • ")
			visual.Label.TextColor3 = available and Theme.Success or Theme.Danger
		end
	end
end

function Runtime:UpdateInventoryOverlay(force)
	if not RuntimeUI.InventoryOverlay then
		return
	end

	local enabled = GetState("inventory.enabled", false)
	RuntimeUI.InventoryOverlay.Visible = enabled

	if RuntimeUI.InventoryBody then
		local baseSize=GetState("inventory.compact", false) and 8 or 9
		RuntimeUI.InventoryBody.TextSize=math.max(1,math.floor(baseSize*UI_TEXT_SCALE+0.5))
	end

	if not enabled then
		return
	end

	local now = os.clock()

	if not force and GetState("inventory.autoRefresh", false) then
		if now - self.LastInventoryRefresh < GetState("inventory.refreshRate", 2) then
			return
		end
	elseif not force and not GetState("inventory.autoRefresh", false) then
		return
	end

	self.LastInventoryRefresh = now

	local targetMode = GetState("inventory.targetMode", "None")
	local target = nil

	if targetMode == "Nearest Player" or targetMode == "Selected Player" then
		target = self:GetBestTarget("aim")
	elseif targetMode == "Last Target" then
		target = self.CurrentAimTarget or self.CurrentSilentTarget
	end

	if not target then
		RuntimeUI.InventoryTitle.Text = "INVENTORY • YOUR PROTOTYPE DATA"

		local items = {}

		for _, item in ipairs(Prototype.Inventory) do
			local allowed = true

			if item.Category == "Weapons" then
				allowed = GetState("inventory.filter.weapons", true)
			elseif item.Category == "Food" then
				allowed = GetState("inventory.filter.food", true)
			elseif item.Category == "Tools" then
				allowed = GetState("inventory.filter.tools", true)
			elseif item.Category == "Throwables" then
				allowed = GetState("inventory.filter.throwables", true)
			else
				allowed = GetState("inventory.filter.misc", true)
			end

			if GetState("inventory.weaponsOnly", false) then
				allowed = item.Category == "Weapons"
			end

			if allowed then
				table.insert(items, {
					Name = item.Name,
					Amount = item.Amount,
					Category = item.Category,
					Rarity = item.Rarity or InferRarity(item.Name,item.Category),
				})
			end
		end

		local sortMode = GetState("inventory.sort", "Category")

		table.sort(items, function(a, b)
			if sortMode == "Amount" then
				return a.Amount > b.Amount
			elseif sortMode == "Name" then
				return a.Name < b.Name
			elseif sortMode == "Rarity" then
				local ar=RarityRank[a.Rarity or "Common"] or 0
				local br=RarityRank[b.Rarity or "Common"] or 0
				if ar==br then return a.Name<b.Name end
				return ar>br
			else
				if a.Category == b.Category then
					return a.Name < b.Name
				end

				return a.Category < b.Category
			end
		end)

		local lines = {}

		if GetState("inventory.cash", true) then
			table.insert(lines, "Cash: $" .. tostring(math.floor(Prototype.Data.Cash)))
			table.insert(lines, "Bank: $" .. tostring(math.floor(Prototype.Data.Bank)))
		end

		for _, item in ipairs(items) do
			local line = ""

			if GetState("inventory.names", true) then
				line = item.Name
			end

			if GetState("inventory.amounts", true) then
				if line ~= "" then
					line = line .. "  x" .. tostring(item.Amount)
				else
					line = "x" .. tostring(item.Amount)
				end
			end

			if line ~= "" then
				table.insert(lines, line)
			end
		end

		RuntimeUI.InventoryBody.Text = table.concat(lines, "\n")
		return
	end

	RuntimeUI.InventoryTitle.Text = "INVENTORY • " .. target.Name

	local lines = {}
	local folder = target:FindFirstChild("PrototypeInventory")

	if GetState("inventory.cash", true) then
		table.insert(lines, "Cash: $" .. tostring(target:GetAttribute("Cash") or 0))
	end

	if folder then
		for _, item in ipairs(folder:GetChildren()) do
			if item:IsA("IntValue") then
				local category = item:GetAttribute("Category") or "Misc"
				local allowed = true

				if category == "Weapons" then
					allowed = GetState("inventory.filter.weapons", true)
				elseif category == "Food" then
					allowed = GetState("inventory.filter.food", true)
				elseif category == "Tools" then
					allowed = GetState("inventory.filter.tools", true)
				elseif category == "Throwables" then
					allowed = GetState("inventory.filter.throwables", true)
				else
					allowed = GetState("inventory.filter.misc", true)
				end

				if GetState("inventory.weaponsOnly", false) then
					allowed = category == "Weapons"
				end

				if allowed then
					local line = GetState("inventory.names", true) and item.Name or "Item"

					if GetState("inventory.amounts", true) then
						line = line .. "  x" .. tostring(item.Value)
					end

					table.insert(lines, line)
				end
			end
		end
	end

	RuntimeUI.InventoryBody.Text = table.concat(lines, "\n")
end


    local entry=Create("Frame",{Size=UDim2.new(1,0,0,20),BackgroundTransparency=1,ZIndex=62},KeybindItems)
    local entryName=Label(entry,d.Name,7,Theme.SubText,Enum.Font.GothamMedium); entryName.Size=UDim2.new(1,-62,1,0); entryName.ZIndex=63
    local entryKey=Label(entry,"["..initial.."]",7,Theme.Muted,Enum.Font.GothamBold); entryKey.Position=UDim2.new(1,-62,0,0); entryKey.Size=UDim2.fromOffset(62,20); entryKey.TextXAlignment=Enum.TextXAlignment.Right; entryKey.ZIndex=63
    KeybindEntries[d.Flag]={Root=entry,Name=entryName,Key=entryKey}

    local function set(v,silent)
        local key=tostring(v)
        State[d.Flag]=key
        b.Text=key
        entryKey.Text="["..key.."]"

        if d.Flag=="bind.menu" and Enum.KeyCode[key] then
            Config.MenuKey=Enum.KeyCode[key]
            StatusKey.Text="["..string.upper(key).."] MENU"
        end

        if not silent then
            GameplayAdapter:SetValue(d.Flag,key)
        end
    end

    b.MouseButton1Click:Connect(function()
        if CapturingKeybind then return end
        CapturingKeybind=true
        local previous=State[d.Flag]
        b.Text="PRESS..."
        b.TextColor3=Theme.AccentSoft
        bs.Color=Theme.Accent

        local con
        con=UserInputService.InputBegan:Connect(function(i)
            if i.UserInputType~=Enum.UserInputType.Keyboard and i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.MouseButton2 and i.UserInputType~=Enum.UserInputType.MouseButton3 then return end

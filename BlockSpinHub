function Runtime:ResetNavigation(owner)
	local nav=self.Navigation
	if not nav then return end
	if owner and nav.Owner and nav.Owner~=owner then return end

	DisconnectNavigationPath()
	if nav.PreviousWalkSpeed then
		local humanoid=GetHumanoid()
		if humanoid and not GetState("player.speed",false) then
			humanoid.WalkSpeed=nav.PreviousWalkSpeed
		end
		nav.PreviousWalkSpeed=nil
	end
	nav.Owner=nil
	nav.TargetName=nil
	nav.GoalPosition=nil
	nav.Waypoints={}
	nav.WaypointIndex=1
	nav.Dirty=false
	nav.LastPlanAt=0
	nav.LastProgressAt=0
	nav.LastWaypointDistance=math.huge
	nav.StuckCount=0
	nav.RoutePoints={}
	nav.PlanToken=(nav.PlanToken or 0)+1
	self:HideRouteVisuals()
end

local function RouteGroundPosition(position)
	local params=RaycastParams.new()
	params.FilterType=Enum.RaycastFilterType.Exclude
	local exclude={}
	local character=GetCharacter()
	if character then table.insert(exclude,character) end
	if RuntimeUI.RouteFolder then table.insert(exclude,RuntimeUI.RouteFolder) end
	params.FilterDescendantsInstances=exclude
	local hit=Workspace:Raycast(position+Vector3.new(0,7,0),Vector3.new(0,-18,0),params)
	if hit then
		return hit.Position+Vector3.new(0,0.18,0)
	end
	return position-Vector3.new(0,2.6,0)
end

function Runtime:BuildRoutePoints()
	local nav=self.Navigation
	nav.RoutePoints={}
	local root=GetRoot()
	if not root or #nav.Waypoints==0 then return end

	local spacing=math.max(3,GetState("jobs.bubbleSpacing",7))
	local maxDots=math.floor(math.clamp(GetState("jobs.pathMaxDots",24),8,36))
	local previous=root.Position

	for index=nav.WaypointIndex,#nav.Waypoints do
		local waypoint=nav.Waypoints[index]
		local target=waypoint.Position
		local delta=target-previous
		local distance=delta.Magnitude
		if distance>0.05 then
			local direction=delta.Unit
			local cursor=spacing
			while cursor<=distance and #nav.RoutePoints<maxDots do
				table.insert(nav.RoutePoints,RouteGroundPosition(previous+direction*cursor))
				cursor=cursor+spacing
			end
		end
		previous=target
		if #nav.RoutePoints>=maxDots then break end
	end
end

function Runtime:RefreshRouteGuide()
	self:EnsureRouteVisuals()
	local nav=self.Navigation
	local showDots=GetState("jobs.smartNav",true) and GetState("jobs.routeBubbles",false)
	local maxDots=math.floor(math.clamp(GetState("jobs.pathMaxDots",24),8,36))

	for index,dot in ipairs(RuntimeUI.RouteDots) do
		local point=nav.RoutePoints[index]
		if showDots and index<=maxDots and point then
			dot.Position=point
			dot.Transparency=0.18
		else
			dot.Transparency=1
		end
	end

	local beacon=RuntimeUI.DestinationBeacon
	local billboard=RuntimeUI.DestinationBillboard
	if beacon and nav.GoalPosition and GetState("jobs.destinationBeacon",false) then
		beacon.Position=RouteGroundPosition(nav.GoalPosition)+Vector3.new(0,0.32,0)
		beacon.Transparency=0.12
		if billboard then billboard.Enabled=true end
	elseif beacon then
		beacon.Transparency=1
		if billboard then billboard.Enabled=false end
	end
end

function Runtime:AnimateRouteGuide(now)
	local nav=self.Navigation
	if not nav or not nav.Owner then
		self:HideRouteVisuals()
		return
	end

	local root=GetRoot()
	local flow=GetState("jobs.flowAnimation",false)
	for index,dot in ipairs(RuntimeUI.RouteDots or {}) do
		if dot and dot.Parent and dot.Transparency<1 then
			local pulse=flow and (0.5+0.5*math.sin(now*5-index*0.65)) or 0.5
			local behind=root and GetDistance(root.Position,dot.Position)<2.2
			dot.Size=Vector3.new(0.34,0.34,0.34)*(1+pulse*0.32)
			dot.Transparency=behind and 0.78 or (0.18+pulse*0.16)
		end
	end

	local beacon=RuntimeUI.DestinationBeacon
	if beacon and beacon.Transparency<1 then
		local pulse=0.5+0.5*math.sin(now*4)
		beacon.Size=Vector3.new(0.72,0.72,0.72)*(1+pulse*0.25)
		local distance=root and nav.GoalPosition and GetDistance(root.Position,nav.GoalPosition) or 0
		if RuntimeUI.DestinationText then
			RuntimeUI.DestinationText.Text=string.format("%s  •  %.0f st",nav.TargetName or "Destination",distance)
		end
	end
end

function Runtime:PlanNavigation(owner,goalPosition,targetName,force)
	local root=GetRoot()
	local nav=self.Navigation
	if not root or not goalPosition then return false end

	local now=os.clock()
	local sameGoal=nav.GoalPosition and GetDistance(nav.GoalPosition,goalPosition)<1.5
	local recompute=math.max(0.5,GetState("jobs.recompute",1.5))
	if not force and nav.Owner==owner and sameGoal and not nav.Dirty and #nav.Waypoints>0 then
		return true
	end
	if not force and now-nav.LastPlanAt<recompute and nav.Owner==owner and sameGoal then
		return #nav.Waypoints>0
	end

	DisconnectNavigationPath()
	nav.Owner=owner
	nav.TargetName=targetName or owner
	nav.GoalPosition=goalPosition
	nav.LastPlanAt=now
	nav.Dirty=false
	nav.PlanToken=nav.PlanToken+1

	local path=PathfindingService:CreatePath({
		AgentRadius=2,
		AgentHeight=5,
		AgentCanJump=true,
		AgentCanClimb=true,
		WaypointSpacing=4,
	})

	local ok=pcall(function()
		path:ComputeAsync(root.Position,goalPosition)
	end)

	if ok and path.Status==Enum.PathStatus.Success then
		nav.Path=path
		nav.Waypoints=path:GetWaypoints()
		nav.WaypointIndex=math.min(2,math.max(1,#nav.Waypoints))
		nav.BlockedConnection=path.Blocked:Connect(function(blockedIndex)
			if blockedIndex>=nav.WaypointIndex then
				nav.Dirty=true
			end
		end)
	else
		nav.Path=nil
		nav.Waypoints={{Position=goalPosition,Action=Enum.PathWaypointAction.Walk}}
		nav.WaypointIndex=1
	end

	nav.LastProgressAt=now
	nav.LastWaypointDistance=math.huge
	nav.StuckCount=0
	self:BuildRoutePoints()
	self:RefreshRouteGuide()
	return #nav.Waypoints>0
end

function Runtime:StepNavigation(owner,goalPosition,targetName)
	local root=GetRoot()
	local humanoid=GetHumanoid()
	if not root or not humanoid or not goalPosition then return false,"Unavailable" end

	local arrival=math.max(2,GetState("jobs.arrivalRadius",4))
	local directDistance=GetDistance(root.Position,goalPosition)
	if directDistance<=arrival then
		self:ResetNavigation(owner)
		return true,"Arrived"
	end

	local mode=GetState("jobs.navMode","Walk")
	if mode=="Teleport" then
		root.CFrame=CFrame.new(goalPosition,goalPosition+root.CFrame.LookVector)
		self:ResetNavigation(owner)
		return true,"Teleported"
	end

	if not GetState("jobs.smartNav",true) then
		humanoid:MoveTo(goalPosition)
		return false,"Direct"
	end

	local nav=self.Navigation
	local sameGoal=nav.Owner==owner and nav.GoalPosition and GetDistance(nav.GoalPosition,goalPosition)<1.5
	if not sameGoal or nav.Dirty or #nav.Waypoints==0 then
		self:PlanNavigation(owner,goalPosition,targetName,nav.Dirty)
	end

	local waypoint=nav.Waypoints[nav.WaypointIndex]
	if not waypoint then
		self:PlanNavigation(owner,goalPosition,targetName,true)
		waypoint=nav.Waypoints[nav.WaypointIndex]
		if not waypoint then return false,"No path" end
	end

	local waypointDistance=GetDistance(root.Position,waypoint.Position)
	if waypointDistance<=math.max(2.2,arrival*0.7) then
		nav.WaypointIndex=nav.WaypointIndex+1
		waypoint=nav.Waypoints[nav.WaypointIndex]
		if not waypoint then
			if GetDistance(root.Position,goalPosition)<=arrival*1.35 then
				self:ResetNavigation(owner)
				return true,"Arrived"
			end
			self:PlanNavigation(owner,goalPosition,targetName,true)
			waypoint=nav.Waypoints[nav.WaypointIndex]
			if not waypoint then return false,"No path" end
		end
		nav.LastWaypointDistance=math.huge
		self:BuildRoutePoints()
		self:RefreshRouteGuide()
	end

	if waypoint.Action==Enum.PathWaypointAction.Jump then
		humanoid.Jump=true
	end

	if mode=="Sprint" then
		if not nav.PreviousWalkSpeed then nav.PreviousWalkSpeed=humanoid.WalkSpeed end
		humanoid.WalkSpeed=math.max(nav.PreviousWalkSpeed,22)
	elseif nav.PreviousWalkSpeed then
		if not GetState("player.speed",false) then humanoid.WalkSpeed=nav.PreviousWalkSpeed end
		nav.PreviousWalkSpeed=nil
	end
	humanoid:MoveTo(waypoint.Position)

	local now=os.clock()
	local currentDistance=GetDistance(root.Position,waypoint.Position)
	if currentDistance<nav.LastWaypointDistance-0.45 then
		nav.LastWaypointDistance=currentDistance
		nav.LastProgressAt=now
		nav.StuckCount=0
	elseif GetState("jobs.stuckRecovery",false) and now-nav.LastProgressAt>=GetState("jobs.stuckTimeout",3) then
		nav.StuckCount=nav.StuckCount+1
		nav.Dirty=true
		nav.LastProgressAt=now
		if nav.StuckCount>=3 then
			-- Fall back to a direct MoveTo route instead of teleporting the player.
			-- This keeps recovery realistic while still escaping bad path results.
			nav.Waypoints={{Position=goalPosition,Action=Enum.PathWaypointAction.Walk}}
			nav.WaypointIndex=1
			nav.Dirty=false
			nav.StuckCount=0
			nav.LastWaypointDistance=math.huge
			humanoid:MoveTo(goalPosition)
			self:BuildRoutePoints()
			self:RefreshRouteGuide()
			return false,"Direct recovery"
		end
		self:PlanNavigation(owner,goalPosition,targetName,true)
		return false,"Recovering"
	end

	return false,"Moving"
end


function Runtime:UpdateESP()
	local enabled = GetState("esp.enabled", false)
	if not enabled then
		for _,visual in pairs(Prototype.TargetVisuals) do
			if visual.Billboard then visual.Billboard.Enabled=false end
			if visual.Highlight then visual.Highlight.Enabled=false end
			if visual.Selection then visual.Selection.Visible=false end
			if visual.HeadDot then visual.HeadDot.Enabled=false end
			if visual.Tracer then visual.Tracer.Visible=false end
			if visual.LookLine then visual.LookLine.Visible=false end
			if visual.Arrow then visual.Arrow.Visible=false end
		end
		return
	end
	local root = GetRoot()
	local camera = Camera

	if not root or not camera then
		return
	end

	local targets = Prototype:GetTargets()
	local viewport = camera.ViewportSize
	local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)

	for index, model in ipairs(targets) do
		local visual = self:EnsureTargetVisual(model, index)
		local targetRoot = model:FindFirstChild("HumanoidRootPart")
		local humanoid = model:FindFirstChildOfClass("Humanoid")

		if visual and targetRoot and humanoid then
			local distance = GetDistance(root.Position, targetRoot.Position)
			local withinDistance = not GetState("esp.distanceLimit", true)
				or distance <= GetState("esp.maxDistance", 1500)
			local show = enabled and withinDistance

			if GetState("esp.teamCheck", false)
				and model:GetAttribute("PrototypeTeam") == LocalPlayer:GetAttribute("PrototypeTeam") then
				show = false
			end

			local color = self:GetESPColor(index)

			if GetState("esp.teamColors", false) then
				color = model:GetAttribute("PrototypeTeam") == "Blue"
					and Color3.fromRGB(75, 135, 255)
					or Color3.fromRGB(235, 82, 99)
			end

			visual.Billboard.Enabled = show and (
				GetState("esp.names", true)
					or GetState("esp.healthText", true)
					or GetState("esp.distance", true)
					or GetState("esp.weapon", true)
					or GetState("esp.inventory", false)
			)

			visual.Name.Visible = GetState("esp.names", true)
			visual.Name.Text = GetState("esp.displayNames", true)
				and model.Name
				or "Target " .. tostring(index)
			visual.Name.TextColor3 = color
			visual.Name.TextSize = GetState("esp.textSize", 13)

			local infoParts = {}

			if GetState("esp.healthText", true) then
				table.insert(infoParts, tostring(math.floor(humanoid.Health)) .. " HP")
			end

			if GetState("esp.distance", true) then
				table.insert(infoParts, tostring(math.floor(distance)) .. "m")
			end

			visual.Info.Text = table.concat(infoParts, "  •  ")
			visual.Info.TextColor3 = Theme.SubText

			local extraParts = {}

			if GetState("esp.weapon", true) then
				table.insert(extraParts, "Street Pistol")
			end

			if GetState("esp.inventory", false) then
				table.insert(extraParts, "4 items")
			end

			visual.Extra.Text = table.concat(extraParts, "  •  ")

			visual.BoxFrame.Visible = show and GetState("esp.boxes", true)
			visual.BoxFrame.BackgroundTransparency = GetState("esp.fill", false) and 0.82 or 1
			visual.BoxFrame.BackgroundColor3 = color
			visual.BoxStroke.Color = color
			visual.Skeleton.Visible = show and GetState("esp.skeleton", false)
			visual.Skeleton.TextColor3 = color

			visual.HealthBack.Visible = show and GetState("esp.healthBar", true)
			visual.HealthBack.Position = GetState("esp.healthSide", "Left") == "Right"
				and UDim2.new(1, -5, 0, 4)
				or UDim2.fromOffset(2, 4)

			local healthPercent = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
			visual.HealthFill.Size = UDim2.new(1, 0, healthPercent, 0)
			visual.HealthFill.BackgroundColor3 = Color3.fromRGB(
				math.floor(255 * (1 - healthPercent)),
				math.floor(210 * healthPercent),
				85
			)

			visual.Highlight.Enabled = show and GetState("esp.chams", false)
			visual.Highlight.FillColor = color
			visual.Highlight.FillTransparency = GetState("esp.chamsTransparency", 45) / 100

			visual.Selection.Visible = show and GetState("esp.box3d", false)
			visual.Selection.Color3 = color

			visual.HeadDot.Enabled = show and GetState("esp.headDot", false)
			visual.Dot.BackgroundColor3 = color

			local screenPoint, onScreen = camera:WorldToViewportPoint(targetRoot.Position)
			local point = Vector2.new(screenPoint.X, screenPoint.Y)

			if show and GetState("esp.tracers", false) and onScreen and screenPoint.Z > 0 then
				local originMode = GetState("esp.tracerOrigin", "Bottom")
				local from

				if originMode == "Center" then
					from = center
				elseif originMode == "Top" then
					from = Vector2.new(center.X, 0)
				elseif originMode == "Mouse" then
					from = UserInputService:GetMouseLocation()
				else
					from = Vector2.new(center.X, viewport.Y)
				end

				self:UpdateLine(visual.Tracer, from, point, 1, color)
			elseif visual.Tracer then
				visual.Tracer.Visible = false
			end

			if show and GetState("esp.lookDirection", false) and onScreen and screenPoint.Z > 0 and visual.Head then
				local endWorld = visual.Head.Position + visual.Head.CFrame.LookVector * 7
				local endPoint, endOnScreen = camera:WorldToViewportPoint(endWorld)

				if endOnScreen and endPoint.Z > 0 then
					self:UpdateLine(
						visual.LookLine,
						point,
						Vector2.new(endPoint.X, endPoint.Y),
						1,
						color
					)
				end
			elseif visual.LookLine then
				visual.LookLine.Visible = false
			end

			if show and GetState("esp.arrows", false) and (not onScreen or screenPoint.Z <= 0) then
				local direction = point - center

				if direction.Magnitude < 0.001 then
					direction = Vector2.new(0, -1)
				end

				direction = direction.Unit

				local radius = GetState("esp.arrowRadius", 160)
				local arrowPos = center + direction * radius
				local angle = math.deg(math.atan2(direction.Y, direction.X)) + 90

				visual.Arrow.Visible = true
				visual.Arrow.Position = UDim2.fromOffset(arrowPos.X - 11, arrowPos.Y - 11)
				visual.Arrow.Rotation = angle
				visual.Arrow.TextColor3 = color
				visual.Arrow.TextSize = GetState("esp.arrowSize", 15)
			else

function Runtime:ApplyUISetting(flag, value)
	if flag == "ui.theme" then
		SetTheme(value)
		return true
	end

	if flag == "ui.accent" then
		SetAccent(value)
		return true
	end

	if flag == "ui.deviceMode" then
		Config.DeviceMode = tostring(value or "Auto")
		UpdateResponsiveScale(true,true)
		UpdateDeviceChrome()
		return true
	end

	if flag == "ui.performanceMode" then
		Config.PerformanceMode = tostring(value or "Auto")
		return true
	end

	if flag == "ui.scale" then
		Config.Scale = math.clamp(value / 100,0.70,1.2)
		UpdateResponsiveScale(false,true)
		local clamped=ClampWindowPosition(Main.Position)
		Tween(Main,{Position=clamped},0.1)
		local scale=GetEffectiveScale()
		Tween(Shadow,{Position=UDim2.fromOffset(clamped.X.Offset-(5*scale),clamped.Y.Offset-(1*scale))},0.1)
		return true
	end

	if flag == "ui.opacity" then
		Config.Opacity = math.clamp(value / 100,0.7,1)
		if Config.MenuVisible then
			Tween(Main,{GroupTransparency=1-Config.Opacity},0.1)
		end
		return true
	end

	if flag == "ui.animations" then
		Config.Animations = value == true
		return true
	end

	if flag == "ui.animSpeed" then
		if value == "Fast" then
			Config.AnimationSpeed = 0.07
		elseif value == "Smooth" then
			Config.AnimationSpeed = 0.2
		else
			Config.AnimationSpeed = 0.12
		end

		return true
	end

	if flag == "ui.tooltips" then
		Config.Tooltips = value == true

		if not Config.Tooltips then
			HideTooltip()
		end

		return true
	end

	if flag == "ui.blur" then
		if not RuntimeUI.Blur then
			RuntimeUI.Blur = Instance.new("BlurEffect")
			RuntimeUI.Blur.Name = "BlockSpinPrototypeBlur"
			RuntimeUI.Blur.Size = 0
			RuntimeUI.Blur.Parent = Lighting
		end

		RuntimeUI.Blur.Size = value and 12 or 0
		return true
	end

	if flag == "ui.compact" then
		local targetHeight = value and 29 or 34

		for _, control in pairs(Controls) do
			if control.Root and control.Root:IsA("Frame") and control.Type ~= "slider" then
				control.Root.Size = UDim2.new(1, 0, 0, targetHeight)
			end
		end

		return true
	end

	if flag == "ui.testWorld" then
		SetPrototypeWorldVisible(value == true)

		if value ~= true then
			SetPrototypeDebugLabelsVisible(false)
		else
			SetPrototypeDebugLabelsVisible(GetState("ui.testLabels", false))
		end

		return true
	end

	if flag == "ui.testLabels" then
		SetPrototypeDebugLabelsVisible(
			value == true and GetState("ui.testWorld", false) == true
		)
		return true
	end

	if flag == "bind.menu" then
		local keyName=tostring(value or "RightShift")
		if Enum.KeyCode[keyName] then
			Config.MenuKey=Enum.KeyCode[keyName]
			if StatusKey then StatusKey.Text="["..string.upper(keyName).."] MENU" end
		end
		return true
	end

	if flag == "bind.list" then
		UpdateDeviceChrome()
		return true
	end

	return false
end

function Runtime:SaveProfile()
	local slot = State["config.slot"] or "Default"
	local snapshot = {}

	for flag, control in pairs(Controls) do
		if flag~="config.slot" then
			if control.Get then
				snapshot[flag] = control.Get()
			elseif State[flag] ~= nil then
				snapshot[flag] = State[flag]
			end
		end
	end

	Prototype.Profiles[slot] = snapshot
	return true
end

function Runtime:LoadProfile()
	if self.ProfileLoadInProgress then
		return false
	end

	local slot = State["config.slot"] or "Default"
	local snapshot = Prototype.Profiles[slot]

	if not snapshot then
		return false
	end

	self.ProfileLoadInProgress=true
	local ok,err=pcall(function()
		for flag, value in pairs(snapshot) do
			if flag~="config.slot" then
				local control = Controls[flag]

				if control and control.Set then
					control.Set(value, false)
				else
					State[flag] = value
				end
			end
		end
	end)
	self.ProfileLoadInProgress=false

	if not ok then
		warn("[BlockSpin V14 Config] Load failed: "..tostring(err))
		return false
	end

	RefreshDependencies()
	return true
end

function Runtime:ResetProfile()
	if self.ProfileLoadInProgress then
		return false
	end

	self.ProfileLoadInProgress=true
	local ok,err=pcall(function()
		for _, pageDef in pairs(Manifest) do
			for _, subtabDef in pairs(pageDef.Subtabs) do
				for _, definition in ipairs(subtabDef.Features) do
					if definition.Default ~= nil and definition.Flag~="config.slot" then
						local control = Controls[definition.Flag]

						if control and control.Set then
							control.Set(definition.Default, false)
						else
							State[definition.Flag] = definition.Default
						end
					end
				end
			end
		end
	end)
	self.ProfileLoadInProgress=false

	if not ok then
		warn("[BlockSpin V14 Config] Reset failed: "..tostring(err))
		return false
	end

	RefreshDependencies()
	return true
end

function Runtime:ExportProfile()
	local snapshot = {}

	for flag, value in pairs(State) do
		local valueType = typeof(value)

		if valueType == "boolean" or valueType == "number" or valueType == "string" then
			snapshot[flag] = value
		end
	end

	local encoded = HttpService:JSONEncode(snapshot)
	self.LastExport = encoded
	print("[BlockSpin Prototype Config Export]")
	print(encoded)
	return encoded
end

function Runtime:ImportLastProfile()
	if not self.LastExport or self.ProfileLoadInProgress then
		return false
	end

	local success, decoded = pcall(function()
		return HttpService:JSONDecode(self.LastExport)
	end)

	if not success or type(decoded) ~= "table" then
		return false
	end

	self.ProfileLoadInProgress=true
	local ok,err=pcall(function()
		for flag, value in pairs(decoded) do
			if flag~="config.slot" then
				local control = Controls[flag]

				if control and control.Set then
					control.Set(value, false)
				else
					State[flag] = value
				end
			end
		end
	end)
	self.ProfileLoadInProgress=false

	if not ok then
		warn("[BlockSpin V14 Config] Import failed: "..tostring(err))
		return false
	end

	RefreshDependencies()
	return true
end

function Runtime:RunAction(flag)
	local masterFlag=DependencyMaster[flag]
	if masterFlag and not IsDependencyChainEnabled(flag) then
		return false, "Enable the parent feature first ("..tostring(masterFlag)..").", "warning"
	end

	if flag == "inventory.refresh" then
		self:UpdateInventoryOverlay(true)
		return true, "Inventory view refreshed.", "success"
	end

	if flag == "weaponCosmetics.apply" then
		local success = self:ApplyWeaponCosmetics(false)
		return success, success and "Weapon cosmetic applied to Prototype Pistol." or "Equip/create the Prototype Pistol first.", success and "success" or "warning"
	end

	if flag == "weaponCosmetics.reset" then
		local success = self:ApplyWeaponCosmetics(true)
		return success, success and "Prototype Pistol cosmetic reset." or "Prototype Pistol was not found.", success and "success" or "warning"
	end

	if flag == "vehicle.applyCosmetics" then
		local success = self:ApplyVehicleCosmetics()
		return success, success and "Vehicle cosmetic applied." or "Prototype vehicle was not found.", success and "success" or "warning"
	end

	if flag == "vehicle.repairNow" then
		if Prototype.Car then
			Prototype.Car:SetAttribute("Health", 100)
			return true, "Prototype vehicle repaired to 100%.", "success"
		end

		return false, "Prototype vehicle was not found.", "warning"
	end

	if flag == "vehicle.unlock" then
		if Prototype.Car then
			Prototype.Car:SetAttribute("Locked", false)
			return true, "Prototype vehicle unlocked.", "success"
		end

		return false, "Prototype vehicle was not found.", "warning"
	end

	if flag == "world.reset" then
		self:ResetWorldSettings()
		return true, "World settings reset.", "success"
	end

	if flag == "ui.center" then
		CenterWindow(true)
		return true, "Window centered.", "success"
	end

	if flag == "config.save" then
		self:SaveProfile()
		return true, "Saved profile: " .. tostring(GetState("config.slot", "Default")), "success"
	end

	if flag == "config.load" then
		local success = self:LoadProfile()
		return success, success and "Profile loaded." or "No saved profile exists in this play session.", success and "success" or "warning"
	end

	if flag == "config.reset" then
		self:ResetProfile()
		return true, "Current controls reset to defaults.", "success"
	end

	if flag == "config.export" then
		self:ExportProfile()
		return true, "Config JSON printed to Studio Output and stored for Import.", "success"
	end

	if flag == "config.import" then
		local success = self:ImportLastProfile()
		return success, success and "Last exported config imported." or "Export a config first.", success and "success" or "warning"
	end

	if flag == "server.rejoin" then
		Prototype:Init()
		return true, "Prototype session rebuilt from a clean state.", "success"
	end

	if flag == "server.hop" then
		Prototype:Init()

		local targets = Prototype:GetTargets()

		for index, target in ipairs(targets) do
			if GetState("server.lowPop", false) and index > 2 then
				target.Parent = nil
			elseif target.PrimaryPart then
				target:PivotTo(target.PrimaryPart.CFrame * CFrame.new(math.random(-12, 12), 0, math.random(-12, 12)))
			end
		end

		return true, GetState("server.lowPop", false) and "Low-population prototype server simulated." or "Prototype world randomized to simulate a new server.", "success"
	end

	if flag == "server.copy" then
		local text = "studio://place/" .. tostring(game.PlaceId) .. "/job/" .. tostring(game.JobId)
		self.LastExport = text
		print("[Prototype Server Link] " .. text)
		return true, "Prototype server reference printed to Output.", "success"
	end

	if flag == "tp.toPlayer" then
		local target = self:GetTeleportPlayerTarget()
		local part = target and target:FindFirstChild("HumanoidRootPart")
		local success = self:TeleportTo(part)
		return success, success and "Teleported to the selected prototype target." or "Select Nearest Player or Last Target first.", success and "success" or "warning"
	end

	if flag == "tp.spectate" then
		local target = self:GetTeleportPlayerTarget()
		local success = self:SpectateTarget(target)
		return success, success and "Spectating for 5 seconds." or "No prototype target selected.", success and "success" or "warning"
	end

	if flag == "tp.copyName" then
		local target = self:GetTeleportPlayerTarget()

		if target then
			print("[Prototype Target Name] " .. target.Name)
			return true, target.Name .. " printed to Studio Output.", "success"
		end

		return false, "No prototype target selected.", "warning"
	end

	if string.sub(flag, 1, 3) == "tp." then
		local location = Prototype:GetLocationByAction(flag)
		local success = self:TeleportTo(location)
		return success, success and "Teleported to the prototype location." or "Prototype location was not found.", success and "success" or "warning"
	end

	if flag == "diag.runtime" then
		local activeErrors=0
		for _,errorState in pairs(self.SystemErrors) do
			if (errorState.Count or 0)>0 or (errorState.DisabledUntil or 0)>os.clock() then activeErrors=activeErrors+1 end
		end
		local message=string.format(
			"builtPages=%d/%d themeBindings=%d accentBindings=%d atmHacks=%d watchdogTrips=%d activeErrorBackoffs=%d",
			BuiltPageCount,
			(function() local n=0 for _ in pairs(Pages) do n=n+1 end return n end)(),
			#ThemeBindings,#AccentBindings,
			self.ATMSession and self.ATMSession.Hacks or 0,
			self.ATMSession and self.ATMSession.WatchdogTrips or 0,
			activeErrors
		)
		print("[BlockSpin V14 Diagnostics] "..message)
		return true,message,"success"
	end

	if flag == "diag.atmStress" then
		local passed,recovered,failed=0,0,0
		local atmCount=Prototype.ATMs and #Prototype.ATMs:GetChildren() or 0
		local baseVehicle=self:IsFarmVehicleReady()
		local servicesReady=(Prototype.Bank and Prototype.Bank.Parent~=nil and Prototype.ToolShop and Prototype.ToolShop.Parent~=nil)
		local routePolicy=GetState("atm.route","Nearest")
		local validPolicy=routePolicy=="Nearest" or routePolicy=="Safest" or routePolicy=="Highest Value"

		for index=1,100 do
			local scenario=index%5
			local ok=atmCount>=5 and servicesReady and validPolicy
			local didRecover=false

			if scenario==0 then
				-- Missing vehicle: should be recoverable only with automatic vehicle recovery.
				ok=ok and GetState("atm.autoVehicle",true) and GetState("atm.autoRecoverVehicle",true)
				didRecover=ok
			elseif scenario==1 then
				-- No tools: either existing cash can fund a restock or Auto Buy is enabled.
				ok=ok and (GetState("atm.buyTools",false) or Prototype.Data.Cash>=180)
				didRecover=ok
			elseif scenario==2 then
				-- Route stall: requires bounded retry/recovery settings.
				ok=ok and GetState("atm.autoRecoverVehicle",true) and GetState("atm.vehicleRetries",3)>=1
				didRecover=ok
			elseif scenario==3 then
				-- ATM cooldown: needs another target or skip-unavailable behavior.
				ok=ok and (atmCount>1 or GetState("atm.skipUnavailable",true))
				didRecover=ok
			else
				-- Normal path validates the base vehicle and target/service graph.
				ok=ok and baseVehicle
			end

			if ok then
				passed=passed+1
				if didRecover then recovered=recovered+1 end
			else
				failed=failed+1
			end
		end

		local message=string.format(
			"ATM prototype stress: %d/100 passed • %d recovery cases passed • %d failed",
			passed,recovered,failed
		)
		print("[BlockSpin V14 Diagnostics] "..message)
		return failed==0,message,failed==0 and "success" or "warning"
	end

	if flag == "diag.clearErrors" then
		self.SystemErrors={}
		return true,"Runtime subsystem error counters cleared.","success"
	end

	if flag == "about.status" then
		return true, "V14 adaptive premium Studio prototype runtime is active.", "success"
	end

	if flag == "about.version" then
		return true, "V14 Adaptive Purple / Resilient Automation Build.", "success"
	end

	if flag == "about.unload" then
		self:Stop()
		Prototype:Clear()
		ClosePopup()
		HideTooltip()
		ActiveSliderDrag=nil
		CleanupUIConnections()
		ScreenGui:Destroy()
		return true, "", "success"
	end

	return true, "Action completed in the Studio prototype.", "success"
end

function Runtime:SetFeature(flag, value)
	self:ApplyUISetting(flag, value)

	if string.sub(flag,1,7)=="player." or string.sub(flag,1,9)=="identity." or flag=="melee.fists" then
		self.PlayerCleanupPending=true
		if flag=="player.noclip" or flag=="identity.invisible" then
			self.CharacterVisualAccumulator=1
		end
	end

	if string.sub(flag, 1, 7) == "hitbox." then
		self:UpdateHitboxes()
	end

	if flag == "identity.invisible" or flag == "identity.hideName" then
		self:UpdatePlayer(0)
	end

	if flag == "inventory.enabled" then
		self:UpdateInventoryOverlay(true)
	end

	if flag == "misc.fastPrompts" or flag == "misc.instantInteract" then
		self:UpdatePrompts()
	end

	if flag == "bind.list" then
		UpdateDeviceChrome()
	end

	if flag=="atm.enabled" then
		if value~=true then
			self:ResetATMSession("Disabled")
		else
			self.ATMSession.Phase="Select"
			self.ATMSession.Target=nil
			self.ATMSession.TargetKind=nil
			self:UpdateATMHUD("START","Checking vehicle and services","")
		end
	end

	if flag=="config.autoload" and value==true and not self.ProfileLoadInProgress then
		self:LoadProfile()
	end

	if flag=="jobs.smartNav" and value~=true then
		self:ResetNavigation()
	elseif flag=="jobs.routeBubbles" or flag=="jobs.destinationBeacon" then
		if self.Navigation.Owner then self:RefreshRouteGuide() else self:HideRouteVisuals() end
	end

	return true
end

function Runtime:SetValue(flag, value)
	self:ApplyUISetting(flag, value)

	if flag == "hitbox.preset" then
		self:ApplyHitboxPreset(value)
	elseif string.sub(flag, 1, 7) == "hitbox." then
		self:UpdateHitboxes()
	end

	if flag == "inventory.targetMode" or string.sub(flag, 1, 10) == "inventory." then
		self:UpdateInventoryOverlay(true)
	end

	if flag == "config.slot" and State["config.autoload"]==true and not self.ProfileLoadInProgress then
		self:LoadProfile()
	end

	if flag == "misc.fastPrompts" or flag == "misc.instantInteract" then
		self:UpdatePrompts()
	end

	if flag == "vehicle.paint" or flag == "vehicle.finish" or flag == "vehicle.tint" then
		if GetState("vehicle.cosmetics", false) then
			self:ApplyVehicleCosmetics()
		end
	end

	if string.sub(flag,1,5)=="jobs." and self.Navigation.Owner then
		if flag=="jobs.bubbleSpacing" or flag=="jobs.pathMaxDots" then
			self:BuildRoutePoints()
		end
		self:RefreshRouteGuide()
	end

	return true
end


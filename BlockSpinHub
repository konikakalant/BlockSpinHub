local function ClampWindowPosition(position)
	local viewport=Root.AbsoluteSize
	local effectiveScale=GetEffectiveScale()
	local scaledWidth=WINDOW_WIDTH*effectiveScale
	local scaledHeight=(minimized and TOPBAR_HEIGHT or WINDOW_HEIGHT)*effectiveScale
	local absoluteX=viewport.X*position.X.Scale+position.X.Offset
	local absoluteY=viewport.Y*position.Y.Scale+position.Y.Offset
	local maxX=math.max(8,viewport.X-scaledWidth-8)
	local maxY=math.max(8,viewport.Y-scaledHeight-8)
	absoluteX=math.clamp(absoluteX,8,maxX)
	absoluteY=math.clamp(absoluteY,8,maxY)
	return UDim2.fromOffset(absoluteX,absoluteY)
end


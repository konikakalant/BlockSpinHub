function Runtime:UpdateATMESP()
	if not Prototype.ATMs then
		return
	end

	if not GetState("atm.esp",false) then
		for _,visual in pairs(Prototype.ATMVisuals) do
			if visual.Gui then visual.Gui.Enabled=false end
		end
		return
	end


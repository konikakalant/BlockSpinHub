local function readyWorld(rec)
    return rec.kind ~= "gui"
        and rec.inst.Parent ~= nil
        and now() >= (State.Cooldowns[rec.inst] or 0)
end

-- Fairness beats pure greed here.
--
-- Picking the nearest ready target looks obvious and behaves badly: one dead
-- station a few studs away wins every single round, and the two photo tables
-- and the pack station on the far side of the plot are never visited at all.
-- So a target that has not been attempted in a while is preferred over a
-- closer one, and distance only breaks ties. Nothing is ever starved, and the
-- cost of being slightly less than nearest-first is a few extra steps.
local function pickWorldTarget(bucket)
    local list = State.Targets[bucket]
    if not list or #list == 0 then return nil end
    local t = now()
    local best, bestScore = nil, nil
    for _, rec in ipairs(list) do
        if readyWorld(rec) and positionOf(rec.inst) then
            -- One blended score instead of two questions, because the earlier
            -- versions were both wrong:
            --
            --   - pure nearest-first starved everything behind one dead
            --     station a few studs away;
            --   - comparing idle SECONDS against distance STUADS in the same
            --     expression made the picker settle on "always the farthest";
            --   - a strict "least recently tried, distance only as a
            --     tiebreak" version starved the far targets outright whenever
            --     every candidate had just been attempted.
            --
            -- Waiting time is the reward, distance is a gentle cost. A target
            -- ignored for much longer than it is far away still wins, and
            -- among equally ignored targets the nearer one does. Monotonic in
            -- both inputs, so nothing can be starved by a tie.
            local idle = t - (rec.lastTried or 0) + Config.FairnessEpsilon
            local d = distanceTo(rec.inst) or 0
            -- learned usefulness: a target that keeps producing a change
            -- outranks an equally distant one that never does, and one that
            -- always fails is pushed back without ever being dropped
            local quality = qualityOf(rec.inst)
            if quality < Config.QualityFloor then quality = Config.QualityFloor end
            local score = idle / (1 + d / Config.FairnessScale) * (0.5 + quality)
            if bestScore == nil or score > bestScore then
                best, bestScore = rec, score
            end
        end
    end
    return best
end

-- Taking a QC photo is an aiming action, not a button press: the game wants
-- the crosshair on the table (usually with a camera tool equipped) and often a
-- moment of holding before the shot lands. Walk in, aim, hold, click, and
-- retry from a slightly different spot if the shot did not register.
local function firePhoto(rec)
    if distanceTo(rec.inst) > math.max(rec.range, 14) then return false end
    equipToolForBucket("photo")

    -- A station can expose a ProximityPrompt that sits a few studs from the
    -- part itself. Such a station is discovered as a "key" target, and the
    -- aiming path would have clicked past the prompt and done nothing. Try the
    -- prompt first, exactly as the generic station path does.
    local parent = rec.inst.Parent
    if parent then
        for _, d in ipairs(parent:GetDescendants()) do
            if d:IsA("ProximityPrompt") and d.Enabled and distanceTo(d) <= 6 then
                if triggerPrompt(d) then
                    State.LastTrigger[rec.inst] = now()
                    return true, "prompt"
                end
            end
        end
    end

    local pos = aimPointOn(rec.inst)
    if not pos then return false end

    -- aim at the middle of the part, not its top edge, and settle for a
    -- moment: the camera script rewrites CFrame every frame, so the shot has
    -- to be taken while the aim is actually being held
    if not aimAt(pos, 0, 0.1) then return false end

    -- only fire if the crosshair is genuinely on the target; if the first
    -- aim missed, try once more from the same spot before giving up
    local onTarget = reticleOnTarget(rec.inst)
    if not onTarget then
        if not aimAt(pos, 0, 0.1) then return false end
        onTarget = reticleOnTarget(rec.inst)
    end

    local shot = false
    if onTarget then
        shot = clickAtReticle()
    end
    if not shot then
        -- builds that want the part clicked rather than the crosshair
        shot = clickWorldPart(rec.inst) or false
    end
    if shot then
        State.LastTrigger[rec.inst] = now()
        -- a second frame of contact helps games that check on the next update
        task.wait(0.08)
        return true, "aim"
    end
    return false
end

local function fireRecord(rec)
    if rec.kind == "prompt" then
        equipToolForBucket(rec.bucket)
        return triggerPrompt(rec.inst)
    elseif rec.kind == "click" then
        if distanceTo(rec.inst) > rec.range then return false end
        if rec.bucket == "photo" then
            return firePhoto(rec)
        end
        equipToolForBucket(rec.bucket)
        if clickWorldPart(rec.inst) then
            State.LastTrigger[rec.inst] = now()
            return true
        end
        return false
    elseif rec.kind == "key" then
        if distanceTo(rec.inst) > rec.range then return false end

        -- photos need aiming; everything else uses the generic path
        if rec.bucket == "photo" then
            return firePhoto(rec)
        end
        equipToolForBucket(rec.bucket)

        local parent = rec.inst.Parent
        if parent then
            for _, d in ipairs(parent:GetDescendants()) do
                if d:IsA("ProximityPrompt") and d.Enabled and distanceTo(d) <= 6 then
                    if triggerPrompt(d) then
                        State.LastTrigger[rec.inst] = now()
                        return true, "prompt"
                    end
                end
            end
        end

        -- E is what most prompt-less stations listen for.
        if pressInteractKey() then
            State.LastTrigger[rec.inst] = now()
            -- Also click the part: games that read raw mouse input on a
            -- raycast ignore the key press entirely.
            clickWorldPart(rec.inst)
            return true, "key"
        end

        if clickWorldPart(rec.inst) then
            State.LastTrigger[rec.inst] = now()
            return true, "click"
        end
        return false
    elseif rec.kind == "pad" then
        return true
    end
    return false
end

local function runTarget(bucket, statKey, label)
    if not State.Features[bucket] then
        if Nav.Record and Nav.Record.bucket == bucket then clearNav() end
        return
    end

    if Nav.Record and Nav.Record.bucket == bucket then
        local rec = Nav.Record
        if rec.inst.Parent == nil then
            clearNav()
            return
        end
        local d = distanceTo(rec.inst)
        if d <= rec.range then
            local ok, mode = fireRecord(rec)
            if ok then
                setCd(rec.inst, cdFor(rec.kind, rec.inst, bucket))
                State.Cooldowns["__" .. bucket] = now() +
                    (bucket == "raid" and 2 or Config.PromptCooldown)
                State.Stats[statKey] = State.Stats[statKey] + 1
                noteAction(bucket, statKey, rec.inst, rec.kind)
                if now() > State.ConfirmUntil then
                    State.ConfirmUntil = now() + Config.ConfirmWindow
                    State.ConfirmCount = 0
                    State.ConfirmArmedAt = now()
                    State.ConfirmEmptyScans = 0
                    State.ConfirmBucket = bucket
                    State.ConfirmFromGui = false
                end
                State.LastAction = label
                if mode == "aim" then
                    addLog(label .. " #" .. State.Stats[statKey] .. " (aimed shot)")
                elseif mode == "key" then
                    addLog(label .. " #" .. State.Stats[statKey] .. " (E key)")
                else
                    addLog(label .. " #" .. State.Stats[statKey])
                end
            else
                setCd(rec.inst, now() + 2)
            end
            clearNav()
        elseif now() > Nav.Until then
            addLog(label .. ": move timeout — skipping target")
            setCd(rec.inst, now() + 15)
            clearNav()
        else
            moveToTarget(rec)
        end
        return
    end

    local list = State.Targets[bucket]
    if list and (now() >= State.ConfirmUntil or not State.ConfirmFromGui)
        and State.GuiClicksThisTick < Config.MaxGuiClicksPerTick then
        -- ROTATE THROUGH GUI LISTS.
        --
        -- GUI targets are sorted biggest-first, so the scan handed back the
        -- same prominent button over and over. For an order list that means one
        -- row is processed while the others sit there untouched. Starting the
        -- search from a rotating offset, combined with each button's own
        -- cooldown, walks the whole list instead.
        local n = #list
        if n > 0 then
        -- Rotate is a ZERO-based offset and start is one-based, so the offset
        -- stored back must be the picked index reduced modulo n and NOT
        -- re-incremented: storing "(start + k) % n + 1" made the offset
        -- identical to the start again whenever n divided evenly, so a two-row
        -- list clicked row one for ever.
        local firstIndex = ((State.Rotate[bucket] or 0) % n) + 1
        -- Two passes: the rotation decides WHO gets a turn, and the learned
        -- quality decides whether this is the turn to take. A button that has
        -- been producing changes is preferred over an equally ready one that
        -- never does - but only as a preference, because the second pass takes
        -- whatever is ready, so nothing in the list can be starved.
        local function rowReady(rec)
            return rec.kind == "gui" and rec.inst.Parent
                and guiVisible(rec.inst)
                and now() >= (State.Cooldowns[rec.inst] or 0)
        end
        local chosen, chosenIdx = nil, nil
        local scanFrom = firstIndex
        -- Every QualityTurnEvery-th pick, quality is ignored entirely. The
        -- cadence comes from a PICK COUNTER, not from the rotation offset: the
        -- offset only moves when a different row is chosen, so deriving the
        -- cadence from it produced a constant and starved every low-quality
        -- row no matter how many picks were made.
        if ((State.GuiPicks[bucket] or 0) % Config.QualityTurnEvery) ~= 0 then
            for k = 0, n - 1 do
                local idx = ((firstIndex - 1 + k) % n) + 1
                local rec = list[idx]
                if rowReady(rec) and qualityOf(rec.inst) >= Config.QualityStart then
                    chosen, chosenIdx = rec, idx
                    break
                end
                -- where this pass gave up, so the fallback resumes from here
                -- instead of rescanning the rows just rejected
                scanFrom = idx
            end
        end
        if not chosen then
            for k = 0, n - 1 do
                local idx = ((scanFrom - 1 + k) % n) + 1
                local rec = list[idx]
                if rowReady(rec) then
                    chosen, chosenIdx = rec, idx
                    break
                end
            end
        end
        do
            local rec, idx = chosen, chosenIdx
            if rec and rec.inst.Parent and guiVisible(rec.inst)
                and now() >= (State.Cooldowns[rec.inst] or 0) then
                -- A confirm-shaped button can also be reached here, not just
                -- through the confirm chain: a row labelled "Confirm Order"
                -- matches the order bucket. Only those buttons are checked,
                -- because the check walks the button's window and must stay
                -- off the path of every ordinary click.
                local confirmShaped = isConfirmText(lower(rec.inst.Text or ""))
                local allowed = true
                if confirmShaped then
                    allowed = confirmIsSafe(rec.inst)
                end
                if allowed and uiClick(rec.inst) then
                    State.Rotate[bucket] = idx % n
                    State.GuiPicks[bucket] = (State.GuiPicks[bucket] or 0) + 1
                    State.GuiClicksThisTick = State.GuiClicksThisTick + 1
                    setCd(rec.inst, cdFor("gui", rec.inst, bucket))
                    State.Stats[statKey] = State.Stats[statKey] + 1
                    noteAction(bucket, statKey, rec.inst, "gui")
                    if now() > State.ConfirmUntil then
                        State.ConfirmUntil = now() + Config.ConfirmWindow
                        State.ConfirmCount = 0
                        State.ConfirmArmedAt = now()
                        State.ConfirmEmptyScans = 0
                        State.ConfirmBucket = bucket
                        State.ConfirmFromGui = true
                    end
                    State.LastGuiClick = rec.inst
                    State.LastGuiClickAt = now()
                    State.LastAction = label
                    addLog(label .. " (gui) #" .. State.Stats[statKey])
                    return
                else
                    setCd(rec.inst, now() + Config.GuiTargetCooldown)
                end
            end
        end
        end
    end

    if Nav.Record and Nav.Record.bucket ~= bucket then
        return
    end

    if now() < (State.Cooldowns["__" .. bucket] or 0) then return end
    local target = pickWorldTarget(bucket)
    if not target then return end
    setNav(target)
end


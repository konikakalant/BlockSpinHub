local function onCharacterAdded(character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    if humanoid then
        State.SpeedApplied = false
        State.EquippedTool = nil
        State.EquippedToolFor = nil
        State.LastAction = nil
        State.CollectingUntil = 0
        clearNav()
        addLog("character spawned")
        task.delay(1, function()
            rescanNow()
        end)
        if State.Features.autocodes and not State.Paused then
            task.delay(6, function()
                if State.Running and State.Features.autocodes and not State.Paused then
                    addLog("auto-codes: redeeming on join")
                    safeCall(redeemCodes)
                end
            end)
        end
    end
end


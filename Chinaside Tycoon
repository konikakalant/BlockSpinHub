-- actions: scanner report
--------------------------------------------------------------------------------

-- Why is a mode working or not? This is the answer the player actually wants,
-- and it is what turns "nothing happens" into something actionable.
-- How many of a mode's most RECENT attempts were confirmed. A mode is only
-- "working" while it is still working.
-- good / total over the recent window, plus whether the MOST RECENT judged
-- attempt actually worked.
--
-- The last one matters more than the ratio. A mode that worked five times and
-- then went quiet still has five "true"s sitting in an eight-wide window, so
-- a ratio alone would keep calling it WORKING for several more misses. The
-- question a player actually asks is "is this working right now", and the
-- newest attempt is the honest answer to that.
local function recentScore(key)
    local hist = State.History[key]
    if not hist or #hist == 0 then return 0, 0, false end
    local good = 0
    for _, ok in ipairs(hist) do
        if ok then good = good + 1 end
    end
    return good, #hist, hist[#hist] == true
end

local function modeVerdict(bucket)
    local key = STAT_KEYS[bucket]
    local tries = State.Stats[key] or 0
    local recentGood, recentN, recentLast = recentScore(key)
    local targets = #State.Targets[bucket]
    if not State.Features[bucket] then
        return "DISABLED", "toggle is off"
    elseif targets == 0 then
        return "NO TARGETS", "nothing in the base matched - walk closer, then F7"
    elseif tries == 0 then
        return "READY", ("%d target(s) waiting"):format(targets)
    elseif recentLast then
        -- "WORKING" now means working RIGHT NOW: the most recent judged
        -- attempt landed. It used to mean "confirmed at least once, ever", so
        -- a mode that worked for two minutes and then went stale kept its
        -- green light for the rest of the session.
        return "WORKING", ("%d of last %d confirmed"):format(recentGood, recentN)
    elseif (State.Misses[key] or 0) >= 3 then
        return "NOT RESPONDING",
            ("%d tries with no change - wrong button, or nothing to do")
                :format(tries)
    end
    return "TRYING", ("%d tries so far"):format(tries)
end

-- The SCAN report is the one thing a user is asked to go and read, and today
-- it only exists in the console and scrolls away. Writing it next to the
-- settings file means the user can just open it, and it can be pasted into an
-- issue without re-running anything.
local function writeScanReport(lines)
    local ok = pcall(function()
        writefile(SCAN_REPORT_FILE, table.concat(lines, "\n"))
    end)
    if ok then
        addLog("scan report written to " .. SCAN_REPORT_FILE)
    end
end

local function runScanReport()
    rescanNow()
    findGuiObjects(true)
    local lines = {}
    lines[#lines + 1] = "=== ChinaSide Auto Hub scan report ==="
    lines[#lines + 1] = "place=" .. tostring(game.PlaceId) .. " time=" .. os.date("%H:%M:%S")
    lines[#lines + 1] = "base=" .. (State.Base and State.Base:GetFullName() or "nil")
        .. " why=" .. tostring(State.BaseWhy)
    lines[#lines + 1] = ("counts: prompts=%d click=%d stations=%d gui=%d"):format(
        State.Counts.prompt, State.Counts.click, State.Counts.key, State.Counts.gui)
    lines[#lines + 1] = "--- per-mode verdict ---"
    if State.CashKnown and State.CashNow then
        lines[#lines + 1] = ("  wallet: %s (earned %s this session)")
            :format(tostring(math.floor(State.CashNow)),
                tostring(math.floor(State.Earned or 0)))
    else
        lines[#lines + 1] = "  wallet: not exposed by this game " ..
            "(falling back to on-screen numbers)"
    end
    for _, bucket in ipairs(BUCKET_ORDER) do
        local verdict, why = modeVerdict(bucket)
        local on = "OFF"
        if State.Features[bucket] then
            on = "on"
        end
        local verdictText = ("  %-8s %-14s %-9s %s"):format(
            tostring(bucket), tostring(verdict), on, tostring(why))
        lines[#lines + 1] = verdictText
    end
    for _, bucket in ipairs(BUCKET_ORDER) do
        local list = State.Targets[bucket]
        lines[#lines + 1] = ("targets.%s=%d"):format(tostring(bucket), #list)
        for i = 1, math.min(#list, 6) do
            local rec = list[i]
            local name = "?"
            pcall(function()
                name = rec.inst:GetFullName()
            end)
            local extra = ""
            if rec.kind == "gui" and rec.inst:IsA("TextButton") then
                extra = " [" .. tostring(rec.inst.Text) .. "]"
            end
            lines[#lines + 1] = ("  - %s: %s%s"):format(rec.kind, name, extra)
        end
    end
    local g = State.GuiParts
    lines[#lines + 1] = ("ui: shop=%s codesTab=%s codeBox=%s redeem=%s bribe=%s"):format(
        tostring(g.shop and g.shop:GetFullName()),
        tostring(g.codesTab and g.codesTab:GetFullName()),
        tostring(g.codeBox and g.codeBox:GetFullName()),
        tostring(g.redeem and g.redeem:GetFullName()),
        tostring(g.bribe and g.bribe:GetFullName()))
    local remotes = {}
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
            local n = lower(d.Name)
            if matchAny(n, { "order", "ship", "photo", "qc", "crate", "hire", "raid",
                             "bribe", "code", "cash", "collect", "claim", "tycoon" }) then
                remotes[#remotes + 1] = d.ClassName .. ":" .. d:GetFullName()
            end
        end
    end
    local scMissing = State.SelfCheckMissing or 0
    lines[#lines + 1] = ("self-check: %d/%d functions resolved%s"):format(
        (State.SelfCheckTotal or 0) - scMissing, State.SelfCheckTotal or 0,
        scMissing > 0 and (" - MISSING: " .. tostring(State.SelfCheckNames)) or "")
    lines[#lines + 1] = "== what the hub has LEARNED =="
    for _, bucket in ipairs(BUCKET_ORDER) do
        local lat = State.Latency[bucket]
        local tune = State.Tune[bucket]
        local good = 0
        local h = State.History[STAT_KEYS[bucket]]
        if h then for _, v in ipairs(h) do if v then good = good + 1 end end end
        lines[#lines + 1] = ("  %-8s measured response %-8s spacing %-8s recent %d/%d")
            :format(bucket:upper(),
                lat and string.format("%.2fs", lat) or "unknown",
                tune and string.format("%.2fs", tune) or "default",
                good, h and #h or 0)
        -- did this mode ever do anything?  This is the question that matters
        -- most and the one the keyword lists cannot answer.
        local tries = State.ResponseTries[bucket] or 0
        local moves = State.ResponseMoves[bucket] or 0
        if tries > 0 then
            local mark = ""
            if modeProvenUseless(bucket) then
                mark = "   <-- never worked, not being clicked"
            end
            lines[#lines + 1] = ("  %-8s counter moved after %d of %d clicks%s")
                :format(bucket:upper(), moves, tries, mark)
        end
    end
    local qn = 0
    for _ in pairs(State.Quality) do qn = qn + 1 end
    lines[#lines + 1] = ("  targets with learned quality: %d"):format(qn)
    lines[#lines + 1] = "keyword remotes (report only, never fired): " .. #remotes
    for i = 1, math.min(#remotes, 12) do
        lines[#lines + 1] = "  - " .. remotes[i]
    end
    local report = table.concat(lines, "\n")
    print(report)
    -- also to a file, so the report can be opened and pasted later instead of
    -- being lost to the console scrollback
    writeScanReport(lines)
    addLog(("scan: %d lines printed (base=%s)"):format(
        #lines, State.Base and State.Base:GetName() or "nil"))
    for i = math.min(#lines, 6), 1, -1 do
        addLog(lines[i])
    end
    setStatus("scan complete — " .. #lines .. " lines, also saved to file")
    return report
end


-- What the observer is reading off the screen right now, and how fast each
-- mode has tuned itself. This is the visible proof the hub is reading the
-- game rather than just guessing from keywords.
local function readGameLine()
    local parts, n = {}, 0
    for _, bucket in ipairs(BUCKET_ORDER) do
        local c = State.CounterByBucket and State.CounterByBucket[bucket]
        local t = State.Tune[bucket]
        local tuned = t and t < Config.DefaultTune - 0.05
        if c or tuned or State.Latency[bucket] then
            n = n + 1
            if n > 3 then break end
            local piece = bucket:upper()
            if c then piece = piece .. " " .. c.value end
            if t and t < Config.DefaultTune - 0.05 then
                piece = piece .. "@" .. string.format("%.1f", t) .. "s"
            end
            -- the measured response time, so the learning is visible rather
            -- than a black box: "@3.2s" is the tuned interval, "/3.6s" the
            -- measured time the game actually took to react
            local lat = State.Latency[bucket]
            if lat then
                piece = piece .. "/" .. string.format("%.1f", lat) .. "s"
            end
            parts[#parts + 1] = piece
        end
    end
    if n == 0 then return "no counters read" end
    return table.concat(parts, "  ")
end

local function updateStatsText()
    if not Gui or not Gui.Stats then return end
    for key, dot in pairs(toggleRows) do
        local on = State.Features[key] and true or false
        -- only touch a property when it actually changes: writing every tick
        -- forces a layout pass 4 times a second for no visible gain
        if dot:GetAttribute("on") ~= on then
            dot:SetAttribute("on", on)
            dot.BackgroundColor3 = on and COLORS.on or COLORS.off
        end
    end
    for key, label in pairs(toggleValues) do
        local text
        local statKey = toggleStats[key]
        local color
        if statKey then
            local tries = State.Stats[statKey] or 0
            -- colour by the RECENT window, not by lifetime. A mode that
            -- worked once hours ago should not still be showing green.
            local _, _, recentLast = recentScore(statKey)
            text = tostring(tries)
            if tries == 0 then
                color = COLORS.dim
            elseif recentLast then
                -- working right now: bright
                color = COLORS.on
            elseif tries >= 6 then
                -- clicking, but the game is not changing: flag it
                color = COLORS.warn
            else
                color = COLORS.text
            end
        else
            text = State.Features[key] and "on" or "off"
            color = State.Features[key] and COLORS.on or COLORS.off
        end
        if label:GetAttribute("t") ~= text then
            label:SetAttribute("t", text)
            label.Text = text
        end
        if label:GetAttribute("c") ~= color then
            label:SetAttribute("c", color)
            label.TextColor3 = color
        end
    end
    local s = State.Stats
    local elapsed = math.max(0, math.floor(now() - (State.StartedAt > 0 and State.StartedAt or now())))
    local mm = math.floor(elapsed / 60)
    local ss = elapsed % 60

    local function commas(n)
        n = math.floor(n or 0)
        local neg = n < 0
        local t = tostring(math.abs(n))
        local out = t:reverse():gsub("(%d%d%d)", "%1,"):reverse()
        out = out:gsub("^,", "")
        if neg then out = "-" .. out end
        return out
    end

    -- real money, not a guess: cash earned this session and the rate it is
    -- arriving at. This is the honest answer to "is any of this working?"
    local earned = math.floor(State.Earned or 0)
    local rate = 0
    if elapsed >= 20 and earned > 0 then
        rate = math.floor(earned / (elapsed / 60))
    end
    local money
    if State.CashKnown and State.CashNow then
        money = ("cash %s | earned %s | %s/min"):format(
            commas(State.CashNow), commas(earned), commas(rate))
    else
        money = ("earned ~%s | %s/min"):format(commas(earned), commas(rate))
    end

    local text = ("%s\nphotos %d orders %d ships %d rewards %d | run %d:%02d\n%s")
        :format(money, s.photos, s.orders, s.ships, s.rewards, mm, ss, readGameLine())
    if Gui.Stats:GetAttribute("t") ~= text then
        Gui.Stats:SetAttribute("t", text)
        Gui.Stats.Text = text
    end
end

-- orders panel: defined here so uiClick (above) is in scope

local function ensureOrderPanelOpen()
    if not State.Features.order then return end
    if now() - State.LastOrderPanelTry < Config.OrderPanelInterval then return end
    if State.ConfirmFromGui and State.ConfirmUntil > now() then return end
    State.LastOrderPanelTry = now()

    -- "Orders" is often a toggle, so require a long gap since our last click.
    if now() - State.LastOrderPanelClick < Config.OrderPanelInterval * 2 then
        return false
    end

    local btn = findOrderPanel()
    if not btn or not btn.Parent then return false end

    -- Only reopen when nothing order-ish is on screen. If a panel is already
    -- showing, clicking a tab again would close it.
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, d in ipairs(playerGui:GetDescendants()) do
            if (d:IsA("TextButton") or d:IsA("ImageButton")) and guiVisible(d)
                and not inHubGui(d) then
                local t = buttonText(d)
                if matchAny(t, ORDER_TAB) and not matchAny(t, WORKFLOW_EXCLUDE)
                    and d ~= btn then
                    return false
                end
            end
        end
    end

    if uiClick(btn) then
        State.LastOrderPanelClick = now()
        State.LastGuiClick = btn
        State.LastGuiClickAt = now()
        addLog("opened orders panel")
        return true
    end
    return false
end

-- stuck recovery: defined here so tick (below) can call it

local function checkStuck()
    if Nav.Record then
        -- Progress is measured against whatever the player is walking TOWARD
        -- right now. On a pathfind route that is the next waypoint, not the
        -- target: walking a detour around a wall barely reduces the
        -- straight-line distance to the target, so measuring against the target
        -- made a healthy route look stuck and shelved it. That defeated the
        -- entire point of pathfinding in exactly the situation it was added
        -- for: teleport off, obstacle in the way.
        -- Progress is measured two ways at once, because either one alone
        -- gives a false answer:
        --   dVia    - distance to the waypoint being walked toward
        --   dTarget - straight-line distance to the target itself
        --
        -- Measuring only dVia breaks the moment the character REACHES a
        -- waypoint: distance collapses to ~0, so the "is it shrinking" test can
        -- never pass and a perfectly healthy 100-stud walk gets declared stuck
        -- and shelved. Measuring only dTarget breaks on a detour, where the
        -- straight line barely moves while the route is working fine.
        local hr = getRoot()
        local via = navProgressTarget()
        local dVia = math.huge
        if via and hr then dVia = (hr.Position - via).Magnitude end
        local dTarget = distanceTo(Nav.Record.inst) or math.huge
        local t = now()
        if State.StuckLastCheck == 0 then
            State.StuckLastCheck = t
        end
        local dt = t - State.StuckLastCheck
        if dt < 0 or dt > 2 then dt = Config.TickRate end
        State.StuckLastCheck = t

        -- Measure LACK OF PROGRESS, not raw distance: a long but healthy walk
        -- must never look stuck. Only count time while NEITHER distance is
        -- actually shrinking, and standing on (or within reach of) the waypoint
        -- counts as progress in its own right, because that is the normal
        -- state between waypoints and not a sign of being wedged.
        local prev = State.StuckPrevDist or 0
        local prevVia = State.StuckPrevVia or math.huge
        local advancing = dVia <= 3
            or (prevVia ~= math.huge and dVia <= prevVia - 0.5)
            or (prev ~= 0 and dTarget <= prev - 0.5)
        State.StuckPrevVia = dVia
        if advancing then
            -- genuinely closing in: renew the move budget so a long walk is
            -- never cut off by the move timeout
            local renew = now() + Config.MoveTimeout
            if Nav.Until < renew then
                Nav.Until = renew
            end
            State.StuckSince = 0
        else
            State.StuckSince = State.StuckSince + dt
        end
        State.StuckPrevDist = dTarget

        -- Escalating recovery instead of giving up straight away: hop fences
        -- first, then nudge past the blocker, only shelve at the threshold.
        if State.StuckSince > 2 and now() - State.LastStuckJump > 1.2 then
            State.LastStuckJump = now()
            local humanoid = getHumanoid()
            if humanoid and humanoid.Health > 0 then
                -- a seated character ignores MoveTo entirely
                if humanoid.Sit then
                    pcall(function() humanoid.Sit = false end)
                end
                pcall(function() humanoid.Jump = true end)
            end
        end
        if State.StuckSince > 5 and State.Features.tp
            and now() - State.LastTeleport > Config.TeleportGap then
            State.LastTeleport = now()
            local pos = positionOf(Nav.Record.inst)
            local root = getRoot()
            if pos and root then
                pcall(function()
                    local flat = root.Position - pos
                    flat = Vector3.new(flat.X, 0, flat.Z)
                    if flat.Magnitude > 0.5 then
                        flat = flat.Unit * 3
                    else
                        flat = Vector3.new(0, 0, -3)
                    end
                    root.CFrame = CFrame.new(pos + flat + Vector3.new(0, 4, 0))
                end)
            end
        end

        if State.StuckSince >= State.StuckThreshold then
            addLog("stuck detected — clearing nav, will rescan")
            setCd(Nav.Record.inst, now() + 30)
            clearNav()
            State.StuckSince = 0
            State.StuckPrevDist = 0
        end
    else
        State.StuckSince = 0
        State.StuckPrevDist = 0
        State.StuckLastCheck = now()
    end
end

--------------------------------------------------------------------------------
-- AFK MODE
--
-- Everything above assumes somebody is watching. AFK mode is the version that
-- has to hold up with nobody there, and the difference is not "keep clicking" -
-- it is that nothing may be allowed to fail SILENTLY and stay failed.
--
-- The purchase guard, the stuck ladder, the respawn handler and every
-- event-driven rescan already run unattended. What was missing is a single
-- place that notices when the whole thing has quietly stopped making progress
-- and puts it right. That is the watchdog, and it escalates:
--
--   1. a modal is sitting on screen   -> close it
--   2. errors are arriving in a burst -> drop cached state, which is what
--                                        corrupted state usually looks like
--   3. nothing has been confirmed      -> forget the world, rescan
--   4. still nothing                  -> forget what it has LEARNED too, so a
--                                        bad measurement cannot wedge it
--   5. still nothing                  -> report it clearly, and stop trying, so
--                                        the status line tells the truth rather
--                                        than spinning forever
--------------------------------------------------------------------------------

local function afkStuckModal()
    -- A confirm-shaped button that has been continuously visible this long is a
    -- dialog nothing closed. While it is up it swallows clicks, so every later
    -- action is wasted until it goes.
    local list = State.ConfirmList
    if not list or #list == 0 then
        State.StuckModalSince = nil
        return false
    end
    -- nil-check, not "== 0": a sentinel that can collide with a real
    -- timestamp silently disables the very check it guards
    if not State.StuckModalSince then
        State.StuckModalSince = now()
        return false
    end
    if now() - State.StuckModalSince < Config.AfkStuckModalAfter then return false end
    for _, d in ipairs(list) do
        if d.Parent and guiVisible(d) and confirmIsSafe(d) and uiClick(d) then
            addLog("afk: closed a dialog that had been stuck open")
            State.StuckModalSince = nil
            return true
        end
    end
    return false
end

-- Invariants that should never be false, checked cheaply and repaired. A
-- long unattended run is exactly where these drift.
local function afkRepairInvariants()
    local t = now()
    -- the pending queue must stay bounded
    if #State.Pending > Config.MaxPending * 2 then
        table.clear(State.Pending)
        addLog("afk: pending queue had grown out of hand, cleared")
    end
    -- per-instance maps are keyed by instance, so a destroyed part would leak
    local live = 0
    for inst in pairs(State.NoChange) do
        if inst.Parent == nil then
            State.NoChange[inst] = nil
        else
            live = live + 1
        end
    end
    for inst in pairs(State.Cooldowns) do
        -- Cooldowns holds STRING keys as well as instances: "__order",
        -- "__pads", "__raid", "__raidui". Reading .Parent off a string does not
        -- error, it returns nil, so an unguarded sweep silently deleted every
        -- one of them on every pass and quietly disabled the per-mode pacing.
        if typeof(inst) == "Instance" and inst.Parent == nil then
            State.Cooldowns[inst] = nil
        end
    end
    -- a cooldown in the future forever would silently park a target
    for inst, when in pairs(State.Cooldowns) do
        -- a cooldown parked further out than ten minutes is not a backoff, it
        -- is a target that will never be tried again
        if type(when) == "number" and when > t + 600 then
            State.Cooldowns[inst] = nil
        end
    end
    -- learned spacing must stay inside its bounds
    for bucket, v in pairs(State.Tune) do
        local lo = spacingFloor(bucket)
        if v < lo then
            State.Tune[bucket] = lo
        elseif v > Config.MaxBackoff then
            State.Tune[bucket] = Config.MaxBackoff
        end
    end
    -- nav pointing at something destroyed
    if Nav.Record and Nav.Record.inst.Parent == nil then
        clearNav()
        clearPath()
    end
    return live
end

-- Escalating recovery. Each step is more destructive than the last, and the
-- last one reports rather than repeating for ever.
-- WHY did it stop? Answer it in the log, from what the hub already knows.
--
-- This does not guess. Every line below is a number the hub already measured,
-- so the answer is either "it is clicking 40 times and its counter has never
-- moved" or "there are no targets in the base at all" - both of which point
-- straight at the fix.
local function afkDiagnose()
    -- Kept deliberately plain: a local table built by appending, read with
    -- ipairs, and never measured with "#". The length of a table the analyzer
    -- cannot see an array part in makes it abandon type inference for the whole
    -- file, which is a far worse outcome than three extra lines here.
    local lines = {}
    local count = 0
    -- annotated, and deliberately not a closure over mutable state: both make
    -- the type solver's job appreciably harder, and this file is close enough
    -- to its inference budget that a small extra cost makes the checker give
    -- up on the WHOLE file - which would mean it silently stops reporting real
    -- problems.
    local function say(text: string)
        count = count + 1
        lines[count] = text
    end

    -- First thing reported, because it explains all the others. A build with a
    -- function that did not resolve is not "not working well", it is a
    -- different program from the one that was reviewed, and no amount of
    -- recovery will help.
    local scMissing = State.SelfCheckMissing or 0
    if scMissing > 0 then
        say(string.format("SELF-CHECK FAILED: %d of %d functions did not "
            .. "resolve: %s", scMissing, State.SelfCheckTotal or 0,
            tostring(State.SelfCheckNames)))
    end

    local targetTotal = 0
    for _, bucket in ipairs(BUCKET_ORDER) do
        if State.Features[bucket] then
            local list = State.Targets[bucket]
            local n = 0
            if list then n = #list end
            targetTotal = targetTotal + n
            -- Useless is reported FIRST: it is the more specific fact, and it
            -- explains the missing targets as a consequence rather than the
            -- other way round.
            if modeProvenUseless(bucket) then
                local tries = responseOf(bucket)
                say(string.format("%s: %d clicks, its counter never moved",
                    bucket:upper(), tries))
            elseif n == 0 and bucket ~= "collect" then
                say(bucket:upper() .. ": no targets found")
            end
        end
    end
    if targetTotal == 0 then
        say("no targets at all - the hub cannot see the base")
    end
    if not State.Base then
        say("base not found - walk to your plot")
    end
    if next(State.CounterByBucket) == nil then
        say("no readable counters - the planner and the response learning "
            .. "both need those")
    end
    if State.Errors and State.Errors > 0 then
        local text = tostring(State.LastErrorText)
        say("last error: " .. text:sub(1, 80))
    end
    if count == 0 then
        say("targets exist and counters are readable, but nothing confirmed "
            .. "- the buttons are probably not the ones the game listens to")
    end
    addLog("afk diagnosis:")
    for i = 1, count do addLog(lines[i]) end
    addLog("afk: F7 writes a full report to " .. SCAN_REPORT_FILE)
    return count
end

local function afkRecover(step)
    if step == 1 then
        addLog("afk: no progress - forgetting targets and rescanning")
        clearNav()
        clearPath()
        clearTargets()
        rescanNow()
    elseif step == 2 then
        addLog("afk: still no progress - forgetting learned timings too")
        State.Latency = {}
        State.Tune = {}
        State.Quality = {}
        State.LastTried = {}
        State.History = {}
        State.NoChange = {}
        clearNav()
        clearPath()
        clearTargets()
        State.Base = nil
        rescanNow()
    elseif step == 3 then
        addLog("afk: STILL no progress - something changed in the game")
        -- "something changed" is useless on its own. Work out WHAT, and say
        -- so: a hub that gives up with a diagnosis is a hub the player can fix
        -- in one message, and a hub that gives up with nothing is a hub they
        -- have to go and investigate themselves.
        safeCall(afkDiagnose)
        -- Everything that can be done from here has been done. Say so ONCE and
        -- stop, rather than repeating the same recovery every few seconds for
        -- the rest of the session: if the game has genuinely changed, no
        -- amount of retrying will fix that, and a hub that retries for ever
        -- while the counter behind it climbs into the thousands is a worse
        -- failure than one that admits the problem.
        State.RecoveryDone = true
    end
end

local function watchdog()
    local t = now()
    if t - (State.WatchAt or 0) < Config.AfkWatchEvery then return end
    State.WatchAt = t

    if afkStuckModal() then return end

    safeCall(afkRepairInvariants)

    -- An old error is not part of a burst. Without this the counter never
    -- decayed, so the third error of the session - hours after the first two -
    -- still read as a burst and dropped every cached target for no reason.
    if State.Errors > 0 and t - (State.LastErrorAt or 0) >= Config.AfkErrorWindow then
        State.Errors = 0
    end
    -- error burst: clear cached state, because a repeating error usually means
    -- something the hub cached no longer matches the game
    if State.Errors > 0 and t - (State.LastErrorAt or 0) < Config.AfkErrorWindow
        and State.Errors >= Config.AfkErrorBurst then
        State.Errors = 0
        addLog("afk: " .. (State.LastErrorText or "errors") ..
            " - dropping cached targets and rescanning")
        clearNav()
        clearPath()
        clearTargets()
        State.Base = nil
        rescanNow()
        return
    end

    -- SELF-CHECK ON THE LEARNING ITSELF.
    --
    -- "This mode never does anything" is a conclusion drawn from evidence, and
    -- evidence goes stale: a game update renames a button and every learned
    -- verdict about it becomes wrong. Worse, if EVERY mode ends up believed
    -- useless then nothing is ever attempted, the hub reports itself perfectly
    -- healthy, and it sits there silent for ever. Believing that nothing works
    -- is itself the thing to distrust, so when it happens the verdicts are
    -- thrown away and the world re-read.
    -- Re-trial, before anything else. One mode at a time, on a timer, so a
    -- stale verdict costs at most one wasted click in three minutes and the
    -- hub cannot be permanently wrong about a mode it stopped testing.
    if t - (State.LastUselessCheck or 0) >= Config.UselessRecheckEvery then
        State.LastUselessCheck = t
        for _, bucket in ipairs(BUCKET_ORDER) do
            if modeProvenUseless(bucket) then
                local tries = responseOf(bucket)
                addLog(("afk: retrying %s - it was judged useless after %d "
                    .. "clicks, the game may have changed")
                    :format(bucket:upper(), tries))
                State.ResponseTries[bucket] = nil
                State.ResponseMoves[bucket] = nil
                State.IdleSaid[bucket] = nil
                break
            end
        end
    end

    local usable, believed = 0, 0
    for _, bucket in ipairs(BUCKET_ORDER) do
        if State.Features[bucket] and not NOTHING_SAFE_SKIP[bucket] then
            usable = usable + 1
            if modeProvenUseless(bucket) then believed = believed + 1 end
        end
    end
    if usable > 0 and believed >= usable then
        State.ResponseTries = {}
        State.ResponseMoves = {}
        for k in pairs(State.IdleSaid) do State.IdleSaid[k] = nil end
        addLog("afk: believed no mode worked at all - discarding that and "
            .. "looking again (the game may have changed)")
        clearNav()
        clearPath()
        clearTargets()
        rescanNow()
        return
    end

    -- no confirmed work at all
    -- How much the hub has actually ATTEMPTED, read straight from the stat
    -- table. Eight reads every few seconds, and it is what separates "nothing
    -- is broken, there is simply nothing to do" from "it is clicking and
    -- nothing is happening".
    local totalTries = 0
    for _, key in pairs(STAT_KEYS) do
        totalTries = totalTries + (State.Stats[key] or 0)
    end
    local triesMoved = totalTries > (State.LastSeenTries or 0)
    State.LastSeenTries = totalTries
    if triesMoved then State.LastTriesAt = t end

    -- Escalate only when it is TRYING and getting nothing. The earlier version
    -- gated on time since AFK was switched on, which fired a full recovery
    -- every eight seconds for the whole session while work was confirming
    -- perfectly well - resetting the stuck and move-timeout timers each time,
    -- so a genuinely unreachable target could never be shelved.
    -- Escalation means "it tried something verifiable and got nothing". If the
    -- only recent work is walking cash pads, there is nothing here to escalate
    -- about - and treating that as a fault would latch NEEDS ATTENTION on a
    -- perfectly healthy collect-only base within a minute.
    local realWorkHappened = (State.LastRealTryAt or 0) > (State.LastConfirmedAt or 0)
    if triesMoved and realWorkHappened
        and (t - (State.LastConfirmedAt or 0)) > Config.AfkNoProgressAfter
        and not State.RecoveryDone
        and t - (State.LastRecoveryAt or 0) >= Config.AfkRecoveryGap then
        State.LastRecoveryAt = t
        State.RecoveryStep = (State.RecoveryStep or 0) + 1
        afkRecover(State.RecoveryStep)
    end
end

-- One line, always true, for the status bar while unattended.
local function afkStatus()
    if not State.Afk then return nil end
    local up = math.floor(now() - (State.AfkSince or now()))
    local mins = math.floor(up / 60)
    local secs = up % 60
    local bits = {
        ("AFK %d:%02d"):format(mins, secs),
        ("%d done"):format(State.TotalConfirmed or 0),
    }
    -- shown apart from the confirmations, because a pad walk is credited
    -- without evidence and must not be presented as though it were proven
    if (State.TotalPadWalks or 0) > 0 then
        bits[#bits + 1] = ("+%d pads"):format(State.TotalPadWalks)
    end
    if State.PipelineJob then
        bits[#bits + 1] = State.PipelineJob:upper()
    end
    if State.RecoveryDone then
        bits[#bits + 1] = "NEEDS ATTENTION"
    elseif State.RecoveryStep and State.RecoveryStep > 0 then
        bits[#bits + 1] = ("recovering x%d"):format(State.RecoveryStep)
    end
    -- only report errors that are actually recent; a single old hiccup should
    -- not sit in the status line for the rest of the session
    if State.Errors and State.Errors > 0
        and now() - (State.LastErrorAt or 0) < Config.AfkErrorWindow then
        bits[#bits + 1] = ("%d errors"):format(State.Errors)
    end
    return table.concat(bits, " \u{00B7} ")
end

local function tick()
    if not State.Running then return end

    State.GuiClicksThisTick = 0
    safeCall(runPurchaseGuard)
    -- the watchdog only exists while unattended; it runs on its own interval,
    -- never per tick
    -- not while paused: PAUSE is documented as freezing all automation, and a
    -- watchdog that clears targets and rescans behind the user's back is the
    -- opposite of that
    if State.Afk and not State.Paused then safeCall(watchdog) end

    -- keep the hub on screen if the window was resized or dragged
    if Gui and Gui.Clamp and now() - (State.LastClamp or 0) >= 1 then
        State.LastClamp = now()
        pcall(Gui.Clamp)
    end

    if State.Paused then
        setStatus("PAUSED — press the ▶ button or F6 to resume")
        setStatusKind("paused")
        updateStatsText()
        return
    end

    local character = getCharacter()
    local humanoid = getHumanoid()
    if not character or not humanoid or humanoid.Health <= 0 then
        setStatus("waiting for character...")
        setStatusKind("wait")
        -- keep the session timer and counters running while dead
        updateStatsText()
        return
    end

    -- A full workspace walk is the most expensive thing the hub does, so it
    -- only runs when the world changed (hook-driven) or the safety net
    -- interval elapsed. Everything else keeps working off the cached targets.
    --
    -- Cash sampling is a property read, so it is cheap enough for every tick
    -- and it is what proves whether any of this is earning anything.
    safeCall(sampleCash)

    -- The base can be rebuilt, sold, or simply streamed out. While State.Base
    -- pointed at something stale-but-present, inBaseScope() rejected every
    -- target on the plot, so the hub went completely silent with no targets
    -- and no explanation. One property read catches that immediately.
    if State.Base and not State.Base.Parent then
        addLog("base lost - rescanning for the plot")
        State.Base = nil
        clearNav()
        clearTargets()
        State.WorldDirty = true
    end

    if State.WorldDirty or now() - State.LastWorldScan >= Config.ForceRescanEvery then
        if now() - State.ScanAt >= Config.ScanInterval then
            -- clear first: anything created *during* the walk re-sets the flag
            -- and must not be swallowed, and a new base found by the walk
            -- asks for one more pass
            rescanNow()
        end
    end
    if State.UiDirty
        or now() - State.LastUiScan >= Config.UiRefreshEvery
        or (pendingAwaitingJudgement()
            and now() - State.LastUiScan >= Config.PendingUiWalk) then
        safeCall(findGuiObjects)
    end

    applySpeed()
    runAntiAfk()

    if State.Busy then
        State.StuckSince = 0
        State.StuckPrevDist = 0
        State.StuckLastCheck = now()
    else
        safeCall(settleAction)
        safeCall(runRaid)
        safeCall(runConfirmClick)
        safeCall(ensureOrderPanelOpen)

        -- THE PLANNER RUNS THE ROUND.
        --
        -- Every enabled mode runs on the normal round below, so the planner
        -- cannot starve anything - it only decides who goes FIRST. If the game
        -- told us it has three orders waiting and no photos, orders get the
        -- first click instead of whatever happened to be nearest.
        local job = nil
        safeCall(function()
            job = planJob()
        end)
        -- Rate limited: two counters can flicker between each other several
        -- times a second, and one line per flicker would bury the real log.
        if job and State.Features[job] and job ~= State.PipelineJob
            and now() - (State.PipelineAt or 0) >= 8 then
            State.PipelineAt = now()
            addLog(string.format("game is waiting on %s%s", job:upper(),
                State.CounterByBucket[job]
                    and string.format(" (%d)", State.CounterByBucket[job].value)
                    or ""))
        end
        -- assigned even when nil, so a job that goes quiet and comes back
        -- reads as a change again instead of being suppressed for ever
        State.PipelineJob = job
        for _, bucket in ipairs(BUCKET_ORDER) do
            -- the flag only stops the SAME message repeating, so it is cleared
            -- as soon as the mode starts working again
            if not idleSkip(bucket) then State.IdleSaid[bucket] = nil end
            if idleSkip(bucket) and not State.IdleSaid[bucket] then
                State.IdleSaid[bucket] = true
                if modeProvenUseless(bucket) then
                    -- Say WHY, and say what was tried. A mode that never moved
                    -- its counter is a different problem from one with nothing
                    -- to do, and the player can only fix it if told which.
                    addLog(("%s: %d clicks, its counter never moved - not "
                        .. "clicking it again. Wrong button, or the game "
                        .. "renamed it."):format(bucket:upper(),
                            responseOf(bucket)))
                else
                    addLog(("%s: game reports nothing to do - paused for %ds")
                        :format(bucket:upper(), Config.IdleSkipFor))
                end
            end
        end
        local ran = {}
        if job and State.Features[job] then
            ran[job] = true
            safeCall(runTarget, job, STAT_KEYS[job], job:upper())
        end
        for _, bucket in ipairs(BUCKET_ORDER) do
            if not ran[bucket] and not idleSkip(bucket) then
                safeCall(runTarget, bucket, STAT_KEYS[bucket], bucket:upper())
            end
        end

        safeCall(runCollectPads)
        safeCall(checkStuck)
    end

    local total = 0
    for _, bucket in ipairs(BUCKET_ORDER) do
        if State.Features[bucket] then
            total = total + #State.Targets[bucket]
        end
    end
    -- pcall-guarded: a plot model can be destroyed, and this runs every tick
    local baseTag = "not found"
    if State.Base then
        local okName, nm = pcall(function() return State.Base:GetName() end)
        if okName and nm then baseTag = nm end
    end
    if total == 0 and not State.Busy then
        -- Standing still on an empty base is the worst outcome: the targets are
        -- usually there, just not discovered yet. Force a rescan and walk
        -- towards the middle of the plot, which is where stations live.
        if State.EmptySinceAt == 0 then
            State.EmptySinceAt = now()
        end
        local idleFor = now() - State.EmptySinceAt
        -- only when there is genuinely nothing else to do. Cash pads exist on
        -- every base, so testing for their EXISTENCE would disable this
        -- forever; what matters is whether a pad is being collected right now.
        local collecting = now() < (State.CollectingUntil or 0)
        if idleFor >= Config.EmptyNudgeAfter and not Nav.Record
            and not collecting then
            State.EmptySinceAt = now()
            rescanNow()
            local root, hum, base = getRoot(), getHumanoid(), State.Base
            if root and hum and base then
                -- positionOf handles Model AND Folder bases; GetPivot does
                -- not exist on a Folder, which silently killed this whole path
                -- MoveTo is ignored while seated, so stand up first
                if hum.Sit then
                    pcall(function() hum.Sit = false end)
                    task.wait(0.1)
                end
                local pos = positionOf(base)
                if pos then
                    pcall(function() hum:MoveTo(pos) end)
                else
                    addLog("nowhere to walk to: base has no parts")
                end
            end
        end
        setStatus(("base: %s | nothing to do yet%s"):format(baseTag,
            State.LastAction and (" · last: " .. State.LastAction) or ""))
        setStatusKind("wait")
    elseif Nav.Record then
        State.EmptySinceAt = 0
        local name = "?"
        pcall(function() name = Nav.Record.inst.Name end)
        setStatus(("base: %s | %s: %s (%.0f studs) · last: %s"):format(
            baseTag, Nav.Record.bucket:upper(), name,
            distanceTo(Nav.Record.inst), State.LastAction or "none yet"))
        setStatusKind("working")
    else
        State.EmptySinceAt = 0
        setStatus(("base: %s | %d targets | P%d C%d S%d G%d | last: %s"):format(
            baseTag, total, State.Counts.prompt, State.Counts.click,
            State.Counts.key, State.Counts.gui,
            State.LastAction or "none yet"))
        setStatusKind("working")
    end
    -- The AFK banner is PREPENDED, never substituted: the normal line still
    -- says what it is doing, and unattended you want the uptime and any warning
    -- in the same glance.
    if State.Afk then
        local banner = afkStatus()
        if banner then
            lastStatusText = nil
            if Gui and Gui.Status then
            setStatus(banner .. " | " .. (Gui.Status.Text or ""))
        end
        end
    end
    updateStatsText()
end


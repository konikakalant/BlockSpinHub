local redeemCodesImpl

local function redeemCodes()
    if State.Busy then
        addLog("codes: busy with another action")
        return false
    end
    State.Busy = true
    local okRun, result = pcall(redeemCodesImpl)
    State.Busy = false
    pcall(function()
        local box = State.GuiParts.codeBox
        if box then box:ReleaseFocus() end
    end)
    if not okRun then
        addLog("codes error: " .. tostring(result))
    end
    return result
end

redeemCodesImpl = function()
    if not vimAvailable() then
        addLog("codes: VirtualInputManager unavailable — redeem manually (Shop > Codes)")
        return false
    end
    addLog("codes: starting redemption of " .. #KNOWN_CODES .. " codes")
    findGuiObjects()
    local g = State.GuiParts

    local function clickMatching(patterns, what)
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not playerGui then return false end
        for _, gui in ipairs(playerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Name ~= HUB_NAME and gui.Enabled then
                for _, d in ipairs(gui:GetDescendants()) do
                    if (d:IsA("TextButton") or d:IsA("ImageButton")) and guiVisible(d) then
                        local text = d:IsA("TextButton")
                            and (lower(d.Text) .. " " .. lower(d.Name))
                            or lower(d.Name)
                        if matchAny(text, patterns) and uiClick(d) then
                            task.wait(0.4)
                            return true
                        end
                    end
                end
            end
        end
        addLog("codes: " .. what .. " not found")
        return false
    end

    if not (g.shop and g.shop.Parent and guiVisible(g.shop)) then
        if not clickMatching({ "shop", "store" }, "shop button") then return false end
        findGuiObjects()
    elseif uiClick(g.shop) then
        task.wait(0.4)
    end

    clickMatching({ "code" }, "codes tab")
    task.wait(0.2)

    local box = State.GuiParts.codeBox
    if not box or not guiVisible(box) then
        findGuiObjects()
        box = State.GuiParts.codeBox
    end
    if not box then
        addLog("codes: code textbox not found")
        return false
    end
    if not guiVisible(box) then
        addLog("codes: textbox exists but codes panel is not visible")
        return false
    end

    local done = 0
    local function releaseBox()
        if box then
            pcall(function() box:ReleaseFocus() end)
        end
    end
    for _, code in ipairs(KNOWN_CODES) do
        if not State.Running then break end
        local ok = pcall(function()
            box:CaptureFocus()
            box.Text = code
            task.wait(0.08)
        end)
        if ok then
            local redeemBtn = State.GuiParts.redeem
            local clicked = false
            if redeemBtn then
                clicked = uiClick(redeemBtn)
            end
            if not clicked then
                clicked = clickMatching({ "redeem" }, "redeem button")
            end
            if not clicked then
                sendKey(Enum.KeyCode.Return, false)
            end
            task.wait(0.5)
            done = done + 1
        end
    end
    releaseBox()
    State.LastAction = "CODES"
    local msg = ("codes: attempted %d/%d (watch for cash/boost notifications)"):format(done, #KNOWN_CODES)
    addLog(msg)
    toast(msg)
    return true
end

local function bribeNow()
    if State.Busy then
        addLog("bribe: busy with another action")
        return false
    end
    findGuiObjects()
    if State.GuiParts.bribe and uiClick(State.GuiParts.bribe) then
        State.LastGuiClick = State.GuiParts.bribe
        State.LastGuiClickAt = now()
        State.Stats.bribed = State.Stats.bribed + 1
        noteAction("raid", "bribed", State.GuiParts.bribe, "gui")
        State.LastAction = "RAID bribe"
        addLog("bribe: clicked on demand")
        return true
    end
    local target = pickWorldTarget("raid")
    if target then
        if distanceTo(target.inst) <= target.range then
            if fireRecord(target) then
                setCd(target.inst, now() + Config.PerPromptCooldown)
                State.Stats.bribed = State.Stats.bribed + 1
                noteAction("raid", "bribed", target.inst, target.kind)
            State.LastAction = "RAID bribe"
            addLog("bribe: prompt triggered")
                return true
            end
            addLog("bribe: trigger did not fire (cooldown?)")
            return false
        else
            -- enable raid handling for this session, but do NOT persist it:
            -- that would override a toggle the player deliberately turned off
            State.Features.raid = true
            clearNav()
            setNav(target)
            addLog("bribe: moving to prompt (auto raid bribe enabled)")
            return true
        end
    end
    addLog("bribe: nothing found (are you raiding?)")
    return false
end


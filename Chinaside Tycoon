local function applySpeed()
    local humanoid = getHumanoid()
    if not humanoid then return end
    if State.Features.speed then
        if not State.SpeedApplied then
            State.SavedSpeed = humanoid.WalkSpeed
            State.SpeedApplied = true
        end
        if humanoid.WalkSpeed ~= Config.WalkSpeed then
            humanoid.WalkSpeed = Config.WalkSpeed
        end
    elseif State.SpeedApplied then
        humanoid.WalkSpeed = State.SavedSpeed
        State.SpeedApplied = false
    end
end

local lastAfk = 0
local function runAntiAfk()
    if not State.Features.antiafk then return end
    if now() - lastAfk < 120 then return end
    lastAfk = now()
    pcall(function()
        local vu = game:GetService("VirtualUser")
        vu:CaptureController()
        vu:ClickButton2(Vector2.new(0, 0))
    end)
end


--------------------------------------------------------------------------------
-- helpers
--------------------------------------------------------------------------------

local function now()
    return os.clock()
end

local function lower(s)
    return string.lower(tostring(s or ""))
end

local function addLog(line)
    table.insert(LogLines, 1, string.format("[%s] %s", os.date("%H:%M:%S"), line))
    while #LogLines > 40 do
        table.remove(LogLines)
    end
    if Gui and Gui.Log then
        Gui.Log.Text = table.concat(LogLines, "\n")
    end
end

local function setStatus(text)
    if Gui and Gui.Status then
        Gui.Status.Text = text
    end
end

local function safeCall(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then
        addLog("error: " .. tostring(err))
    end
    return ok
end

local function guiVisible(obj)
    local node = obj
    while node and node ~= game do
        if node:IsA("GuiObject") and node.Visible == false then
            return false
        end
        if node:IsA("LayerCollector") and node.Enabled == false then
            return false
        end
        node = node.Parent
    end
    return true
end

local function matchAny(text, patterns)
    text = lower(text)
    for _, p in ipairs(patterns) do
        if string.find(text, p, 1, true) then
            return true
        end
    end
    return false
end

local function inHubGui(inst)
    local node = inst
    while node and node ~= game do
        if node.Name == HUB_NAME then return true end
        node = node.Parent
    end
    return false
end

local function bucketForText(text)
    for _, key in ipairs(BUCKET_ORDER) do
        if matchAny(text, BUCKET_PATTERNS[key]) then
            return key
        end
    end
    return nil
end

--------------------------------------------------------------------------------
-- character
--------------------------------------------------------------------------------

local function getCharacter()
    return LocalPlayer.Character
end

local function getHumanoid()
    local c = getCharacter()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local c = getCharacter()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function positionOf(inst)
    if not inst then return nil end
    if inst:IsA("ProximityPrompt") then
        local node = inst.Parent
        while node and node ~= game do
            if node:IsA("BasePart") or node:IsA("Model") or node:IsA("Folder") then
                return positionOf(node)
            end
            node = node.Parent
        end
        return nil
    end
    if inst:IsA("BasePart") then
        return inst.Position
    end
    local ok, pos = pcall(function()
        return inst:GetPivot().Position
    end)
    if ok then return pos end
    if inst:IsA("Model") or inst:IsA("Folder") then
        local p = inst:FindFirstChildWhichIsA("BasePart", true)
        if p then return p.Position end
    end
    return nil
end

local function distanceTo(inst)
    local root = getRoot()
    local pos = positionOf(inst)
    if not root or not pos then return math.huge end
    return (root.Position - pos).Magnitude
end

local function isCharacterModel(model)
    return model:FindFirstChildOfClass("Humanoid") ~= nil
end

--------------------------------------------------------------------------------
-- base discovery
--------------------------------------------------------------------------------

local function modelOwnerMatch(model)
    local userId = tostring(LocalPlayer.UserId)
    local name = lower(LocalPlayer.Name)
    local display = lower(LocalPlayer.DisplayName)
    for attr, value in pairs(model:GetAttributes()) do
        local v = lower(value)
        local a = lower(attr)
        if v == userId or v == name or v == display then
            if string.find(a, "owner") or string.find(a, "user") or string.find(a, "player") then
                return true
            end
        end
    end
    local lname = lower(model.Name)
    if lname == name or lname == display then
        return true
    end
    if (name ~= display) and string.find(lname, display, 1, true) then
        return true
    end
    return false
end

local function findBase()
    local candidates = {}

    local folders = { "Tycoons", "Tycoon", "Bases", "Base", "Plots", "Plot", "Players" }
    for _, folderName in ipairs(folders) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder and (folder:IsA("Folder") or folder:IsA("Model")) then
            for _, child in ipairs(folder:GetChildren()) do
                if (child:IsA("Model") or child:IsA("Folder")) and not isCharacterModel(child) then
                    if modelOwnerMatch(child) then
                        return child, "owner match in " .. folderName
                    end
                    table.insert(candidates, child)
                end
            end
        end
    end

    for _, d in ipairs(Workspace:GetDescendants()) do
        if (d:IsA("Model") or d:IsA("Folder")) and not isCharacterModel(d)
            and modelOwnerMatch(d) then
            return d, "owner attribute/name match"
        end
    end
    if #candidates == 1 then
        return candidates[1], "single plot (no owner match)"
    end
    return nil, "no owner match found"
end

--------------------------------------------------------------------------------
-- target discovery: prompts, click detectors, station parts, GUI buttons
--------------------------------------------------------------------------------

local function clearTargets()
    for _, list in pairs(State.Targets) do
        table.clear(list)
    end
    State.Counts = { prompt=0, click=0, key=0, gui=0 }
end

local function addRecord(bucket, kind, inst, range)
    local rec = { kind = kind, inst = inst, bucket = bucket, range = range or 10 }
    table.insert(State.Targets[bucket], rec)
    State.Counts[kind] = (State.Counts[kind] or 0) + 1
    return rec
end

local function inBaseScope(inst)
    local base = State.Base
    if base then
        return base:IsAncestorOf(inst)
    end
    local root = getRoot()
    local pos = positionOf(inst)
    if not root or not pos then
        return false
    end
    return (root.Position - pos).Magnitude <= Config.NearRangeNoBase
end

local function stationPartFilter(name)
    return matchAny(name, { "station", "desk", "table", "terminal", "console",
        "kiosk", "booth", "workstation", "machine", "console", "pad", "button" })
end

local function rescanTargets()
    State.ScanCount = State.ScanCount + 1
    local hadBase = State.Base ~= nil
    local base, why = findBase()
    State.Base = base
    State.BaseWhy = why or "unknown"
    clearTargets()

    for key, untilTime in pairs(State.Cooldowns) do
        if typeof(key) == "Instance" then
            if key.Parent == nil or now() >= untilTime then
                State.Cooldowns[key] = nil
            end
        end
    end
    for key, time in pairs(State.LastTrigger) do
        if typeof(key) == "Instance" and key.Parent == nil then
            State.LastTrigger[key] = nil
        end
    end

    local worldRecords = {}

    for _, d in ipairs(Workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled then
            local text = lower(table.concat({
                tostring(d.Name), tostring(d.ActionText), tostring(d.ObjectText) }, " "))
            local bucket = bucketForText(text)
            if bucket and inBaseScope(d) then
                local range = math.clamp((d.MaxActivationDistance or 10) + 2, 6, 18)
                worldRecords[#worldRecords + 1] = addRecord(bucket, "prompt", d, range)
            end
        elseif d:IsA("ClickDetector") and d.Enabled then
            local parent = d.Parent
            if parent and not isCharacterModel(parent) then
                local text = lower(parent.Name)
                local node = parent.Parent
                for _ = 1, 2 do
                    if node and node ~= Workspace then
                        text = text .. " " .. lower(node.Name)
                        node = node.Parent
                    end
                end
                local bucket = bucketForText(text)
                if bucket and inBaseScope(parent) then
                    local range = math.clamp((d.MaxActivationDistance or 32) + 3, 8, 20)
                    worldRecords[#worldRecords + 1] = addRecord(bucket, "click", parent, range)
                end
            end
        elseif d:IsA("BasePart") and stationPartFilter(d.Name) and inBaseScope(d) then
            local bucket = bucketForText(d.Name)
            if bucket then
                worldRecords[#worldRecords + 1] = addRecord(bucket, "key", d, 9)
            end
        end
    end

    for _, rec in ipairs(worldRecords) do
        if rec.kind == "key" then
            local pos = positionOf(rec.inst)
            if pos then
                for _, other in ipairs(worldRecords) do
                    if other.kind ~= "key" and other.kind ~= "removed"
                        and other.bucket == rec.bucket then
                        local p2 = positionOf(other.inst)
                        if p2 and (pos - p2).Magnitude < 4 then
                            rec.kind = "removed"
                            break
                        end
                    end
                end
            end
        end
    end
    for i = #worldRecords, 1, -1 do
        if worldRecords[i].kind == "removed" then
            table.remove(worldRecords, i)
        end
    end
    for _, list in pairs(State.Targets) do
        for i = #list, 1, -1 do
            if list[i].kind == "removed" then
                table.remove(list, i)
                State.Counts.key = math.max(0, State.Counts.key - 1)
            end
        end
    end

    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, gui in ipairs(playerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Name ~= HUB_NAME and gui.Enabled then
                for _, d in ipairs(gui:GetDescendants()) do
                    if (d:IsA("TextButton") or d:IsA("ImageButton")) and guiVisible(d) then
                        local text = d:IsA("TextButton")
                            and (lower(d.Text) .. " " .. lower(d.Name))
                            or lower(d.Name)
                        if not matchAny(text, WORKFLOW_EXCLUDE) then
                            local bucket = bucketForText(text)
                            if bucket then
                                addRecord(bucket, "gui", d, 0)
                            end
                        end
                    end
                end
            end
        end
    end

    for _, list in pairs(State.Targets) do
        table.sort(list, function(a, b)
            return distanceTo(a.inst) < distanceTo(b.inst)
        end)
    end

    State.ScanAt = now()
    if State.ScanCount == 1 or hadBase ~= (base ~= nil) then
        addLog(base and ("base: " .. base:GetName() .. " (" .. why .. ")")
                  or ("base not found (" .. tostring(why) .. "); using nearby scan"))
        addLog(("targets: %d prompts, %d click, %d stations, %d gui buttons"):format(
            State.Counts.prompt, State.Counts.click, State.Counts.key, State.Counts.gui))
    end
end


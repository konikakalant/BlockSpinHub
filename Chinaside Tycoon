            saveSettings()
            clearNav()
            Nav.Record = target
            Nav.Until = now() + Config.MoveTimeout
            addLog("bribe: moving to prompt (auto raid bribe enabled)")
            return true
        end
    end
    addLog("bribe: nothing found (are you raiding?)")
    return false
end


-- SELF-CHECK
--
-- The bug that has bitten this project more than any other is a function using
-- a local declared LATER in this file. Lua resolves that as a nil GLOBAL: no
-- compile error, no error at load, no warning - the call simply does nothing
-- and one feature stops existing. It has shipped. It survived review. It was
-- caught later only because a test happened to exercise that path, which is
-- luck, not engineering.
--
-- So every function the hub depends on is listed here BY REFERENCE. Building
-- this table resolves all of them at load time, so a name that failed to
-- resolve arrives as a nil entry and is reported on screen, in the log, and in
-- the scan report - immediately, and by name. A broken build now says which
-- function is missing instead of quietly running at 80% and blaming the game.
local SELF_CHECK = {
        { "now", now },  { "lower", lower },  { "addLog", addLog },
        { "setStatus", setStatus },  { "setStatusKind", setStatusKind },  { "toast", toast },
        { "warnSettings", warnSettings },  { "saveSettings", saveSettings },  { "loadSettings", loadSettings },
        { "safeCall", safeCall },  { "guiVisible", guiVisible },  { "matchAny", matchAny },
        { "buttonText", buttonText },  { "ownLabel", ownLabel },  { "isGated", isGated },
        { "inHubGui", inHubGui },  { "bucketForText", bucketForText },  { "isConfirmText", isConfirmText },
        { "getCharacter", getCharacter },  { "getHumanoid", getHumanoid },  { "getRoot", getRoot },
        { "positionOf", positionOf },  { "distanceTo", distanceTo },  { "isCharacterModel", isCharacterModel },
        { "equipToolForBucket", equipToolForBucket },  { "isNavigationButton", isNavigationButton },  { "findOrderPanel", findOrderPanel },
        { "responseOf", responseOf },  { "modeProvenUseless", modeProvenUseless },  { "idleSkip", idleSkip },
        { "noteIdleRead", noteIdleRead },  { "planJob", planJob },  { "looksLikePlot", looksLikePlot },
        { "modelOwnerMatch", modelOwnerMatch },  { "findBaseInKnownFolders", findBaseInKnownFolders },  { "pickBaseFromCandidates", pickBaseFromCandidates },
        { "clearTargets", clearTargets },  { "addRecord", addRecord },  { "inBaseScope", inBaseScope },
        { "stationPartFilter", stationPartFilter },  { "rescanTargets", rescanTargets },  { "rescanNow", rescanNow },
        { "isMoneyText", isMoneyText },  { "isCounterText", isCounterText },  { "parseCounter", parseCounter },
        { "noteCounter", noteCounter },  { "noteLatency", noteLatency },  { "latencyFor", latencyFor },
        { "spacingFloor", spacingFloor },  { "noteCounterChange", noteCounterChange },  { "finishCounters", finishCounters },
        { "findGuiObjects", findGuiObjects },  { "refreshSignature", refreshSignature },  { "readNumberValue", readNumberValue },
        { "findCash", findCash },  { "sampleCash", sampleCash },  { "raidGuiVisible", raidGuiVisible },
        { "wordsOf", wordsOf },  { "looksLikePurchase", looksLikePurchase },  { "confirmIsSafe", confirmIsSafe },
        { "triggerPrompt", triggerPrompt },  { "vimAvailable", vimAvailable },  { "checkInputSupport", checkInputSupport },
        { "uiClickAt", uiClickAt },  { "screenCenter", screenCenter },  { "scrollIntoView", scrollIntoView },
        { "userIsTyping", userIsTyping },  { "overHub", overHub },  { "uiClick", uiClick },
        { "sendKey", sendKey },  { "pressInteractKey", pressInteractKey },  { "findPromptNode", findPromptNode },
        { "backoffFor", backoffFor },  { "tuneFor", tuneFor },  { "noteQuality", noteQuality },
        { "qualityOf", qualityOf },  { "cdFor", cdFor },  { "tuneFaster", tuneFaster },
        { "tuneSlower", tuneSlower },  { "setCd", setCd },  { "noteAction", noteAction },
        { "pendingAwaitingJudgement", pendingAwaitingJudgement },  { "settleAction", settleAction },  { "runPurchaseGuard", runPurchaseGuard },
        { "runConfirmClick", runConfirmClick },  { "aimPointOn", aimPointOn },  { "aimAt", aimAt },
        { "clickWorldPart", clickWorldPart },  { "reticleOnTarget", reticleOnTarget },  { "clickAtReticle", clickAtReticle },
        { "clearPath", clearPath },  { "startPath", startPath },  { "nextPathPoint", nextPathPoint },
        { "moveToTarget", moveToTarget },  { "navProgressTarget", navProgressTarget },  { "clearNav", clearNav },
        { "setNav", setNav },  { "readyWorld", readyWorld },  { "pickWorldTarget", pickWorldTarget },
        { "firePhoto", firePhoto },  { "fireRecord", fireRecord },  { "runTarget", runTarget },
        { "runCollectPads", runCollectPads },  { "runRaid", runRaid },  { "applySpeed", applySpeed },
        { "runAntiAfk", runAntiAfk },  { "redeemCodes", redeemCodes },  { "bribeNow", bribeNow },
        { "recentScore", recentScore },  { "modeVerdict", modeVerdict },  { "writeScanReport", writeScanReport },
        { "runScanReport", runScanReport },  { "mk", mk },  { "buildGui", buildGui },
        { "toggleAfk", toggleAfk },  { "togglePause", togglePause },  { "bindGui", bindGui },
        { "readGameLine", readGameLine },  { "updateStatsText", updateStatsText },  { "ensureOrderPanelOpen", ensureOrderPanelOpen },
        { "checkStuck", checkStuck },  { "afkStuckModal", afkStuckModal },  { "afkRepairInvariants", afkRepairInvariants },
        { "afkDiagnose", afkDiagnose },  { "afkRecover", afkRecover },  { "watchdog", watchdog },
        { "afkStatus", afkStatus },  { "tick", tick },  { "onCharacterAdded", onCharacterAdded },
}

local function selfCheck(): (number, number, string)
    local missing, total = 0, 0
    local names = {}
    for _, pair in ipairs(SELF_CHECK) do
        total = total + 1
        local name, fn = pair[1], pair[2]
        if type(fn) ~= "function" then
            missing = missing + 1
            names[#names + 1] = name
        end
    end
    if missing == 0 then
        return 0, total, ""
    end
    return missing, total, table.concat(names, ", ")
end

local function start()
    if game.PlaceId ~= PLACE_ID then
        addLog(("warning: place %s is not ChinaSide Tycoon (%s)")
            :format(tostring(game.PlaceId), tostring(PLACE_ID)))
    end

    State.StartedAt = now()
    loadSettings()

    if State.ClockSource == nil or State.ClockSource == "" then
        -- Every wall-clock source failed, so now() is on os.clock() and every
        -- timer in the hub will run slow. Say that plainly instead of letting
        -- the player conclude the game is the problem.
        addLog("WARNING: no wall clock found - timers will run slow "
            .. "(this executor restricts tick, GetServerTimeNow and DateTime)")
    end

    -- Say up front whether every function in the hub actually resolved. A
    -- build with a missing one runs at partial capability and blames the game
    -- for it, which is the least useful thing this script could do.
    local missing, checked, names = selfCheck()
    State.SelfCheckMissing = missing
    State.SelfCheckTotal = checked
    if missing > 0 then
        addLog(("SELF-CHECK FAILED: %d of %d functions did not resolve: %s")
            :format(missing, checked, names))
        toast("self-check failed - see log")
    else
        addLog(("self-check passed: all %d functions resolved"):format(checked))
    end

    -- random suffix: two instances started in the same clock tick would
    -- otherwise share a stamp and both hubs would run side by side
    local runStamp = tostring(now()) .. "-" .. tostring(math.random(1, 1e9))
    pcall(function()
        LocalPlayer:SetAttribute(HUB_NAME .. "Run", runStamp)
    end)
    task.spawn(function()
        while State.Running do
            task.wait(2)
            local ok, current = pcall(function()
                return LocalPlayer:GetAttribute(HUB_NAME .. "Run")
            end)
            if ok and current ~= nil and current ~= runStamp then
                addLog("new instance started — stopping this one")
                State.Running = false
                -- same as UNLOAD: a humanoid keeps walking after its MoveTo
                -- caller is gone, so the old copy would drift across the map
                pcall(function()
                    local humanoid = getHumanoid()
                    if humanoid then humanoid:MoveTo(getRoot().Position) end
                end)
                pcall(clearPath)
                if State.SpeedApplied then
                    local humanoid = getHumanoid()
                    if humanoid then humanoid.WalkSpeed = State.SavedSpeed end
                    State.SpeedApplied = false
                end
                for _, conn in ipairs(Connections) do
                    pcall(function() conn:Disconnect() end)
                end
                table.clear(Connections)
                if Gui and Gui.Screen then
                    Gui.Screen:Destroy()
                end
                Gui = nil
                return
            end
        end
    end)

    buildGui()
    bindGui()
    if State.Paused and Gui and Gui.Pause then
        Gui.Pause.Text = "▶"
        Gui.Pause.BackgroundColor3 = COLORS.accent
    end

    addLog("ChinaSide Auto Hub " .. VERSION .. " loaded")
    addLog(("place=%s player=%s"):format(tostring(game.PlaceId), LocalPlayer.Name))
    addLog("keys: RIGHT SHIFT show/hide · F6 pause · F7 rescan · F8 codes \u{00B7} F9 afk")

    rescanNow()
    findGuiObjects(true)
    State.UiDirty = false
    State.LastUiScan = now()

    -- Change hooks: these are what let the hub skip its expensive world and
    -- UI walks. Each is a single boolean write, versus re-walking thousands of
    -- instances several times a second.
    table.insert(Connections, Workspace.DescendantAdded:Connect(function()
        State.WorldDirty = true
    end))
    table.insert(Connections, Workspace.DescendantRemoving:Connect(function()
        State.WorldDirty = true
    end))
    do
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            table.insert(Connections, playerGui.DescendantAdded:Connect(function()
                State.UiDirty = true
                State.PromptDirty = true
            end))
            table.insert(Connections, playerGui.DescendantRemoving:Connect(function()
                State.UiDirty = true
                State.PromptDirty = true
            end))
        end
        if CoreGuiRef then
            table.insert(Connections, CoreGuiRef.DescendantAdded:Connect(function()
                State.PromptDirty = true
            end))
            table.insert(Connections, CoreGuiRef.DescendantRemoving:Connect(function()
                State.PromptDirty = true
            end))
        end
    end

    if LocalPlayer.Character then
        task.spawn(function()
            if LocalPlayer.Character then
                onCharacterAdded(LocalPlayer.Character)
            end
        end)
    end
    table.insert(Connections, LocalPlayer.CharacterAdded:Connect(onCharacterAdded))

    table.insert(Connections, LocalPlayer.Idled:Connect(function()
        if State.Features.antiafk and State.Running then
            pcall(function()
                local vu = game:GetService("VirtualUser")
                vu:CaptureController()
                vu:ClickButton2(Vector2.new(0, 0))
            end)
            addLog("anti-afk: idle event handled")
        end
    end))

    local accumulator = 0
    local tickRunning = false
    table.insert(Connections, RunService.Heartbeat:Connect(function(dt)
        accumulator = accumulator + dt
        local busy = Nav.Record ~= nil or State.WorldDirty or State.UiDirty
            or State.PromptDirty
        local interval = busy and Config.TickRate or Config.IdleTickRate
        if accumulator >= interval then
            if tickRunning then
                -- a tick is still running: drop the backlog rather than
                -- banking it, otherwise ticks queue back to back forever
                accumulator = 0
                return
            end
            accumulator = 0
            tickRunning = true
            local ok, err = pcall(tick)
            tickRunning = false
            if not ok then
                -- Counted like every other error. A tick that keeps throwing is
                -- the most serious kind of failure there is - it aborts before
                -- any mode runs - and the watchdog's burst handling has to be
                -- able to see it.
                State.Errors = (State.Errors or 0) + 1
                State.LastErrorAt = now()
                State.LastErrorText = "tick: " .. tostring(err)
                addLog("tick error: " .. tostring(err))
            end
        end
    end))

    table.insert(Connections, UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.RightShift then
            if Gui and Gui.Screen then
                Gui.Screen.Enabled = not Gui.Screen.Enabled
            end
        elseif input.KeyCode == Enum.KeyCode.F6 then
            togglePause()
        elseif input.KeyCode == Enum.KeyCode.F7 then
            -- spawned: these walk the whole Workspace/PlayerGui tree and
            -- would otherwise stall the input thread
            task.spawn(function()
                rescanNow()
                findGuiObjects(true)
                State.LastUiScan = now()
                State.LastOrderPanelTry = 0
                addLog("manual rescan — targets refreshed")
            end)
        elseif input.KeyCode == Enum.KeyCode.F9 then
            toggleAfk()
        elseif input.KeyCode == Enum.KeyCode.F8 then
            task.spawn(function()
                safeCall(redeemCodes)
            end)
        end
    end))

    toast("ChinaSide Auto Hub " .. VERSION .. " loaded")
    -- after a beat, so this banner replaces the splash rather than the
    -- other way round
    task.delay(4, function()
        if not State.Running then return end
        local found = State.FirstScanFound
        if found and found > 0 then
            toast(("found %d things to automate"):format(found))
        elseif found ~= nil then
            addLog("nothing found yet — walk to your base, then press SCAN")
            toast("No targets yet — walk to your base")
        end
    end)
    -- last, so its warning toast is the one the player actually sees
    safeCall(checkInputSupport)
    if State.InputBroken then
        setStatus("executor blocks input — stations/prompts only")
    else
        setStatus("loaded — RIGHT SHIFT show/hide · F6 pause · F7 rescan")
    end
end

-- start() failures would otherwise be invisible: at this point the GUI does
-- not exist yet, so addLog has nowhere to write
local okStart, errStart = pcall(start)
if not okStart then
    print("[ChinaSideAutoHub] startup failed: " .. tostring(errStart))
end

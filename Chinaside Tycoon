local function getCharacter()
    return LocalPlayer.Character
end

local function getHumanoid()
    local c = getCharacter()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local c = getCharacter()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function positionOf(inst)
    if not inst then return nil end
    if inst:IsA("ProximityPrompt") then
        local node = inst.Parent
        while node and node ~= game do
            if node:IsA("BasePart") or node:IsA("Model") or node:IsA("Folder") then
                return positionOf(node)
            end
            node = node.Parent
        end
        return nil
    end
    if inst:IsA("BasePart") then
        if not inst.Parent then return nil end
        return inst.Position
    end
    local ok, pos = pcall(function()
        return inst:GetPivot().Position
    end)
    if ok then return pos end
    if inst:IsA("Model") or inst:IsA("Folder") then
        local p = inst:FindFirstChildWhichIsA("BasePart", true)
        if p then return p.Position end
    end
    return nil
end

local function distanceTo(inst)
    local root = getRoot()
    local pos = positionOf(inst)
    if not root or not pos then return math.huge end
    return (root.Position - pos).Magnitude
end

local function isCharacterModel(model)
    return model:FindFirstChildOfClass("Humanoid") ~= nil
end

local TOOL_HINTS = {
    photo = { "camera", "photo", "qc", "snapshot" },
    order = { "order", "pack", "label", "scanner", "tablet", "tape", "box" },
    ship  = { "ship", "haul", "truck", "van", "label" },
    crate = { "crate", "key" },
}

local function equipToolForBucket(bucket)
    local hints = TOOL_HINTS[bucket]
    if not hints then return end
    local humanoid = getHumanoid()
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not humanoid or not backpack then return end
    local character = getCharacter()
    if character then
        for _, t in ipairs(character:GetChildren()) do
            if t:IsA("Tool") and matchAny(lower(t.Name), hints) then
                -- already correct in hand; deliberately NOT recorded as ours,
                -- so it is never put away again
                return
            end
        end
    end
    for _, t in ipairs(backpack:GetChildren()) do
        if t:IsA("Tool") and matchAny(lower(t.Name), hints) then
            local ok = pcall(function() humanoid:EquipTool(t) end)
            if ok then
                task.wait(0.12)
                local equipped = character and character:FindFirstChildOfClass("Tool")
                if equipped and matchAny(lower(equipped.Name), hints) then
                    State.EquippedTool = equipped
                    State.EquippedToolFor = bucket
                    addLog("equipped: " .. equipped.Name .. " for " .. bucket)
                end
            end
            return
        end
    end

    -- No tool for this mode, but one WE equipped earlier is still in hand. A
    -- camera held while packing orders can stop the interaction, so put away
    -- exactly that tool - never one the player or the game equipped, which is
    -- why this compares instances rather than a mode name.
    if character then
        local held = character:FindFirstChildOfClass("Tool")
        if held and State.EquippedTool and State.EquippedTool == held then
            pcall(function() humanoid:UnequipTool(held) end)
            State.EquippedTool = nil
            State.EquippedToolFor = nil
        end
    end
end

-- Navigation is identified by an ALLOWLIST rather than by guessing from verbs.
--
-- The earlier heuristic ("a workflow word with no verb is a tab") threw away
-- real buttons like "Cash Out" and "Free Cash", and a mode that can never
-- self-correct is much worse off than a tab that gets clicked a few times.
--
-- So only the tabs belonging to modes WITHOUT automatic self-correction are
-- skipped. Those are photo, order and hire: their result is not visible
-- immediately, so the backoff that quietly fixes a mistyped tab never engages
-- for them. Every other mode (ship, collect, reward, crate, raid) is FAST_EFFECT
-- and corrects itself within a few clicks if the button turns out to be a tab.
local NAV_TAB_WORDS = {
    ["order"] = true, ["orders"] = true, ["my orders"] = true,
    ["order list"] = true, ["orderlist"] = true, ["incoming"] = true,
    ["job board"] = true, ["jobs"] = true,
    ["photo"] = true, ["photos"] = true, ["photo table"] = true,
    ["staff"] = true, ["employees"] = true, ["team"] = true,
    -- NB "hire" is deliberately NOT here: a bare "Hire" button is the action,
    -- not a tab. hire is FAST_EFFECT instead, so an inert one backs off.
}

local function isNavigationButton(own)
    if own == nil or own == "" then return false end
    local t = lower(own):gsub("^%s+", ""):gsub("%s+$", "")
    if NAV_TAB_WORDS[t] then return true end
    -- also treat it as a tab if the WHOLE label is just that word plus filler
    -- such as "Orders (3)" or "Photos 2/5"
    local stripped = t:gsub("[%(%)%d:/%.%s!+x]", "")
    if stripped ~= "" and NAV_TAB_WORDS[stripped] then return true end
    return false
end

local ORDER_TAB = { "orders", "order", "my orders", "order list", "orderlist",
                    "incoming", "job board", "jobs", "packing", "process" }

local function findOrderPanel()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    -- bestScore starts BELOW any real score on purpose. It used to start at
    -- math.huge, so "score > bestScore" was never true, this function always
    -- returned nil, and the auto-open-orders feature never ran at all.
    local best, bestScore = nil, -math.huge
    for _, gui in ipairs(playerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= HUB_NAME and gui.Enabled then
            for _, d in ipairs(gui:GetDescendants()) do
                if (d:IsA("TextButton") or d:IsA("ImageButton")) and guiVisible(d) then
                    local t = buttonText(d)
                    if matchAny(t, ORDER_TAB) and not isGated(t)
                        and not matchAny(t, WORKFLOW_EXCLUDE) then
                        -- prefer short, tab-like labels ("Orders") over long
                        -- action labels ("Process Order 3 items")
                        local score = 100 - #t
                        if score > bestScore then
                            best, bestScore = d, score
                        end
                    end
                end
            end
        end
    end
    return best
end


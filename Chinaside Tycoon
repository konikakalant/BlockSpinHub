local function toggleAfk()
    State.Afk = not State.Afk
    if State.Afk then
        State.AfkSince = now()
        State.RecoveryStep = 0
        State.RecoveryDone = false
        State.LastRecoveryAt = 0
        State.LastConfirmedAt = now()
        State.LastSeenTries = 0
        State.LastTriesAt = now()
        -- seeded, or the very first watchdog pass would immediately spend its
        -- one re-trial on a verdict that is still perfectly fresh
        State.LastUselessCheck = now()
        State.WatchAt = 0
        State.StuckModalSince = nil
        addLog("afk mode ON — watchdog active, hub will recover on its own")
        toast("AFK mode on")
    else
        State.Afk = false
        addLog("afk mode off")
        toast("AFK mode off")
    end
    if Gui and Gui.Afk then
        Gui.Afk.Text = State.Afk and "AFK*" or "AFK"
        Gui.Afk.BackgroundColor3 = State.Afk and COLORS.on or COLORS.off

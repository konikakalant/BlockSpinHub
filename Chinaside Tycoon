local function runCollectPads()
    if not State.Features.collect then return end
    if Nav.Record then return end
    if now() < (State.Cooldowns["__pads"] or 0) then return end
    local root = getRoot()
    if not root then return end

    -- Throttle here, once, rather than only on the two outcomes. Previously a
    -- base that had pads but none within range set no cooldown, so the whole
    -- list was re-measured four times a second, for ever.
    State.Cooldowns["__pads"] = now() + 3.0

    -- cash pads are cached by the main scan, so this no longer walks the
    -- whole base every 3 seconds
    local pads = State.PadParts
    if not pads or #pads == 0 then return end
    local best, bestDist = nil, 70
    for _, d in ipairs(pads) do
        if d.Parent and now() >= (State.Cooldowns[d] or 0)
            and (State.Base == nil or State.Base:IsAncestorOf(d)) then
            local d2 = (root.Position - d.Position).Magnitude
            if d2 < bestDist then
                best, bestDist = d, d2
            end
        end
    end
    if best then
        setNav({ kind = "pad", inst = best, bucket = "collect", range = 4 })
        State.CollectingUntil = now() + 3.0
    end
end


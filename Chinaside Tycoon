-- Confirm-shaped text is not enough to make a button safe. A game's own
-- purchase window can have a button that simply says "Confirm", and clicking
-- that would spend money - which this hub must never do. So before any
-- confirm-shaped button is pressed, its ancestors are checked for purchase
-- wording, and the purchase guard's own 90s shelve is the second line.
-- An ARRAY, not a set, because matchAny() iterates with ipairs. This table was
-- originally written as a hash, which made every matchAny call against it
-- return false - so the entire purchase guard was dead code that still looked
-- correct in the source. PURCHASE_WORDS is now an array and this lookup is the
-- only way anything tests membership, so the two can never disagree again.
-- "purchase" is deliberately NOT a word on its own. In a tycoon "Purchase
-- Order" is a core action, and refusing it would break the loop the hub exists
-- to run. A real purchase panel says buy, robux, checkout, upgrade, cart or
-- subscribe, and a confirmation says "Confirm Purchase" - which is why the
-- phrase below is checked.
local PURCHASE_WORDS = {
    buy = true, robux = true, gamepass = true, premium = true,
    checkout = true, store = true, shop = true,
    upgrade = true, bundle = true, subscribe = true, cart = true,
}

-- Multi-word phrases, checked as consecutive token PAIRS. Kept apart from the
-- set above because that one is a lookup, not an iteration.
local PURCHASE_PHRASES = {
    { "confirm", "purchase" }, { "dev", "product" },
    { "buy", "now" }, { "get", "robux" }, { "game", "pass" },
}

-- Split a name or a label into words on spaces, separators, digits and case
-- transitions. Roblox instance names are usually CamelCase, so plain substring
-- matching is useless in both directions: "shop" matches "Workshop", and
-- whole-word matching by spaces misses "ShopFrame" entirely.
local function wordsOf(text: string)
    local out, cur = {}, {}
    local prevLower = false
    for i = 1, #text do
        local c = text:sub(i, i)
        local upper = string.find(c, "%u") ~= nil
        local sep = string.find(c, "[%s_%-%d%.]") ~= nil
        if sep then
            if #cur > 0 then
                out[#out + 1] = lower(table.concat(cur))
                cur = {}
            end
            prevLower = false
        elseif upper and prevLower then
            -- a case boundary, so this character STARTS the next word. Dropping
            -- it instead turned "ShopFrame" into "shop" + "rame", and every
            -- CamelCase name lost its first letter of the second word.
            if #cur > 0 then
                out[#out + 1] = lower(table.concat(cur))
            end
            cur = { c }
            prevLower = false
        else
            cur[#cur + 1] = c
            prevLower = string.find(c, "%l") ~= nil
        end
    end
    if #cur > 0 then out[#out + 1] = lower(table.concat(cur)) end
    return out
end

-- Refusing too much is its own bug: a confirm dialog that is never clicked
-- stays open and stalls the round, which is exactly what the stuck-modal
-- cleaner exists to prevent. So a purchase frame is recognised by its WORDS,
-- and only its words.
local function looksLikePurchase(text: string): boolean
    if not text or text == "" then return false end
    local words = wordsOf(text)
    for i = 1, #words do
        if PURCHASE_WORDS[words[i]] then return true end
        for _, phrase in ipairs(PURCHASE_PHRASES) do
            local width = #phrase
            local matched = true
            for k = 1, width do
                if words[i + k - 1] ~= phrase[k] then
                    matched = false
                    break
                end
            end
            if matched then return true end
        end
    end
    return false
end

local function confirmIsSafe(d)
    local node = d
    local depth = 0
    while node and depth < 8 do
        local name = ""
        pcall(function() name = lower(node.Name) end)
        if name ~= "" and looksLikePurchase(name) then return false end
        node = node.Parent
        depth = depth + 1
    end
    -- a TextLabel inside the same window that names a price settles it too
    node = d.Parent
    depth = 0
    while node and depth < 6 do
        local one, two
        pcall(function()
            if node:IsA("GuiObject") then
                one, two = node.Name, node.Text
            end
        end)
        for _, txt in ipairs({ one, two }) do
            if type(txt) == "string" and txt ~= ""
                and looksLikePurchase(txt) then return false end
        end
        node = node.Parent
        depth = depth + 1
    end

    -- Finally, the window's own contents. A purchase panel can have no
    -- purchase wording on the frame or its title and still show a price and a
    -- plain "OK" button, so the labels inside the window are read too. Bounded
    -- twice over - only a small window, only short labels - because this runs
    -- for every confirm-shaped button that comes up.
    local frame = d.Parent
    if frame and frame:IsA("GuiObject") then
        local scanned = 0
        for _, kid in ipairs(frame:GetDescendants()) do
            if scanned >= 20 then break end
            local isLabel = false
            pcall(function() isLabel = kid:IsA("TextLabel") or kid:IsA("TextButton") end)
            if isLabel then
                local txt = ""
                pcall(function() txt = kid.Text end)
                if type(txt) == "string" and #txt <= 30 and txt ~= ""
                    and looksLikePurchase(txt) then
                    return false
                end
            end
            scanned = scanned + 1
        end
    end
    return true
end

local function triggerPrompt(p)
    if not p or not p.Parent then return false end
    local last = State.LastTrigger[p] or 0
    if now() - last < Config.PerPromptCooldown then return false end
    State.LastTrigger[p] = now()

    local originalHold = p.HoldDuration
    local ok = pcall(function()
        p.HoldDuration = 0
        p:InputHoldBegin()
        task.wait(0.05)
        p:InputHoldEnd()
    end)
    pcall(function()
        p.HoldDuration = originalHold
    end)
    if ok then
        return true
    end
    addLog("prompt trigger failed: " .. tostring(p.Name))
    return false
end

local function vimAvailable()
    return typeof(VirtualInputManager) == "Instance"
end

-- Probes the executor's input support once. Without this, a user whose
-- executor stubs VirtualInputManager just sees "nothing happens" and has no
-- idea why. The probes are deliberately harmless: a left-shift tap and a
-- mouse-button release at a point nothing occupies.
local inputChecked = false
local function checkInputSupport()
    if inputChecked then return end
    inputChecked = true
    if not vimAvailable() then
        State.InputBroken = true
        local msg = "No VirtualInputManager — GUI clicks and keys are off"
        addLog("INPUT: no VirtualInputManager in this executor — GUI buttons "
            .. "and key presses are off, prompts/stations still work")
        toast(msg)
        return
    end
    local keysOk = pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game, 0)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game, 0)
    end)
    local mouseOk = pcall(function()
        VirtualInputManager:SendMouseButtonEvent(1, 1, 0, false, game, 0)
    end)
    if not (keysOk and mouseOk) then
        State.InputBroken = true
        addLog("INPUT: this executor blocks virtual input — GUI buttons and "
            .. "keys are off, prompts/stations still work")
        toast("Executor blocks input — stations only")
    end
end

local function uiClickAt(x, y)
    if not vimAvailable() then return false end
    local ok = pcall(function()
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(0.06)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)
    if ok then return true end
    local ok2 = pcall(function()
        local vu = game:GetService("VirtualUser")
        vu:Button1Down(Vector2.new(x, y))
        task.wait(0.06)
        vu:Button1Up(Vector2.new(x, y))
    end)
    return ok2
end

local function screenCenter(obj)
    local pos = obj.AbsolutePosition
    local size = obj.AbsoluteSize
    return Vector2.new(pos.X + size.X / 2, pos.Y + size.Y / 2)
end

local function scrollIntoView(obj)
    local node = obj.Parent
    while node and node ~= game do
        if node:IsA("ScrollingFrame") then
            pcall(function()
                local fPos = node.AbsolutePosition
                local fSize = node.AbsoluteSize
                local oPos = obj.AbsolutePosition
                local oSize = obj.AbsoluteSize
                local top = oPos.Y - fPos.Y
                local bottom = top + oSize.Y
                local dy = 0
                if top < 0 then
                    dy = top - 6
                elseif bottom > fSize.Y then
                    dy = bottom - fSize.Y + 6
                end
                if dy ~= 0 then
                    local canvas = node.CanvasPosition
                    node.CanvasPosition = Vector2.new(canvas.X,
                        math.max(0, canvas.Y + dy))
                end
            end)
            return true
        end
        node = node.Parent
    end
    return false
end

local CoreGuiRef = nil
do
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok then CoreGuiRef = cg end
end

-- true only while the player is typing in the Roblox chat box, so workflow
-- clicks never land in the middle of someone typing a message
local function userIsTyping()
    if not CoreGuiRef then return false end
    local ok, focused = pcall(function() return GuiService:GetFocusedTextBox() end)
    if not (ok and focused) then return false end
    local node = focused
    while node and node ~= game do
        if node == CoreGuiRef then return true end
        node = node.Parent
    end
    return false
end

local overHubWarnedAt = 0
local function overHub(point)
    if not Gui or not Gui.Main or not Gui.Main.Parent then return false end
    if not Gui.Screen or not Gui.Screen.Enabled then return false end
    local okA, pos = pcall(function() return Gui.Main.AbsolutePosition end)
    local okS, size = pcall(function() return Gui.Main.AbsoluteSize end)
    if not (okA and okS) then return false end
    -- AbsolutePosition is window space while camera viewport points are not,
    -- so the top-bar inset has to be added or the guard misses a strip
    local inset = 0
    pcall(function() inset = GuiService:GetGuiInset().Y end)
    if point.X >= pos.X and point.Y + inset >= pos.Y
        and point.X <= pos.X + size.X and point.Y + inset <= pos.Y + size.Y then
        -- say why the click did nothing, instead of failing silently
        if now() - overHubWarnedAt > 30 then
            overHubWarnedAt = now()
            addLog("hub is sitting on top of a game button — drag the hub "
                .. "aside (grab the title bar)")
        end
        return true
    end
    return false
end

local function uiClick(obj, allowWhileTyping)
    if not obj or not obj.Parent then return false end
    if not guiVisible(obj) then return false end
    if not allowWhileTyping and userIsTyping() then return false end
    local scrolled = scrollIntoView(obj)
    if scrolled then
        task.wait(0.08)
    end
    local ok, center = pcall(screenCenter, obj)
    if not ok then return false end
    if center.X == 0 and center.Y == 0 then return false end
    if overHub(center) then return false end
    local camera = Workspace.CurrentCamera
    if camera then
        -- AbsolutePosition is window space while the 3D viewport excludes the
        -- top inset, so compare against the full window or the lowest strip of
        -- the game UI is wrongly treated as off-screen and never clicked
        local inset = Vector2.zero
        pcall(function() inset = GuiService:GetGuiInset() end)
        local vp = camera.ViewportSize + inset
        if center.X < -8 or center.Y < -8 or center.X > vp.X + 8 or center.Y > vp.Y + 8 then
            return false
        end
    end
    return uiClickAt(center.X, center.Y)
end

local function sendKey(keyCode, requireNoFocus)

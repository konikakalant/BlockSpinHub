        end
        -- Source broke: keep returning the last good reading. Falling back to
        -- os.clock() here would mix two time bases and make every stored
        -- deadline unreachable, silently freezing the whole hub.
        return lastGoodTime
    end
    return os.clock()
end

local function lower(s)
    return string.lower(tostring(s or ""))
end

-- palette, declared up front so status/toast helpers can use it too
local COLORS = {
    bg     = Color3.fromRGB(18, 20, 26),
    panel  = Color3.fromRGB(26, 29, 37),
    accent = Color3.fromRGB(232, 72, 60),
    text   = Color3.fromRGB(235, 238, 245),
    dim    = Color3.fromRGB(140, 146, 160),
    on     = Color3.fromRGB(72, 200, 130),
    off    = Color3.fromRGB(80, 86, 100),
    -- a mode that is clicking but not changing: hoisted so the per-tick
    -- comparison is reference-equal and does not rewrite the property
    warn   = Color3.fromRGB(230, 170, 60),
}

local lastLogLine, lastLogCount, lastLogStamp = nil, 0, nil

local function addLog(line)
    line = tostring(line)
    -- collapse repeats: a single error firing every tick would otherwise push
    -- every real message out of the log
    if line == lastLogLine then
        lastLogCount = lastLogCount + 1
        if Gui and Gui.Log then
            -- keep the ORIGINAL time, so the log says when it first happened
            -- rather than when it was last repeated
            LogLines[1] = string.format("[%s] %s  (x%d)", lastLogStamp,
                line, lastLogCount)
            Gui.Log.Text = table.concat(LogLines, "\n")
        end
        return
    end
    lastLogLine, lastLogCount = line, 1
    lastLogStamp = os.date("%H:%M:%S")
    table.insert(LogLines, 1, string.format("[%s] %s", lastLogStamp, line))
    while #LogLines > 40 do
        table.remove(LogLines)
    end
    if Gui and Gui.Log then
        Gui.Log.Text = table.concat(LogLines, "\n")
    end
end

local lastStatusText = nil
local function setStatus(text)
    if not Gui or not Gui.Status then return end
    if lastStatusText == text then return end
    lastStatusText = text
    Gui.Status.Text = text
end

-- state colour for the status bar: red paused, green working, amber idle
local lastStatusKind = nil
local function setStatusKind(kind)
    if not Gui or not Gui.StatusBar or lastStatusKind == kind then return end
    lastStatusKind = kind
    local color = COLORS.dim
    if kind == "paused" then
        color = Color3.fromRGB(220, 90, 80)
    elseif kind == "working" then
        color = COLORS.on
    elseif kind == "wait" then
        color = Color3.fromRGB(220, 170, 70)
    end
    Gui.StatusBar.BackgroundColor3 = color
end

local toastSeq = 0
local function toast(text)
    if not Gui or not Gui.Toast then return end
    toastSeq = toastSeq + 1
    local my = toastSeq
    Gui.Toast.Text = text
    Gui.Toast.Visible = true
    task.delay(3.5, function()
        if toastSeq == my and Gui and Gui.Toast and Gui.Toast.Parent then
            pcall(function()
                Gui.Toast.Visible = false
            end)
        end
    end)
end

local SETTINGS_FILE = "ChinaSideAutoHub_settings.txt"
local SCAN_REPORT_FILE = "ChinaSideAutoHub_scan.txt"

local settingsWarned = false
local function warnSettings()
    if not settingsWarned then
        settingsWarned = true
        addLog("settings: this executor has no writefile/readfile — toggles won't persist")
    end
end

local function saveSettings()
    local ok = pcall(function()
        local lines = {}
        for key, value in pairs(State.Features) do
            lines[#lines + 1] = key .. "=" .. (value and "1" or "0")
        end
        lines[#lines + 1] = "paused=" .. (State.Paused and "1" or "0")
        lines[#lines + 1] = "afk=" .. (State.Afk and "1" or "0")
        writefile(SETTINGS_FILE, table.concat(lines, "\n"))
    end)
    if not ok then warnSettings() end
end

local function loadSettings()
    local ok = pcall(function()
        local data = readfile(SETTINGS_FILE)
        if type(data) ~= "string" then return end
        local loaded = 0
        for line in data:gmatch("[^\n]+") do
            local key, value = line:match("^([%w_]+)=([01])")
            if key then
                if key == "paused" then
                    State.Paused = value == "1"
                elseif key == "afk" then
                    -- restored, but the clock starts now, not at last session's
                    State.Afk = value == "1"
                    State.AfkSince = now()
                elseif State.Features[key] ~= nil then
                    State.Features[key] = value == "1"
                    loaded = loaded + 1
                end
            end
        end
        if loaded > 0 then
            addLog(("settings: restored %d toggles"):format(loaded))
        end
    end)
    if not ok then warnSettings() end
end

local function safeCall(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then
        -- Counted as well as logged. Unattended, a swallowed error that repeats
        -- is a feature that is quietly dead, and the log is not there to be
        -- read; the watchdog needs a number to act on.
        State.Errors = (State.Errors or 0) + 1
        State.LastErrorAt = now()
        State.LastErrorText = tostring(err)
        addLog("error: " .. tostring(err))
    end
    return ok
end

local function guiVisible(obj)
    local node = obj
    while node and node ~= game do
        if node:IsA("GuiObject") and node.Visible == false then
            return false
        end
        if node:IsA("LayerCollector") and node.Enabled == false then
            return false
        end
        node = node.Parent
    end
    return true
end

local function matchAny(text, patterns)
    text = lower(text)
    for _, p in ipairs(patterns) do
        if string.find(text, p, 1, true) then
            return true
        end
    end
    return false
end

local function buttonText(d)
    local text = ""
    if d:IsA("TextButton") or d:IsA("TextLabel") then
        text = lower(d.Text)
    end
    if text == "" or text == "button" then
        local parts = {}
        for _, child in ipairs(d:GetDescendants()) do
            if child:IsA("TextLabel") and child.Visible and lower(child.Text) ~= "" then
                parts[#parts + 1] = lower(child.Text)
            end
        end
        if #parts > 0 then
            text = text .. " " .. table.concat(parts, " ")
        end
    end
    -- parenthesised: gsub returns (string, count) and the count must not
    -- leak out of this function
    return ((text .. " " .. lower(d.Name)):gsub("%s+", " "))
end

-- The label a button actually SHOWS, without the instance name.
--
-- Deliberately different from buttonText: that one appends d.Name, which
-- would make a tab read as "orders ordersbutton" and defeat the tab check.
-- A TextButton built with empty Text and a child TextLabel is very common in
-- this game, and without this the gated and navigation checks never saw those
-- labels at all.
local function ownLabel(d)
    local function usable(t)
        t = lower(t):gsub("^%s+", ""):gsub("%s+$", "")
        -- "Button" is Roblox's placeholder text, not a label
        if t == "" or t == "button" then return nil end
        return t
    end
    if d:IsA("TextButton") then
        local t = usable(d.Text)
        if t then return t end
    end
    for _, c in ipairs(d:GetChildren()) do
        if c:IsA("TextLabel") and c.Visible then
            local t = usable(c.Text)
            if t then return t end
        end
    end
    return ""
end

local function isGated(text)
    return matchAny(text, GATED_PATTERNS)
end

local function inHubGui(inst)
    local node = inst
    while node and node ~= game do
        if node.Name == HUB_NAME then return true end
        node = node.Parent
    end
    return false
end

local function bucketForText(text)
    -- Two passes, because a broad one-word pattern in an early bucket would
    -- otherwise steal a specific label from a later one: photo's "qc" was
    -- swallowing order's "qc check", and collect's "claim" was swallowing
    -- reward's "claim reward". Multi-word phrases are matched first, because
    -- they are the more specific statement of intent.
    --
    -- The lowercase is hoisted: this runs for every prompt, click detector,
    -- station part and button in the workspace on every scan, and re-lowering
    -- the text once per pattern tripled its cost.
    local lt = lower(text)
    for _, key in ipairs(BUCKET_ORDER) do
        for _, pattern in ipairs(BUCKET_PATTERNS[key]) do
            if string.find(pattern, " ", 1, true)
                and string.find(lt, pattern, 1, true) then
                return key
            end
        end
    end
    for _, key in ipairs(BUCKET_ORDER) do
        if matchAny(text, BUCKET_PATTERNS[key]) then
            return key
        end
    end
    return nil
end

local function isConfirmText(text)
    text = lower(text):gsub("^%s+", ""):gsub("%s+$", "")
    -- room for a real dialog title such as "Confirm Delivery"; the dangerous
    -- words (buy, robux, gamepass, purchase, cancel) are pattern-excluded
    -- below, so a longer cap cannot let a costly button through
    if text == "" or #text > 18 then return false end
    if isGated(text) or matchAny(text, WORKFLOW_EXCLUDE) then return false end
    -- A dialog button is never a workflow action, even when it mentions a
    -- workflow word: "Confirm Order" is exactly the button that finishes
    -- packing, and refusing to click it left the dialog open.
    if bucketForText(text) and not matchAny(text, { "confirm", "accept" }) then
        return false
    end
    return CONFIRM_EXACT[text] ~= nil or matchAny(text, CONFIRM_SUBSTR)
end


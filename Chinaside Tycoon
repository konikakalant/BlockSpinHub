--------------------------------------------------------------------------------
-- interaction: prompts, screen clicks, keys, movement, teleport
--------------------------------------------------------------------------------

local function triggerPrompt(p)
    if not p or not p.Parent then return false end
    local last = State.LastTrigger[p] or 0
    if now() - last < Config.PerPromptCooldown then return false end
    State.LastTrigger[p] = now()

    local originalHold = p.HoldDuration
    local ok = pcall(function()
        p.HoldDuration = 0
        p:InputHoldBegin()
        task.wait(0.05)
        p:InputHoldEnd()
    end)
    pcall(function()
        p.HoldDuration = originalHold
    end)
    if ok then
        return true
    end
    addLog("prompt trigger failed: " .. tostring(p.Name))
    return false
end

local function vimAvailable()
    return typeof(VirtualInputManager) == "Instance"
end

local function uiClickAt(x, y)
    if not vimAvailable() then return false end
    local ok = pcall(function()
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(0.06)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)
    if ok then return true end
    local ok2 = pcall(function()
        local vu = game:GetService("VirtualUser")
        vu:Button1Down(Vector2.new(x, y))
        task.wait(0.06)
        vu:Button1Up(Vector2.new(x, y))
    end)
    return ok2
end

local function screenCenter(obj)
    local pos = obj.AbsolutePosition
    local size = obj.AbsoluteSize
    return Vector2.new(pos.X + size.X / 2, pos.Y + size.Y / 2)
end

local function uiClick(obj)
    if not obj or not obj.Parent then return false end
    if not guiVisible(obj) then return false end
    local ok, center = pcall(screenCenter, obj)
    if not ok then return false end
    if center.X == 0 and center.Y == 0 then return false end
    local camera = Workspace.CurrentCamera
    if camera then
        local vp = camera.ViewportSize
        if center.X < -8 or center.Y < -8 or center.X > vp.X + 8 or center.Y > vp.Y + 8 then
            return false
        end
    end
    return uiClickAt(center.X, center.Y)
end

local function pressInteractKey()
    local focusOk, focused = pcall(function()
        return GuiService:GetFocusedTextBox()
    end)
    if focusOk and focused then return false end
    if not vimAvailable() then return false end
    local ok = pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game, 1)
    end)
    return ok
end

local function clickWorldPart(part)
    local camera = Workspace.CurrentCamera
    local root = getRoot()
    if not camera or not root or not part or not part.Parent then return false end
    local vp, onScreen = camera:WorldToViewportPoint(part.Position)
    local viewport = camera.ViewportSize
    if onScreen and vp.X >= 0 and vp.Y >= 0 and vp.X <= viewport.X and vp.Y <= viewport.Y then
        return uiClickAt(vp.X, vp.Y)
    end
    pcall(function()
        local flat = Vector3.new(part.Position.X - root.Position.X, 0,
            part.Position.Z - root.Position.Z)
        if flat.Magnitude > 0.5 then
            root.CFrame = CFrame.lookAt(root.Position,
                root.Position + Vector3.new(flat.X, 0, flat.Z))
        end
    end)
    return false
end

local function moveToTarget(rec)
    local humanoid = getHumanoid()
    local root = getRoot()
    local pos = positionOf(rec.inst)
    if not humanoid or not root or not pos then return end
    if humanoid.Health <= 0 then return end

    local dist = (root.Position - pos).Magnitude
    if State.Features.tp and dist > Config.TeleportDistance
        and now() - State.LastTeleport > Config.TeleportGap then
        State.LastTeleport = now()
        local ok = pcall(function()
            local flat = root.Position - pos
            flat = Vector3.new(flat.X, 0, flat.Z)
            if flat.Magnitude > 0.5 then
                flat = flat.Unit * 3
            else
                flat = Vector3.new(0, 0, -3)
            end
            root.CFrame = CFrame.new(pos + flat + Vector3.new(0, 4, 0))
        end)
        if ok then
            dist = (root.Position - pos).Magnitude
        end
    end
    humanoid:MoveTo(pos)
end

--------------------------------------------------------------------------------
-- navigation slot
--------------------------------------------------------------------------------

local Nav = {
    Record = nil,
    Until  = 0,
}

local function clearNav()
    Nav.Record = nil
end

local function readyWorld(rec)
    return rec.kind ~= "gui"
        and rec.inst.Parent ~= nil
        and now() >= (State.Cooldowns[rec.inst] or 0)
end

local function pickWorldTarget(bucket)
    local list = State.Targets[bucket]
    if not list or #list == 0 then return nil end
    local best, bestDist = nil, math.huge
    for _, rec in ipairs(list) do
        if readyWorld(rec) then
            local d = distanceTo(rec.inst)
            if d < bestDist then
                best, bestDist = rec, d
            end
        end
    end
    return best
end

local function fireRecord(rec)
    if rec.kind == "prompt" then
        return triggerPrompt(rec.inst)
    elseif rec.kind == "click" then
        if distanceTo(rec.inst) > rec.range then return false end
        if clickWorldPart(rec.inst) then
            State.LastTrigger[rec.inst] = now()
            return true
        end
        return false
    elseif rec.kind == "key" then
        if distanceTo(rec.inst) > rec.range then return false end
        local parent = rec.inst.Parent
        if parent then
            for _, d in ipairs(parent:GetDescendants()) do
                if d:IsA("ProximityPrompt") and d.Enabled and distanceTo(d) <= 6 then
                    if triggerPrompt(d) then
                        State.LastTrigger[rec.inst] = now()
                        return true, "prompt"
                    end
                end
            end
        end
        if pressInteractKey() then
            State.LastTrigger[rec.inst] = now()
            return true, "key"
        end
        return false
    elseif rec.kind == "pad" then
        return true
    end
    return false
end

local function runTarget(bucket, statKey, label)
    if not State.Features[bucket] then
        if Nav.Record and Nav.Record.bucket == bucket then clearNav() end
        return
    end

    if Nav.Record and Nav.Record.bucket == bucket then
        local rec = Nav.Record
        if rec.inst.Parent == nil then
            clearNav()
            return
        end
        local d = distanceTo(rec.inst)
        if d <= rec.range then
            local ok, mode = fireRecord(rec)
            if ok then
                State.Cooldowns[rec.inst] = now() + Config.PerPromptCooldown
                State.Cooldowns["__" .. bucket] = now() +
                    (bucket == "raid" and 2 or Config.PromptCooldown)
                State.Stats[statKey] = State.Stats[statKey] + 1
                if mode == "key" then
                    addLog(label .. " #" .. State.Stats[statKey] .. " (E key)")
                else
                    addLog(label .. " #" .. State.Stats[statKey])
                end
            else
                State.Cooldowns[rec.inst] = now() + 2
            end
            clearNav()
        elseif now() > Nav.Until then
            addLog(label .. ": move timeout — skipping target")
            State.Cooldowns[rec.inst] = now() + 15
            clearNav()
        else
            moveToTarget(rec)
        end
        return
    end

    local list = State.Targets[bucket]
    if list then
        for _, rec in ipairs(list) do
            if rec.kind == "gui" and rec.inst.Parent and guiVisible(rec.inst)
                and now() >= (State.Cooldowns[rec.inst] or 0) then
                if uiClick(rec.inst) then
                    State.Cooldowns[rec.inst] = now() + Config.GuiTargetCooldown
                    State.Stats[statKey] = State.Stats[statKey] + 1
                    addLog(label .. " (gui) #" .. State.Stats[statKey])
                    return
                else
                    State.Cooldowns[rec.inst] = now() + Config.GuiTargetCooldown
                end
            end
        end
    end

    if Nav.Record and Nav.Record.bucket ~= bucket then
        return
    end

    if now() < (State.Cooldowns["__" .. bucket] or 0) then return end
    local target = pickWorldTarget(bucket)
    if not target then return end
    Nav.Record = target
    Nav.Until = now() + Config.MoveTimeout
end

--------------------------------------------------------------------------------
-- cash pads: walk over anchored cash/claim parts in the base
--------------------------------------------------------------------------------

local function runCollectPads()
    if not State.Features.collect then return end
    if Nav.Record then return end
    if now() < (State.Cooldowns["__pads"] or 0) then return end
    local root = getRoot()
    if not root then return end

    local container = State.Base or Workspace
    local best, bestDist = nil, 70
    for _, d in ipairs(container:GetDescendants()) do
        if d:IsA("BasePart") and d.Anchored then
            local n = lower(d.Name)
            if matchAny(n, { "cash", "money", "claim", "collector", "dropoff", "payout" })
                and not string.find(n, "wall", 1, true)
                and now() >= (State.Cooldowns[d] or 0)
                and (State.Base == nil or State.Base:IsAncestorOf(d)) then
                local d2 = (root.Position - d.Position).Magnitude
                if d2 < bestDist then
                    best, bestDist = d, d2
                end
            end
        end
    end
    if best then
        Nav.Record = { kind = "pad", inst = best, bucket = "collect", range = 4 }
        Nav.Until = now() + Config.MoveTimeout
        State.Cooldowns["__pads"] = now() + 3.0
    end
end


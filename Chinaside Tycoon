    local function layoutFor(h)
        local listH: number = math.clamp(h - 638 + 360, 110, 360)
        local actY = LIST_Y + listH + GAP
        local statsY = actY + ACT_H + 6
        local logY = statsY + STATS_H + 6
        local logH: number = h - logY - 8
        if logH < 50 then
            local listH2: number = math.max(90, listH - (50 - logH))
            actY = LIST_Y + listH2 + GAP
            statsY = actY + ACT_H + 6
            logY = statsY + STATS_H + 6
            listH, logH = listH2, h - logY - 8
        end
        return listH, actY, statsY, logY, math.max(40, logH)

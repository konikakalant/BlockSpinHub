local CANCEL_TEXT = {
    ["cancel"] = true, ["no thanks"] = true, ["not now"] = true,
    ["never mind"] = true, ["no, thanks"] = true, ["x"] = true,
    ["close"] = true, ["no"] = true,
}

local lastPromptLog = 0
local lastPromptAct = 0
local lastGatedLog = 0
local escapeArmedAt = 0

local function findPromptNode(node, depth)
    if depth > 14 then return nil end
    if node:IsA("GuiObject") and node.Visible == false then return nil end
    if node:IsA("LayerCollector") and node.Enabled == false then return nil end
    local n = lower(node.Name)
    if string.find(n, "purchaseprompt", 1, true)
        or string.find(n, "robloxprompt", 1, true)
        or (string.find(n, "prompt", 1, true)
            and (string.find(n, "purchase", 1, true)
                or string.find(n, "robux", 1, true)
                or string.find(n, "gamepass", 1, true)
                or string.find(n, "buy", 1, true))) then
        return node
    end
    for _, child in ipairs(node:GetChildren()) do
        local found = findPromptNode(child, depth + 1)
        if found then return found end
    end
    return nil
end

-- did the last action actually do anything?
--
-- A click that changes nothing is a wasted click: it burns the per-tick click
-- budget, spams the game, and inflates the counters. After every action the
-- hub snapshots the game's own on-screen numbers, and a moment later compares
-- them. Unchanged means the target is dead (no orders left, on cooldown, wrong
-- button) and gets an exponentially longer wait; changed means real work was
-- done and the target is trusted again.
--------------------------------------------------------------------------------

-- How long to leave a target alone after it produced nothing. The cap
-- depends on the mode: a fast-effect mode can be parked for a long time,
-- while a slow-paying one (photo, packing) gets a much shorter ladder so it
-- recovers almost at once. Without a per-mode cap, one dead station either
-- blocked its mode for half a minute or - for the slow modes - was retried
-- every two seconds for ever and starved every other station behind it.
local function backoffFor(inst, bucket)
    local misses = State.NoChange[inst] or 0
    if misses <= 0 then return 0 end
    local cap = FAST_EFFECT[bucket] and Config.MaxBackoff
        or Config.SlowModeBackoff
    return math.min(cap, Config.GuiTargetCooldown * (2 ^ (misses - 1)))
end

-- One writer for every per-target cooldown, and it can only ever RAISE a
-- deadline. Without this, a short backoff silently overwrote the 90s
-- gamepass shelve and the 30s stuck shelve, undoing those protections.
-- The flat cooldown is only a starting point. A mode that keeps confirming
-- is retried faster and faster, down to Config.MinTune; a mode that stops
-- confirming is pushed back out again. Modes tune independently, so one slow
-- corner of the map cannot hold the whole hub back.
local function tuneFor(bucket)
    -- indexing a table with nil raises, so the guard belongs here rather than
    -- at the call site
    if not bucket then return Config.DefaultTune end
    local t = State.Tune[bucket]
    if not t then
        t = Config.DefaultTune
        State.Tune[bucket] = t
    end
    return t
end

-- WHICH TARGETS ARE ACTUALLY WORTH THE WALK
--
-- The keyword lists say what a button is CALLED. Only measurement says whether
-- it does anything. Each target earns or loses a little quality every time it
-- produces, or fails to produce, a change, and the picker uses that alongside
-- fairness and distance. Quality is clamped to 0..1 and the queue multiplier
-- never drops below QualityFloor, so the worst target on the map is tried
-- rarely rather than never.
local function noteQuality(inst, worked)
    if not inst then return end
    local q = State.Quality[inst]
    if not q then
        q = Config.QualityStart
        State.Quality[inst] = q
    end
    if worked then
        q = math.min(1, q + Config.QualityStep)
    else
        q = math.max(0, q - Config.QualityStep)
    end
    State.Quality[inst] = q
end

local function qualityOf(inst)
    return State.Quality[inst] or Config.QualityStart
end

local function cdFor(kind, inst, bucket)
    -- never faster than the mode's own measured response time, because
    -- clicking again before the last one landed can only be wasted
    local floor_ = spacingFloor(bucket)
    local base = tuneFor(bucket)
    if base < floor_ then base = floor_ end
    if kind ~= "gui" then
        base = math.max(Config.PerPromptCooldown, floor_)
    end
    return now() + base + backoffFor(inst, bucket)
end

-- A confirmation is proof the click landed, so earn the right to go faster.
local function tuneFaster(bucket)
    local t = tuneFor(bucket)
    -- The floor is the mode's MEASURED response time, not just MinTune. Tuning
    -- faster than a mode can possibly react is how a working mode gets declared
    -- broken, so the measurement wins.
    local floor_ = spacingFloor(bucket)
    if t < floor_ then
        -- raised to the floor rather than left alone: State.Tune is what the HUD
        -- displays and what cdFor starts from, so storing a spacing the game
        -- cannot honour would make the hub look faster than it is
        State.Tune[bucket] = floor_
    elseif t > floor_ then
        State.Tune[bucket] = math.max(floor_, t * 0.8)
    end
end

-- Silence means the click did nothing. Ease off, but never below the default,
-- so a mode that has gone bad cannot creep faster than it started.
local function tuneSlower(bucket)
    local t = tuneFor(bucket)
    -- never below the measured floor, and never above the default: a mode that
    -- has gone bad is pushed back out to where it started, not beyond it
    local capped = math.min(Config.DefaultTune, t * 1.25)
    State.Tune[bucket] = math.max(spacingFloor(bucket), capped)
end

local function setCd(inst, deadline)
    if not inst then return end
    State.Cooldowns[inst] = math.max(State.Cooldowns[inst] or 0, deadline)
end

-- a short list, not one slot: a tick can fire two clicks and the first
-- verdict must not be thrown away
local function noteAction(bucket, statKey, inst, kind)
    local list = State.Pending
    list[#list + 1] = {
        bucket = bucket,
        statKey = statKey,
        inst = inst,
        kind = kind or "gui",
        sig = State.Signature or "",
        cash = State.CashNow,
        -- this mode's own counter, if the observer could read one. It is the
        -- only signal that can prove THIS click is what changed the game.
        counter = State.CounterByBucket[bucket]
            and State.CounterByBucket[bucket].value or nil,
        at = now(),
    }
    -- NOTE: nothing is recorded in State.History here. The window is written
    -- when an attempt is JUDGED, not when it is started. A placeholder was
    -- tried and was badly wrong: the credit branch "flipped" an entry that was
    -- already true, while the miss branch pushed a SECOND entry, so 12 misses
    -- in a row produced true,false,true,false... and a dead mode reported
    -- "4 of last 8 confirmed" as WORKING for ever.
    -- must exceed (actions per second x SettleMinAge) or entries are
    -- dropped before they can ever be judged
    while #list > Config.MaxPending do table.remove(list, 1) end
end

local warnedNoEffect = {}

-- Is a response still owed? True while any action taken within the judging
-- window could still produce one.
--
-- This deliberately stays TRUE after the action has been judged. Gating on
-- "not yet judged" stopped reading the screen at 1.2s - which is exactly the
-- moment a slower mode is still working, so those responses were never seen
-- and their timings could never be learned. Entries are appended in order, so
-- the newest one bounds the answer.
local function pendingAwaitingJudgement()
    local list = State.Pending
    local last = list[#list]
    if not last then return false end
    return (now() - last.at) < Config.SettleMaxAge
end

local function settleAction()
    local list = State.Pending
    if #list == 0 then return end

    local t = now()

    -- An action is judged ONCE, at the first pass old enough to judge it, and
    -- is then left in place until it is well past that window.
    --
    -- It used to be REMOVED at that moment instead. That looks tidy and is
    -- wrong twice over: it cannot be measured afterwards, so any mode slower
    -- than the judging age could never have its response time learned - the
    -- exact case the latency learner exists for - and an action that needed
    -- three seconds was recorded as a failure at 1.2s and thrown away.
    --
    -- `judged` keeps the result from being counted twice, and the entry stays
    -- findable by the observer so the moment its counter moves can still be
    -- attributed to the click that caused it.
    for i = #list, 1, -1 do
        if t - list[i].at > Config.SettleMaxAge then
            table.remove(list, i)
        end
    end
    local mature = {}
    for i = #list, 1, -1 do
        if not list[i].judged and t - list[i].at >= Config.SettleMinAge then
            list[i].judged = true
            mature[#mature + 1] = list[i]
        end
    end
    if #mature == 0 then return end
    local judgeable = mature

    -- Read the game NOW. Cash is checked first because it is exact; the
    -- on-screen numbers are only a fallback for games that do not expose a
    -- wallet value, and they have to be re-read on demand because the ordinary
    -- walk can be seconds old.
    sampleCash()
    -- a forced read, so a counter change is timestamped as close to the moment
    -- it happened as the engine allows, rather than up to a safety-net interval
    -- later
    refreshSignature(true)

    -- ------------------------------------------------------------------------
    -- WHO GETS THE CREDIT
    --
    -- This used to judge every pending action against one global signal -
    -- "did anything on screen change at all". With up to twelve actions in
    -- flight, a single real change, or a single tick of passive income, marked
    -- ALL of them confirmed. A dead button could therefore sit there reporting
    -- WORKING for the rest of the session, and the tuner would read its own
    -- background earnings as proof that every click landed.
    --
    -- The credit is now EXCLUSIVE - at most one action per pass - and the
    -- evidence is ranked:
    --   1. the action whose OWN counter moved. That is direct proof.
    --   2. otherwise the OLDEST action, if anything on screen changed.
    --   3. otherwise the oldest, if cash jumped clear of the background drift.
    --   4. otherwise nobody is credited and the rest are recorded honestly.
    --
    -- Anyone not credited is recorded as a miss, which is honest but not
    -- fatal: the per-mode backoff ladder caps photo and packing at a few
    -- seconds (Config.SlowModeBackoff), so a slow-paying mode recovers almost
    -- at once instead of being shelved like a fast-effect mode would be.
    ------------------------------------------------------------------------
    local cashKnown = State.CashKnown and State.CashNow ~= nil
    local signatureChanged = false
    local credit, creditWhy = nil, nil
    local oldest = nil
    local proven = {}
    -- judgeable is newest-first (the harvest loop walks the pending list
    -- backwards), so breaking here credits the NEWEST pending action of that
    -- mode. That is the right one to credit: a counter that has just moved was
    -- most likely moved by the most recent click on it, and it is also the
    -- only choice that does not let an old unrelated action take the credit.
    --
    -- NOTE: judgeable is newest-first (the harvest loop walks the pending list
    -- backwards), so the first match below is the NEWEST action of that mode.
    -- That is the right one: a counter that has just moved was most likely
    -- moved by the most recent click on it.
    --
    -- EVERY match is credited, not just the first. Each one is proven by its
    -- OWN counter, which is direct evidence tied to that specific action, so
    -- crediting two of them is not cross-attribution. Making this exclusive
    -- meant that whenever two working buckets happened to land in the same
    -- tick - which they do constantly, because the round runs every mode every
    -- tick - only the later one won and the other was logged as a miss, so a
    -- mode doing real work reported NOT RESPONDING.
    for _, p in ipairs(judgeable) do
        oldest = p
        if p.kind ~= "pad" and p.counter ~= nil then
            local c = State.CounterByBucket[p.bucket]
            if c and c.value ~= p.counter then
                proven[p] = true
                -- Only a counter-proven change measures response time. A credit
                -- from the global screen/cash rules can be given to the oldest
                -- action, whose age says nothing about how long THIS mode takes.
                p.proven = true
                if not credit then
                    credit, creditWhy = p, "counter"
                end
            end
        end
    end
    if not credit then
        for _, p in ipairs(judgeable) do
            if p.kind ~= "pad" and (State.Signature or "") ~= p.sig then
                signatureChanged = true
                break
            end
        end
        if not credit and oldest and oldest.kind ~= "pad" then
            if signatureChanged then
                credit, creditWhy = oldest, "screen"
            elseif cashKnown and oldest.cash ~= nil then
                local jump = math.abs((State.CashNow or oldest.cash) - oldest.cash)
                -- must beat the recent rate of ordinary money movement, or
                -- passive income takes the credit for a click that did nothing
                if (State.CashNow or oldest.cash) ~= oldest.cash
                    and jump > ((State.CashDrift or 0) * 1.5 + 1) then
                    credit, creditWhy = oldest, "cash"
                end
            end
        end
    end

    for _, p in ipairs(judgeable) do
            if p.kind == "pad" then
                -- a cash pad action is a walk, not a click: the payout can take
                -- seconds to appear, so it is credited rather than judged
                if p.statKey then
                    State.Verified[p.statKey] = (State.Verified[p.statKey] or 0) + 1
                end
                -- Pads must count as progress too. A collect-only session never
                -- enters the non-pad branch at all, so without this the
                -- watchdog saw attempts climbing and confirmations never
                -- moving, and escalated to "NEEDS ATTENTION" while the cash was
                -- coming in perfectly well.
                -- Counted as activity, but deliberately NOT as a confirmation
                -- for the watchdog's purposes. A pad is credited simply for
                -- being walked to, so with a pad nearby it refreshes every few
                -- seconds for ever: the watchdog would then never see a lack
                -- of progress and would never notice that photo, order and
                -- ship had all quietly stopped working.
                State.TotalPadWalks = (State.TotalPadWalks or 0) + 1
                if p.bucket then
                    State.ResponseTries[p.bucket] =
                        (State.ResponseTries[p.bucket] or 0) + 1
                end
            else
                local changed = proven[p] or (credit == p)
                State.LastRealTryAt = t
                if changed then
                    State.TotalConfirmed = (State.TotalConfirmed or 0) + 1
                    State.LastConfirmedAt = t
                    State.RecoveryStep = 0
                    State.RecoveryDone = false
                    if p.inst then
                        State.NoChange[p.inst] = nil
                        noteQuality(p.inst, true)
                    end
                    if p.proven then
                        -- measured from when the counter MOVED, not from when
                        -- this pass happened to look at it
                        local movedAt = State.CounterAtBucket[p.bucket]
                        if movedAt and movedAt >= p.at then
                            noteLatency(p.bucket, movedAt - p.at)
                        end
                    end
                    if p.statKey then
                        State.Verified[p.statKey] = (State.Verified[p.statKey] or 0) + 1
                        State.Misses[p.statKey] = 0
                        local hist = State.History[p.statKey]
                        if not hist then
                            hist = {}
                            State.History[p.statKey] = hist
                        end
                        table.insert(hist, true)
                        while #hist > Config.HistoryWindow do
                            table.remove(hist, 1)
                        end
                        -- The mode is working, so any STALE per-target failure
                        -- in it is out of date. Without this a photo station
                        -- that failed once kept its 6s backoff for ever, even
                        -- though the mode as a whole was paying out.
                        local tlist = State.Targets[p.bucket]
                        if tlist then
                            for _, rec in ipairs(tlist) do
                                State.NoChange[rec.inst] = nil
                            end
                        end
                    end
                    if p.bucket then tuneFaster(p.bucket) end
                    if creditWhy == "counter" and not State.AnnouncedCounter then
                        State.AnnouncedCounter = true
                        addLog("autopilot: work is being confirmed from the game's own counters")
                    end
                else
                    noteQuality(p.inst, false)
                    if p.bucket then
                        State.ResponseTries[p.bucket] =
                            (State.ResponseTries[p.bucket] or 0) + 1
                    end
                    if p.statKey then
                        State.Misses[p.statKey] = (State.Misses[p.statKey] or 0) + 1
                        local hist = State.History[p.statKey]
                        if not hist then
                            hist = {}
                            State.History[p.statKey] = hist
                        end
                        table.insert(hist, false)
                        while #hist > Config.HistoryWindow do
                            table.remove(hist, 1)
                        end
                    end
                    -- Only ease a mode off when NOTHING can be credited, not
                    -- merely because some other action took the credit this
                    -- pass. Otherwise a busy round would punish every mode.
                    if p.bucket and not FAST_EFFECT[p.bucket] and not credit then
                        tuneSlower(p.bucket)
                    end
                    -- Only back off modes whose effect is immediate and
                    -- observable. Photos and packing look like no-ops for a
                    -- second or two by design, and throttling them would break
                    -- the two most important modes in the game.
                    if p.inst then
                        local misses = (State.NoChange[p.inst] or 0) + 1
                        State.NoChange[p.inst] = misses
                        -- Every mode backs off a dead target now, not just the
                        -- fast-effect ones. cdFor already adds the per-mode
                        -- backoff, so this is the same call as before; what
                        -- changed is the gate, and the cap now lives in
                        -- backoffFor so slow modes back off far less.
                        -- The loss log is kept to FAST_EFFECT modes so a slow
                        -- one that is merely not responding does not spam.
                        setCd(p.inst, cdFor(p.kind, p.inst, p.bucket))
                        if misses == 3 then
                            addLog(("%s: target not responding, waiting longer "
                                .. "between tries"):format(p.bucket:upper()))
                        end
                    end
                end
            end
    end

    for _, bucket in ipairs(BUCKET_ORDER) do
        local key = STAT_KEYS[bucket]
        local tries = State.Stats[key] or 0
        local ok = State.Verified[key] or 0
        if (State.Misses[key] or 0) >= 4 and ok == 0 and not warnedNoEffect[bucket] then
            warnedNoEffect[bucket] = true
            addLog(("%s: %d tries with no visible change — press SCAN to read "
                .. "the report"):format(bucket:upper(), tries))
        end
    end
end


local function runPurchaseGuard()
    -- the recursive CoreGui/PlayerGui walk only runs when a new GUI object
    -- actually appeared (or as a periodic safety net)
    if not State.PromptDirty and now() - State.LastPromptWatch < Config.PromptWatchEvery then
        return
    end
    if now() - State.LastPromptWatch < 0.6 then return end
    State.PromptDirty = false
    State.LastPromptWatch = now()

    local roots = {}
    local okCore, coreGui = pcall(function()
        return game:GetService("CoreGui")
    end)
    if okCore and coreGui then roots[#roots + 1] = coreGui end
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then roots[#roots + 1] = playerGui end

    local prompt = nil
    for _, root in ipairs(roots) do
        local ok, found = pcall(findPromptNode, root, 0)
        if ok and found then
            prompt = found
            break
        end
    end
    if not prompt then return end

    if now() - lastPromptAct < 1.2 then return end
    lastPromptAct = now()

    local clicked = false
    pcall(function()
        for _, d in ipairs(prompt:GetDescendants()) do
            if clicked then return end
            if (d:IsA("TextButton") or d:IsA("ImageButton"))
                and guiVisible(d) then
                local t = d:IsA("TextButton") and lower(d.Text):gsub("^%s+", "")
                    :gsub("%s+$", "") or ""
                if CANCEL_TEXT[t] == true and not isGated(t) then
                    if uiClick(d, true) then clicked = true end
                end
            end
        end
    end)
    if not clicked and now() - escapeArmedAt > 6 then
        escapeArmedAt = now()
        sendKey(Enum.KeyCode.Escape, false)
    end

    if State.LastGuiClick and State.LastGuiClick.Parent
        and now() - State.LastGuiClickAt < 5 then
        setCd(State.LastGuiClick, now() + 90)
        if now() - lastGatedLog > 8 then
            lastGatedLog = now()
            addLog("gated: button wants a gamepass — shelved 90s, "
                .. "continuing on free paths")
        end
        State.LastGuiClick = nil
    end
    if now() - lastPromptLog > 8 then
        lastPromptLog = now()
        addLog("purchase prompt cancelled — nothing bought")
        toast("Purchase prompt closed")
    end
end

-- Multi-step dialog handling.
--
-- This used to walk every descendant of PlayerGui several times a second for
-- as long as a confirm window was armed - and windows were armed after nearly
-- every action, so it was effectively a permanent full UI walk. The candidate
-- buttons are now collected during the walk findGuiObjects already makes, and
-- this iterates that short list instead.
--
-- It also used to allow exactly ONE confirm per action. An order is normally
-- several steps long (process -> confirm -> pack -> confirm), so the second
-- dialog used to be left sitting on screen with nothing able to close it. The
-- window now re-arms for up to Config.MaxConfirmsPerAction confirms, and only
-- closes when a step is not followed by another.
local function runConfirmClick()
    if now() > State.ConfirmUntil or not State.ConfirmBucket then return end
    if not State.Features[State.ConfirmBucket] then
        State.ConfirmUntil = 0
        State.ConfirmBucket = nil
        State.ConfirmCount = 0
        State.ConfirmEmptyScans = 0
        return
    end
    local list = State.ConfirmList
    if not list or #list == 0 then
        -- An empty list is only meaningful if a walk has actually happened
        -- since the window was armed. Otherwise the list is merely stale and
        -- closing here would abandon the dialog before it was ever seen.
        -- the list is only empty-meaningful once a walk has happened SINCE
        -- this window was armed. Testing "a walk in the last few seconds" was
        -- not enough: the walk that armed the window also satisfies that, so
        -- the window was closed while the dialog was still being created and
        -- the whole multi-step chain was abandoned.
        if (State.LastUiScan or 0) < (State.ConfirmArmedAt or 0) then
            return
        end
        -- A walk HAS happened since this step was armed and still no dialog.
        -- One empty walk is not enough to believe that: findGuiObjects has a
        -- half-second floor, so the first walk after a click can land while
        -- the dialog is still being created. Two consecutive empty walks means
        -- the step really is over.
        State.ConfirmEmptyScans = (State.ConfirmEmptyScans or 0) + 1
        if State.ConfirmEmptyScans < 2 then
            State.UiDirty = true
            return
        end
        -- no dialog on screen. A cleared step means the chain is over; an
        -- untouched window just expired.
        if State.ConfirmCount and State.ConfirmCount > 0 then
            addLog(("%s: %d step(s) confirmed"):format(
                State.ConfirmBucket:upper(), State.ConfirmCount))
        end
        State.ConfirmCount = 0
        State.ConfirmEmptyScans = 0
        State.ConfirmUntil = 0
        State.ConfirmBucket = nil
        State.ConfirmFromGui = false
        return
    end
    local statKey = STAT_KEYS[State.ConfirmBucket]
    for _, d in ipairs(list) do
        if d.Parent and guiVisible(d)
            and now() >= (State.Cooldowns[d] or 0) then
            if State.GuiClicksThisTick >= Config.MaxGuiClicksPerTick then
                return
            end
            local t = lower(d.Text)
            if confirmIsSafe(d) and uiClick(d) then
                State.GuiClicksThisTick = State.GuiClicksThisTick + 1
                setCd(d, now() + 3)
                if statKey then
                    State.Stats[statKey] = (State.Stats[statKey] or 0) + 1
                end
                noteAction(State.ConfirmBucket, statKey, d, "gui")
                State.LastAction = (State.ConfirmBucket or "?"):upper()
                    .. " confirm"
                State.ConfirmCount = (State.ConfirmCount or 0) + 1
                local step = State.ConfirmCount
                addLog(("confirm: clicked \"%s\" (%s, step %d)"):format(
                    t, State.ConfirmBucket, step))
                if step >= Config.MaxConfirmsPerAction then
                    State.ConfirmUntil = 0
                    State.ConfirmBucket = nil
                    State.ConfirmFromGui = false
                    State.ConfirmCount = 0
                    State.ConfirmEmptyScans = 0
                else
                    -- another step may be coming: keep the window open, but
                    -- force a fresh UI read so the next dialog is seen
                    --
                    -- ConfirmArmedAt has to be re-stamped here as well as at
                    -- the first arming. It is what makes the "is this list
                    -- really empty" test meaningful for THIS step; without it
                    -- the test went slack from step two onwards and a dialog
                    -- that had not finished rendering was written off.
                    State.ConfirmUntil = now() + Config.ConfirmWindow
                    State.ConfirmArmedAt = now()
                    State.ConfirmEmptyScans = 0
                    State.UiDirty = true
                end
                return
            end
        end
    end
end

--------------------------------------------------------------------------------
-- aiming
--
-- Actions like "shoot a QC photo" are not really clicks: the game checks that
-- the reticle is ON the object, so the camera has to be pointed at it with the
-- right pitch. Turning the character's body sideways (all clickWorldPart does)
-- is not enough, which is the most likely reason photos never worked.
--------------------------------------------------------------------------------
local function aimPointOn(inst)
    -- the middle of the target, so the crosshair lands on it rather than on
    -- some arbitrary corner
    if not inst then return nil end
    if inst:IsA("BasePart") then
        if not inst.Parent then return nil end
        return inst.Position
    end
    local ok, cf = pcall(function()
        return inst:GetBoundingBox()
    end)
    if ok and cf then return cf.Position end
    return positionOf(inst)
end

-- Point the CAMERA at a target. Deliberately does not move the character:
-- walking into range is moveToTarget's job, and an earlier version stood the
-- character exactly 6 studs away, which threw away the walk, ignored the
-- "Teleport to Stations" toggle and could drop the character into geometry.
local function aimAt(worldPos, pitchOffset, dwell)
    local camera = Workspace.CurrentCamera
    if not camera or not worldPos then return false end
    -- never aim with a dead body
    local humanoid = getHumanoid()
    if not humanoid or humanoid.Health <= 0 then return false end
    -- a seated character ignores everything, and simply refusing here used to
    -- deadlock: every attempt failed, nav was cleared, and the stuck timer
    -- that would have stood us up never got the chance to run
    if humanoid.Sit then
        pcall(function() humanoid.Sit = false end)
        task.wait(0.1)
        if humanoid.Sit then return false end
    end

    local origin = camera.CFrame.Position
    local ok = pcall(function()
        camera.CFrame = CFrame.lookAt(origin,
            worldPos + Vector3.new(0, pitchOffset or 0, 0))
    end)
    if not ok then return false end

    if dwell and dwell > 0 then
        -- hold the aim: a game may sample the camera over several frames, and
        -- the camera script rewrites CFrame every frame
        task.wait(dwell)
    end
    return true
end

-- Is the crosshair actually on this target? A crosshair game ignores a click
-- that lands on the floor, so this is checked before firing rather than after.
-- Clicking a world part means clicking a SCREEN position, so anything outside
-- the viewport cannot be clicked at all. When the target was off screen this
-- used to turn the character's body and give up, which cannot help: the body
-- facing an object does not put the object on screen, so a station behind or
-- beside the player could never be clicked and was retried every two seconds
-- for ever. Turning the CAMERA puts the target on screen, and the camera is
-- restored straight afterwards. The character itself is never moved.
local function clickWorldPart(part)
    if not part or not part.Parent then return false end
    local camera = Workspace.CurrentCamera
    local root = getRoot()
    local pos = positionOf(part)
    if not camera or not root or not pos then return false end
    local viewport = camera.ViewportSize

    local function attempt()
        local vp, onScreen = camera:WorldToViewportPoint(pos)
        if onScreen and vp.X >= 0 and vp.Y >= 0
            and vp.X <= viewport.X and vp.Y <= viewport.Y then
            -- never click our own panel: it is opaque and would eat the click
            if overHub(Vector2.new(vp.X, vp.Y)) then return false end
            return uiClickAt(vp.X, vp.Y)
        end
        return false
    end

    if attempt() then return true end

    local saved = camera.CFrame
    -- gated on its own toggle only: the body turn below is the ORIGINAL
    -- behaviour and must keep working when the camera aim is switched off
    local turned = State.Features.aim and aimAt(pos, 0, 0)
    if turned then
        if attempt() then
            -- leave the camera where the player last had it
            task.spawn(function()
                task.wait(0.25)
                pcall(function() camera.CFrame = saved end)
            end)
            return true
        end
    end
    pcall(function() camera.CFrame = saved end)
    -- last resort, as before: face the target with the body
    pcall(function()
        local flat = Vector3.new(pos.X - root.Position.X, 0,
            pos.Z - root.Position.Z)
        if flat.Magnitude > 0.5 then
            root.CFrame = CFrame.lookAt(root.Position,
                root.Position + Vector3.new(flat.X, 0, flat.Z))
        end
    end)
    return false
end

local function reticleOnTarget(inst)
    local camera = Workspace.CurrentCamera
    if not camera or not inst then return false end
    local vp = camera.ViewportSize
    local ok, hit = pcall(function()
        local ray = camera:ViewportPointToRay(vp.X / 2, vp.Y / 2)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { getCharacter() }
        params.IgnoreWater = true
        return Workspace:Raycast(ray.Origin, ray.Direction * 500, params)
    end)
    if not ok or not hit then return false end
    local part = hit.Instance
    -- Accept only the target itself or something inside it. An earlier version
    -- also accepted "any part of the model that contains what we hit", which
    -- meant a wall or the floor of the base counted as hitting the table.
    if part == inst then return true end
    if part:IsDescendantOf(inst) then return true end
    local model = part:FindFirstAncestorOfClass("Model")
    if model and model == inst then return true end
    return false
end

-- click the middle of the screen, which is where the crosshair is
local function clickAtReticle()
    local camera = Workspace.CurrentCamera
    if not camera then return false end
    local vp = camera.ViewportSize
    local point = Vector2.new(vp.X / 2, vp.Y / 2)
    -- the hub's own panel is opaque and would swallow the shot
    if overHub(point) then return false end
    return uiClickAt(point.X, point.Y)
end

-- ------------------------------------------------------------------------
-- PATHFINDING
--
-- With teleport ON, walls do not matter: the character simply arrives. With
-- teleport OFF the hub walked in a straight line, so a fence, a wall or a
-- piece of furniture between the player and the station meant the character
-- pressed against it until the move timed out, got shelved for 30s, and the
-- whole thing repeated. That is why the stuck ladder needed teleport to
-- recover at all.
--
-- This asks the engine for a route and walks the waypoints. It is entirely
-- client-side and read-only: the engine is only being asked where the floor
-- is. Anything that goes wrong - no navmesh, a failed computation, a destroyed
-- part - falls straight back to the old straight line, so the worst case is
-- exactly the behaviour we had before.
local Path = {
    Rec = nil,
    Points = {},
    Index = 1,
    -- set once a route has been walked to the end, so the hub does not start
    -- computing another one for the same target
    Done = false,
    -- earliest time to retry a target whose computation failed
    RetryAt = 0,
    -- true while ComputeAsync is in flight, so the per-tick caller cannot
    -- start a second request for the same target before the first returns
    Computing = false,
    -- identifies WHICH request is in flight, because a bare Path.Rec check
    -- cannot tell two requests for the same instance apart
    Token = 0,
}

local function clearPath()
    Path.Rec = nil
    table.clear(Path.Points)
    Path.Index = 1
    Path.Done = false
    Path.RetryAt = 0
    Path.Computing = false
end

-- one computation per target, never per tick
local function startPath(rec)
    if not State.Features.pathfind then
        -- switching the toggle off must drop a live route immediately, or the
        -- row looks dead while the hub keeps following it
        if Path.Rec then clearPath() end
        return
    end
    local pos = positionOf(rec.inst)
    if not pos then return end
    if Path.Rec == rec.inst then
        -- already attempted this target: do not recompute while a route is
        -- being walked, while it has finished, or before a failure may retry
        if #Path.Points > 0 or Path.Done then return end
        if Path.Computing then return end
        if now() < (Path.RetryAt or 0) then return end
    end
    clearPath()
    Path.Rec = rec.inst
    Path.Token = Path.Token + 1
    local token = Path.Token
    Path.Computing = true
    local pfs = game:GetService("PathfindingService")
    task.spawn(function()
        local ok, points = pcall(function()
            local path = pfs:CreatePath({
                AgentRadius = 2,
                AgentHeight = 5,
                AgentCanJump = true,
                AgentCanClimb = false,
            })
            path:ComputeAsync(pos)
            if path.Status ~= Enum.PathStatus.Success then return nil end
            local wps = path:GetWaypoints()
            local out = {}
            -- waypoint 1 is where we already are
            for i = 2, #wps do
                out[#out + 1] = wps[i].Position
            end
            return out
        end)
        -- discard the result if the nav target changed, or if a NEWER request
        -- for the same target has since been issued. Without the token check a
        -- late callback applied Path.Index = 1 and restarted the route mid-walk.
        if Path.Token ~= token then return end
        Path.Computing = false
        if ok and points and #points > 0 then
            for i, p in ipairs(points) do Path.Points[i] = p end
            Path.Index = 1
            Path.Done = false
        else
            -- No navmesh here, or the computation failed. Walking straight at
            -- the target is the correct fallback, so Path.Rec is KEPT: that
            -- stops this from becoming a per-tick retry storm, and a short
            -- delay lets one transient failure recover on its own.
            Path.RetryAt = now() + Config.PathRetryEvery
        end
    end)
end

-- returns a position to walk to, or nil to walk straight at the target
local function nextPathPoint(root)
    if #Path.Points == 0 then return nil end
    local p = Path.Points[Path.Index]
    if not p then return nil end
    if (root.Position - p).Magnitude <= 3 then
        Path.Index = Path.Index + 1
        p = Path.Points[Path.Index]
        if not p then
            -- Route finished. Path.Rec is deliberately KEPT and Done set:
            -- clearing Rec here made the very next tick start another
            -- computation for the same target, so walking the last few studs
            -- to a station ran a fresh ComputeAsync about twice a second.
            table.clear(Path.Points)
            Path.Index = 1
            Path.Done = true
            return nil
        end
    end
    return p
end


local function moveToTarget(rec)
    local humanoid = getHumanoid()
    local root = getRoot()
    local pos = positionOf(rec.inst)
    if not humanoid or not root or not pos then return end
    if humanoid.Health <= 0 then return end

    local dist = (root.Position - pos).Magnitude
    if State.Features.tp and dist > Config.TeleportDistance
        and now() - State.LastTeleport > Config.TeleportGap then
        State.LastTeleport = now()
        local ok = pcall(function()
            local flat = root.Position - pos
            flat = Vector3.new(flat.X, 0, flat.Z)
            if flat.Magnitude > 0.5 then
                flat = flat.Unit * 3
            else
                flat = Vector3.new(0, 0, -3)
            end
            root.CFrame = CFrame.new(pos + flat + Vector3.new(0, 4, 0))
        end)
        if ok then
            dist = (root.Position - pos).Magnitude
        end
    end

    -- teleport already put us here, or it is off: no route needed
    if State.Features.tp and dist <= Config.TeleportDistance then
        clearPath()
        humanoid:MoveTo(pos)
        return
    end
    startPath(rec)
    local step = nextPathPoint(root)
    humanoid:MoveTo(step or pos)
end

--------------------------------------------------------------------------------
-- navigation slot
--------------------------------------------------------------------------------

local Nav = {
    Record = nil,
    Until  = 0,
}

-- Where the player is actually trying to get to RIGHT NOW. The stuck detector
-- has to measure progress against this rather than against the target itself:
-- on a detour around a wall the straight-line distance to the target barely
-- moves, so the detector would call a perfectly good route stuck and shelf it.
local function navProgressTarget()
    if Path.Rec and #Path.Points > 0 then
        return Path.Points[Path.Index]
    end
    if Nav.Record then return positionOf(Nav.Record.inst) end
    return nil
end

local function clearNav()
    Nav.Record = nil
    clearPath()
    State.StuckSince = 0
    State.StuckPrevDist = 0
    State.StuckPrevVia = math.huge
    State.StuckLastCheck = now()
end

-- single place where navigation is claimed, so stuck-tracking state can never
-- leak from one target into the next
local function setNav(rec, timeout)
    if Nav.Record ~= rec then clearPath() end
    Nav.Record = rec
    if rec then
        rec.lastTried = now()
        State.LastTried[rec.inst] = rec.lastTried
    end
    State.StuckSince = 0
    State.StuckPrevDist = 0
    State.StuckPrevVia = math.huge
    State.StuckLastCheck = now()
    Nav.Until = now() + (timeout or Config.MoveTimeout)
end


local function triggerPrompt(p)
    if not p or not p.Parent then return false end
    local last = State.LastTrigger[p] or 0
    if now() - last < Config.PerPromptCooldown then return false end
    State.LastTrigger[p] = now()

    local originalHold = p.HoldDuration
    local ok = pcall(function()
        p.HoldDuration = 0
        p:InputHoldBegin()
        task.wait(0.05)
        p:InputHoldEnd()
    end)
    pcall(function()
        p.HoldDuration = originalHold
    end)
    if ok then
        return true
    end
    addLog("prompt trigger failed: " .. tostring(p.Name))
    return false
end

local function vimAvailable()
    return typeof(VirtualInputManager) == "Instance"
end

local function uiClickAt(x, y)
    if not vimAvailable() then return false end
    local ok = pcall(function()
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(0.06)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)
    if ok then return true end
    local ok2 = pcall(function()
        local vu = game:GetService("VirtualUser")
        vu:Button1Down(Vector2.new(x, y))
        task.wait(0.06)
        vu:Button1Up(Vector2.new(x, y))
    end)
    return ok2
end

local function screenCenter(obj)
    local pos = obj.AbsolutePosition
    local size = obj.AbsoluteSize
    return Vector2.new(pos.X + size.X / 2, pos.Y + size.Y / 2)
end

local function scrollIntoView(obj)
    local node = obj.Parent
    while node and node ~= game do
        if node:IsA("ScrollingFrame") then
            pcall(function()
                local fPos = node.AbsolutePosition
                local fSize = node.AbsoluteSize
                local oPos = obj.AbsolutePosition
                local oSize = obj.AbsoluteSize
                local top = oPos.Y - fPos.Y
                local bottom = top + oSize.Y
                local dy = 0
                if top < 0 then
                    dy = top - 6
                elseif bottom > fSize.Y then
                    dy = bottom - fSize.Y + 6
                end
                if dy ~= 0 then
                    local canvas = node.CanvasPosition
                    node.CanvasPosition = Vector2.new(canvas.X,
                        math.max(0, canvas.Y + dy))
                end
            end)
            return true
        end
        node = node.Parent
    end
    return false
end

local function uiClick(obj)
    if not obj or not obj.Parent then return false end
    if not guiVisible(obj) then return false end
    local scrolled = scrollIntoView(obj)
    if scrolled then
        task.wait(0.08)
    end
    local ok, center = pcall(screenCenter, obj)
    if not ok then return false end
    if center.X == 0 and center.Y == 0 then return false end
    local camera = Workspace.CurrentCamera
    if camera then
        local vp = camera.ViewportSize
        if center.X < -8 or center.Y < -8 or center.X > vp.X + 8 or center.Y > vp.Y + 8 then
            return false
        end
    end
    return uiClickAt(center.X, center.Y)
end

local function sendKey(keyCode, requireNoFocus)
    if requireNoFocus then
        local focusOk, focused = pcall(function()
            return GuiService:GetFocusedTextBox()
        end)
        if focusOk and focused then return false end
    end
    if not vimAvailable() then return false end
    local ok = pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game, 1)
    end)
    return ok
end

local function pressInteractKey()
    return sendKey(Enum.KeyCode.E, true)
end

local CANCEL_TEXT = {
    ["cancel"] = true, ["no thanks"] = true, ["not now"] = true,
    ["never mind"] = true, ["no, thanks"] = true, ["x"] = true,
    ["close"] = true, ["no"] = true,
}

local lastPromptLog = 0
local lastPromptAct = 0
local lastGatedLog = 0
local escapeArmedAt = 0

local function findPromptNode(node, depth)
    if depth > 14 then return nil end
    if node:IsA("GuiObject") and node.Visible == false then return nil end
    if node:IsA("LayerCollector") and node.Enabled == false then return nil end
    local n = lower(node.Name)
    if string.find(n, "purchaseprompt", 1, true)
        or string.find(n, "robloxprompt", 1, true)
        or (string.find(n, "prompt", 1, true)
            and (string.find(n, "purchase", 1, true)
                or string.find(n, "robux", 1, true)
                or string.find(n, "gamepass", 1, true)
                or string.find(n, "buy", 1, true))) then
        return node
    end
    for _, child in ipairs(node:GetChildren()) do
        local found = findPromptNode(child, depth + 1)
        if found then return found end
    end
    return nil
end

local function runPurchaseGuard()
    if now() - State.LastPromptWatch < 0.4 then return end
    State.LastPromptWatch = now()

    local roots = {}
    local okCore, coreGui = pcall(function()
        return game:GetService("CoreGui")
    end)
    if okCore and coreGui then roots[#roots + 1] = coreGui end
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then roots[#roots + 1] = playerGui end

    local prompt = nil
    for _, root in ipairs(roots) do
        local ok, found = pcall(findPromptNode, root, 0)
        if ok and found then
            prompt = found
            break
        end
    end
    if not prompt then return end

    if now() - lastPromptAct < 1.2 then return end
    lastPromptAct = now()

    local clicked = false
    pcall(function()
        for _, d in ipairs(prompt:GetDescendants()) do
            if clicked then return end
            if (d:IsA("TextButton") or d:IsA("ImageButton"))
                and guiVisible(d) then
                local t = d:IsA("TextButton") and lower(d.Text):gsub("^%s+", "")
                    :gsub("%s+$", "") or ""
                if CANCEL_TEXT[t] == true and not isGated(t) then
                    if uiClick(d) then clicked = true end
                end
            end
        end
    end)
    if not clicked and now() - escapeArmedAt > 6 then
        escapeArmedAt = now()
        sendKey(Enum.KeyCode.Escape, false)
    end

    if State.LastGuiClick and State.LastGuiClick.Parent
        and now() - State.LastGuiClickAt < 5 then
        State.Cooldowns[State.LastGuiClick] = now() + 90
        if now() - lastGatedLog > 8 then
            lastGatedLog = now()
            addLog("gated: button wants a gamepass — shelved 90s, "
                .. "continuing on free paths")
        end
        State.LastGuiClick = nil
    end
    if now() - lastPromptLog > 8 then
        lastPromptLog = now()
        addLog("purchase prompt cancelled — nothing bought")
        toast("Purchase prompt closed")
    end
end

local function runConfirmClick()
    if now() > State.ConfirmUntil or not State.ConfirmBucket then return end
    if not State.Features[State.ConfirmBucket] then return end
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end
    local statKey = STAT_KEYS[State.ConfirmBucket]
    for _, gui in ipairs(playerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= HUB_NAME and gui.Enabled then
            for _, d in ipairs(gui:GetDescendants()) do
                if d:IsA("TextButton") and guiVisible(d)
                    and now() >= (State.Cooldowns[d] or 0) then
                    local t = lower(d.Text)
                    if isConfirmText(t) and uiClick(d) then
                        State.Cooldowns[d] = now() + 3
                        if statKey then
                            State.Stats[statKey] = State.Stats[statKey] + 1
                        end
                        addLog(("confirm: clicked \"%s\" (%s)"):format(
                            t, State.ConfirmBucket))
                        State.ConfirmUntil = 0
                        State.ConfirmBucket = nil
                        return
                    end
                end
            end
        end
    end
end

local function clickWorldPart(part)
    local camera = Workspace.CurrentCamera
    local root = getRoot()
    if not camera or not root or not part or not part.Parent then return false end
    local vp, onScreen = camera:WorldToViewportPoint(part.Position)
    local viewport = camera.ViewportSize
    if onScreen and vp.X >= 0 and vp.Y >= 0 and vp.X <= viewport.X and vp.Y <= viewport.Y then
        return uiClickAt(vp.X, vp.Y)
    end
    pcall(function()
        local flat = Vector3.new(part.Position.X - root.Position.X, 0,
            part.Position.Z - root.Position.Z)
        if flat.Magnitude > 0.5 then
            root.CFrame = CFrame.lookAt(root.Position,
                root.Position + Vector3.new(flat.X, 0, flat.Z))
        end
    end)
    return false
end

local function moveToTarget(rec)
    local humanoid = getHumanoid()
    local root = getRoot()
    local pos = positionOf(rec.inst)
    if not humanoid or not root or not pos then return end
    if humanoid.Health <= 0 then return end

    local dist = (root.Position - pos).Magnitude
    if State.Features.tp and dist > Config.TeleportDistance
        and now() - State.LastTeleport > Config.TeleportGap then
        State.LastTeleport = now()
        local ok = pcall(function()
            local flat = root.Position - pos
            flat = Vector3.new(flat.X, 0, flat.Z)
            if flat.Magnitude > 0.5 then
                flat = flat.Unit * 3
            else
                flat = Vector3.new(0, 0, -3)
            end
            root.CFrame = CFrame.new(pos + flat + Vector3.new(0, 4, 0))
        end)
        if ok then
            dist = (root.Position - pos).Magnitude
        end
    end
    humanoid:MoveTo(pos)
end

--------------------------------------------------------------------------------
-- navigation slot
--------------------------------------------------------------------------------

local Nav = {
    Record = nil,
    Until  = 0,
}

local function clearNav()
    Nav.Record = nil
end

local function readyWorld(rec)
    return rec.kind ~= "gui"
        and rec.inst.Parent ~= nil
        and now() >= (State.Cooldowns[rec.inst] or 0)
end

local function pickWorldTarget(bucket)
    local list = State.Targets[bucket]
    if not list or #list == 0 then return nil end
    local best, bestDist = nil, math.huge
    for _, rec in ipairs(list) do
        if readyWorld(rec) then
            local d = distanceTo(rec.inst)
            if d < bestDist then
                best, bestDist = rec, d
            end
        end
    end
    return best
end

local function fireRecord(rec)
    if rec.kind == "prompt" then
        return triggerPrompt(rec.inst)
    elseif rec.kind == "click" then
        if distanceTo(rec.inst) > rec.range then return false end
        if clickWorldPart(rec.inst) then
            State.LastTrigger[rec.inst] = now()
            return true
        end
        return false
    elseif rec.kind == "key" then
        if distanceTo(rec.inst) > rec.range then return false end
        local parent = rec.inst.Parent
        if parent then
            for _, d in ipairs(parent:GetDescendants()) do
                if d:IsA("ProximityPrompt") and d.Enabled and distanceTo(d) <= 6 then
                    if triggerPrompt(d) then
                        State.LastTrigger[rec.inst] = now()
                        return true, "prompt"
                    end
                end
            end
        end
        if pressInteractKey() then
            State.LastTrigger[rec.inst] = now()
            return true, "key"
        end
        return false
    elseif rec.kind == "pad" then
        return true
    end
    return false
end

local function runTarget(bucket, statKey, label)
    if not State.Features[bucket] then
        if Nav.Record and Nav.Record.bucket == bucket then clearNav() end
        return
    end

    if Nav.Record and Nav.Record.bucket == bucket then
        local rec = Nav.Record
        if rec.inst.Parent == nil then
            clearNav()
            return
        end
        local d = distanceTo(rec.inst)
        if d <= rec.range then
            local ok, mode = fireRecord(rec)
            if ok then
                State.Cooldowns[rec.inst] = now() + Config.PerPromptCooldown
                State.Cooldowns["__" .. bucket] = now() +
                    (bucket == "raid" and 2 or Config.PromptCooldown)
                State.Stats[statKey] = State.Stats[statKey] + 1
                if now() > State.ConfirmUntil then
                    State.ConfirmUntil = now() + 4
                    State.ConfirmBucket = bucket
                end
                if mode == "key" then
                    addLog(label .. " #" .. State.Stats[statKey] .. " (E key)")
                else
                    addLog(label .. " #" .. State.Stats[statKey])
                end
            else
                State.Cooldowns[rec.inst] = now() + 2
            end
            clearNav()
        elseif now() > Nav.Until then
            addLog(label .. ": move timeout — skipping target")
            State.Cooldowns[rec.inst] = now() + 15
            clearNav()
        else
            moveToTarget(rec)
        end
        return
    end

    local list = State.Targets[bucket]
    if list and now() >= State.ConfirmUntil then
        for _, rec in ipairs(list) do
            if rec.kind == "gui" and rec.inst.Parent and guiVisible(rec.inst)
                and now() >= (State.Cooldowns[rec.inst] or 0) then
                if uiClick(rec.inst) then
                    State.Cooldowns[rec.inst] = now() + Config.GuiTargetCooldown
                    State.Stats[statKey] = State.Stats[statKey] + 1
                    if now() > State.ConfirmUntil then
                        State.ConfirmUntil = now() + 4
                        State.ConfirmBucket = bucket
                    end
                    State.LastGuiClick = rec.inst
                    State.LastGuiClickAt = now()
                    addLog(label .. " (gui) #" .. State.Stats[statKey])
                    return
                else
                    State.Cooldowns[rec.inst] = now() + Config.GuiTargetCooldown
                end
            end
        end
    end

    if Nav.Record and Nav.Record.bucket ~= bucket then
        return
    end

    if now() < (State.Cooldowns["__" .. bucket] or 0) then return end
    local target = pickWorldTarget(bucket)
    if not target then return end
    Nav.Record = target
    Nav.Until = now() + Config.MoveTimeout
end


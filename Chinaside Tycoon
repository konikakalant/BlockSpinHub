local function runCollectPads()
    if not State.Features.collect then return end
    if Nav.Record then return end
    if now() < (State.Cooldowns["__pads"] or 0) then return end
    local root = getRoot()
    if not root then return end

    local container = State.Base or Workspace
    local best, bestDist = nil, 70
    for _, d in ipairs(container:GetDescendants()) do
        if d:IsA("BasePart") and d.Anchored then
            local n = lower(d.Name)
            if matchAny(n, { "cash", "money", "claim", "collector", "dropoff", "payout" })
                and not string.find(n, "wall", 1, true)
                and now() >= (State.Cooldowns[d] or 0)
                and (State.Base == nil or State.Base:IsAncestorOf(d)) then
                local d2 = (root.Position - d.Position).Magnitude
                if d2 < bestDist then
                    best, bestDist = d, d2
                end
            end
        end
    end
    if best then
        Nav.Record = { kind = "pad", inst = best, bucket = "collect", range = 4 }
        Nav.Until = now() + Config.MoveTimeout
        State.Cooldowns["__pads"] = now() + 3.0
    end
end


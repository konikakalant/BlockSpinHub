local function togglePause()
    State.Paused = not State.Paused
    if Gui and Gui.Pause and Gui.Pause.Parent then
        Gui.Pause.Text = State.Paused and "▶" or "||"
        Gui.Pause.BackgroundColor3 = State.Paused and COLORS.accent or COLORS.off
    end
    toast(State.Paused and "PAUSED" or "RESUMED")
    addLog(State.Paused and "paused" or "resumed")
    if State.Paused then
        clearNav()
    end
    saveSettings()
end

local function bindGui()
    for key, btn in pairs(toggles) do
        btn.Activated:Connect(function()
            State.Features[key] = not State.Features[key]
            addLog((State.Features[key] and "on: " or "off: ") .. key)
            if key == "speed" and not State.Features.speed and State.SpeedApplied then
                local humanoid = getHumanoid()
                if humanoid then humanoid.WalkSpeed = State.SavedSpeed end
                State.SpeedApplied = false
            end
            saveSettings()
        end)
    end
    Gui.Actions.SCAN.Activated:Connect(function()
        safeCall(runScanReport)
    end)
    Gui.Actions.CODES.Activated:Connect(function()
        task.spawn(function()
            safeCall(redeemCodes)
        end)
    end)
    Gui.Actions.BRIBE.Activated:Connect(function()
        task.spawn(function()
            safeCall(bribeNow)
        end)
    end)
    Gui.Actions.UNLOAD.Activated:Connect(function()
        addLog("unloading...")
        State.Running = false
        if State.SpeedApplied then
            local humanoid = getHumanoid()
            if humanoid then humanoid.WalkSpeed = State.SavedSpeed end
            State.SpeedApplied = false
        end
        for _, conn in ipairs(Connections) do
            pcall(function() conn:Disconnect() end)
        end
        table.clear(Connections)
        if Gui and Gui.Screen then
            Gui.Screen:Destroy()
        end
        Gui = nil
    end)
    Gui.Close.Activated:Connect(function()
        if Gui and Gui.Screen then
            Gui.Screen.Enabled = not Gui.Screen.Enabled
        end
    end)
    Gui.Pause.Activated:Connect(function()
        togglePause()
    end)
    Gui.Min.Activated:Connect(function()
        if not Gui or not Gui.Main then return end
        Gui.Minimized = not Gui.Minimized
        for _, el in ipairs(Gui.Body) do
            el.Visible = not Gui.Minimized
        end
        Gui.Main.Size = Gui.Minimized and UDim2.fromOffset(320, 44)
            or UDim2.fromOffset(320, 640)
        Gui.Min.Text = Gui.Minimized and "+" or "_"
    end)
end

--------------------------------------------------------------------------------
-- scheduler
--------------------------------------------------------------------------------

local function updateStatsText()
    if not Gui or not Gui.Stats then return end
    for key, dot in pairs(toggleRows) do
        dot.BackgroundColor3 = State.Features[key] and COLORS.on or COLORS.off
    end
    local s = State.Stats
    local elapsed = math.max(0, math.floor(now() - (State.StartedAt > 0 and State.StartedAt or now())))
    local mm = math.floor(elapsed / 60)
    local ss = elapsed % 60
    Gui.Stats.Text = ("photos %d orders %d ships %d cash %d rewards %d\nhired %d bribes %d crates %d run %d:%02d"):format(
        s.photos, s.orders, s.ships, s.collected, s.rewards,
        s.hired, s.bribed, s.crates, mm, ss)
end

local function tick()
    if not State.Running then return end

    safeCall(runPurchaseGuard)

    if State.Paused then
        setStatus("PAUSED — press ▶ or F6 to resume")
        updateStatsText()
        return
    end

    local character = getCharacter()
    local humanoid = getHumanoid()
    if not character or not humanoid or humanoid.Health <= 0 then
        setStatus("waiting for character...")
        return
    end

    if now() - State.ScanAt >= Config.ScanInterval then
        safeCall(rescanTargets)
        safeCall(findGuiObjects)
    end

    applySpeed()
    runAntiAfk()

    if not State.Busy then
        safeCall(runRaid)
        safeCall(runConfirmClick)

        for _, bucket in ipairs(BUCKET_ORDER) do
            safeCall(runTarget, bucket, STAT_KEYS[bucket], bucket:upper())
        end

        safeCall(runCollectPads)
    end

    local total = 0
    for _, bucket in ipairs(BUCKET_ORDER) do
        if State.Features[bucket] then
            total = total + #State.Targets[bucket]
        end
    end
    local baseTag = State.Base and State.Base:GetName() or "not found"
    if total == 0 then
        setStatus(("base: %s | no active targets — SCAN for report"):format(baseTag))
    elseif Nav.Record then
        local name = "?"
        pcall(function() name = Nav.Record.inst.Name end)
        setStatus(("base: %s | %s: %s (%.0f studs)"):format(
            baseTag, Nav.Record.kind, name, distanceTo(Nav.Record.inst)))
    else
        setStatus(("base: %s | P%d C%d S%d G%d | ready"):format(
            baseTag, State.Counts.prompt, State.Counts.click,
            State.Counts.key, State.Counts.gui))
    end
    updateStatsText()
end

--------------------------------------------------------------------------------
-- lifecycle
--------------------------------------------------------------------------------

local function onCharacterAdded(character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    if humanoid then
        State.SpeedApplied = false
        clearNav()
        addLog("character spawned")
        task.delay(1, function()
            safeCall(rescanTargets)
        end)
        if State.Features.autocodes and not State.Paused then
            task.delay(6, function()
                if State.Running and State.Features.autocodes and not State.Paused then
                    addLog("auto-codes: redeeming on join")
                    safeCall(redeemCodes)
                end
            end)
        end
    end
end

local function start()
    if game.PlaceId ~= PLACE_ID then
        addLog(("warning: place %s is not ChinaSide Tycoon (%s)")
            :format(tostring(game.PlaceId), tostring(PLACE_ID)))
    end

    State.StartedAt = now()
    loadSettings()

    local runStamp = tostring(now())
    pcall(function()
        LocalPlayer:SetAttribute(HUB_NAME .. "Run", runStamp)
    end)
    task.spawn(function()
        while State.Running do
            task.wait(2)
            local ok, current = pcall(function()
                return LocalPlayer:GetAttribute(HUB_NAME .. "Run")
            end)
            if ok and current ~= nil and current ~= runStamp then
                addLog("new instance started — stopping this one")
                State.Running = false
                if State.SpeedApplied then
                    local humanoid = getHumanoid()
                    if humanoid then humanoid.WalkSpeed = State.SavedSpeed end
                    State.SpeedApplied = false
                end
                for _, conn in ipairs(Connections) do
                    pcall(function() conn:Disconnect() end)
                end
                table.clear(Connections)
                if Gui and Gui.Screen then
                    Gui.Screen:Destroy()
                end
                Gui = nil
                return
            end
        end
    end)

    buildGui()
    bindGui()
    if State.Paused and Gui and Gui.Pause then
        Gui.Pause.Text = "▶"
        Gui.Pause.BackgroundColor3 = COLORS.accent
    end

    addLog("ChinaSide Auto Hub v1.3 loaded")
    addLog(("place=%s player=%s"):format(tostring(game.PlaceId), LocalPlayer.Name))
    addLog("keys: RIGHT SHIFT show/hide · F6 pause · F8 codes")

    safeCall(rescanTargets)
    safeCall(findGuiObjects)

    if LocalPlayer.Character then
        task.spawn(function()
            if LocalPlayer.Character then
                onCharacterAdded(LocalPlayer.Character)
            end
        end)
    end
    table.insert(Connections, LocalPlayer.CharacterAdded:Connect(onCharacterAdded))

    table.insert(Connections, LocalPlayer.Idled:Connect(function()
        if State.Features.antiafk and State.Running then
            pcall(function()
                local vu = game:GetService("VirtualUser")
                vu:CaptureController()
                vu:ClickButton2(Vector2.new(0, 0))
            end)
            addLog("anti-afk: idle event handled")
        end
    end))

    local accumulator = 0
    local tickRunning = false
    table.insert(Connections, RunService.Heartbeat:Connect(function(dt)
        accumulator = accumulator + dt
        if accumulator >= Config.TickRate then
            accumulator = 0
            if tickRunning then return end
            tickRunning = true
            local ok, err = pcall(tick)
            tickRunning = false
            if not ok then
                addLog("tick error: " .. tostring(err))
            end
        end
    end))

    table.insert(Connections, UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.RightShift then
            if Gui and Gui.Screen then
                Gui.Screen.Enabled = not Gui.Screen.Enabled
            end
        elseif input.KeyCode == Enum.KeyCode.F6 then
            togglePause()
        elseif input.KeyCode == Enum.KeyCode.F8 then
            task.spawn(function()
                safeCall(redeemCodes)
            end)
        end
    end))

    setStatus("loaded — RIGHT SHIFT show/hide · F6 pause")
    toast("ChinaSide Auto Hub v1.3 loaded")
end

safeCall(start)

-- base discovery
--------------------------------------------------------------------------------

-- Computed once. This used to be rebuilt inside modelOwnerMatch, which runs
-- for every Model and Folder in the workspace on every single scan.
local MY_ID, MY_NAME, MY_DISPLAY = nil, nil, nil
do
    MY_ID = tostring(LocalPlayer.UserId)
    MY_NAME = lower(LocalPlayer.Name)
    MY_DISPLAY = lower(LocalPlayer.DisplayName)
end

--------------------------------------------------------------------------------
-- THE PLANNER
--
-- The tycoon loop is a chain: photos -> orders -> shipping -> cash. A fixed
-- priority list walks that order blindly. The planner reads the counters the
-- observer collected and asks a different question: not "what should I try
-- next", but "what is the game actually waiting for".
--
-- Safety is the whole design. The planner can only ever REORDER work, never
-- remove it - every enabled mode still runs on the normal round afterwards.
-- So the worst a wrong guess can do is spend one click on a mode that was
-- going to run anyway. It cannot buy, cannot fire a remote, and cannot leave
-- money on the table. If the game cannot be read, or nothing is pending, the
-- planner stands down and behaviour is exactly what it was before.
--------------------------------------------------------------------------------

-- Lower number = earlier in the chain the game is stuck at.
local PIPELINE_RANK = {
    raid = 0, photo = 1, order = 2, ship = 3,
    collect = 4, reward = 5, crate = 6, hire = 7,
}
-- A pending queue is small. A five-figure number on screen is a balance, not
-- a count of work, and must never be mistaken for one.
local MAX_PENDING = 999

-- Has this mode ever been shown to do anything?
--
-- This is the end point of everything the hub has learned. It can time a mode
-- accurately, and it can rank targets by usefulness, but both of those assume
-- the mode WORKS. When a mode has been clicked many times and its own counter
-- has never once moved, the honest conclusion is that the button is not the
-- one the game listens to - a renamed button, a decoy, a tab rather than an
-- action. Clicking it forever is not slow, it is pointless, and it is what
-- fills the log with "not responding".
--
-- It is skipped rather than removed, and the skip is reported, so a mode that
-- starts working later is picked up again the moment its counter moves.
local USELESS_NEVER = { raid = true, collect = true, reward = true }

-- One annotated reader for the response evidence. Routing the two tables
-- through a single declared-signature function, instead of indexing them at
-- every use site, keeps the file's type inference inside its budget.
local function responseOf(bucket: string): (number, number)
    return State.ResponseTries[bucket] or 0, State.ResponseMoves[bucket] or 0
end

local function modeProvenUseless(bucket: string): boolean
    if USELESS_NEVER[bucket] then return false end
    -- A mode whose counter the observer cannot read can never be credited with
    -- a move, so after a few clicks it would look "proven useless" and be
    -- switched off for the rest of the session. Refusing to judge a mode we
    -- cannot actually observe is the whole point of this check.
    if not State.CounterByBucket[bucket] then return false end
    local tries, moves = responseOf(bucket)
    if tries < Config.ResponseTriesBeforeUseless then return false end
    return moves == 0
end

-- Should this mode be left alone for now?
--
-- If the game says "Orders: 0" and keeps saying so, there is no order to
-- process, and clicking an order button anyway is pure noise - it is also the
-- main reason slow modes used to end up flagged NOT RESPONDING when in fact
-- there was simply nothing to respond to.
--
-- The bar is deliberately high: three consecutive reads, spread over time,
-- and the mode always comes back. Raid and collect are never skipped, because
-- a stale zero there is dangerous rather than merely wasteful.
local NOTHING_SAFE_SKIP = { raid = true, collect = true, reward = true }

local function idleSkip(bucket)
    if NOTHING_SAFE_SKIP[bucket] then return false end
    if not State.Features[bucket] then return false end
    if State.IdleUntil[bucket] and now() < State.IdleUntil[bucket] then
        return true
    end
    -- proven to do nothing: do not click it at all
    if modeProvenUseless(bucket) then return true end
    return false
end

local function noteIdleRead()
    -- One read per walk. The pause is short and re-armed by a later read, so a
    -- counter that was briefly wrong costs a few seconds of not clicking,
    -- never a mode that is switched off.
    for _, bucket in ipairs(BUCKET_ORDER) do
        local c = State.CounterByBucket[bucket]
        if c then
            if c.value <= 0 then
                State.IdleReads[bucket] = (State.IdleReads[bucket] or 0) + 1
                if (State.IdleReads[bucket] or 0) >= Config.IdleReadsToSkip
                    and (State.IdleUntil[bucket] or 0) <= now() then
                    State.IdleUntil[bucket] = now() + Config.IdleSkipFor
                end
            else
                State.IdleReads[bucket] = 0
                State.IdleUntil[bucket] = 0
            end
        end
    end
end

local function planJob()
    local job, rank = nil, math.huge
    for bucket, counter in pairs(State.CounterByBucket) do
        local r = PIPELINE_RANK[bucket]
        -- a disabled mode cannot be worked on, so letting it win the reorder
        -- would spend the one priority slot on nothing and suppress the log
        if r and State.Features[bucket]
            and counter.value > 0 and counter.value <= MAX_PENDING
            and r < rank and not idleSkip(bucket) then
            job, rank = bucket, r
        end
    end
    return job
end

-- A plot is a direct child of the workspace, or a child of one of the usual
-- plot containers. Checking this before the owner match keeps the attributes
-- scan off the thousands of deep decorative models in a tycoon.
local PLOT_PARENTS = {
    tycoons = true, tycoon = true, bases = true, base = true,
    plots = true, plot = true, players = true, workspace = true,
}

local function looksLikePlot(node)
    local parent = node.Parent
    if not parent then return false end
    if parent == Workspace then return true end
    return PLOT_PARENTS[lower(parent.Name)] == true
end

local function modelOwnerMatch(model)
    -- cheap name test first: it settles almost every model without touching
    -- attributes at all
    local lname = lower(model.Name)
    if lname == MY_NAME or lname == MY_DISPLAY then
        return true
    end
    if (MY_NAME ~= MY_DISPLAY) and string.find(lname, MY_DISPLAY, 1, true) then
        return true
    end
    -- GetAttributes() allocates a table per call, so this is only reached for
    -- models that could plausibly BE a plot (see looksLikePlot), not for every
    -- model in the workspace
    for attr, value in pairs(model:GetAttributes()) do
        local v = lower(value)
        local a = lower(attr)
        if v == MY_ID or v == MY_NAME or v == MY_DISPLAY then
            if string.find(a, "owner") or string.find(a, "user")
                or string.find(a, "player") then
                return true
            end
        end
    end
    return false
end

-- Cheap pass only: looks in the usual plot containers. The expensive
-- whole-workspace owner search is folded into the single main scan below, so
-- a rescan walks the workspace exactly once instead of twice.
local function findBaseInKnownFolders()
    local candidates = {}
    local folders = { "Tycoons", "Tycoon", "Bases", "Base", "Plots", "Plot", "Players" }
    for _, folderName in ipairs(folders) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder and (folder:IsA("Folder") or folder:IsA("Model")) then
            for _, child in ipairs(folder:GetChildren()) do
                if (child:IsA("Model") or child:IsA("Folder")) and not isCharacterModel(child) then
                    if modelOwnerMatch(child) then
                        return child, "owner match in " .. folderName
                    end
                    table.insert(candidates, child)
                end
            end
        end
    end
    return nil, nil, candidates
end

local function pickBaseFromCandidates(candidates)
    if candidates and #candidates == 1 then
        return candidates[1], "single plot (no owner match)"
    end
    return nil, "no owner match found"
end

--------------------------------------------------------------------------------
-- target discovery: prompts, click detectors, station parts, GUI buttons
--------------------------------------------------------------------------------

local function clearTargets()
    for _, list in pairs(State.Targets) do
        table.clear(list)
    end
    State.Counts = { prompt=0, click=0, key=0, gui=0 }
    -- LastTried is keyed by instance, so parts that get destroyed would sit
    -- in it for the rest of the session. Dropping the ones with no parent
    -- keeps it bounded by the live objects in the base.
    -- Both per-instance maps are pruned here, and separately: LastTried only
    -- ever holds targets that were walked to, so pruning Quality from inside
    -- that loop would leak a permanent entry for every GUI button ever clicked.
    for inst in pairs(State.LastTried) do
        if inst.Parent == nil then
            State.LastTried[inst] = nil
        end
    end
    for inst in pairs(State.Quality) do
        if inst.Parent == nil then
            State.Quality[inst] = nil
        end
    end
end

local function addRecord(bucket, kind, inst, range)
    -- lastTried is what makes the picker fair: without it the nearest target
    -- wins every single time, so one dead-but-close station could keep every
    -- other station on the map from ever being visited
    -- seeded from a map that survives a rescan. rescanTargets rebuilds every
    -- record list from scratch every 2-6 seconds, so a lastTried field on the
    -- record itself was thrown away before it could ever matter.
    local rec = { kind = kind, inst = inst, bucket = bucket, range = range or 10,
        lastTried = State.LastTried[inst] or 0 }
    table.insert(State.Targets[bucket], rec)
    State.Counts[kind] = (State.Counts[kind] or 0) + 1
    return rec
end

local function inBaseScope(inst)
    local base = State.Base
    if base then
        return base:IsAncestorOf(inst)
    end
    local root = getRoot()
    local pos = positionOf(inst)
    if not root or not pos then
        return false
    end
    return (root.Position - pos).Magnitude <= Config.NearRangeNoBase
end

local CASH_PAD_NAMES = { "cash", "money", "claim", "collector", "dropoff", "payout" }

local function stationPartFilter(name)
    return matchAny(name, { "station", "desk", "table", "terminal", "console",
        "kiosk", "booth", "workstation", "machine", "pad", "button" })
end

local function rescanTargets()
    State.ScanCount = State.ScanCount + 1
    local hadBase = State.Base ~= nil
    local base, why, candidates = findBaseInKnownFolders()
    if base then
        State.Base = base
        State.BaseWhy = why or "unknown"
    end
    clearTargets()

    for key, untilTime in pairs(State.Cooldowns) do
        if typeof(key) == "Instance" then
            if key.Parent == nil or now() >= untilTime then
                State.Cooldowns[key] = nil
            end
        end
    end
    for key, time in pairs(State.LastTrigger) do
        if typeof(key) == "Instance" and key.Parent == nil then
            State.LastTrigger[key] = nil
        end
    end
    for key in pairs(State.NoChange) do
        if typeof(key) == "Instance" and key.Parent == nil then
            State.NoChange[key] = nil
        end
    end

    local worldRecords = {}
    local padList = {}
    local ownerHit, ownerHitWhy = nil, nil

    -- ONE walk of the workspace collects: the player's plot, every usable
    -- interaction target, and the cash pads. Previously this data came from
    -- three separate full walks per cycle.
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled then
            local text = lower(table.concat({
                tostring(d.Name), tostring(d.ActionText), tostring(d.ObjectText) }, " "))
            local bucket = bucketForText(text)
            if bucket and not matchAny(text, WORKFLOW_EXCLUDE)
                and not isGated(text) and inBaseScope(d) then
                local range = math.clamp((d.MaxActivationDistance or 10) + 2, 6, 18)
                worldRecords[#worldRecords + 1] = addRecord(bucket, "prompt", d, range)
            end
        elseif d:IsA("ClickDetector") and d.Enabled then
            local parent = d.Parent
            if parent and not isCharacterModel(parent) then
                local text = lower(parent.Name)
                local node = parent.Parent
                for _ = 1, 2 do
                    if node and node ~= Workspace then
                        text = text .. " " .. lower(node.Name)
                        node = node.Parent
                    end
                end
                local bucket = bucketForText(text)
                if bucket and not matchAny(text, WORKFLOW_EXCLUDE)
                    and not isGated(text) and inBaseScope(parent) then
                    local range = math.clamp((d.MaxActivationDistance or 32) + 3, 8, 20)
                    worldRecords[#worldRecords + 1] = addRecord(bucket, "click", parent, range)
                end
            end
        elseif d:IsA("BasePart") then
            local name = d.Name
            if d.Anchored and matchAny(lower(name), CASH_PAD_NAMES)
                and not string.find(lower(name), "wall", 1, true) then
                padList[#padList + 1] = d
            end
            if stationPartFilter(name) and inBaseScope(d) then
                local bucket = bucketForText(name)
                if bucket and not matchAny(name, WORKFLOW_EXCLUDE)
                    and not isGated(name) then
                    worldRecords[#worldRecords + 1] = addRecord(bucket, "key", d, 9)
                end
            end
        elseif not ownerHit and (d:IsA("Model") or d:IsA("Folder"))
            and looksLikePlot(d) and not isCharacterModel(d)
            and modelOwnerMatch(d) then
            ownerHit, ownerHitWhy = d, "owner attribute/name match"
        end
    end
    State.PadParts = padList

    if not base then
        if ownerHit then
            base, why = ownerHit, ownerHitWhy
        else
            base, why = pickBaseFromCandidates(candidates)
        end
        -- if the plot only just became known, the walk above was scoped
        -- without it, so refresh immediately instead of using targets that
        -- may belong to a neighbour
        if State.Base ~= base then
            State.WorldDirty = true
            State.Base = base
            State.BaseWhy = why or "unknown"
        end
    end

    for _, rec in ipairs(worldRecords) do
        if rec.kind == "key" then
            local pos = positionOf(rec.inst)
            if pos then
                for _, other in ipairs(worldRecords) do
                    if other.kind ~= "key" and other.kind ~= "removed"
                        and other.bucket == rec.bucket then
                        local p2 = positionOf(other.inst)
                        if p2 and (pos - p2).Magnitude < 4 then
                            rec.kind = "removed"
                            break
                        end
                    end
                end
            end
        end
    end
    for i = #worldRecords, 1, -1 do
        if worldRecords[i].kind == "removed" then
            table.remove(worldRecords, i)
        end
    end
    for _, list in pairs(State.Targets) do
        for i = #list, 1, -1 do
            if list[i].kind == "removed" then
                table.remove(list, i)
                State.Counts.key = math.max(0, State.Counts.key - 1)
            end
        end
    end

    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, gui in ipairs(playerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Name ~= HUB_NAME and gui.Enabled then
                for _, d in ipairs(gui:GetDescendants()) do
                    if (d:IsA("TextButton") or d:IsA("ImageButton")) and guiVisible(d) then
                        local own = ownLabel(d)
                        local text = buttonText(d)
                        if not matchAny(text, WORKFLOW_EXCLUDE)
                            and not isGated(own) and not isGated(lower(d.Name))
                            and not isNavigationButton(own) then
                            local bucket = bucketForText(text)
                            if bucket then
                                local rec = addRecord(bucket, "gui", d, 0)
                                local okSize, size = pcall(function()
                                    return d.AbsoluteSize
                                end)
                                if okSize and typeof(size) == "Vector2" then
                                    rec.score = math.max(1, size.X * size.Y)
                                else
                                    rec.score = 1
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    -- Sort key computed ONCE per record. The comparator used to call
    -- distanceTo - a pcall'd GetPivot - every time it was invoked, which is
    -- O(n log n) engine calls instead of n, and this runs on every world
    -- rescan. The order itself is unchanged, so behaviour is identical.
    for _, list in pairs(State.Targets) do
        for _, rec in ipairs(list) do
            rec.sortKey = (rec.kind == "gui")
                and -(rec.score or 1)
                or (distanceTo(rec.inst) or math.huge)
        end
        table.sort(list, function(a, b)
            return a.sortKey < b.sortKey
        end)
    end

    State.ScanAt = now()
    if State.ScanCount == 1 or hadBase ~= (base ~= nil) then
        addLog(base and ("base: " .. base:GetName() .. " (" .. why .. ")")
                  or ("base not found (" .. tostring(why) .. "); using nearby scan"))
        addLog(("targets: %d prompts, %d click, %d stations, %d gui buttons"):format(
            State.Counts.prompt, State.Counts.click, State.Counts.key, State.Counts.gui))
        -- tell the player straight away whether there is anything to work on
        if State.ScanCount == 1 then
            State.FirstScanFound = State.Counts.prompt + State.Counts.click
                + State.Counts.key + State.Counts.gui
        end
    end
end


-- Rescan immediately, keeping the event-driven bookkeeping in step. Calling
-- rescanTargets directly left WorldDirty set, so the normal path walked the
-- entire workspace a second time about two seconds later.
local function rescanNow()
    State.WorldDirty = false
    if safeCall(rescanTargets) then
        State.LastWorldScan = now()
        return true
    end
    -- a failed scan must not be retried every tick: WorldDirty alone
    -- re-satisfies the outer gate, and State.ScanAt is only written at the very
    -- end of a scan that completes, so a partial failure would otherwise walk
    -- the whole workspace four times a second, for ever
    State.WorldDirty = true
    State.LastWorldScan = now()
    State.ScanAt = now()
    return false
end

--------------------------------------------------------------------------------
-- screen UI discovery (shop / codes / bribe)
--------------------------------------------------------------------------------

-- does this label look like a stable resource counter?
-- A LOOKUP table, keyed by the label a game would use for a wallet. It is
-- consumed with CASH_LABELS[name] in findCash, never iterated.
local CASH_LABELS = {
    cash = true, money = true, coins = true, balance = true, funds = true,
    ["$cash"] = true, ["$money"] = true, ["$coins"] = true, ["$"] = true,
}

-- Is this label showing MONEY rather than a count of things?
--
-- The screen fingerprint has to leave money out. A tycoon pays out passively,
-- so the wallet text changes on its own every few seconds, and a fingerprint
-- that includes it changes constantly. That mattered far more once the credit
-- logic started trusting the fingerprint: a mode with no readable counter
-- would collect a confirmation on every pass, purely from background income,
-- and report itself as WORKING for ever.
--
-- Only excluded when the wallet is readable some other way, because for a game
-- with no readable wallet that on-screen number is the only signal there is.
local function isMoneyText(txt)
    -- NOTE: this deliberately does not go through matchAny(). matchAny
    -- iterates with ipairs, and CASH_LABELS is a HASH keyed by name, so
    -- passing it there iterates nothing at all - the first version of this
    -- function therefore matched only text containing "$" and quietly left
    -- every "Cash: 1,500" in the fingerprint, which is the exact case it was
    -- written to catch.
    if type(txt) ~= "string" then return false end
    local t = lower(txt)
    -- a money word or a currency symbol: these are always a wallet
    if string.find(t, "cash", 1, true)
        or string.find(t, "money", 1, true)
        or string.find(t, "coin", 1, true)
        or string.find(t, "balance", 1, true)
        or string.find(t, "fund", 1, true)
        or string.find(t, "profit", 1, true)
        or string.find(t, "wallet", 1, true)
        or string.find(t, "robux", 1, true)
        or string.find(t, "%$", 1, true) then
        return true
    end
    -- A bare grouped number with no label at all ("1,500") is a money display.
    -- A grouped number that DOES carry a label ("Stock 123,456") is a real
    -- counter and must stay in the fingerprint: over-matching here silently
    -- drops genuine state changes, which is worse than the problem it fixes.
    if string.find(t, "%d+,%d%d%d") and not string.find(t, "%a") then
        return true
    end
    return false
end

local function isCounterText(txt)
    if type(txt) ~= "string" then return false end
    if #txt == 0 or #txt > 24 then return false end
    if not string.find(txt, "%d") then return false end
    -- a bare number, or a number with its label
    if string.match(txt, "^%s*[$%d][%d,%.%s]*$") then return true end
    -- or a named counter such as "cash 1,234", "orders: 3", "stock 12/40"
    if not string.match(txt, "^[%a%s%$%d%.:/,%-%+]+$") then return false end
    local t = lower(txt)
    for _, word in ipairs({ "cash", "order", "photo", "stock", "level",
        "haul", "crate", "money", "profit", "xp", "reward", "bribe" }) do
        if string.find(t, word, 1, true) then return true end
    end
    return false
end


-- THE OBSERVER
--
-- The game already displays its own state as "Label: number" text. Reading it
-- turns the hub from something that clicks by keyword into something that can
-- tell what the game is actually waiting for.
--
-- The label is then bucketed with the SAME matcher used for targets, so the
-- game labels its own state for us and no game-specific strings are hardcoded.
-- Nothing here costs a walk: it rides along on the PlayerGui pass that
-- findGuiObjects already makes.
--------------------------------------------------------------------------------

local function parseCounter(txt)
    -- Accepted: "Orders: 3"  "Orders = 3"  "orders 2 / 10"  "Staff: 4/6"
    --           "Hauls 1"  "Crates Available 2"
    --
    -- Rejected on purpose: a number that comes FIRST ("1,500 Cash"), because
    -- that is a balance on screen, not a count of work waiting. Reading a
    -- wallet as "1500 cash pads pending" would send the hub into a collect
    -- loop that never finishes. A real counter always leads with its label.
    --
    -- NOTE: Lua patterns have no "?" quantifier - it is a literal character
    -- there, not "optional". An optional group has to be stripped first.
    local body = txt:gsub("%s*/%s*%d[%d,%.]*%s*$", ""):gsub("%s*%%%s*$", "")
    local label, value
    label, value = body:match("^(.-)%s*[:=]%s*(%d[%d,%.]*)%s*$")
    if not label then
        label, value = body:match("^(.-)%s+(%d[%d,%.]*)%s*$")
    end
    if not label or not value then return nil end
    local n = tonumber((value:gsub(",", "")))
    if not n then return nil end
    label = lower(label):gsub("[%s:=/%%%(%%)%-%.+]+$", "")
    if label == "" then return nil end
    return label, n
end

-- Labels that report finished work rather than work waiting. Kept OUT of the
-- planner's choice for the same reason as above: "Orders Processed: 120" must
-- never stand in for "Orders: 3".
local LIFETIME_WORDS = { "taken", "total", "earned", "all time", "all-time",
                        "lifetime", "best", "completed", "done", "sold",
                        "record", "high", "processed", "fulfilled",
                        "shipped", "delivered", "cumulative", "bribed" }

-- Counters are gathered DURING the walk findGuiObjects already makes. This
-- used to be a second full walk of the same tree, which roughly doubled the
-- most expensive UI work the hub does - and that walk runs on every settle.
local function noteCounter(d)
    -- string.len, not "#": d is untyped here so the analyzer cannot prove
    -- Text is a string and flags the length operator
    if string.len(d.Text) > 28 then return end
    local label, value = parseCounter(d.Text)
    if not label then return end
    -- a total is history, not a queue: "Photos Taken: 500" is not 500 photos
    -- waiting, and trusting it would pin the planner to that mode for ever
    if matchAny(label, LIFETIME_WORDS) then return end
    local bucket = bucketForText(label)
    if not bucket then return end
    -- table.insert rather than "#t + 1": the table is re-created as an empty
    -- {} every scan, so it has no array part to measure and the analyzer is
    -- right to be suspicious of a length here
    table.insert(State.Counters, {
        label = label, value = value, bucket = bucket,
    })
end

-- HOW LONG THIS MODE ACTUALLY TAKES
--
-- Everything before v2.6 guessed at this. A 2.5s wait is right for a cash pad
-- and badly wrong for a QC photo that takes six seconds to register: with a
-- 2.5s cadence, the first shot works and every click after it lands on a table
-- that has already been photographed. Those clicks are not merely useless, they
-- are what makes a slow mode look broken.
--
-- So the hub measures it. Every proven confirmation records how long the
-- change actually took, and the running average becomes the floor for that
-- mode's spacing. This is the difference between guessing and measuring.
local function noteLatency(bucket, seconds)
    if seconds < Config.LatencyFloor or seconds > Config.LatencyCeiling then
        return
    end
    local prev = State.Latency[bucket]
    if not prev then
        State.Latency[bucket] = seconds
        return
    end
    -- weighted toward the newest sample: the game can be tuned mid-session
    State.Latency[bucket] = prev * 0.6 + seconds * 0.4
end

local function latencyFor(bucket)
    local l = State.Latency[bucket]
    if not l then return 0 end
    return l * Config.LatencyMargin
end

-- The shortest spacing this mode can honour: never faster than the game can
-- possibly react, and never faster than the global minimum.
local function spacingFloor(bucket)
    return math.max(Config.MinTune, latencyFor(bucket))
end

-- WHEN A COUNTER ACTUALLY MOVED
--
-- The first version of the latency learner measured the time between clicking
-- and the settle pass that noticed, which is always 1.2-1.7s because that is
-- when settleAction looks. It never measured the game at all, so the whole
-- layer was inert. The honest measurement is: this is the instant the counter
-- changed, that is the instant we clicked, and the difference is the answer.
-- Counters are tracked PER LABEL, not per bucket.
--
-- A screen showing both "Orders: 3" and "Orders Processed: 120" is showing a
-- queue and a total. Keyed by bucket, the larger number won, the queue was
-- invisible, and three things broke at once: the planner thought work was
-- always pending, the idle check never saw an empty queue, and the 3 -> 2
-- decrement was never seen as a move, so the order mode slowly talked itself
-- into "this never works".
local function noteCounterChange(bucket, label, value)
    local key = bucket .. "|" .. label
    local prev = State.CounterValue[key]
    if prev ~= nil and prev ~= value then
        local moved = now()
        State.CounterAt[key] = moved
        -- keep the bucket's freshest change, which is the one the planner and
        -- the response check should believe
        local at = State.CounterAtBucket[bucket]
        if not at or moved > at then State.CounterAtBucket[bucket] = moved end
        -- A counter of this mode moved. Credit it, but only if a click of this
        -- mode is recent enough to plausibly have caused it - otherwise a
        -- background change elsewhere in the game would be booked as proof
        -- that this mode works.
        -- At most ONE move per bucket per walk. Processing an order moves both
        -- "Orders" and "Orders Processed" at once, and crediting each would
        -- count a single piece of work twice - which inflates the evidence for
        -- a mode and hides a mode that is really failing.
        local credited = State.MoveCreditedThisWalk
        if credited and not credited[bucket] then
            for i = #State.Pending, 1, -1 do
                local q = State.Pending[i]
                if q.bucket == bucket and moved > q.at
                    and (moved - q.at) <= Config.ResponseWindow then
                    State.ResponseMoves[bucket] =
                        (State.ResponseMoves[bucket] or 0) + 1
                    credited[bucket] = true
                    break
                end
            end
        end
        -- Measure HERE, the instant the change is seen, rather than in
        -- settleAction. The settle pass judges an action at a fixed early age
        -- and then discards it, so any mode slower than that age could never
        -- be measured at all - which is the entire case this layer exists for.
        for i = #State.Pending, 1, -1 do
            local q = State.Pending[i]
            if q.bucket == bucket and moved > q.at then
                noteLatency(bucket, moved - q.at)
                break
            end
        end
    end
    State.CounterValue[key] = value
end

local function finishCounters()
    -- EVERY label is compared, so a change in any of them is seen.
    State.MoveCreditedThisWalk = {}
    local seen = State.CounterSeen
    for k in pairs(seen) do seen[k] = nil end
    for _, c in ipairs(State.Counters) do
        noteCounterChange(c.bucket, c.label, c.value)
        seen[c.bucket .. "|" .. c.label] = true
    end
    -- Labels come and go as the game's own UI changes, and the per-label maps
    -- are keyed by them, so anything not seen in this walk is dropped. Without
    -- this they grow for as long as the script runs.
    for key in pairs(State.CounterValue) do
        if not seen[key] then
            State.CounterValue[key] = nil
            State.CounterAt[key] = nil
        end
    end
    -- For the planner and the idle check, prefer the label that moved most
    -- recently: that is the one describing work in progress. Only when nothing
    -- has moved do we fall back to the largest, which is the best guess at a
    -- pending count.
    --
    -- Lifetime labels never appear here at all - noteCounter drops them - which
    -- is what actually stops "Orders Processed: 120" standing in for
    -- "Orders: 3".
    local chosen = {}
    for _, c in ipairs(State.Counters) do
        local key = c.bucket .. "|" .. c.label
        local at = State.CounterAt[key]
        local cur = chosen[c.bucket]
        if not cur then
            c.at = at
            chosen[c.bucket] = c
        elseif at and (not cur.at or at > cur.at) then
            c.at = at
            chosen[c.bucket] = c
        elseif not cur.at and c.value > cur.value then
            chosen[c.bucket] = c
        end
    end
    State.CounterByBucket = chosen
end

local function findGuiObjects(force)
    -- only walk the whole PlayerGui when its contents changed, or as a
    -- periodic safety net
    if not force then
        if not State.UiDirty and now() - State.LastUiScan < Config.UiRefreshEvery then
            return
        end
        -- floor as well as ceiling: a chatty game firing UI events must not
        -- turn this into a several-times-per-second PlayerGui walk
        if now() - State.LastUiScan < 0.5 then return end
    end
    State.UiDirty = false
    State.LastUiScan = now()
    local g = State.GuiParts
    g.shop, g.codesTab, g.codeBox, g.redeem, g.bribe = nil, nil, nil, nil, nil
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end

    -- While we are already walking this tree, build a cheap fingerprint of the
    -- game's own numbers (cash, order counts, stock...). Comparing it before
    -- and after an action is the only honest way to tell whether a click did
    -- anything, and it costs nothing extra.
    --
    -- The fingerprint is a COUNT plus a SUM of per-label hashes. Summing makes
    -- it independent of the order labels happen to be visited in, so a new
    -- label appearing early cannot change it by itself.
    local sigSum, sigCount = 0, 0
    State.Counters = {}
    State.ConfirmList = {}

    for _, gui in ipairs(playerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= HUB_NAME and gui.Enabled then
            for _, d in ipairs(gui:GetDescendants()) do
                if d:IsA("TextButton") or d:IsA("ImageButton") then
                    local t = d:IsA("TextButton") and (lower(d.Text) .. " " .. lower(d.Name))
                        or lower(d.Name)
                    if not g.shop and matchAny(t, { "shop", "store" }) and guiVisible(d) then
                        g.shop = d
                    end
                    if not g.codesTab and matchAny(t, { "code" }) and guiVisible(d) then
                        g.codesTab = d
                    end
                    if not g.redeem and matchAny(t, { "redeem" }) and guiVisible(d) then
                        g.redeem = d
                    end
                    -- free ride: this button is already being visited, and
                    -- runConfirmClick used to walk the whole PlayerGui again
                    -- several times a second just to find these
                    if d:IsA("TextButton") and guiVisible(d)
                        and isConfirmText(lower(d.Text)) then
                        table.insert(State.ConfirmList, d)
                    end
                    if not g.bribe and matchAny(t, { "bribe", "pay off", "payoff", "bail" })
                        and guiVisible(d) then
                        g.bribe = d
                    end
                elseif d:IsA("TextBox") then
                    if not g.codeBox and matchAny(lower(d.Name) .. " " .. lower(d.PlaceholderText),
                        { "code", "redeem" }) then
                        g.codeBox = d
                    end
                elseif d:IsA("TextLabel") and guiVisible(d) then
                    local txt = d.Text
                    -- free ride: this label is already being visited
                    noteCounter(d)
                    -- Only stable counters are fingerprinted. Fingerprinting
                    -- every animated number in a live game UI (timers, progress
                    -- bars) made the fingerprint change constantly, so every
                    -- click looked "confirmed" and nothing was ever backed off.
                    if isCounterText(txt)
                        and not (State.CashKnown and isMoneyText(txt)) then
                        sigCount = sigCount + 1
                        local h = 0
                        for i = 1, #txt do
                            h = (h * 131 + txt:byte(i)) % 2147483647
                        end
                        sigSum = sigSum + h
                    end
                end
            end
        end
    end
    State.Signature = sigCount .. "/" .. sigSum
    State.SignatureAt = now()
    finishCounters()
    -- Judged HERE, at the end of the walk that actually collected the
    -- counters. It used to be called from tick on every tick, so while the
    -- UI-dirty flag was set a single stale "Orders: 0" was counted three
    -- times in three quarters of a second and a mode got paused off one read.
    safeCall(noteIdleRead)
end

--------------------------------------------------------------------------------
-- Fresh read on demand. Callers that are about to judge an action use force,
-- because the ordinary walk can be only a few seconds old.
local function refreshSignature(force)
    if force or now() - (State.SignatureAt or 0) >= 0.5 then
        findGuiObjects(true)
    end
end

--------------------------------------------------------------------------------
-- ground truth: the player's own money
--
-- Cash is the one signal in these games that is both exact and unambiguous.
-- It is only ever READ here - the hub never writes a value and never touches a
-- remote, so this stays a client-side observation of our own player.
--------------------------------------------------------------------------------

-- modes whose result shows up immediately, so a miss is real and worth
-- backing off. Photos and packing pay out later and are never throttled.
local FAST_EFFECT = {
    collect = true, ship = true, reward = true, crate = true, raid = true,
    -- hiring spends cash, and any cash movement in the window counts as proof,
    -- so a hire that worked is not throttled; an inert "Hire" tab backs off
    hire = true,
}

local function readNumberValue(v)
    if typeof(v) == "number" then return v end
    local ok, n = pcall(function() return v.Value end)
    if not ok then return nil end
    if type(n) == "number" then return n end
    if type(n) == "string" then
        -- some games store money as "$1,234"
        local cleaned = string.gsub(n, "[^%d%.%-]", "")
        return tonumber(cleaned)
    end
    return nil
end

local function findCash()
    -- the usual home: PlayerGui-free, on the player itself
    local ls = LocalPlayer:FindFirstChild("leaderstats")
        or LocalPlayer:FindFirstChild("leaderboard")
    if ls then
        for _, child in ipairs(ls:GetChildren()) do
            if CASH_LABELS[lower(child.Name)] then
                local n = readNumberValue(child)
                if n then return n, child end
            end
        end
    end
    -- some games keep the wallet in a module or a folder on the player
    for _, child in ipairs(LocalPlayer:GetChildren()) do
        if child ~= getCharacter()
            and (child:IsA("Folder") or child:IsA("Model")) then
            for _, sub in ipairs(child:GetChildren()) do
                if CASH_LABELS[lower(sub.Name)] then
                    local n = readNumberValue(sub)
                    if n then return n, sub end
                end
            end
        end
    end
    return nil, nil
end

local function sampleCash()
    local amount = findCash()
    if not amount then
        -- the wallet can disappear on respawn or a map change; say so rather
        -- than freezing a stale number and comparing it with itself
        if State.CashKnown and now() - (State.CashAt or 0) > Config.CashFreshFor then
            State.CashKnown = false
            State.CashNow = nil
            -- drop the baseline too, or a wallet that comes back at a higher
            -- number books the difference as phantom session earnings
            State.CashLast = nil
            addLog("wallet: no longer readable, using on-screen numbers")
        end
        return
    end
    if State.CashLast == nil then
        -- first reading is the baseline, never counted as earnings
        State.CashLast = amount
        State.CashDrift = 0
    elseif amount ~= State.CashLast then
        local delta = amount - State.CashLast
        if delta > 0 then
            -- money went up: real, confirmed progress
            State.Earned = (State.Earned or 0) + delta
        end
        -- How big is ORDINARY money movement? A tycoon pays out passively, so
        -- without this the tuner cannot tell its own payout from background
        -- income and races every mode to top speed on idle earnings alone.
        State.CashDrift = math.max(math.abs(delta), (State.CashDrift or 0) * 0.9)
        State.CashLast = amount
    else
        State.CashDrift = (State.CashDrift or 0) * 0.9
    end
    State.CashNow = amount
    State.CashKnown = true
    State.CashAt = now()
end

local lastRaidCheck, raidVisibleCache = 0, false
local function raidGuiVisible()
    if now() - lastRaidCheck < 0.6 then
        return raidVisibleCache
    end
    -- a full PlayerGui walk just to look for a raid banner is wasteful when
    -- the UI has not changed
    if not State.UiDirty and now() - lastRaidCheck < 3.0 then
        return raidVisibleCache
    end
    lastRaidCheck = now()
    raidVisibleCache = false
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    -- Only a dedicated notice counts. A stat row reading "Police: 2" or a
    -- "RAID DEFENCE" label would otherwise keep the raid handler firing
    -- bribes every 3s forever.
    local ALARM = {
        "raid incoming", "incoming raid", "raid!", "raid in", "raid under",
        "you are being raided", "being raided", "police raid", "police are",
        "police at", "police incoming", "cops incoming", "cops are",
        "busted", "raid warning", "under attack", "shop raid",
        "pay the police", "evade the police", "hide from", "get raided",
    }
    for _, gui in ipairs(playerGui:GetDescendants()) do
        if (gui:IsA("TextLabel") or gui:IsA("TextButton")) and gui.Visible
            and not inHubGui(gui) and guiVisible(gui) then
            local t = lower(gui.Text)
            if #t > 0 and #t <= 60 and matchAny(t, ALARM) then
                raidVisibleCache = true
                break
            end
        end
    end
    return raidVisibleCache
end


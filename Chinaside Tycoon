local function runScanReport()
    rescanTargets()
    findGuiObjects()
    local lines = {}
    lines[#lines + 1] = "=== ChinaSide Auto Hub scan report ==="
    lines[#lines + 1] = "place=" .. tostring(game.PlaceId) .. " time=" .. os.date("%H:%M:%S")
    lines[#lines + 1] = "base=" .. (State.Base and State.Base:GetFullName() or "nil")
        .. " why=" .. tostring(State.BaseWhy)
    lines[#lines + 1] = ("counts: prompts=%d click=%d stations=%d gui=%d"):format(
        State.Counts.prompt, State.Counts.click, State.Counts.key, State.Counts.gui)
    for _, bucket in ipairs(BUCKET_ORDER) do
        local list = State.Targets[bucket]
        lines[#lines + 1] = ("targets.%s=%d"):format(bucket, #list)
        for i = 1, math.min(#list, 6) do
            local rec = list[i]
            local name = "?"
            pcall(function()
                name = rec.inst:GetFullName()
            end)
            local extra = ""
            if rec.kind == "gui" and rec.inst:IsA("TextButton") then
                extra = " [" .. tostring(rec.inst.Text) .. "]"
            end
            lines[#lines + 1] = ("  - %s: %s%s"):format(rec.kind, name, extra)
        end
    end
    local g = State.GuiParts
    lines[#lines + 1] = ("ui: shop=%s codesTab=%s codeBox=%s redeem=%s bribe=%s"):format(
        tostring(g.shop and g.shop:GetFullName()),
        tostring(g.codesTab and g.codesTab:GetFullName()),
        tostring(g.codeBox and g.codeBox:GetFullName()),
        tostring(g.redeem and g.redeem:GetFullName()),
        tostring(g.bribe and g.bribe:GetFullName()))
    local remotes = {}
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
            local n = lower(d.Name)
            if matchAny(n, { "order", "ship", "photo", "qc", "crate", "hire", "raid",
                             "bribe", "code", "cash", "collect", "claim", "tycoon" }) then
                remotes[#remotes + 1] = d.ClassName .. ":" .. d:GetFullName()
            end
        end
    end
    lines[#lines + 1] = "keyword remotes (report only, never fired): " .. #remotes
    for i = 1, math.min(#remotes, 12) do
        lines[#lines + 1] = "  - " .. remotes[i]
    end
    local report = table.concat(lines, "\n")
    print(report)
    addLog(("scan: %d lines printed to console (base=%s)"):format(
        #lines, State.Base and State.Base:GetName() or "nil"))
    for i = math.min(#lines, 6), 1, -1 do
        addLog(lines[i])
    end
    setStatus("scan complete — " .. #lines .. " lines printed to console")
    return report
end


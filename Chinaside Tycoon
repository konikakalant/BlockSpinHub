-- Wall-clock timer. os.clock() in Roblox reports CPU time, not real time, so
-- every cooldown and timer here would run slow on a loaded machine. One time
-- source is chosen once at load and never swapped mid-run (mixing them would
-- corrupt every stored deadline).
local wallClock = nil
-- NOTE: the chosen source is recorded in State.ClockSource rather than a local
-- of its own. This file declares 201 top-level locals against Luau's limit of
-- 200, so there is not one register spare for a new one - adding a single
-- top-level local here stops the whole script compiling.
do
    -- Several sources, most reliable first. The first version tried only
    -- _G.tick and Workspace:GetServerTimeNow(), and if BOTH failed it fell
    -- through to os.clock() - which the comment above warns is the one source
    -- that must not be used, because it measures CPU time, so every cooldown
    -- and every "is it stuck yet" test runs slow and the hub appears to do
    -- nothing at all. That failure is silent, and it was found by running the
    -- real script under a stub where _G is a read-only snapshot.
    --
    -- Each source is probed ONCE, at load, and one is chosen for the session:
    -- switching time bases mid-run would corrupt every stored deadline.
    local candidates = {
        { "_G.tick", function() return _G.tick and _G.tick() or nil end },
        { "GetServerTimeNow", function()
            return Workspace and Workspace.GetServerTimeNow
                and Workspace:GetServerTimeNow() or nil
        end },
        { "DateTime", function()
            if not _G.DateTime then return nil end
            local n = _G.DateTime.now().UnixTimestampMillis
            return (type(n) == "number") and (n / 1000) or nil
        end },
        { "os.time", function()
            local n = os.time()
            return (type(n) == "number" and n > 1000000) and n or nil
        end },
    }
    for _, c in ipairs(candidates) do
        local ok, v = pcall(c[2])
        if ok and type(v) == "number" and v > 1000000 then
            wallClock = c[2]
            State.ClockSource = c[1]
            break
        end
    end
end


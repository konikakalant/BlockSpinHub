local function runRaid()
    if not State.Features.raid then return end
    if not raidGuiVisible() then return end

    -- this walks every PlayerGui descendant, so never do it per tick
    if now() - (State.LastFindGui or 0) >= 1.0 then
        State.LastFindGui = now()
        findGuiObjects()
    end
    if State.GuiParts.bribe and now() >= (State.Cooldowns["__raidui"] or 0) then
        if uiClick(State.GuiParts.bribe) then
            State.LastGuiClick = State.GuiParts.bribe
            State.LastGuiClickAt = now()
            State.Stats.bribed = State.Stats.bribed + 1
            noteAction("raid", "bribed", State.GuiParts.bribe, "gui")
            State.LastAction = "RAID bribe"
            addLog("raid: clicked bribe button")
            State.Cooldowns["__raidui"] = now() + 3
            return
        end
    end
    if Nav.Record then return end
    if now() < (State.Cooldowns["__raid"] or 0) then return end
    local target = pickWorldTarget("raid")
    if target then
        setNav(target)
        State.Cooldowns["__raid"] = now() + 2
        addLog("raid detected: heading to bribe")
        if now() - (State.LastRaidToast or 0) > 15 then
            State.LastRaidToast = now()
            toast("RAID detected — bribing!")
        end
    end
end

